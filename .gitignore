.DS_Store
.build/
dist/
*.xcodeproj
.swiftpm/
*.dmg
*.app
.claude/settings.local.json
temp/
.tmp-shots/
queue/manager/.last-run
queue/manager/.objectives-seen

# A playtest lock is machine-local: it says someone at THIS machine is using
# the dev app. Committed, it followed the repo onto the build machine and made
# every CI run refuse to build the app bundle (2026-08-23 to 2026-09-13).
queue/playtest.lock

# A walk with no "out" of its own now writes to /tmp/photonz-playtest/<its
# name>, and a test holds every walk in the folder to writing outside the repo
# (PlaytestWalkOutputFolderTests). This stays as the net under an older build
# of the app, or a hand run, still dropping renders here.
Scripts/playtest/out/

# run_runner's picture of the working tree as it was before a runner started,
# which queue/bin/leftovers.mjs compares against when that runner ends. It is
# scratch for one task, not queue state (the records beside it ARE committed).
queue/leftovers/.before.json

# The pid of the caffeinate holding this Mac awake while the loop works. It is
# one machine's live process, not queue state: committed, it would send a dead
# pid to every other checkout, and a hold is a thing you put down BY PID.
queue/.loop-awake.pid
