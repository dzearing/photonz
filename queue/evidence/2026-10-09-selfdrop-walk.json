{
  "out": "/tmp/photonz-playtest/selfdrop",
  "setup": { "forget": ["all"] },
  "steps": [
    { "do": "blank", "canvasWidth": 1440, "canvasHeight": 1024, "width": 1240, "height": 900 },
    { "do": "action", "action": "showComponentShelf" },
    { "do": "wait", "seconds": 1.2 },
    { "do": "dragTile", "tile": "Button", "to": [420, 300] },
    { "do": "wait", "seconds": 1.2 },
    { "do": "action", "action": "editPickedComponentOriginal" },
    { "do": "wait", "seconds": 1.2 },
    { "do": "snapshot", "name": "1-space" },
    { "do": "dragTile", "tile": "Button", "to": [600, 600] },
    { "do": "wait", "seconds": 1.2 },
    { "do": "panel", "stage": "2-dropped-self" },
    { "do": "snapshot", "name": "2-dropped-self" },
    { "do": "dragTile", "tile": "Card", "to": [900, 300] },
    { "do": "wait", "seconds": 1.2 },
    { "do": "snapshot", "name": "3-dropped-card" },
    { "do": "action", "action": "doneEditingOriginal" },
    { "do": "wait", "seconds": 1.5 },
    { "do": "panel", "stage": "4-back" },
    { "do": "snapshot", "name": "4-back" },
    { "do": "render", "name": "4-back-doc" }
  ]
}
