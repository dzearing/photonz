{
  "out": "/tmp/photonz-playtest/tool-holds-saved-colour",
  "steps": [
    { "do": "blank", "canvasWidth": 1100, "canvasHeight": 700, "width": 1500, "height": 950 },
    { "do": "wait", "seconds": 1 },

    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [140, 160], "to": [380, 320], "steps": 8 },
    { "do": "wait", "seconds": 0.6 },
    { "do": "tool", "tool": "select" },
    { "do": "selectRow", "row": "Rectangle" },
    { "do": "wait", "seconds": 0.5 },

    { "do": "action", "action": "paintSelectionColor" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "action", "action": "saveColorStyle" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "1-naming", "note": "the name field open on the box's first colour row" },
    { "do": "snapshot", "name": "held-1-naming" },
    { "do": "type", "text": "Accent" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "2-saved", "note": "the box wears Accent now. toolStyle or toolFillStyle must say Accent as well: saving pointed this box at the name, so the tool that draws boxes is holding it" },
    { "do": "snapshot", "name": "held-2-saved-and-armed" },

    { "do": "tool", "tool": "rectangle" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "drag", "from": [420, 160], "to": [660, 320], "steps": 8 },
    { "do": "wait", "seconds": 0.7 },
    { "do": "tool", "tool": "select" },
    { "do": "selectRow", "row": "Rectangle 2" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "3-second-box", "note": "a second box drawn and never painted. selectedColors must say 'style Accent': it is wearing the NAME, not a copy of the colour" },
    { "do": "snapshot", "name": "held-3-second-box-wears-the-name" },

    { "do": "action", "action": "pickFirstColorStyle" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "action", "action": "recolorPickedColorStyle" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "4-edited", "note": "Accent repainted green on the shelf. BOTH boxes must follow, which is the whole point of holding the name rather than a copy" },
    { "do": "render", "name": "held-4-both-boxes-followed" },
    { "do": "snapshot", "name": "held-5-edit-moved-everything" },

    { "do": "tool", "tool": "rectangle" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "drag", "from": [700, 160], "to": [940, 320], "steps": 8 },
    { "do": "wait", "seconds": 0.7 },
    { "do": "describe", "stage": "5-third-box", "note": "a third box drawn AFTER the edit: it must come out the new green, not the crimson the tool was armed with when Accent was saved" },
    { "do": "render", "name": "held-6-third-box-is-current" },

    { "do": "tool", "tool": "select" },
    { "do": "selectRow", "row": "Rectangle 3" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "action", "action": "unlinkColorStyle" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "6-unlinked", "note": "unlinked. toolStyle and toolFillStyle must both read none now: the tool let go with the shape, so the next box is a colour of its own" },
    { "do": "snapshot", "name": "held-7-unlinked" },

    { "do": "tool", "tool": "rectangle" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "drag", "from": [140, 380], "to": [380, 540], "steps": 8 },
    { "do": "wait", "seconds": 0.7 },
    { "do": "tool", "tool": "select" },
    { "do": "selectRow", "row": "Rectangle 4" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "7-plain-again", "note": "a fourth box, drawn after unlinking: selectedColors must be a bare hex with no style on it" },
    { "do": "snapshot", "name": "held-8-plain-again" },

    { "do": "tool", "tool": "arrow" },
    { "do": "drag", "from": [460, 400], "to": [700, 520], "steps": 8 },
    { "do": "wait", "seconds": 0.6 },
    { "do": "tool", "tool": "select" },
    { "do": "selectRow", "row": "Arrow" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "action", "action": "useFirstColorStyle" },
    { "do": "wait", "seconds": 0.7 },
    { "do": "describe", "stage": "8-arrow-uses-accent", "note": "the arrow pointed at Accent from its colour row: toolStyle must say Accent, and the arrow tool is a different tool from the box tool" },

    { "do": "tool", "tool": "arrow" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "9-arrow-tool-holding", "note": "back on the arrow tool with nothing picked: the toolbar swatch must be carrying the palette mark in its corner, because two identical greens where only one follows Accent look exactly alike" },
    { "do": "snapshot", "name": "held-9-swatch-carries-the-mark" },
    { "do": "key", "key": "s" },
    { "do": "wait", "seconds": 0.9 },
    { "do": "describe", "stage": "10-popover", "note": "the swatch's own popover: the row at the top must read 'Using Accent' with an Unlink beside it" },
    { "do": "snapshot", "name": "held-10-using-accent" },
    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.4 }
  ]
}
