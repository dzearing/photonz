{
  "out": "/tmp/photonz-playtest/transform-resets-from-the-menu-walk",
  "seed": "Edit > Transform > Turn in 3D and the four resets at Next defaults with no flag changed. A busy screenshot is dropped and picked. Turn in 3D puts the grips in 3D; a tip there puts a dot on the chip's 3D button. The open menu a right click on the chip raises is photographed with its rows, Reset 3D live and the rest greyed. Edit > Transform > Reset 3D takes the tip back and the dot with it; a turn then lights Reset Size, and Edit > Transform > Reset All takes it back. The menu bar is only live with the app in front, so this walk takes the front.",
  "setup": { "forget": ["all"], "front": true },
  "steps": [
    { "do": "blank", "canvasWidth": 1200, "canvasHeight": 860, "width": 1400, "height": 1000 },
    { "do": "dropImage", "file": "fixtures/Busy screenshot 800x500.png", "at": [600, 430] },
    { "do": "wait", "seconds": 1.0 },
    { "do": "tool", "tool": "select" },
    { "do": "click", "at": [600, 430] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expectGrips", "mode": "size", "dots": [] },
    { "do": "menus", "stage": "1-edit-transform", "menu": "Edit", "choose": "Edit > Transform > Turn in 3D" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expectGrips", "mode": "space" },
    { "do": "grip", "grip": "right", "by": [67, -25] },
    { "do": "expectTilt", "atLeast": 1.02 },
    { "do": "expectGrips", "mode": "space", "dots": ["space"] },
    { "do": "rightClick", "on": "grip:chip-space", "shot": "2-chip-menu",
      "rows": ["Reset Size", "Reset Skew & Distort", "Reset 3D", "—", "Reset All"],
      "dimmed": ["Reset Size", "Reset Skew & Distort"] },
    { "do": "menus", "stage": "3-reset-3d", "menu": "Edit", "choose": "Edit > Transform > Reset 3D" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "expectGrips", "dots": [] },
    { "do": "snapshot", "name": "3-3d-reset-from-the-menu" },
    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "grip", "grip": "knob", "by": [90, 60] },
    { "do": "expectGrips", "mode": "size", "dots": ["size"] },
    { "do": "menus", "stage": "4-reset-all", "menu": "Edit", "choose": "Edit > Transform > Reset All" },
    { "do": "wait", "seconds": 1.6, "onTheClock": true },
    { "do": "expectGrips", "mode": "size", "tag": "800 × 500", "dots": [] },
    { "do": "snapshot", "name": "4-all-reset-from-the-menu" },
    { "do": "describe", "stage": "4-menu", "note": "Turn in 3D from Edit > Transform put the grips in 3D; Reset 3D from the menu took the tip and its dot; a turn lit Size, and Reset All from the menu took it back" }
  ]
}
