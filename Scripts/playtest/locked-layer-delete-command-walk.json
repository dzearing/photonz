{
  "out": "/tmp/photonz-playtest/locked-delete-command",
  "seed": "Lock a rectangle, then issue the Delete Layer command the menu row issues. Does the lock hold, does the row grey out, and does a mixed pick still clear the unlocked one?",
  "setup": { "forget": ["shapes", "color", "tools"] },
  "steps": [
    { "do": "blank", "canvasWidth": 1200, "canvasHeight": 800, "width": 1280, "height": 900 },
    { "do": "wait", "seconds": 1.0 },
    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [200, 160], "to": [560, 380] },
    { "do": "wait", "seconds": 0.8 },
    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [640, 160], "to": [900, 380] },
    { "do": "wait", "seconds": 0.8 },
    { "do": "tool", "tool": "select" },
    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "selectRow", "row": "Rectangle" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "press", "control": "Lock", "in": "Rectangle" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "selectRow", "row": "Rectangle" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "1-locked-picked", "note": "layers 3, the locked Rectangle picked alone" },
    { "do": "snapshot", "name": "locked-delete-command-1-locked-picked" },
    { "do": "action", "action": "deleteLayer" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "2-after-delete-command", "note": "THE LOCK MUST HOLD: layers still 3, and the step above must say the menu row was dimmed" },
    { "do": "selectRow", "row": "Rectangle 2" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "selectRow", "row": "Rectangle", "modifiers": ["shift"] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "3-mixed-picked", "note": "one locked and one unlocked picked together" },
    { "do": "action", "action": "deleteLayer" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "4-after-mixed-delete", "note": "THE UNLOCKED ONE GOES, THE LOCKED ONE STAYS: layers 2, Rectangle still in the list" },
    { "do": "snapshot", "name": "locked-delete-command-4-after-mixed-delete" }
  ]
}
