{
  "out": "/tmp/photonz-playtest/picture-keys-thirty-seconds-walk",
  "seed": "A person who has never keyed anything animates a layer moving and fading in, from the first click to it playing, at a person's pace: two seconds of looking before each of the seven things they do. Read the clock from step log times of 'first-click' and 'playing'. Next defaults.",
  "setup": { "forget": ["tools", "panel"] },
  "steps": [
    { "do": "blank", "canvasWidth": 900, "canvasHeight": 700, "width": 1420, "height": 980 },
    { "do": "wait", "seconds": 1 },
    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [120, 230], "to": [260, 370], "steps": 8 },
    { "do": "tool", "tool": "select" },
    { "do": "click", "at": [600, 600] },
    { "do": "wait", "seconds": 0.8 },

    { "do": "describe", "stage": "first-click", "note": "the clock starts: nothing picked, nothing keyed." },
    { "do": "click", "at": [190, 300] },
    { "do": "wait", "seconds": 2, "onTheClock": true },
    { "do": "windowClick", "at": [1270, 543] },
    { "do": "wait", "seconds": 2, "onTheClock": true },
    { "do": "focus", "field": "Opacity" },
    { "do": "type", "text": "0" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 2, "onTheClock": true },
    { "do": "windowClick", "at": [625, 913] },
    { "do": "wait", "seconds": 2, "onTheClock": true },
    { "do": "drag", "from": [190, 300], "to": [640, 300], "steps": 12 },
    { "do": "wait", "seconds": 2, "onTheClock": true },
    { "do": "focus", "field": "Opacity" },
    { "do": "type", "text": "100" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 2, "onTheClock": true },
    { "do": "key", "key": "space" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "expect", "control": "Pause", "present": true },
    { "do": "describe", "stage": "playing", "note": "the clock stops: it moves and fades in, and it is playing." },
    { "do": "snapshot", "name": "playing" },
    { "do": "wait", "seconds": 0.6, "onTheClock": true },
    { "do": "snapshot", "name": "playing-later" },
    { "do": "key", "key": "space" },
    { "do": "wait", "seconds": 0.5 }
  ]
}
