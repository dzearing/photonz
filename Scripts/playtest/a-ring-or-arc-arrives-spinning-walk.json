{
  "out": "/tmp/photonz-playtest/a-ring-or-arc-arrives-spinning",
  "seed": "A spinner is a ring or an arc in an icon, and Rotation on one arrives as the mock's answer: 0 to 360, Linear, Forever, a turn every 1.2 seconds (icon-loop-wt.html step 3, 'because that is what you would have typed'). Before 2026-10-15 every shape arrived as a small swing back and forth, so a person had to retype both ends, the curve and the repeat before anything spun. This walk draws an arc with the pen and a ring with the ellipse tool in a 24 unit icon frame, adds Rotation to each and reads the row, then draws a box and checks it still arrives as the swing. Next defaults, no switch changed.",
  "setup": { "forget": ["all"] },
  "steps": [
    { "do": "blank", "canvasWidth": 1600, "canvasHeight": 1100, "width": 1240, "height": 900 },
    { "do": "action", "action": "newFrameDialog" },
    { "do": "wait", "seconds": 0.9 },
    { "do": "press", "control": "24", "in": "Icons" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "press", "control": "Add Frame" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "pinch", "to": 8 },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "0-frame", "note": "a 24 unit icon frame at 800%: it runs 788 to 812 across and 538 to 562 down" },

    { "do": "tool", "tool": "pen" },
    { "do": "click", "at": [791, 551] },
    { "do": "drag", "from": [796, 542], "to": [800, 541], "steps": 8 },
    { "do": "click", "at": [804, 543] },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectPath", "anchors": 3, "closed": false, "curves": 2 },
    { "do": "panelMenu", "menu": "Add Motion", "choose": "Rotation" },
    { "do": "wait", "seconds": 1 },
    { "do": "describe", "stage": "1-arc", "note": "THE PICTURE TO LOOK AT. Rotation on an open arc arrives as a spinner: From 0, To 360, Linear, Forever, over 1200 ms, turning about its own middle until Around is set to Artboard." },
    { "do": "expect", "field": "Rotation From", "reads": "0" },
    { "do": "expect", "field": "Rotation To", "reads": "360" },
    { "do": "expect", "field": "Rotation Summary", "reads": "0° → 360° over 1.2s" },
    { "do": "expect", "control": "Repeat", "in": "Rotation", "reads": "Forever" },
    { "do": "expect", "control": "Curve", "in": "Rotation", "reads": "Linear" },
    { "do": "panel", "stage": "1-arc" },
    { "do": "snapshot", "name": "1-an-arc-arrives-spinning" },

    { "do": "tool", "tool": "ellipse" },
    { "do": "drag", "from": [800, 550], "to": [810, 560], "steps": 8 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "click", "at": [805, 555] },
    { "do": "wait", "seconds": 0.8 },
    { "do": "panelMenu", "menu": "Add Motion", "choose": "Rotation" },
    { "do": "wait", "seconds": 1 },
    { "do": "describe", "stage": "2-ring", "note": "a ring drawn with the ellipse tool arrives the same way" },
    { "do": "expect", "field": "Rotation Summary", "reads": "0° → 360° over 1.2s" },
    { "do": "expect", "control": "Repeat", "in": "Rotation", "reads": "Forever" },
    { "do": "expect", "control": "Curve", "in": "Rotation", "reads": "Linear" },

    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [790, 554], "to": [796, 560], "steps": 8 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "click", "at": [793, 557] },
    { "do": "wait", "seconds": 0.8 },
    { "do": "panelMenu", "menu": "Add Motion", "choose": "Rotation" },
    { "do": "wait", "seconds": 1 },
    { "do": "describe", "stage": "3-box", "note": "a box in the same icon is not a spinner: it arrives as the swing every other shape gets" },
    { "do": "expect", "field": "Rotation Summary", "reads": "-12° → 12° over 0.9s" },
    { "do": "expect", "control": "Repeat", "in": "Rotation", "reads": "Forever, there and back" },
    { "do": "snapshot", "name": "2-a-box-still-swings" }
  ]
}
