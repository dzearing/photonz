{
  "out": "/tmp/photonz-playtest/active-icon-buttons-look-live",
  "setup": { "forget": ["shapes", "color", "panel"] },
  "steps": [
    { "do": "blank", "canvasWidth": 900, "canvasHeight": 600, "width": 1280, "height": 900 },
    { "do": "wait", "seconds": 1 },
    { "do": "key", "key": "r" },
    { "do": "drag", "from": [320, 260], "to": [620, 460] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "panelMenu", "menu": "Add Effect", "choose": "Shadow" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "panelMenu", "menu": "Add Effect", "choose": "Blur" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "press", "control": "Switch", "in": "Blur" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "move", "at": [80, 80] },
    { "do": "wait", "seconds": 0.3 },
    { "do": "describe", "stage": "1-at-rest",
      "note": "two effect rows: Shadow on, Blur switched off. On each row the grip, the eye and the cross are drawn in the eye's tone, the system's label colour; Blur's eye is crossed out and a step quieter, never as faint as a control that cannot be used (IconButtonTone)" },
    { "do": "panelEdge", "stage": "1-at-rest" },
    { "do": "snapshot", "name": "1-at-rest" },
    { "do": "move", "control": "Remove", "in": "Shadow" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "snapshot", "name": "2-cross-under-the-pointer" },
    { "do": "describe", "stage": "2-cross-under-the-pointer",
      "note": "the pointer rests on Shadow's cross: it comes up to the full foreground with a soft wash behind it" },
    { "do": "move", "at": [80, 80] },
    { "do": "wait", "seconds": 0.3 },
    { "do": "press", "control": "Remove", "in": "Shadow" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "expect", "control": "Remove", "in": "Shadow", "present": false },
    { "do": "snapshot", "name": "3-shadow-removed" }
  ]
}
