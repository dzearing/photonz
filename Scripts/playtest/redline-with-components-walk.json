{
  "out": "/tmp/photonz-playtest/redline-with-components-walk",
  "steps": [
    { "do": "open", "file": "../../Tests/PhotonzRenderTests/Fixtures/settings-pane-2x.png", "width": 1280, "height": 840 },
    { "do": "wait", "seconds": 1 },
    { "do": "describe", "stage": "1-capture", "note": "a captured screenshot, opened the way it always was" },
    { "do": "snapshot", "name": "rc-1-capture" },

    { "do": "key", "key": "i" },
    { "do": "waitFor", "condition": "tool", "value": "measure" },
    { "do": "waitFor", "condition": "edgeMap", "timeout": 15 },
    { "do": "measureMode", "mode": "size" },
    { "do": "move", "at": [356, 786] },
    { "do": "wait", "seconds": 0.4 },
    { "do": "click", "at": [356, 786] },
    { "do": "wait", "seconds": 0.4 },
    { "do": "measureMode", "mode": "gap" },
    { "do": "move", "at": [720, 432] },
    { "do": "wait", "seconds": 0.4 },
    { "do": "click", "at": [720, 432] },
    { "do": "wait", "seconds": 0.4 },
    { "do": "describe", "stage": "2-measured", "note": "size and gap measured before any component is anywhere near this picture" },
    { "do": "snapshot", "name": "rc-2-measured" },

    { "do": "action", "action": "showComponentShelf" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "action", "action": "pickFirstComponent" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "dropComponent", "at": [1240, 110] },
    { "do": "wait", "seconds": 1.0 },
    { "do": "describe", "stage": "3-component-dropped", "note": "a component dragged straight off the shelf onto the same screenshot" },
    { "do": "snapshot", "name": "rc-3-component-dropped" },

    { "do": "tool", "tool": "measure" },
    { "do": "waitFor", "condition": "tool", "value": "measure" },
    { "do": "measureMode", "mode": "distance" },
    { "do": "click", "at": [236, 696] },
    { "do": "move", "at": [476, 696] },
    { "do": "click", "at": [476, 696] },
    { "do": "move", "at": [476, 656] },
    { "do": "click", "at": [476, 656] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "4-measured-again", "note": "measuring lands exactly the same with a component in the document" },
    { "do": "snapshot", "name": "rc-4-measured-again" },

    { "do": "clearClipboard" },
    { "do": "action", "action": "copySpecList" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "readClipboard", "stage": "5-spec" },
    { "do": "snapshot", "name": "rc-5-spec-copied" },
    { "do": "clearClipboard" },
    { "do": "action", "action": "copyImage" },
    { "do": "wait", "seconds": 0.7 },
    { "do": "readClipboard", "stage": "6-image" },
    { "do": "render", "name": "rc-6-final-doc" }
  ]
}
