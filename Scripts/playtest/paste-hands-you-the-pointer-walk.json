{
  "out": "/tmp/photonz-playtest/paste-hands-you-the-pointer",
  "seed": "Pasting used to leave you holding whatever tool you had, so the obvious next move, dragging the thing you just pasted, drew a new shape on top of it instead. The walk draws a box with the rectangle tool, copies it, pastes with the rectangle tool still in hand, and checks the pointer arrived: the drag that follows should MOVE the copy, and the tree should still show two boxes rather than three. Then it pastes again and presses undo straight away, which should hand the rectangle tool back.",
  "setup": { "forget": ["shapes", "color", "tools"] },
  "steps": [
    { "do": "blank", "canvasWidth": 1200, "canvasHeight": 800, "width": 1280, "height": 900 },
    { "do": "wait", "seconds": 1.0 },

    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [300, 250], "to": [600, 450] },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "1-drawn", "note": "one box drawn, rectangle tool still in hand" },
    { "do": "snapshot", "name": "1-drawn" },

    { "do": "action", "action": "copyLayer" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "tool", "tool": "rectangle" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "describe", "stage": "2-copied", "note": "box copied, rectangle tool deliberately back in hand before the paste" },

    { "do": "action", "action": "pasteLayer" },
    { "do": "waitFor", "condition": "tool", "value": "select", "timeout": 5 },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "3-pasted", "note": "the paste should have handed over the pointer with the copy picked" },
    { "do": "snapshot", "name": "3-pasted-pointer-in-hand" },

    { "do": "drag", "from": [466, 366], "to": [800, 620] },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "4-dragged", "note": "the drag must MOVE the copy: the tree should still hold two boxes, the second one somewhere new" },
    { "do": "snapshot", "name": "4-dragged-not-drawn" },

    { "do": "tool", "tool": "rectangle" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "action", "action": "pasteLayer" },
    { "do": "waitFor", "condition": "tool", "value": "select", "timeout": 5 },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "5-pasted-again", "note": "a second paste, again with the pointer in hand and a third box on the ladder" },
    { "do": "snapshot", "name": "5-pasted-again" },

    { "do": "action", "action": "undo" },
    { "do": "waitFor", "condition": "tool", "value": "rectangle", "timeout": 5 },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "6-undone", "note": "undo took the paste back and handed the rectangle tool back with it" },
    { "do": "snapshot", "name": "6-undo-gives-the-tool-back" },

    { "do": "action", "action": "redo" },
    { "do": "waitFor", "condition": "tool", "value": "select", "timeout": 5 },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "7-redone", "note": "redo put the copy back and took the pointer up again" },
    { "do": "snapshot", "name": "7-redo-takes-the-pointer-back" },

    { "do": "tool", "tool": "rectSelect" },
    { "do": "drag", "from": [320, 270], "to": [560, 420] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "8-marquee", "note": "a live marquee over the first box, with the marquee tool in hand: region should read a rectangle" },
    { "do": "snapshot", "name": "8-marquee-up" },
    { "do": "action", "action": "copy" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "action", "action": "pasteLayer" },
    { "do": "waitFor", "condition": "tool", "value": "select", "timeout": 5 },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "9-region-pasted", "note": "a copied region pastes the same way: pointer in hand, the copy picked, and region should read none" },
    { "do": "snapshot", "name": "9-region-pasted" },

    { "do": "action", "action": "copyImage" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "tool", "tool": "measure" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "action", "action": "pasteLayer" },
    { "do": "waitFor", "condition": "tool", "value": "select", "timeout": 5 },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "10-picture-pasted", "note": "a plain picture with no Photonz payload behind it, the way one from another app arrives: the pointer comes over for that too" },
    { "do": "snapshot", "name": "10-plain-picture-pasted" },
    { "do": "action", "action": "undo" },
    { "do": "waitFor", "condition": "tool", "value": "measure", "timeout": 5 },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "11-picture-undone", "note": "and undoing that paste hands the measure tool back" }
  ]
}
