{
  "out": "/tmp/photonz-playtest/trim-with-pieces-walk",
  "setup": { "forget": ["all"] },
  "steps": [
    { "do": "action", "action": "openSampleRecording" },
    { "do": "action", "action": "videoPause" },
    { "do": "action", "action": "videoSeekMiddle" },
    { "do": "action", "action": "clipSplit" },
    { "do": "action", "action": "videoSeekThreeQuarters" },
    { "do": "action", "action": "clipSplit" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectRecording", "pieces": 3 },
    { "do": "describe", "stage": "1-three-pieces", "note": "two splits leave an eight second recording in three pieces on V1: four, two and two seconds" },
    { "do": "snapshot", "name": "1-three-pieces" },

    { "do": "action", "action": "videoBeginTrim" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectRecording", "pieces": 3, "seconds": 8 },
    { "do": "describe", "stage": "2-trimming-shows-pieces", "note": "Trim in hand keeps the pieces on the bar, with a handle at each end of the whole clip" },
    { "do": "snapshot", "name": "2-trimming-shows-pieces" },

    { "do": "action", "action": "videoTrimStart" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "expectRecording", "starts": 2, "seconds": 6 },
    { "do": "action", "action": "videoTrimEnd" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expectRecording", "starts": 2, "seconds": 4 },
    { "do": "describe", "stage": "3-both-handles-in", "note": "the in handle is part way into the first piece, the out handle is on the second cut: the last piece is wholly spare" },
    { "do": "snapshot", "name": "3-both-handles-in" },

    { "do": "action", "action": "videoTrimDone" },
    { "do": "wait", "seconds": 0.9 },
    { "do": "expectRecording", "pieces": 2, "seconds": 4 },
    { "do": "describe", "stage": "4-trim-keeps-what-was-shown", "note": "THE TEST: Trim keeps exactly what the handles showed: the first piece shortened from the front and the middle piece whole, two pieces and four seconds, the last piece gone from play" },
    { "do": "snapshot", "name": "4-trim-keeps-what-was-shown" }
  ]
}
