{
  "out": "/tmp/photonz-playtest/first-long-jump-when-zoomed-in-walk",
  "setup": { "timelineOpen": true, "forget": ["all"] },
  "steps": [
    { "do": "describe", "stage": "why", "note": "On a five minute captioned recording, zoomed in close, the first long jump of the playhead held the whole app for half a second to a second. Next defaults, no switch turned on. Each jump is judged on the longest single pass of the main thread after it, at 50ms." },
    { "do": "action", "action": "openLongTalk" },
    { "do": "action", "action": "captionsWaitForThemselves" },
    { "do": "wait", "seconds": 1.5 },
    { "do": "action", "action": "videoPause" },
    { "do": "action", "action": "videoSeekQuarter" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "action", "action": "timelineZoomIn" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "action", "action": "timelineZoomIn" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "action", "action": "timelineZoomIn" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "action", "action": "timelineZoomIn" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "describe", "stage": "1-far", "note": "16x, about twenty seconds across the width: the playhead jumps from a quarter to the middle, carrying the window with it, and the app never stops" },
    { "do": "action", "action": "videoSeekMiddle" },
    { "do": "wait", "seconds": 0.8, "longestUnderMS": 50 },
    { "do": "snapshot", "name": "1-jumped-to-the-middle" },
    { "do": "action", "action": "videoSeekThreeQuarters" },
    { "do": "wait", "seconds": 0.8, "longestUnderMS": 50 },
    { "do": "action", "action": "videoSeekMiddle" },
    { "do": "wait", "seconds": 0.8, "longestUnderMS": 50 },
    { "do": "describe", "stage": "2-fit", "note": "at Fit and one step in, the same jumps stay as smooth as before" },
    { "do": "action", "action": "timelineFit" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "action", "action": "videoSeekQuarter" },
    { "do": "wait", "seconds": 0.8, "longestUnderMS": 50 },
    { "do": "action", "action": "videoSeekThreeQuarters" },
    { "do": "wait", "seconds": 0.8, "longestUnderMS": 50 },
    { "do": "action", "action": "timelineZoomIn" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "action", "action": "videoSeekMiddle" },
    { "do": "wait", "seconds": 0.8, "longestUnderMS": 50 },
    { "do": "action", "action": "videoSeekQuarter" },
    { "do": "wait", "seconds": 0.8, "longestUnderMS": 50 },
    { "do": "snapshot", "name": "2-two-x-after-jumps" }
  ]
}
