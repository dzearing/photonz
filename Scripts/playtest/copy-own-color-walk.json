{
  "out": "/tmp/photonz-playtest/copy-own-color-walk",
  "steps": [
    { "do": "blank", "canvasWidth": 1440, "canvasHeight": 1024, "width": 1320, "height": 920 },

    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [200, 200], "to": [520, 300] },
    { "do": "tool", "tool": "text" },
    { "do": "click", "at": [240, 330] },
    { "do": "type", "text": "Save" },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "drag", "from": [150, 150], "to": [640, 420] },
    { "do": "wait", "seconds": 0.3 },
    { "do": "action", "action": "group" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "action", "action": "makeComponent" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "type", "text": "Button" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.8 },

    { "do": "action", "action": "exposeColor" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "1-exposed",
      "note": "the original's Adjustable list grew a colour knob, named Fill for the part it paints rather than for the box it sits on" },
    { "do": "snapshot", "name": "copy-own-color-1-exposed" },

    { "do": "action", "action": "pickFirstComponent" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "action", "action": "insertPickedComponent" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "2-copy",
      "note": "a copy is placed and selected; its section shows a Fill row with a swatch of what the original is painted" },
    { "do": "snapshot", "name": "copy-own-color-2-copy" },

    { "do": "press", "control": "Color", "in": "Fill" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "3-picker",
      "note": "the app's own colour picker opened on the colour this copy is wearing, the same picker every other colour row opens" },
    { "do": "snapshot", "name": "copy-own-color-3-picker" },
    { "do": "press", "control": "Related", "in": "Swatches" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "press", "control": "Related 6" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "press", "control": "Close", "in": "the picker" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "4-own-colour",
      "note": "this copy alone is red; the original and the Fill row's revert arrow both say so" },
    { "do": "snapshot", "name": "copy-own-color-4-own-colour" },
    { "do": "render", "name": "copy-own-color-4-own-colour-doc" },

    { "do": "action", "action": "pickFirstComponent" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "dropComponent", "at": [1000, 700] },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "5-second-copy",
      "note": "a second copy arrives following the original, so it is still the original's blue" },
    { "do": "snapshot", "name": "copy-own-color-5-second-copy" },

    { "do": "press", "control": "Color", "in": "Fill" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "press", "control": "Save style", "in": "the picker" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "press", "control": "Style name" },
    { "do": "type", "text": "Brand" },
    { "do": "press", "control": "Save" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "6-saved-colour",
      "note": "saving from inside the knob's own picker: the colour this copy follows, kept in the Library under a name" },
    { "do": "snapshot", "name": "copy-own-color-6-saved-colour" },
    { "do": "press", "control": "Close", "in": "the picker" },
    { "do": "wait", "seconds": 0.5 },

    { "do": "action", "action": "knobUsesSavedColor" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "7-named-colour",
      "note": "the second copy answers its Fill knob with a saved colour; the row names it beside the swatch" },
    { "do": "snapshot", "name": "copy-own-color-7-named-colour" },
    { "do": "render", "name": "copy-own-color-7-named-colour-doc" },

    { "do": "click", "at": [400, 250] },
    { "do": "wait", "seconds": 0.4 },
    { "do": "describe", "stage": "8-original",
      "note": "back on the original, whose Adjustable list shows the one colour knob" },
    { "do": "snapshot", "name": "copy-own-color-8-original" },

    { "do": "action", "action": "pickFirstComponent" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "dropComponent", "at": [430, 700] },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "8b-third-copy",
      "note": "a third copy, left alone, so there is one of each: its own colour, a saved name, and following" },

    { "do": "click", "at": [400, 250], "count": 2 },
    { "do": "wait", "seconds": 0.5 },
    { "do": "press", "control": "Color", "in": "Fill" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "press", "control": "Related", "in": "Swatches" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "press", "control": "Related 5" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "press", "control": "Close", "in": "the picker" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "9-original-repainted",
      "note": "repainting the original reached the copy that never answered; the magenta one kept its own colour, and the one pointing at Brand kept Brand" },
    { "do": "snapshot", "name": "copy-own-color-9-original-repainted" },
    { "do": "render", "name": "copy-own-color-9-original-repainted-doc" },

    { "do": "action", "action": "undo" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "render", "name": "copy-own-color-10-undone-doc" }
  ]
}
