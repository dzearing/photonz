{
  "out": "/tmp/photonz-playtest/notices-say-what-happened-walk",
  "seed": "At Next defaults the canvas carries no line of instructions. Picking up Measure, cycling its mode, picking up the Pen and reshaping a path used to stand a sentence of how-to at the foot of the canvas; now nothing stands there, the Pen's and Measure's hover tips carry those words, and what a path command did is an ordinary notice with an Undo button a person can click. A click on the first point of a flat Pen run is reported after the click as Nothing closed.",
  "setup": { "forget": ["shapes", "color", "panel", "tools", "measure"] },
  "steps": [
    { "do": "blank", "canvasWidth": 900, "canvasHeight": 700, "width": 1280, "height": 900 },
    { "do": "wait", "seconds": 1 },

    { "do": "key", "key": "i" },
    { "do": "waitFor", "condition": "tool", "value": "measure" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expectHint", "contains": "none" },
    { "do": "expectNotice", "absent": true },
    { "do": "describe", "stage": "1-measure-picked-up", "note": "Measure in hand, no pill over the canvas saying what a click does" },
    { "do": "snapshot", "name": "1-measure-no-pill" },

    { "do": "key", "key": "i" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expectHint", "contains": "none" },
    { "do": "expectNotice", "absent": true },
    { "do": "describe", "stage": "2-measure-next-mode", "note": "I again moves to the next mode: the tool's glyph changes, and still no pill" },
    { "do": "snapshot", "name": "2-measure-next-mode-no-pill" },

    { "do": "hover", "label": "Measure" },
    { "do": "wait", "seconds": 1.2 },
    { "do": "describe", "stage": "3-measure-tip", "note": "THE TEACHING MOVED HERE: the tip names the tool and its mode, then says what a click does in that mode, in the words the pill used" },
    { "do": "snapshot", "name": "3-measure-tip" },
    { "do": "hover", "at": [640, 400], "space": "view" },
    { "do": "wait", "seconds": 0.5 },

    { "do": "key", "key": "p" },
    { "do": "waitFor", "condition": "tool", "value": "pen" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expectHint", "contains": "none" },
    { "do": "describe", "stage": "4-pen-picked-up", "note": "the Pen in hand and nothing over the canvas" },
    { "do": "snapshot", "name": "4-pen-no-pill" },

    { "do": "hover", "label": "Pen" },
    { "do": "wait", "seconds": 1.2 },
    { "do": "describe", "stage": "5-pen-tip", "note": "THE TEACHING MOVED HERE: Pen and its key, then how to place a corner or pull a curve, how to close, and that Return finishes it open while Esc discards it" },
    { "do": "snapshot", "name": "5-pen-tip" },
    { "do": "hover", "at": [640, 400], "space": "view" },
    { "do": "wait", "seconds": 0.5 },

    { "do": "click", "at": [200, 560] },
    { "do": "wait", "seconds": 0.3 },
    { "do": "click", "at": [500, 560] },
    { "do": "wait", "seconds": 0.3 },
    { "do": "click", "at": [200, 560] },
    { "do": "wait", "seconds": 0.4 },
    { "do": "expectNotice", "says": "Nothing closed" },
    { "do": "expectHint", "contains": "none" },
    { "do": "describe", "stage": "6-flat-close-reported", "note": "two points in a line and a click back on the first: nothing closes, and a notice says so after the click, as a result, with no advice" },
    { "do": "snapshot", "name": "6-nothing-closed" },
    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.4 },

    { "do": "key", "key": "p" },
    { "do": "waitFor", "condition": "tool", "value": "pen" },
    { "do": "click", "at": [450, 160] },
    { "do": "wait", "seconds": 0.3 },
    { "do": "click", "at": [640, 480] },
    { "do": "wait", "seconds": 0.3 },
    { "do": "click", "at": [260, 480] },
    { "do": "wait", "seconds": 0.3 },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "waitFor", "condition": "tool", "value": "select", "timeout": 2 },
    { "do": "expectPath", "anchors": 3, "closed": false },
    { "do": "expectPicked", "layers": ["Path"] },
    { "do": "expectHint", "contains": "none" },
    { "do": "describe", "stage": "7-path-picked", "note": "an open outline drawn and picked: its points show on it and no chip stands under the canvas telling you what they do" },
    { "do": "snapshot", "name": "7-path-picked-no-pill" },

    { "do": "click", "at": [450, 160], "count": 2 },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectHint", "contains": "none" },
    { "do": "describe", "stage": "8-point-curved", "note": "a double click curved the top point; still no chip" },

    { "do": "rightClick", "on": "Path", "choose": "Close Path…" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "expectPath", "anchors": 3, "closed": true },
    { "do": "expectNotice", "says": "Closed" },
    { "do": "expectHint", "contains": "none" },
    { "do": "describe", "stage": "9-closed-says-what-happened", "note": "THE RESULT: a notice reads Closed with an Undo button and its key on it. No 'Switch Fill on', no 'Command Z to put the open line back'" },
    { "do": "snapshot", "name": "9-closed-with-undo" },

    { "do": "press", "control": "Undo" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expectPath", "anchors": 3, "closed": false },
    { "do": "expectNotice", "absent": true },
    { "do": "describe", "stage": "10-undo-clicked", "note": "the pill's Undo button, clicked on its face with the pointer, put the open line back and took the pill away" },
    { "do": "snapshot", "name": "10-undone" }
  ]
}
