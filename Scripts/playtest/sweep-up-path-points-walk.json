{
  "out": "/tmp/photonz-playtest/sweep-up-path-points-walk",
  "setup": { "forget": ["all"] },
  "steps": [
    { "do": "blank", "canvasWidth": 900, "canvasHeight": 700, "width": 1280, "height": 900 },
    { "do": "wait", "seconds": 1 },

    { "do": "key", "key": "p" },
    { "do": "waitFor", "condition": "tool", "value": "pen" },
    { "do": "click", "at": [200, 200] },
    { "do": "wait", "seconds": 0.2 },
    { "do": "click", "at": [400, 200] },
    { "do": "wait", "seconds": 0.2 },
    { "do": "click", "at": [600, 200] },
    { "do": "wait", "seconds": 0.2 },
    { "do": "click", "at": [600, 500] },
    { "do": "wait", "seconds": 0.2 },
    { "do": "click", "at": [200, 500] },
    { "do": "wait", "seconds": 0.2 },
    { "do": "click", "at": [203, 203] },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expectPath", "anchors": 5, "closed": true },
    { "do": "waitFor", "condition": "tool", "value": "select", "timeout": 2 },
    { "do": "expectPicked", "layers": ["Path"] },
    { "do": "describe", "stage": "1-drawn", "note": "a closed shape of five points, three of them along the top edge: the case a box is for, in miniature" },
    { "do": "snapshot", "name": "1-points-showing" },

    { "do": "expectPath", "picked": 0 },
    { "do": "drag", "from": [150, 140], "to": [660, 245], "steps": 14, "hold": "2-box-in-flight" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expectPath", "anchors": 5, "picked": 3 },
    { "do": "describe", "stage": "2-swept", "note": "one box across the top took all three points at once, where before it was three separate shift clicks" },
    { "do": "snapshot", "name": "3-three-picked" },

    { "do": "drag", "from": [650, 460], "to": [560, 560], "steps": 10, "modifiers": ["shift"] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expectPath", "anchors": 5, "picked": 4 },
    { "do": "describe", "stage": "3-added", "note": "holding shift, a second box added its catch to the first rather than starting over" },
    { "do": "snapshot", "name": "4-four-picked" },

    { "do": "drag", "from": [400, 200], "to": [400, 140], "steps": 12 },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectPath", "anchors": 5, "anchor": 0, "near": [200, 140], "within": 6 },
    { "do": "expectPath", "anchors": 5, "anchor": 1, "near": [400, 140], "within": 6 },
    { "do": "expectPath", "anchors": 5, "anchor": 2, "near": [600, 140], "within": 6 },
    { "do": "expectPath", "anchors": 5, "anchor": 3, "near": [600, 440], "within": 6 },
    { "do": "expectPath", "anchors": 5, "anchor": 4, "near": [200, 500], "within": 6 },
    { "do": "describe", "stage": "4-moved-together", "note": "dragging any one of the picked points moved all four of them and left the fifth exactly where it was" },
    { "do": "snapshot", "name": "5-moved-together" },

    { "do": "action", "action": "undo" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expectPath", "anchors": 5, "anchor": 0, "near": [200, 200], "within": 6 },
    { "do": "expectPath", "anchors": 5, "anchor": 3, "near": [600, 500], "within": 6 },
    { "do": "describe", "stage": "5-one-undo", "note": "moving four points together is one undo step, like every other reshape" },

    { "do": "drag", "from": [150, 620], "to": [300, 660], "steps": 10 },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expectPath", "anchors": 5, "picked": 0 },
    { "do": "expectPicked", "layers": ["Path"] },
    { "do": "describe", "stage": "6-box-over-nothing", "note": "a box thrown round empty space means none of them: the points are let go and the shape itself stays picked" },

    { "do": "drag", "from": [150, 140], "to": [460, 245], "steps": 12, "cancel": true },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expectPath", "anchors": 5, "picked": 0 },
    { "do": "describe", "stage": "7-changed-my-mind", "note": "Escape half way through a box gives it back: what was picked before it started is what is picked after" },

    { "do": "drag", "from": [150, 140], "to": [460, 245], "steps": 12 },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expectPath", "anchors": 5, "picked": 2 },
    { "do": "key", "key": "delete" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectPath", "anchors": 3, "closed": true, "picked": 0 },
    { "do": "expectLayers", "count": 2 },
    { "do": "describe", "stage": "8-deleted", "note": "Delete took the two swept points out and the shape closed over the gap, with the layer still there" },
    { "do": "snapshot", "name": "6-after-delete" },

    { "do": "render", "name": "7-final-render" }
  ]
}
