{
  "out": "/tmp/photonz-playtest/words-in-the-middle",
  "seed": "The words inside a caption pill and a measurement chip used to sit about two points left of centre, at every length. This walk puts a one character caption, a two character one and a sentence side by side, catches one of them mid-typing (the field must already have its words where the commit will draw them), and adds a short and a long measurement so the same badge can be judged with digits in it.",
  "setup": { "forget": ["measure", "tools", "shapes", "text"] },
  "steps": [
    { "do": "open", "file": "../../Tests/PhotonzRenderTests/Fixtures/settings-pane-2x.png", "width": 1280, "height": 840 },
    { "do": "wait", "seconds": 1 },
    { "do": "action", "action": "zoomToFit" },
    { "do": "wait", "seconds": 0.5 },

    { "do": "key", "key": "a" },
    { "do": "waitFor", "condition": "tool", "value": "arrow" },
    { "do": "drag", "from": [340, 760], "to": [300, 560], "steps": 12 },
    { "do": "waitFor", "condition": "captionField", "timeout": 3 },
    { "do": "wait", "seconds": 0.4 },
    { "do": "type", "text": "1" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "0-typing", "note": "one character still being typed: the digit should already sit in the middle of the bubble, where Return will leave it" },
    { "do": "snapshot", "name": "0-typing" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "1-committed", "note": "the same digit, committed: it must not have moved" },
    { "do": "snapshot", "name": "1-committed" },

    { "do": "key", "key": "a" },
    { "do": "waitFor", "condition": "tool", "value": "arrow" },
    { "do": "drag", "from": [700, 760], "to": [660, 560], "steps": 12 },
    { "do": "waitFor", "condition": "captionField", "timeout": 3 },
    { "do": "wait", "seconds": 0.4 },
    { "do": "type", "text": "Hi" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.8 },

    { "do": "key", "key": "a" },
    { "do": "waitFor", "condition": "tool", "value": "arrow" },
    { "do": "drag", "from": [1080, 760], "to": [1040, 560], "steps": 12 },
    { "do": "waitFor", "condition": "captionField", "timeout": 3 },
    { "do": "wait", "seconds": 0.4 },
    { "do": "type", "text": "Primary action" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 1 },
    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "2-three-captions", "note": "one character, two characters and a sentence: every word in the middle of its pill" },
    { "do": "snapshot", "name": "2-three-captions" },
    { "do": "render", "name": "2-three-captions" },

    { "do": "key", "key": "i" },
    { "do": "waitFor", "condition": "tool", "value": "measure" },
    { "do": "waitFor", "condition": "edgeMap", "timeout": 20 },
    { "do": "measureMode", "mode": "gap" },
    { "do": "move", "at": [258, 589] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "click", "at": [258, 589] },
    { "do": "wait", "seconds": 0.6 },

    { "do": "key", "key": "i" },
    { "do": "waitFor", "condition": "tool", "value": "measure" },
    { "do": "measureMode", "mode": "size" },
    { "do": "move", "at": [356, 786] },
    { "do": "wait", "seconds": 0.4 },
    { "do": "click", "at": [356, 786] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "3-measurements", "note": "a one or two digit measurement and a three digit one: the digits sit in the middle of the badge too" },
    { "do": "snapshot", "name": "3-measurements" },
    { "do": "render", "name": "3-measurements" }
  ]
}
