    { "do": "snapshot", "name": "5-stronger" },

    { "do": "action", "action": "lensPixelate" },
    { "do": "waitFor", "condition": "tutorialStep", "value": "what-leaves-the-app", "timeout": 6 },
    { "do": "wait", "seconds": 0.9 },
    { "do": "describe", "stage": "6-blocks", "note": "the same lens switched to blocks, which is what most people want over a name: it reads as hidden on purpose" },
    { "do": "panel", "stage": "6-blocks" },
    { "do": "snapshot", "name": "6-blocks" },
    { "do": "render", "name": "6-canvas" },

    { "do": "action", "action": "tutorialNext" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "7-finished", "note": "Done closed the guide and left the lens on the picture" }
  ]
