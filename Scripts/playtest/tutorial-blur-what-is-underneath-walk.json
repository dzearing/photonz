    { "do": "wait", "seconds": 1 },

    { "do": "startGuide", "guide": "blur-what-is-underneath" },
    { "do": "waitFor", "condition": "tutorialStep", "value": "the-picture", "timeout": 10 },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "1-the-picture", "note": "the guide brought an account screen with a name and an address on it, flattened into the picture the way a real capture is" },
    { "do": "snapshot", "name": "1-the-picture" },

    { "do": "action", "action": "tutorialNext" },
    { "do": "waitFor", "condition": "tutorialStep", "value": "pick-the-lens", "timeout": 5 },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "2-pick-the-lens", "note": "a waiting step aimed at the lens button in the tool bar, which has a slot of its own so it is always on screen" },
    { "do": "snapshot", "name": "2-pick-the-lens" },

    { "do": "key", "key": "k" },
    { "do": "waitFor", "condition": "tool", "value": "lens" },
    { "do": "waitFor", "condition": "tutorialStep", "value": "drag-over-it", "timeout": 5 },
    { "do": "wait", "seconds": 0.5 },
    { "do": "snapshot", "name": "3-drag-over-it" },

    { "do": "drag", "from": [96, 286], "to": [416, 322], "steps": 10 },
    { "do": "waitFor", "condition": "tutorialStep", "value": "how-hard", "timeout": 6 },
    { "do": "wait", "seconds": 0.9 },
    { "do": "describe", "stage": "4-blurred", "note": "THE TEST: one drag hid the address and the guide moved on by itself. The panel opened and scrolled to the lens's own settings" },
    { "do": "panel", "stage": "4-blurred" },
    { "do": "snapshot", "name": "4-blurred" },

    { "do": "action", "action": "pullLensAmount" },
