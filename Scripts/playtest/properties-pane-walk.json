{
  "out": "/tmp/photonz-playtest/properties-pane-walk",
  "seed": "The Properties pane beside a clip and a title, at Next defaults with nothing switched on by hand, as video.html draws it: a header saying Properties and what is picked, one clip line with its name, in, out, length and speed, then Animating, which lists only what is keyed, and Animate a property, which opens a grouped picker of the rest. A key taken off the last time leaves the list; the row's cross stops a value animating.",
  "setup": {
    "forget": ["all"]
  },
  "steps": [
    { "do": "action", "action": "openSampleRecording" },
    { "do": "wait", "seconds": 2.0 },
    { "do": "action", "action": "videoPause" },
    { "do": "tool", "tool": "select" },
    { "do": "action", "action": "videoSeekQuarter" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "press", "control": "Tutorial Sample clip" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "1-a-clip", "note": "THE FIRST TEST: the recording picked on the timeline. The panel opens on Properties with a Clip chip; its first line names the clip and says it runs 0.0s to 8.0s, 8.0s long at 1.0x; Animating says nothing yet and lists no rows" },
    { "do": "expectSections", "leading": ["Properties", "Time", "Sound"] },
    { "do": "expect", "field": "Properties Kind", "reads": "Clip" },
    { "do": "expect", "field": "Clip line", "reads": "Tutorial Sample 0.0s → 8.0s · 8.0s · 1.0x" },
    { "do": "expect", "field": "Animating Count", "reads": "nothing yet" },
    { "do": "expect", "control": "Key", "in": "Opacity", "present": false },
    { "do": "snapshot", "name": "1-a-clip" },

    { "do": "press", "control": "Animate a property" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "2-the-picker", "note": "THE SECOND TEST: Animate a property opens a picker of every value the clip is not animating, grouped Transform, Appearance, Effects and Crop, with Volume under Levels, and a box to find one by name" },
    { "do": "expect", "control": "Opacity", "in": "Animate a property", "present": true },
    { "do": "expect", "control": "Crop left", "in": "Animate a property", "present": true },
    { "do": "expect", "control": "Volume", "in": "Animate a property", "present": true },
    { "do": "snapshot", "name": "2-the-picker" },
    { "do": "press", "control": "Opacity", "in": "Animate a property" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "3-opacity-animating", "note": "THE THIRD TEST: picking Opacity keys it at the playhead, and its row is the one row in Animating, its diamond filled" },
    { "do": "expect", "field": "Animating Count", "reads": "1 of 12 properties" },
    { "do": "expect", "control": "Key", "in": "Opacity", "reads": "on a key" },
    { "do": "snapshot", "name": "3-opacity-animating" },

    { "do": "press", "control": "Key", "in": "Opacity" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "4-last-key-off", "note": "THE FOURTH TEST: the diamond on a key takes that key off, as Premiere's keyframe button does. It was the only key, so Opacity stops animating and leaves the list" },
    { "do": "expect", "field": "Animating Count", "reads": "nothing yet" },
    { "do": "expect", "control": "Key", "in": "Opacity", "present": false },

    { "do": "action", "action": "videoSeekMiddle" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "tool", "tool": "text" },
    { "do": "click", "at": [620, 330] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "type", "text": "Shipping today" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "key", "key": "return", "modifiers": ["command"] },
    { "do": "wait", "seconds": 1.0 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "5-a-title", "note": "THE FIFTH TEST: a title typed at four seconds. The chip says Title, the clip line names it by its words and says it is on screen 4.0s to 7.0s, and nothing is animating yet" },
    { "do": "expectSections", "leading": ["Properties", "Time", "Text"] },
    { "do": "expect", "field": "Properties Kind", "reads": "Title" },
    { "do": "expect", "field": "Clip line", "reads": "Shipping today 4.0s → 7.0s · 3.0s · 1.0x" },
    { "do": "expect", "field": "Animating Count", "reads": "nothing yet" },
    { "do": "press", "control": "Animate a property" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "press", "control": "Scale", "in": "Animate a property" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "press", "control": "Animate a property" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "press", "control": "Opacity", "in": "Animate a property" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "6-two-animating", "note": "THE SIXTH TEST: Scale and Opacity picked, and Animating lists exactly those two, the last one touched in the key colour" },
    { "do": "expect", "field": "Animating Count", "reads": "2 of 8 properties" },
    { "do": "snapshot", "name": "6-a-title-two-animating" },
    { "do": "press", "control": "Stop Animating", "in": "Scale" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "7-stopped", "note": "THE SEVENTH TEST: the Scale row's cross stops it animating, and only Opacity is left" },
    { "do": "expect", "field": "Animating Count", "reads": "1 of 8 properties" },
    { "do": "expect", "control": "Key", "in": "Scale", "present": false },
    { "do": "snapshot", "name": "7-scale-stopped" }
  ]
}
