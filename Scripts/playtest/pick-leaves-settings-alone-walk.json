{
  "out": "/tmp/photonz-playtest/pick-leaves-settings-alone",
  "seed": "The panel leaves a control alone when the number or the word on it has not changed, which is what makes clicking between two alike shapes feel instant. The danger in doing that is a control that was left alone still pointing at the layer it was drawn for. So every stage here picks the SECOND of two arrows that read exactly alike, which is the case where the control really was skipped, and then uses that control and checks which arrow moved.",
  "setup": { "forget": ["all"] },
  "steps": [
    { "do": "blank", "canvasWidth": 900, "canvasHeight": 700, "width": 1240, "height": 900 },
    { "do": "wait", "seconds": 0.8 },

    { "do": "tool", "tool": "arrow" },
    { "do": "drag", "from": [160, 300], "to": [420, 420] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "tool", "tool": "arrow" },
    { "do": "drag", "from": [520, 300], "to": [780, 420] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.8 },

    { "do": "describe", "stage": "1-two-arrows-that-read-alike",
      "note": "two arrows drawn the same way, so every control in Appearance says exactly the same thing over either of them. This is the click the panel is allowed to skip." },
    { "do": "click", "at": [290, 360] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expect", "field": "Thickness", "reads": "4" },
    { "do": "click", "at": [650, 360] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expectPicked", "layers": ["Arrow 2"] },
    { "do": "expect", "field": "Thickness", "reads": "4" },
    { "do": "snapshot", "name": "pick-leaves-settings-alone-1-alike" },

    { "do": "describe", "stage": "2-thickness-reaches-what-is-picked-now",
      "note": "THE TEST: a pull on Thickness straight after that click changes the arrow clicked LAST. The other one keeps its 4." },
    { "do": "press", "control": "Slider", "in": "Thickness", "across": 0.6 },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expect", "field": "Thickness", "reads": "25" },
    { "do": "click", "at": [290, 360] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expect", "field": "Thickness", "reads": "4" },

    { "do": "describe", "stage": "3-no-stale-reading",
      "note": "THE TEST: with the two now different, clicking the thick one reads the THICK one's number rather than the one before it." },
    { "do": "click", "at": [650, 360] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expect", "field": "Thickness", "reads": "25" },
    { "do": "click", "at": [290, 360] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expect", "field": "Thickness", "reads": "4" },
    { "do": "snapshot", "name": "pick-leaves-settings-alone-2-thin-again" },

    { "do": "describe", "stage": "4-opacity-reaches-what-is-picked-now",
      "note": "the same for Opacity, which speaks for the whole selection rather than for one row. Both arrows are at 100, so this slider too was left alone by the click." },
    { "do": "click", "at": [650, 360] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expect", "field": "Opacity", "reads": "100" },
    { "do": "press", "control": "Slider", "in": "Opacity", "across": 0.5 },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expect", "field": "Opacity", "reads": "50" },
    { "do": "click", "at": [290, 360] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expect", "field": "Opacity", "reads": "100" },

    { "do": "describe", "stage": "5-ending-reaches-what-is-picked-now",
      "note": "and for the picture picker, which is the control that was left alone most often and cost the most to rebuild. Both arrows end in a solid head, so the segments never changed across the click." },
    { "do": "click", "at": [650, 360] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expect", "control": "Solid head", "in": "Ending", "reads": "Ending, already on Solid head, tooltip \"Solid head\"" },
    { "do": "press", "control": "Open head", "in": "Ending" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expect", "control": "Open head", "in": "Ending", "reads": "Ending, already on Open head, tooltip \"Open head\"" },
    { "do": "click", "at": [290, 360] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expect", "control": "Open head", "in": "Ending", "reads": "Ending, tooltip \"Open head\"" },
    { "do": "expect", "control": "Solid head", "in": "Ending", "reads": "Ending, already on Solid head, tooltip \"Solid head\"" },
    { "do": "snapshot", "name": "pick-leaves-settings-alone-3-endings" },

    { "do": "describe", "stage": "6-nothing-else-moved",
      "note": "still the two arrows on the background they were drawn on: nothing above made a third thing" },
    { "do": "expectLayers", "count": 3 }
  ]
}
