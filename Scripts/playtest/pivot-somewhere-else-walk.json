{
  "out": "/tmp/photonz-playtest/pivot-somewhere-else",
  "seed": "The Around menu ends with Somewhere else, as the mock draws it (icon-animate-wt.html, #oriMenu and #btnPickOrigin). A swinging bell is picked; Somewhere else is chosen from its Around menu and the canvas waits under a crosshair, the move button beside the menu held in. One click off the bell puts the pivot there, one undo step. Then the move button is clicked and Escape gives up without moving anything, with the bell still picked. Then Y, through the menu bar's Layer > Move the Pivot, and a drag carries the pivot from where the press landed; Command Z takes that whole drag back in one step. Runs at Next defaults with no switch changed, and every step survives a locked screen.",
  "setup": { "forget": ["all"] },
  "steps": [
    { "do": "open", "file": "fixtures/pivot-of-its-own.photonz", "width": 1320, "height": 900 },
    { "do": "wait", "seconds": 1.2 },
    { "do": "expectLayers", "count": 1 },
    { "do": "click", "at": [380, 280] },
    { "do": "wait", "seconds": 1 },
    { "do": "reveal", "control": "Around", "in": "Rotation" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expect", "control": "Around", "in": "Rotation", "reads": "Custom" },
    { "do": "expect", "control": "Move the pivot", "in": "Rotation", "reads": "out" },
    { "do": "expect", "field": "Around X", "reads": "380" },
    { "do": "expect", "field": "Around Y", "reads": "140" },

    { "do": "describe", "stage": "1-somewhere-else", "note": "Somewhere else is chosen from the Around menu, below Custom. The canvas now waits for one press: the pointer is a crosshair over it and the move button beside the menu is held in." },
    { "do": "panelMenu", "menu": "Around", "choose": "Somewhere else…" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expect", "control": "Move the pivot", "in": "Rotation", "reads": "waiting for the canvas" },
    { "do": "panel", "stage": "1-somewhere-else" },
    { "do": "snapshot", "name": "1-waiting-for-the-canvas" },

    { "do": "describe", "stage": "2-placed-by-a-click", "note": "THE PICTURE TO LOOK AT. One click to the right of the bell, off the drawing altogether, and the pivot is there: Around reads Custom, At reads 500, 120, and the button is out again." },
    { "do": "click", "at": [500, 120] },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expect", "control": "Around", "in": "Rotation", "reads": "Custom" },
    { "do": "expect", "field": "Around X", "reads": "500" },
    { "do": "expect", "field": "Around Y", "reads": "120" },
    { "do": "expect", "control": "Move the pivot", "in": "Rotation", "reads": "out" },
    { "do": "panel", "stage": "2-placed-by-a-click" },
    { "do": "snapshot", "name": "2-placed-by-a-click" },

    { "do": "describe", "stage": "3-escape-gives-up", "note": "The move button is clicked, and Escape gives up: the pivot stays at 500, 120 and the bell stays picked." },
    { "do": "press", "control": "Move the pivot", "in": "Rotation" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "expect", "control": "Move the pivot", "in": "Rotation", "reads": "waiting for the canvas" },
    { "do": "appKey", "key": "escape" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expect", "control": "Move the pivot", "in": "Rotation", "reads": "out" },
    { "do": "expect", "control": "Around", "in": "Rotation", "reads": "Custom" },
    { "do": "expect", "field": "Around X", "reads": "500" },
    { "do": "expect", "field": "Around Y", "reads": "120" },

    { "do": "describe", "stage": "4-y-and-a-drag", "note": "Y reaches Layer > Move the Pivot in the menu bar, and a drag that starts anywhere carries the pivot from where the press landed to where the hand lets go." },
    { "do": "shortcut", "key": "y", "modifiers": [], "menuItem": "Move the Pivot" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "expect", "control": "Move the pivot", "in": "Rotation", "reads": "waiting for the canvas" },
    { "do": "drag", "from": [300, 150], "to": [260, 130], "steps": 12 },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expect", "field": "Around X", "reads": "260" },
    { "do": "expect", "field": "Around Y", "reads": "130" },
    { "do": "expect", "control": "Move the pivot", "in": "Rotation", "reads": "out" },
    { "do": "snapshot", "name": "4-dragged-from-the-press" },

    { "do": "describe", "stage": "5-one-undo", "note": "Command Z takes the whole press and drag back in one step, to the point the click put down." },
    { "do": "shortcut", "key": "z", "modifiers": ["command"], "menuItem": "Undo" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expect", "field": "Around X", "reads": "500" },
    { "do": "expect", "field": "Around Y", "reads": "120" }
  ]
}
