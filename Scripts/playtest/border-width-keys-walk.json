    { "do": "expect", "field": "Border width", "reads": "0" },
    { "do": "panel", "stage": "2-first-key" },
    { "do": "snapshot", "name": "2-first-key-at-0" },
    { "do": "render", "name": "2-canvas-first-key" },
    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expect", "control": "Key", "in": "Border width", "reads": "between keys" },
    { "do": "press", "control": "Border width Value" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "key", "key": "a", "modifiers": ["command"] },
    { "do": "type", "text": "12" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "3-second-key", "note": "THE THIRD TEST: at 0:01, typing 12 is a second key, and the picture wears a 12 point frame. The border has its own lane under the clip's track" },
    { "do": "expect", "control": "Key", "in": "Border width", "reads": "on a key" },
    { "do": "expect", "field": "Border width", "reads": "12" },
    { "do": "expect", "field": "Key lane Tutorial Sample Border width", "present": true },
    { "do": "panel", "stage": "3-second-key" },
    { "do": "snapshot", "name": "3-second-key-at-12" },
    { "do": "render", "name": "3-canvas-second-key" },
    { "do": "action", "action": "videoSeekStart" },
    { "do": "action", "action": "videoStepQuarterSecond" },
    { "do": "action", "action": "videoStepQuarterSecond" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "4-between", "note": "THE FOURTH TEST: at half a second, between the keys, the diamond is hollow, the width reads part way from 0 to 12, and the frame round the picture is part grown" },
    { "do": "expect", "control": "Key", "in": "Border width", "reads": "between keys" },
    { "do": "panel", "stage": "4-between" },
    { "do": "snapshot", "name": "4-between-the-keys" },
    { "do": "render", "name": "4-canvas-between" },
    { "do": "action", "action": "videoSeekStart" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "press", "control": "Animate a property" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "press", "control": "Border color", "in": "Animate a property" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expect", "control": "Key", "in": "Border color", "reads": "on a key" },
    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "action", "action": "paintSelectionBorderColor" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "5-colour-key", "note": "THE FIFTH TEST: the border's colour keyed at 0:00, then at 0:01 the ring is painted crimson from the panel. On a keyed colour that is a second key at the playhead, so the diamond is filled and the frame is crimson here" },
    { "do": "expect", "control": "Key", "in": "Border color", "reads": "on a key" },
    { "do": "expect", "field": "Key lane Tutorial Sample Border color", "present": true },
    { "do": "panel", "stage": "5-colour-key" },
    { "do": "snapshot", "name": "5-colour-keyed-at-1" },
    { "do": "render", "name": "5-canvas-crimson" },
    { "do": "action", "action": "videoSeekStart" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "action", "action": "videoPlay" },
    { "do": "wait", "seconds": 1.6 },
    { "do": "action", "action": "videoPause" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "6-played", "note": "THE SIXTH TEST: played from the start, the frame grows in round the picture over the first second, turning crimson as it does, and stays" },
    { "do": "snapshot", "name": "6-after-playing" }
  ]
}
