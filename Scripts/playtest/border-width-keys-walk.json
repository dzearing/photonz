{
  "out": "/tmp/photonz-playtest/border-width-keys-walk",
  "seed": "A picture grows a frame as it lands: at Next defaults with no flag changed, the recording is picked, given a Border from the Effects plus set Inside (the recording fills the frame, so an Outside ring would be off the canvas), and keyed through Animate a property > Border width, 0 at 0:00 and 12 at 0:01. The diamond fills on each key and is hollow between them, the width reads part way between, the picture's frame grows as the playhead moves, and playing runs it. Then the border's colour is keyed, and painting the ring at a second moment is a second key there.",
  "setup": { "timelineOpen": true, "forget": ["all"] },
  "steps": [
    { "do": "action", "action": "openSampleRecording" },
    { "do": "wait", "seconds": 2.0 },
    { "do": "action", "action": "videoPause" },
    { "do": "tool", "tool": "select" },
    { "do": "action", "action": "videoSeekStart" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "selectRow", "row": "Tutorial Sample" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "reveal", "control": "Effects section" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "panelMenu", "menu": "Add Effect", "choose": "Border" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "panelMenu", "menu": "Border", "choose": "Inside" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "reveal", "control": "Properties section" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "press", "control": "Animate a property" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "1-the-picker", "note": "THE FIRST TEST: a picture with a Border offers the border's width and colour under Effects in Animate a property, named Border width and Border color, and no Stroke width: a picture has no line of its own" },
    { "do": "expect", "control": "Border width", "in": "Animate a property", "present": true },
    { "do": "expect", "control": "Border color", "in": "Animate a property", "present": true },
    { "do": "expect", "control": "Stroke width", "in": "Animate a property", "present": false },
    { "do": "snapshot", "name": "1-the-picker" },
    { "do": "press", "control": "Border width", "in": "Animate a property" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expect", "control": "Key", "in": "Border width", "reads": "on a key" },
    { "do": "press", "control": "Border width Value" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "key", "key": "a", "modifiers": ["command"] },
    { "do": "type", "text": "0" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "2-first-key", "note": "THE SECOND TEST: at 0:00 the border is keyed at 0: no frame round the picture yet. The diamond is filled: a key sits here" },
