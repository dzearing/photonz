      "stage": "both-picked"
    },
    {
      "do": "snapshot",
      "name": "outline-2-both-picked"
    },
    {
      "do": "press",
      "control": "Switch",
      "in": "Outline"
    },
    {
      "do": "wait",
      "seconds": 0.8
    },
    {
