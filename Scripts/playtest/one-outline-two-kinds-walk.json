      "at": [
        430,
        300
      ]
    },
    {
      "do": "wait",
      "seconds": 1.0
    },
    {
      "do": "tool",
      "tool": "rectangle"
    },
    {
      "do": "drag",
      "from": [
        300,
        430
      ],
      "to": [
        520,
        570
      ],
      "steps": 10
    },
    {
      "do": "tool",
      "tool": "select"
    },
    {
      "do": "wait",
      "seconds": 0.8
    },
    {
      "do": "describe",
