{
  "out": "/tmp/photonz-playtest/one-outline-two-kinds",
  "seed": "Picking a rectangle and a screenshot together used to list Outline twice, one for the line the shape draws itself and one for the ring the picture wears. Since 2026-09-08 both are the same thing, a Border in the Effects list, and there is no Outline row left to double up. This walk gives the picture a border, picks both layers, and pushes the one switch, the one colour and the one Width to see all of them land on both kinds of edge at once.",
  "setup": { "forget": ["shapes", "color", "panel", "tools"] },
  "steps": [
    { "do": "blank", "canvasWidth": 760, "canvasHeight": 520, "width": 1280, "height": 900 },
    { "do": "wait", "seconds": 1.2 },
    { "do": "dropImage", "file": "../../Tests/PhotonzRenderTests/Fixtures/settings-pane-2x.png", "at": [430, 300] },
    { "do": "wait", "seconds": 1.0 },
    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [300, 430], "to": [520, 570], "steps": 10 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "1-box-alone", "note": "the regression check first: a lone rectangle offers Fill in Appearance and the Border it came out of the tool wearing in Effects, that Border carrying the switch, the colour and the width." },
    { "do": "expect", "control": "Switch", "in": "Border", "reads": "Border, on" },
    { "do": "expect", "control": "Slider", "in": "Border", "present": true },
    { "do": "panel", "stage": "box-alone" },
    { "do": "snapshot", "name": "outline-1-box-alone" },
    { "do": "selectRow", "row": "settings-pane-2x" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "2-picture-alone", "note": "the screenshot on its own arrives with no ring, so its Effects list is empty until one is added from the plus." },
    { "do": "expect", "control": "Remove", "present": false },
    { "do": "panelMenu", "menu": "Add Effect", "choose": "Border" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expect", "control": "Switch", "in": "Border", "reads": "Border, on" },
    { "do": "selectRow", "row": "Rectangle", "modifiers": ["shift"] },
    { "do": "wait", "seconds": 0.9 },
    { "do": "describe", "stage": "3-both-picked", "note": "THE TEST: the rectangle and the screenshot picked together. Exactly ONE row called Border, reaching both of them, so the switch says on and nothing else." },
    { "do": "expect", "control": "Switch", "in": "Border", "reads": "Border, on" },
    { "do": "panel", "stage": "both-picked" },
    { "do": "snapshot", "name": "outline-2-both-picked" },
    { "do": "describe", "stage": "4-width-visible", "note": "ONE Width on the line under the Border row, with no arrow to press, reading whichever line each of them actually has." },
    { "do": "expect", "control": "Slider", "in": "Border", "present": true },
    { "do": "panel", "stage": "width-open" },
    { "do": "snapshot", "name": "outline-4-width-open" },
    { "do": "press", "control": "Slider", "in": "Border", "across": 0.6 },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "5-width-pulled", "note": "one pull: the shape's edge and the picture's ring must both land on the same number." },
    { "do": "panel", "stage": "width-pulled" },
    { "do": "snapshot", "name": "outline-5-width-pulled" },
    { "do": "render", "name": "outline-5-width-pulled-doc" },
    { "do": "press", "control": "Color", "in": "Border" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "6-picker", "note": "one well for both kinds of line: the picker it opens is the app's own." },
    { "do": "snapshot", "name": "outline-6-picker" },
    { "do": "press", "control": "Shades 2" },
    { "do": "wait", "seconds": 0.7 },
    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.7 },
    { "do": "describe", "stage": "7-painted", "note": "THE OTHER TEST: one colour picked once must paint the shape its edge and the picture its ring." },
    { "do": "panel", "stage": "painted" },
    { "do": "snapshot", "name": "outline-7-painted" },
    { "do": "render", "name": "outline-7-painted-doc" },
    { "do": "press", "control": "Switch", "in": "Border" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "8-switched-off", "note": "and one press takes the line off both of them again, colours kept." },
    { "do": "expect", "control": "Switch", "in": "Border", "reads": "Border, off" },
    { "do": "render", "name": "outline-8-switched-off-doc" },
    { "do": "snapshot", "name": "outline-8-switched-off" }
  ]
}
