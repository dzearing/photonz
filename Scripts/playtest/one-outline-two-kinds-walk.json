      "do": "render",
      "name": "outline-3-switched-on-doc"
    },
    {
      "do": "press",
      "control": "Settings",
      "in": "Outline"
    },
    {
      "do": "wait",
      "seconds": 0.7
    },
    {
      "do": "describe",
      "stage": "4-width-open",
      "note": "ONE Width under the one row, reading whichever line each of them actually has."
