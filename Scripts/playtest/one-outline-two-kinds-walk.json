    {
      "do": "panel",
      "stage": "width-pulled"
    },
    {
      "do": "snapshot",
      "name": "outline-5-width-pulled"
    },
    {
      "do": "render",
      "name": "outline-5-width-pulled-doc"
    },
    {
      "do": "press",
      "control": "Color",
      "in": "Outline"
