{
  "out": "/tmp/photonz-playtest/align-in-group",
  "steps": [
    { "do": "blank", "canvasWidth": 1200, "canvasHeight": 900, "width": 1280, "height": 900 },
    { "do": "wait", "seconds": 1 },

    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [300, 200], "to": [500, 260], "steps": 8 },
    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [320, 215], "to": [380, 235], "steps": 8 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "click", "at": [470, 252] },
    { "do": "click", "at": [350, 225], "modifiers": ["shift"] },
    { "do": "action", "action": "group" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "1-a-button", "note": "a 200x60 background with a small 60x20 word on it, wrapped in one group: the GROUP is picked, and it sits on bare canvas with nothing holding it, so canAlign should be false" },

    { "do": "click", "at": [350, 225], "count": 2 },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "2-the-word-picked", "note": "double clicking steps into the group and picks the word alone: canAlign should be TRUE with one layer picked, alignsTo should name the group, and alignAxes should hold all six" },
    { "do": "snapshot", "name": "align-group-1-row" },
    { "do": "render", "name": "align-group-1-row-doc" },

    { "do": "action", "action": "alignHorizontalCenter" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "3-centred-across", "note": "one press: the word should be centred across the group, x 370 for a 60 wide word in a group spanning 300 to 500, its y untouched at 215" },
    { "do": "snapshot", "name": "align-group-2-centred-across" },

    { "do": "action", "action": "alignVerticalCenter" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "4-centred-both", "note": "second press: the word sits dead centre of the button, y 220 for a 20 tall word in a group spanning 200 to 260. The group's own box must still be 300,200 200x60" },
    { "do": "snapshot", "name": "align-group-3-centred" },
    { "do": "render", "name": "align-group-3-centred-doc" },

    { "do": "action", "action": "alignVerticalCenter" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "describe", "stage": "5-pressed-twice", "note": "pressing the same button again must change nothing at all: the word stays at 370, 220 and no undo step was spent" },

    { "do": "action", "action": "undo" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "6-one-undo", "note": "ONE undo puts the vertical press back: y 215 again, x still centred at 370" },
    { "do": "action", "action": "undo" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "7-two-undos", "note": "a second undo puts the word back where it was drawn, 320, 215" },
    { "do": "render", "name": "align-group-7-undone-doc" },

    { "do": "action", "action": "alignRight" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "8-right-edge", "note": "Align Right against the group: the word's right edge lands on the background's, x 440" },
    { "do": "snapshot", "name": "align-group-4-right" },

    { "do": "key", "key": "escape" },
    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.4 },

    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [700, 400], "to": [900, 460], "steps": 8 },
    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [700, 500], "to": [900, 520], "steps": 8 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "click", "at": [800, 430] },
    { "do": "click", "at": [800, 510], "modifiers": ["shift"] },
    { "do": "action", "action": "group" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "click", "at": [800, 510], "count": 2 },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "9-nothing-to-move-sideways", "note": "this piece is exactly as wide as the rest of its group, so the three sideways buttons have nowhere to move it: alignAxes should hold only top, verticalCenter and bottom, and those three buttons should be dim in the snapshot" },
    { "do": "snapshot", "name": "align-group-5-one-axis" },

    { "do": "key", "key": "escape" },
    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [700, 620], "to": [820, 680], "steps": 8 },
    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [860, 620], "to": [980, 680], "steps": 8 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "click", "at": [760, 650] },
    { "do": "click", "at": [920, 650], "modifiers": ["shift"] },
    { "do": "action", "action": "group" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "click", "at": [920, 650], "count": 2 },
    { "do": "wait", "seconds": 0.5 },
    { "do": "action", "action": "deleteLayer" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "click", "at": [760, 650], "count": 2 },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "10-a-group-of-one", "note": "with its only sibling deleted, this piece IS the whole group, so there is no box to line it up inside: canAlign should be false and the Arrange row should be gone rather than showing six buttons that do nothing" },
    { "do": "snapshot", "name": "align-group-6-group-of-one" }
  ]
}
