{
  "out": "/tmp/photonz-playtest/f-puts-a-video-full-screen-walk",
  "seed": "F puts the video you are watching full screen, at Next defaults with no flag changed. A five minute recording, opened the way a person opens one, comes up in View (the player); it plays, F fills the screen with the picture and the transport and nothing else, and it keeps playing from where it was, still a player, the Arrow still in hand. With the pointer still, the transport tucks away after a moment, as QuickTime's controls do. Escape brings the window back, still playing. F again goes in and F comes out, even pressed twice quickly while the window is still sliding. View > Enter Full Screen is on the menu bar with the Mac's Control Command F, which does the same, and in the editor F is still the Frame tool. The transport's Full Screen button goes in and out too. Reported on 2026-10-11: 'the video's fullscreen feature lists ctrl-cmd-f as the shortcut but that does not work. and it's a bad shortcut. i expected f to just fullscreen it but it puts it into edit mode'. It needs the Mac to itself: full screen takes over a space of its own.",
  "setup": {
    "front": true,
    "forget": ["all"]
  },
  "steps": [
    { "do": "action", "action": "openLongTalk" },
    { "do": "wait", "seconds": 1.5 },
    { "do": "expectTimeline", "mode": "view", "open": false, "tool": "select", "fullScreen": false },
    { "do": "describe", "stage": "1-player", "note": "the player as it opens: picture, transport, Full Screen at the transport's right end" },
    { "do": "snapshot", "name": "1-player" },

    { "do": "key", "key": "space" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "expectTimeline", "rate": 1, "mode": "view" },
    { "do": "key", "key": "f" },
    { "do": "wait", "seconds": 1.6, "onTheClock": true },
    { "do": "expectTimeline", "fullScreen": true, "rate": 1, "mode": "view", "open": false, "tool": "select", "controlsTucked": false },
    { "do": "describe", "stage": "2-full-screen", "note": "THE TEST: F filled the screen with the picture and the transport, still playing, still the player" },
    { "do": "snapshot", "name": "2-full-screen" },
    { "do": "wait", "seconds": 3.0, "onTheClock": true },
    { "do": "expectTimeline", "fullScreen": true, "rate": 1, "controlsTucked": true },
    { "do": "describe", "stage": "3-transport-tucked-away", "note": "the pointer still for a moment while it plays: the transport tucked away, the picture alone" },
    { "do": "snapshot", "name": "3-transport-tucked-away" },

    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 1.6, "onTheClock": true },
    { "do": "expectTimeline", "fullScreen": false, "rate": 1, "mode": "view", "tool": "select", "controlsTucked": false },
    { "do": "describe", "stage": "4-escape-back", "note": "Escape brought the window back, still playing, the transport back" },
    { "do": "snapshot", "name": "4-escape-back" },

    { "do": "key", "key": "space" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "expectTimeline", "rate": 0, "mode": "view" },
    { "do": "key", "key": "f" },
    { "do": "wait", "seconds": 1.6, "onTheClock": true },
    { "do": "expectTimeline", "fullScreen": true, "rate": 0, "mode": "view" },
    { "do": "wait", "seconds": 3.0, "onTheClock": true },
    { "do": "expectTimeline", "fullScreen": true, "controlsTucked": false },
    { "do": "menus", "stage": "view-menu-full", "menu": "View", "oneKeyEach": true },
    { "do": "key", "key": "f" },
    { "do": "wait", "seconds": 1.6, "onTheClock": true },
    { "do": "expectTimeline", "fullScreen": false, "rate": 0, "mode": "view", "tool": "select" },

    { "do": "press", "control": "Full Screen" },
    { "do": "wait", "seconds": 1.6, "onTheClock": true },
    { "do": "expectTimeline", "fullScreen": true, "mode": "view" },
    { "do": "press", "control": "Full Screen" },
    { "do": "wait", "seconds": 1.6, "onTheClock": true },
    { "do": "expectTimeline", "fullScreen": false, "mode": "view" },

    { "do": "menus", "stage": "view-menu", "menu": "View", "oneKeyEach": true },
    { "do": "key", "key": "f", "modifiers": ["control", "command"] },
    { "do": "wait", "seconds": 1.6, "onTheClock": true },
    { "do": "expectTimeline", "fullScreen": true, "mode": "view" },
    { "do": "key", "key": "f", "modifiers": ["control", "command"] },
    { "do": "wait", "seconds": 1.6, "onTheClock": true },
    { "do": "expectTimeline", "fullScreen": false, "mode": "view" },

    { "do": "key", "key": "f" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "key", "key": "f" },
    { "do": "wait", "seconds": 3.0, "onTheClock": true },
    { "do": "expectTimeline", "fullScreen": false, "mode": "view" },
    { "do": "describe", "stage": "quick-f-f", "note": "F twice quickly, the second while the window was still sliding out to the edges: it came back, rather than the second press being lost" },

    { "do": "key", "key": "2", "modifiers": ["command"] },
    { "do": "wait", "seconds": 0.8 },
    { "do": "key", "key": "f" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "expectTimeline", "mode": "edit", "tool": "frame", "fullScreen": false },
    { "do": "key", "key": "f", "modifiers": ["control", "command"] },
    { "do": "wait", "seconds": 1.6, "onTheClock": true },
    { "do": "expectTimeline", "mode": "edit", "fullScreen": true },
    { "do": "describe", "stage": "5-editor-full-screen", "note": "in the editor F is still the Frame tool, and Control Command F fills the screen with the whole editor" },
    { "do": "snapshot", "name": "5-editor-full-screen" },
    { "do": "key", "key": "f", "modifiers": ["control", "command"] },
    { "do": "wait", "seconds": 1.6, "onTheClock": true },
    { "do": "expectTimeline", "fullScreen": false }
  ]
}
