{
  "out": "/tmp/photonz-playtest/ellipse-border",
  "setup": { "forget": ["shapes", "color", "panel"] },
  "steps": [
    { "do": "blank", "canvasWidth": 900, "canvasHeight": 600, "width": 1280, "height": 900 },
    { "do": "wait", "seconds": 1 },
    { "do": "key", "key": "o" },
    { "do": "drag", "from": [320, 280], "to": [600, 460] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "1-oval", "note": "an oval, drawn with O: its Border row is there at width 0, so there is no ring on it yet" },
    { "do": "render", "name": "1-canvas-oval" },
    { "do": "press", "control": "Slider", "in": "Border, Width", "across": 0.35 },
    { "do": "wait", "seconds": 0.6 },
    { "do": "panelMenu", "menu": "Border", "choose": "Outside" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "press", "control": "Color", "in": "Border" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "press", "control": "Shades 9" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "2-outside", "note": "the border thickened, darkened and put outside the edge: it should be an oval ring following the shape, not a square frame round its box" },
    { "do": "panel", "stage": "2-outside" },
    { "do": "snapshot", "name": "2-outside" },
    { "do": "render", "name": "2-canvas-outside" },
    { "do": "panelMenu", "menu": "Border", "choose": "Inside" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "3-inside", "note": "the same ring moved inside the edge, still oval" },
    { "do": "snapshot", "name": "3-inside" },
    { "do": "render", "name": "3-canvas-inside" },
    { "do": "panelMenu", "menu": "Border", "choose": "Center" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "4-centred", "note": "and centred on the edge" },
    { "do": "render", "name": "4-canvas-centred" },
    { "do": "panelMenu", "menu": "Border", "choose": "Outside" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "drag", "from": [600, 460], "to": [720, 400] },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "5-resized", "note": "the oval dragged wider by its corner handle: the ring follows the new shape" },
    { "do": "snapshot", "name": "5-resized" },
    { "do": "render", "name": "5-canvas-resized" },
    { "do": "key", "key": "r" },
    { "do": "drag", "from": [200, 120], "to": [420, 240] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "press", "control": "Slider", "in": "Border, Width", "across": 0.35 },
    { "do": "wait", "seconds": 0.6 },
    { "do": "panelMenu", "menu": "Border", "choose": "Outside" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "press", "control": "Color", "in": "Border" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "press", "control": "Shades 9" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "6-rectangle-unchanged", "note": "a rectangle beside it takes the same border: still a square ring, unchanged" },
    { "do": "snapshot", "name": "6-rectangle-unchanged" },
    { "do": "render", "name": "6-canvas-rectangle" }
  ]
}
