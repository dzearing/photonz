{
  "out": "/tmp/photonz-playtest/trim-keeps-the-piece-you-picked-walk",
  "setup": { "forget": ["all"] },
  "steps": [
    { "do": "action", "action": "openSampleRecording" },
    { "do": "action", "action": "videoPause" },
    { "do": "action", "action": "videoSeekQuarter" },
    { "do": "action", "action": "clipSplit" },
    { "do": "action", "action": "videoSeekThreeQuarters" },
    { "do": "action", "action": "clipSplit" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "action", "action": "videoSeekMiddle" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "expectRecording", "pieces": 3, "picked": 2 },
    { "do": "describe", "stage": "1-middle-piece-picked", "note": "an eight second recording cut in three: the second split leaves you holding the piece before it, the middle one" },
    { "do": "snapshot", "name": "1-middle-piece-picked" },

    { "do": "action", "action": "videoBeginTrim" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectRecording", "pieces": 3, "picked": 2, "seconds": 8 },
    { "do": "describe", "stage": "2-trim-keeps-the-pick", "note": "Trim opens on the clip the piece belongs to and the middle piece is STILL the picked one" },
    { "do": "snapshot", "name": "2-trim-keeps-the-pick" },

    { "do": "action", "action": "videoTrimStart" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expectRecording", "pieces": 3, "picked": 2, "seconds": 6, "starts": 2 },
    { "do": "describe", "stage": "3-handle-in-pick-held", "note": "the in handle is on the first cut, so the first piece is on its way out; the pick has not moved" },
    { "do": "snapshot", "name": "3-handle-in-pick-held" },

    { "do": "action", "action": "videoTrimDone" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "expectRecording", "pieces": 2, "picked": 0, "seconds": 6 },
    { "do": "describe", "stage": "4-trim-lets-go-of-a-pick-that-moved", "note": "THE TEST: the trim dropped the first piece, so the piece that was number two is now number one. Nothing is left picked rather than the pick quietly landing on a different piece, and the clip stays picked" },
    { "do": "snapshot", "name": "4-trim-lets-go-of-a-pick-that-moved" }
  ]
}
