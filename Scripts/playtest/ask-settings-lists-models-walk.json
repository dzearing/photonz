{
  "out": "/tmp/photonz-playtest/ask-settings-lists-models-walk",
  "clock": 180,
  "seed": "Settings > Ask lists every model as a row with what it needs, its quality and speed and Download, opened from Ask's setup dialog straight at the Ask section, on a 16 GB Mac with nothing downloaded",
  "setup": {
    "forget": [
      "all"
    ],
    "askModelMissing": true,
    "askMac": 16
  },
  "steps": [
    {
      "do": "open",
      "file": "../../Tests/PhotonzRenderTests/Fixtures/settings-pane-2x.png",
      "width": 1280,
      "height": 840
    },
    {
      "do": "wait",
      "seconds": 1
    },
    {
      "do": "press",
      "control": "Ask"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "type",
      "text": "measure the gaps between the buttons"
    },
    {
      "do": "press",
      "control": "Ask Send"
    },
    {
      "do": "wait",
      "seconds": 1.2
    },
    {
      "do": "expect",
      "control": "Ask Setup Other Models",
      "present": true
    },
    {
      "do": "expect",
      "control": "Ask Setup Download",
      "present": true
    },
    {
      "do": "expect",
      "control": "Ask Setup Model",
      "present": true
    },
    {
      "do": "describe",
      "stage": "1-dialog",
      "note": "the setup dialog on a 16 GB Mac: it offers the small model that fits, with its size and Download"
    },
    {
      "do": "snapshot",
      "name": "1-dialog"
    },
    {
      "do": "press",
      "control": "Ask Setup Other Models"
    },
    {
      "do": "wait",
      "seconds": 1.5
    },
    {
      "do": "expect",
      "control": "Ask Model Gemma 4 E4B",
      "present": true
    },
    {
      "do": "expect",
      "control": "Ask Download Gemma 4 E4B",
      "present": false
    },
    {
      "do": "expect",
      "control": "Ask Model Qwen3.5 9B",
      "present": true
    },
    {
      "do": "expect",
      "control": "Ask Download Qwen3.5 9B",
      "present": true
    },
    {
      "do": "expect",
      "control": "Ask Model Qwen3.8 27B",
      "present": true
    },
    {
      "do": "expect",
      "control": "Ask Model Qwen3.6 27B",
      "present": false
    },
    {
      "do": "describe",
      "stage": "2-settings",
      "note": "Settings opened from the dialog, at the Ask section: Qwen3.5 9B offers its Download on a 16 GB Mac; the big ones say they are too big for this Mac, the small weak ones that they are too weak"
    },
    {
      "do": "snapshot",
      "name": "2-settings",
      "window": "Settings"
    },
    {
      "do": "reveal",
      "control": "Ask Use Ollama"
    },
    {
      "do": "wait",
      "seconds": 0.6
    },
    {
      "do": "snapshot",
      "name": "3-settings-end",
      "window": "Settings"
    }
  ]
}
