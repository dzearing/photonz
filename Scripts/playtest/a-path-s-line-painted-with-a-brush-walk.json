{
  "out": "/tmp/photonz-playtest/a-path-s-line-painted-with-a-brush-walk",
  "seed": "A path's line can be painted with one of the brushes instead of a plain stroke, and the path stays editable (docs/design/brushes.md, decision 9). This walk draws a curve with the Pen at Next defaults, turns its line into charcoal from the Brush row under Outline, thickens it, drags an anchor and checks the brushed line followed, then picks two paths and swaps both to marker in one choice.",
  "setup": {
    "forget": ["shapes", "tools", "color", "panel"]
  },
  "steps": [
    { "do": "blank", "canvasWidth": 1000, "canvasHeight": 700, "width": 1280, "height": 900 },
    { "do": "wait", "seconds": 0.8 },

    { "do": "key", "key": "p" },
    { "do": "waitFor", "condition": "tool", "value": "pen" },
    { "do": "click", "at": [160, 470] },
    { "do": "wait", "seconds": 0.2 },
    { "do": "drag", "from": [460, 200], "to": [620, 200], "steps": 8 },
    { "do": "wait", "seconds": 0.2 },
    { "do": "click", "at": [840, 470] },
    { "do": "wait", "seconds": 0.2 },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectPath", "anchors": 3, "closed": false },
    { "do": "expect", "menu": "Brush", "reads": "Plain" },
    { "do": "describe", "stage": "1-plain", "note": "the curve the Pen drew, its line plain, with the Brush row under Outline reading Plain" },
    { "do": "snapshot", "name": "1-plain" },

    { "do": "panelMenu", "menu": "Brush", "choose": "Charcoal" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expect", "menu": "Brush", "reads": "Charcoal" },
    { "do": "focus", "field": "Thickness" },
    { "do": "type", "text": "18" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 1.2 },
    { "do": "expect", "field": "Thickness", "reads": "18" },
    { "do": "describe", "stage": "2-charcoal", "note": "THE TEST: the line is charcoal on paper grain, tapering at both open ends, not a flat vector stroke; the panel shows the brush's own Grain and Smudge under it" },
    { "do": "panel", "stage": "2-charcoal" },
    { "do": "snapshot", "name": "2-charcoal" },
    { "do": "render", "name": "2-charcoal-doc" },

    { "do": "drag", "from": [840, 470], "to": [880, 260], "steps": 14, "hold": "3-dragging" },
    { "do": "wait", "seconds": 1.2 },
    { "do": "expectPath", "anchors": 3, "closed": false, "anchor": 2, "near": [880, 260], "within": 2 },
    { "do": "expect", "menu": "Brush", "reads": "Charcoal" },
    { "do": "describe", "stage": "4-moved", "note": "THE TEST: the right end moved up and the charcoal line re-painted along the new curve, still charcoal, still tapering" },
    { "do": "snapshot", "name": "4-moved" },
    { "do": "render", "name": "4-moved-doc" },

    { "do": "key", "key": "p" },
    { "do": "waitFor", "condition": "tool", "value": "pen" },
    { "do": "click", "at": [160, 620] },
    { "do": "wait", "seconds": 0.2 },
    { "do": "click", "at": [500, 560] },
    { "do": "wait", "seconds": 0.2 },
    { "do": "click", "at": [840, 620] },
    { "do": "wait", "seconds": 0.2 },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectLayers", "count": 3 },
    { "do": "selectRow", "row": "Path", "modifiers": ["shift"] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expect", "menu": "Brush", "reads": "Mixed" },
    { "do": "panelMenu", "menu": "Brush", "choose": "Marker" },
    { "do": "wait", "seconds": 1.2 },
    { "do": "expect", "menu": "Brush", "reads": "Marker" },
    { "do": "describe", "stage": "5-both-marker", "note": "THE TEST: both paths picked, one choice of Marker, and both lines are marker now" },
    { "do": "panel", "stage": "5-both-marker" },
    { "do": "snapshot", "name": "5-both-marker" },
    { "do": "render", "name": "5-both-marker-doc" }
  ]
}
