{
  "out": "/tmp/photonz-playtest/close-a-trimmed-recording-walk",
  "setup": { "forget": ["all"] },
  "steps": [
    { "do": "action", "action": "openSampleRecording" },
    { "do": "action", "action": "videoPause" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "action", "action": "videoBeginTrim" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "action", "action": "videoTrimStart" },
    { "do": "action", "action": "videoTrimEnd" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "action", "action": "videoTrimDone" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "expectRecording", "seconds": 4 },

    { "do": "action", "action": "askToClose" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "1-closing-asks", "note": "trimmed and not saved, so closing the window stops and asks, with Save first" },
    { "do": "snapshot", "name": "1-closing-asks" },

    { "do": "action", "action": "answerCloseFirst" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "expectWindows", "titled": "Tutorial Sample", "count": 0 },
    { "do": "open", "file": "/tmp/photonz-playtest/close-a-trimmed-recording-walk/project.photonz" },
    { "do": "wait", "seconds": 1.5 },
    { "do": "action", "action": "expectReopenedAsSaved" },
    { "do": "expectRecording", "seconds": 4 },
    { "do": "describe", "stage": "2-saved-and-closed", "note": "THE TEST: Save in the close question wrote the trim as a project and let the window go; opening that project gives the four second trim back" },
    { "do": "snapshot", "name": "2-saved-and-reopened" }
  ]
}
