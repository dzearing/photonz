{
  "out": "/tmp/photonz-playtest/locked-layer-key",
  "seed": "A locked rectangle is picked from the layers list, then the two keys that would move it and remove it are pressed. Neither can act. This walk records whether the app says anything about it.",
  "setup": { "forget": ["shapes", "color", "tools"] },
  "steps": [
    { "do": "blank", "canvasWidth": 1200, "canvasHeight": 800, "width": 1280, "height": 900 },
    { "do": "wait", "seconds": 1.0 },
    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [200, 160], "to": [560, 380] },
    { "do": "wait", "seconds": 0.8 },
    { "do": "tool", "tool": "select" },
    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "click", "at": [380, 270] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "1-unlocked-picked", "note": "rectangle drawn and picked; layers 2" },
    { "do": "panel", "stage": "1b-rows" },
    { "do": "press", "control": "Lock", "in": "Rectangle" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "selectRow", "row": "Rectangle" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "2-locked-and-picked", "note": "the rectangle is now locked and picked from the list" },
    { "do": "snapshot", "name": "locked-2-picked" },
    { "do": "key", "key": "delete" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "3-after-delete", "note": "BACKSPACE ON A LOCKED LAYER: layers must still be 2, and 'copied' says whether the canvas said anything" },
    { "do": "snapshot", "name": "locked-3-after-delete" },
    { "do": "key", "key": "up" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "key", "key": "up" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "4-after-arrows", "note": "ARROW ON A LOCKED LAYER: the frame must be unchanged and 'copied' says whether the canvas said anything" },
    { "do": "snapshot", "name": "locked-4-after-arrows" }
  ]
}
