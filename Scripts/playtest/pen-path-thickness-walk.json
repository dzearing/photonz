{
  "out": "/tmp/photonz-playtest/pen-path-thickness-walk",
  "seed": "A shape drawn with the Pen came out at whatever weight the canvas gave it and stayed there: the panel offered its colour, its opacity and its blending and nothing else, while every other shape in the app keeps a Thickness right beside its colour. The walk draws a path, picks it, and reads the row: it has to be there, read the weight the line actually has, change the line live, land as ONE undo step, reach two paths at once, and show the thinner weight a path drawn on an icon frame arrives at.",
  "setup": {
    "forget": ["shapes", "frames", "tools"]
  },
  "steps": [
    { "do": "blank", "canvasWidth": 1600, "canvasHeight": 1100, "width": 1240, "height": 900 },
    { "do": "wait", "seconds": 1 },

    { "do": "key", "key": "p" },
    { "do": "waitFor", "condition": "tool", "value": "pen" },
    { "do": "click", "at": [240, 640] },
    { "do": "wait", "seconds": 0.2 },
    { "do": "click", "at": [400, 640] },
    { "do": "wait", "seconds": 0.2 },
    { "do": "click", "at": [470, 720] },
    { "do": "wait", "seconds": 0.2 },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expectPath", "anchors": 3, "closed": false, "width": 4 },
    { "do": "describe", "stage": "1-drawn", "note": "an open path of three corners, out of the Pen at the weight every new line ships with" },

    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expect", "field": "Thickness", "present": true },
    { "do": "expect", "field": "Thickness", "reads": "4 px" },
    { "do": "describe", "stage": "2-row", "note": "THE TEST: picking the drawn path offers a Thickness under its colour row in Appearance, reading the weight the line actually has. Before this the panel offered Opacity, Blending and a colour, and nothing that could change the line." },
    { "do": "snapshot", "name": "2-thickness-row" },

    { "do": "action", "action": "dragThickness" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expectPath", "anchors": 3, "width": 9 },
    { "do": "expect", "field": "Thickness", "reads": "9 px" },
    { "do": "describe", "stage": "3-thicker", "note": "pulling it took the line from 4 to 9 and the canvas followed it up" },
    { "do": "snapshot", "name": "3-thicker" },

    { "do": "action", "action": "undo" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expectPath", "anchors": 3, "width": 4 },
    { "do": "describe", "stage": "4-undo", "note": "ONE undo step puts the whole pull back, however many previews went through it on the way" },

    { "do": "action", "action": "redo" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "expectPath", "anchors": 3, "width": 9 },

    { "do": "key", "key": "p" },
    { "do": "waitFor", "condition": "tool", "value": "pen" },
    { "do": "click", "at": [240, 200] },
    { "do": "wait", "seconds": 0.2 },
    { "do": "click", "at": [400, 200] },
    { "do": "wait", "seconds": 0.2 },
    { "do": "click", "at": [470, 280] },
    { "do": "wait", "seconds": 0.2 },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expectPath", "anchors": 3, "width": 4 },

    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "click", "at": [320, 200] },
    { "do": "wait", "seconds": 0.3 },
    { "do": "click", "at": [320, 640], "modifiers": ["shift"] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expect", "field": "Thickness", "reads": "Mixed" },
    { "do": "describe", "stage": "5-mixed", "note": "both paths picked, one 9 and one 4: ONE row, reading Mixed, exactly as a colour row does" },
    { "do": "snapshot", "name": "5-mixed" },

    { "do": "action", "action": "dragThicknessThin" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expect", "field": "Thickness", "reads": "3 px" },
    { "do": "expectPath", "width": 3 },
    { "do": "describe", "stage": "6-both", "note": "one pull reached both: the row stops saying Mixed and both lines land on 3" },
    { "do": "snapshot", "name": "6-both-thinner" },

    { "do": "action", "action": "undo" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expect", "field": "Thickness", "reads": "Mixed" },
    { "do": "describe", "stage": "7-one-step", "note": "THE TEST: ONE undo put BOTH lines back. Had it reached only one, the row would read a number rather than Mixed" },

    { "do": "action", "action": "newFrameDialog" },
    { "do": "wait", "seconds": 0.9 },
    { "do": "press", "control": "24", "in": "Icons" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "press", "control": "Add Frame" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "tool", "tool": "pen" },
    { "do": "click", "at": [792, 544] },
    { "do": "wait", "seconds": 0.2 },
    { "do": "click", "at": [806, 544] },
    { "do": "wait", "seconds": 0.2 },
    { "do": "click", "at": [799, 556] },
    { "do": "wait", "seconds": 0.2 },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expectPath", "anchors": 3, "width": 2 },
    { "do": "expect", "field": "Thickness", "reads": "2 px" },
    { "do": "describe", "stage": "8-icon-frame", "note": "a path drawn on a 24 pixel icon frame arrives at 2, and the row says 2 rather than the 4 every new line ships with, so the weight the shape HAS is the weight on screen" },
    { "do": "snapshot", "name": "8-icon-frame" },
    { "do": "render", "name": "9-final-render" }
  ]
}
