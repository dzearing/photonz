{
  "out": "/tmp/photonz-playtest/arrow-caption-touch",
  "steps": [
    { "do": "open", "file": "../../Tests/PhotonzRenderTests/Fixtures/settings-pane-2x.png",
      "width": 1280, "height": 840 },
    { "do": "wait", "seconds": 1 },

    { "do": "key", "key": "a" },
    { "do": "waitFor", "condition": "tool", "value": "arrow" },
    { "do": "drag", "from": [700, 600], "to": [1000, 760] },
    { "do": "waitFor", "condition": "captionField", "timeout": 3 },
    { "do": "type", "text": "ok" },
    { "do": "key", "key": "return", "modifiers": ["command"] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "1-short-label",
      "note": "short label, pill hangs off the tail; selection box should hug arrow + pill" },
    { "do": "render", "name": "1-short-label" },
    { "do": "snapshot", "name": "1-short-label" },

    { "do": "drag", "from": [700, 600], "to": [420, 300], "steps": 14,
      "hold": "2-mid-drag" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "3-tail-moved", "note": "tail dragged up and left" },
    { "do": "render", "name": "3-tail-moved" },
    { "do": "snapshot", "name": "3-tail-moved" },

    { "do": "action", "action": "undo" },
    { "do": "wait", "seconds": 0.4 },

    { "do": "key", "key": "a" },
    { "do": "drag", "from": [400, 250], "to": [640, 250] },
    { "do": "waitFor", "condition": "captionField", "timeout": 3 },
    { "do": "type", "text": "ok" },
    { "do": "key", "key": "return", "modifiers": ["command"] },
    { "do": "wait", "seconds": 0.4 },

    { "do": "key", "key": "a" },
    { "do": "drag", "from": [1100, 250], "to": [860, 250] },
    { "do": "waitFor", "condition": "captionField", "timeout": 3 },
    { "do": "type", "text": "ok" },
    { "do": "key", "key": "return", "modifiers": ["command"] },
    { "do": "wait", "seconds": 0.4 },

    { "do": "key", "key": "a" },
    { "do": "drag", "from": [400, 880], "to": [560, 700] },
    { "do": "waitFor", "condition": "captionField", "timeout": 3 },
    { "do": "type", "text": "ok" },
    { "do": "key", "key": "return", "modifiers": ["command"] },
    { "do": "wait", "seconds": 0.4 },

    { "do": "key", "key": "a" },
    { "do": "drag", "from": [1150, 880], "to": [980, 700] },
    { "do": "waitFor", "condition": "captionField", "timeout": 3 },
    { "do": "type", "text": "ok" },
    { "do": "key", "key": "return", "modifiers": ["command"] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "describe", "stage": "4-four-angles",
      "note": "four short labels at four angles; every tail should run into the middle of its pill's near edge" },
    { "do": "render", "name": "4-four-angles" },
    { "do": "snapshot", "name": "4-four-angles" },

    { "do": "key", "key": "a" },
    { "do": "drag", "from": [700, 500], "to": [1050, 620] },
    { "do": "waitFor", "condition": "captionField", "timeout": 3 },
    { "do": "type", "text": "Focus ring is two pixels off" },
    { "do": "key", "key": "return", "modifiers": ["command"] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "5-long-label", "note": "long label, still selected" },
    { "do": "render", "name": "5-long-label" },
    { "do": "snapshot", "name": "5-long-label" }
  ]
}
