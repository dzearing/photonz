{
  "out": "/tmp/photonz-playtest/title-type-set-like-apple",
  "seed": "A title's type can be set the way Apple sets its titles (video-titles-apple.html): at Next defaults with no flag changed, a title is typed over the sample recording and picked; Tracking -2.8 and Leading 106 are typed into the two boxes under Size and Weight; New York is chosen in the Font menu; and the Color row paints the words with a gradient, one undo step that undo takes back off.",
  "setup": {
    "forget": ["all"],
    "timelineOpen": true
  },
  "steps": [
    { "do": "action", "action": "openSampleRecording" },
    { "do": "wait", "seconds": 2.0 },
    { "do": "action", "action": "videoPause" },
    { "do": "appearance", "value": "dark" },
    { "do": "tool", "tool": "select" },
    { "do": "action", "action": "videoSeekStart" },
    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "tool", "tool": "text" },
    { "do": "click", "at": [560, 330] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "type", "text": "Field notes" },
    { "do": "key", "key": "return", "modifiers": ["command"] },
    { "do": "wait", "seconds": 1.0 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "focus", "field": "Size" },
    { "do": "type", "text": "96" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "reveal", "control": "Text section" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "1-picked",
      "note": "a title picked at 96: under Size and Weight the Text section has Tracking and Leading boxes, Tracking reading 0 and Leading Auto" },
    { "do": "expect", "field": "Tracking", "reads": "0" },
    { "do": "expect", "field": "Leading", "reads": "Auto" },
    { "do": "panel", "stage": "1-picked" },
    { "do": "snapshot", "name": "1-spacing-row" },

    { "do": "focus", "field": "Tracking" },
    { "do": "type", "text": "-2.8" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "2-tracked",
      "note": "THE FIRST TEST: -2.8 typed into Tracking and Return pressed. The letters pull together, the way an Apple headline's -0.028em does, and the box still hugs the words" },
    { "do": "expect", "field": "Tracking", "reads": "-2.8" },
    { "do": "render", "name": "2-tracked" },

    { "do": "focus", "field": "Leading" },
    { "do": "type", "text": "106" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "3-leading",
      "note": "Leading 106 typed: a line 1.06 times the size, as the New York headline is set" },
    { "do": "expect", "field": "Leading", "reads": "106" },

    { "do": "panelMenu", "menu": "Font", "choose": "New York" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "4-new-york",
      "note": "THE SECOND TEST: New York is on the Font menu, and the title is drawn in it: a serif, not Helvetica standing in" },
    { "do": "expect", "menu": "Font", "reads": "New York" },
    { "do": "render", "name": "4-new-york" },
    { "do": "snapshot", "name": "4-new-york-window" },

    { "do": "action", "action": "paintSelectionColor" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "action", "action": "paintSelectionGradient" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "5-gradient",
      "note": "THE THIRD TEST: the Color row painted the words with a straight gradient out of the crimson they had, and it runs through the letters left to right" },
    { "do": "action", "action": "openColorPicker" },
    { "do": "wait", "seconds": 0.9 },
    { "do": "snapshot", "name": "5-picker-on-a-title" },
    { "do": "action", "action": "closeColorPicker" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "render", "name": "5-gradient" },
    { "do": "snapshot", "name": "5-gradient-window" },

    { "do": "action", "action": "undo" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "6-undone",
      "note": "one undo takes the gradient back off: the words are the flat crimson again, still New York, still tracked" },
    { "do": "expect", "menu": "Font", "reads": "New York" },
    { "do": "expect", "field": "Tracking", "reads": "-2.8" },
    { "do": "render", "name": "6-undone" },

    { "do": "appearance", "value": "light" },
    { "do": "reveal", "control": "Text section" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "snapshot", "name": "7-spacing-row-light" },
    { "do": "appearance", "value": "dark" }
  ]
}
