    {"do": "wait", "seconds": 0.4},
    {"do": "drag", "from": [120, 320], "to": [300, 320], "steps": 8},
    {"do": "wait", "seconds": 0.6},
    {"do": "tool", "tool": "select"},
    {"do": "wait", "seconds": 0.8},
    {"do": "panel", "stage": "1-a-line-of-its-own"},
    {"do": "snapshot", "name": "1-a-line-of-its-own"},
    {"do": "press", "control": "Glyph / stroke 1.75", "in": "Line Style"},
    {"do": "wait", "seconds": 0.8},
    {"do": "expect", "field": "Width", "reads": "1.75"},
    {"do": "expect", "control": "Style", "reads": "Line Style, Glyph / stroke 1.75"},
    {"do": "snapshot", "name": "2-the-line-wears-it"},

    {"do": "tool", "tool": "ellipse"},
    {"do": "wait", "seconds": 0.4},
    {"do": "drag", "from": [380, 300], "to": [500, 420], "steps": 8},
    {"do": "wait", "seconds": 0.6},
    {"do": "tool", "tool": "select"},
    {"do": "wait", "seconds": 0.8},
    {"do": "panelMenu", "menu": "Add Effect", "choose": "Border"},
