    {"do": "wait", "seconds": 0.7},
    {"do": "expect", "field": "Width", "reads": "1.75"},
    {"do": "click", "at": [300, 120]},
    {"do": "wait", "seconds": 0.7},
    {"do": "expect", "field": "Width", "reads": "1.75"},
