    {"do": "panel", "stage": "3-an-oval-of-its-own"},
    {"do": "snapshot", "name": "3-an-oval-of-its-own"},
    {"do": "press", "control": "Glyph / stroke 1.75", "in": "Border Stroke"},
    {"do": "wait", "seconds": 0.8},
    {"do": "expect", "control": "Stroke", "reads": "Border, Border Stroke, Glyph / stroke 1.75"},
    {"do": "expect", "control": "Position", "in": "Border", "reads": "Center"},
    {"do": "panel", "stage": "4-the-oval-wears-it"},
    {"do": "snapshot", "name": "4-the-oval-wears-it"},

    {"do": "click", "at": [60, 470]},
    {"do": "wait", "seconds": 0.8},
    {"do": "press", "control": "Glyph / stroke 1.75"},
    {"do": "wait", "seconds": 1},
    {"do": "panel", "stage": "5-the-stroke-itself"},
    {"do": "expect", "control": "Glyph / stroke 1.75", "present": true},
    {"do": "focus", "field": "Width"},
    {"do": "type", "text": "3"},
    {"do": "key", "key": "return"},
    {"do": "wait", "seconds": 1},
    {"do": "snapshot", "name": "5-every-part-followed"},
    {"do": "render", "name": "5-canvas-every-part-followed"},
    {"do": "click", "at": [300, 120]},
    {"do": "wait", "seconds": 0.7},
    {"do": "expect", "field": "Width", "reads": "3"},
    {"do": "click", "at": [210, 320]},
    {"do": "wait", "seconds": 0.7},
    {"do": "expect", "field": "Width", "reads": "3"},
    {"do": "expect", "control": "Style", "reads": "Line Style, Glyph / stroke 1.75"},
    {"do": "click", "at": [440, 302]},
    {"do": "wait", "seconds": 0.7},
