{
  "out": "/tmp/photonz-playtest/a-line-and-an-oval-wear-the-saved-stroke",
  "seed": "A glyph is more than Pen paths: on a File, New, Image, Icon picture at Next defaults a Pen line is saved as the set's stroke, then a Line tool line takes it from the button on its Style row and an oval given a Border from the Effects plus takes it from the button on its Border's Stroke row, one pointer click each. One change of the saved stroke's width moves the path, the line and the oval's edge together, and one undo puts all three back.",
  "setup": {
    "forget": ["all"]
  },
  "steps": [
    {"do": "startFromEmpty", "row": "New image", "answer": ["Icon", "Create"], "width": 1280, "height": 900},
    {"do": "wait", "seconds": 1.2},
    {"do": "tool", "tool": "pen"},
    {"do": "wait", "seconds": 0.4},
    {"do": "click", "at": [200, 120]},
    {"do": "wait", "seconds": 0.3},
    {"do": "click", "at": [400, 120]},
    {"do": "wait", "seconds": 0.3},
    {"do": "click", "at": [400, 240]},
    {"do": "wait", "seconds": 0.3},
    {"do": "key", "key": "return"},
    {"do": "wait", "seconds": 0.5},
    {"do": "tool", "tool": "select"},
    {"do": "wait", "seconds": 0.8},
    {"do": "focus", "field": "Width"},
    {"do": "type", "text": "1.75"},
    {"do": "key", "key": "return"},
    {"do": "wait", "seconds": 0.6},
    {"do": "press", "control": "Round", "in": "Corners"},
    {"do": "wait", "seconds": 0.6},
    {"do": "press", "control": "Save as Style"},
    {"do": "wait", "seconds": 0.9},
    {"do": "key", "key": "return"},
    {"do": "wait", "seconds": 1},
