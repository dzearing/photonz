{
  "out": "/tmp/photonz-playtest/outline-width",
  "setup": { "forget": ["all"] },
  "steps": [
    { "do": "blank", "canvasWidth": 1100, "canvasHeight": 700, "width": 1400, "height": 1080 },
    { "do": "wait", "seconds": 1 },

    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [150, 160], "to": [430, 330], "steps": 8 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "action", "action": "toggleFillSwitch" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "action", "action": "dragThicknessThin" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "1-one-width", "note": "a rectangle picked: the Rectangle section offers Thickness, and the Effects section below it has Opacity, Blur and Corner Radius and no Border row. One control for the line round the box, not two." },
    { "do": "snapshot", "name": "outline-1-one-width" },

    { "do": "action", "action": "dragThickness" },
    { "do": "wait", "seconds": 0.7 },
    { "do": "describe", "stage": "2-thicker", "note": "one pull on Thickness and the line round the box is 9px" },
    { "do": "snapshot", "name": "outline-2-thicker" },
    { "do": "render", "name": "box-at-nine" },

    { "do": "action", "action": "undo" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "2b-undone", "note": "one undo puts the whole pull back: the line is 3px again" },
    { "do": "render", "name": "box-back-at-three" },
    { "do": "action", "action": "redo" },
    { "do": "wait", "seconds": 0.6 },

    { "do": "tool", "tool": "ellipse" },
    { "do": "drag", "from": [520, 160], "to": [800, 330], "steps": 8 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "3-ellipse", "note": "an ellipse is the same story: Thickness in its own section, no Border row that would have drawn a rectangle round it" },
    { "do": "snapshot", "name": "outline-3-ellipse" },

    { "do": "tool", "tool": "frame" },
    { "do": "drag", "from": [150, 420], "to": [430, 600], "steps": 8 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "4-frame-keeps-border", "note": "a frame has no line of its own, so it still gets Border under Effects" },
    { "do": "snapshot", "name": "outline-4-frame-keeps-border" },

    { "do": "action", "action": "borderSelection" },
    { "do": "wait", "seconds": 0.7 },
    { "do": "describe", "stage": "5-frame-bordered", "note": "the frame takes a 4px border, and the Border color row appears in the Color section" },
    { "do": "snapshot", "name": "outline-5-frame-bordered" },
    { "do": "render", "name": "frame-bordered" },

    { "do": "click", "at": [280, 240], "modifiers": ["shift"] },
    { "do": "wait", "seconds": 0.9 },
    { "do": "describe", "stage": "6-mixed", "note": "a box and a frame picked together: Thickness speaks for the box, Border speaks for the frame, and each row says how far it reaches" },
    { "do": "snapshot", "name": "outline-6-mixed" },
    { "do": "key", "key": "escape" },
    { "do": "tool", "tool": "line" },
    { "do": "drag", "from": [520, 420], "to": [1000, 420], "steps": 8 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "7-line", "note": "a line from the Line tool, picked: Thickness sits under its Line row in Appearance" },
    { "do": "expectInk", "at": [760, 420], "thickness": 4 },
    { "do": "render", "name": "line-before" },
    { "do": "press", "control": "Slider", "in": "Thickness", "across": 0.6 },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expect", "field": "Thickness", "reads": "26" },
    { "do": "describe", "stage": "8-line-thicker", "note": "THE TEST: a click on the Thickness track takes the line to 26, and the PICTURE is 26 pixels thick, not just the number. Until 2026-10-19 the number said 26 and the line was still drawn at its old width, cut down to the box it was drawn in." },
    { "do": "expectInk", "at": [760, 420], "thickness": 26 },
    { "do": "snapshot", "name": "outline-8-line-thicker" },
    { "do": "render", "name": "line-after" },
    { "do": "action", "action": "undo" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "9-line-undone", "note": "one undo puts the line back to the width it was drawn at, on the canvas" },
    { "do": "expectInk", "at": [760, 420], "thickness": 4 },
    { "do": "action", "action": "redo" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectInk", "at": [760, 420], "thickness": 26 },

    { "do": "key", "key": "escape" },
    { "do": "tool", "tool": "arrow" },
    { "do": "drag", "from": [520, 540], "to": [1000, 540], "steps": 8 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "press", "control": "Slider", "in": "Thickness", "across": 0.95 },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expect", "field": "Thickness", "reads": "40" },
    { "do": "describe", "stage": "10-arrow-thicker", "note": "an arrow at the top of the slider: its shaft is drawn 40 pixels thick, and its head grows round it" },
    { "do": "expectInk", "at": [700, 540], "thickness": 40 },
    { "do": "snapshot", "name": "outline-10-arrow-thicker" },

    { "do": "key", "key": "escape" },
    { "do": "key", "key": "p" },
    { "do": "waitFor", "condition": "tool", "value": "pen" },
    { "do": "click", "at": [520, 650] },
    { "do": "wait", "seconds": 0.2 },
    { "do": "click", "at": [1000, 650] },
    { "do": "wait", "seconds": 0.2 },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "press", "control": "Slider", "in": "Thickness", "across": 0.6 },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expect", "field": "Thickness", "reads": "26" },
    { "do": "describe", "stage": "11-pen-path-thicker", "note": "a path from the Pen takes the same pull the same way" },
    { "do": "expectInk", "at": [760, 650], "thickness": 26 },
    { "do": "snapshot", "name": "outline-11-pen-path-thicker" },
    { "do": "render", "name": "all-thicker" }
  ]
}
