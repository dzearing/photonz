{
  "out": "/tmp/photonz-playtest/border-offset",
  "setup": { "forget": ["shapes", "color", "panel"] },
  "steps": [
    { "do": "blank", "canvasWidth": 900, "canvasHeight": 600, "width": 1280, "height": 900 },
    { "do": "wait", "seconds": 1 },
    { "do": "key", "key": "r" },
    { "do": "drag", "from": [360, 300], "to": [560, 440] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "panelMenu", "menu": "Border", "choose": "Outside" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "press", "control": "Color", "in": "Border" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "press", "control": "Shades 2" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "press", "control": "Slider", "in": "Width", "across": 0.15 },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "1-on-the-edge",
      "note": "one border sitting right on the outside edge, and an Offset row of its own under the Width" },
    { "do": "panel", "stage": "1-on-the-edge" },
    { "do": "snapshot", "name": "1-on-the-edge" },
    { "do": "render", "name": "1-canvas-on-the-edge" },
    { "do": "press", "control": "Slider", "in": "Offset", "across": 0.4 },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "2-standing-off",
      "note": "the same ring standing clear of the shape, with air between them" },
    { "do": "panel", "stage": "2-standing-off" },
    { "do": "snapshot", "name": "2-standing-off" },
    { "do": "render", "name": "2-canvas-standing-off" },
    { "do": "panelMenu", "menu": "Border", "choose": "Center" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expect", "control": "Slider", "in": "Offset", "present": false },
    { "do": "describe", "stage": "3-centred",
      "note": "centred: the Offset slider is gone and a line says why, and says the number is kept" },
    { "do": "panel", "stage": "3-centred" },
    { "do": "snapshot", "name": "3-centred" },
    { "do": "render", "name": "3-canvas-centred" },
    { "do": "panelMenu", "menu": "Border", "choose": "Inside" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "4-inside-offset",
      "note": "inside with the same offset: the ring moved that far further in, and the number came back" },
    { "do": "panel", "stage": "4-inside-offset" },
    { "do": "snapshot", "name": "4-inside-offset" },
    { "do": "render", "name": "4-canvas-inside-offset" },
    { "do": "panelMenu", "menu": "Border", "choose": "Outside" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "press", "control": "Slider", "in": "Corner Radius", "across": 0.3 },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "5-rounded",
      "note": "the offset ring round a rounded box stays parallel to it instead of going square" },
    { "do": "panel", "stage": "5-rounded" },
    { "do": "snapshot", "name": "5-rounded" },
    { "do": "render", "name": "5-canvas-rounded" },
    { "do": "panelMenu", "menu": "Add Effect", "choose": "Border" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "panelMenu", "menu": "Border 2", "choose": "Outside" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "press", "control": "Color", "in": "Border 2" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "press", "control": "Shades 4" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "6-two-rings",
      "note": "a tight ring on the edge and a second one standing off it: two rings, not one thick one" },
    { "do": "panel", "stage": "6-two-rings" },
    { "do": "snapshot", "name": "6-two-rings" },
    { "do": "render", "name": "6-canvas-two-rings" },
    { "do": "action", "action": "undo" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "7-undo", "note": "one undo takes the colour back off the second ring" },
    { "do": "panel", "stage": "7-undo" }
  ]
}
