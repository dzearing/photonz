{
  "out": "/tmp/photonz-playtest/picked-piece-reads-first-walk",
  "setup": { "flags": { "next-a-recording-is-a-document": false }, "forget": ["all"] },
  "steps": [
    { "do": "action", "action": "openSampleRecording" },
    { "do": "action", "action": "videoPause" },
    { "do": "action", "action": "videoSeekMiddle" },
    { "do": "action", "action": "videoCut" },
    { "do": "action", "action": "videoSeekThreeQuarters" },
    { "do": "action", "action": "videoCut" },

    { "do": "action", "action": "videoPlay" },
    { "do": "action", "action": "videoPause" },
    { "do": "action", "action": "videoSeekThreeQuarters" },
    { "do": "describe", "stage": "1-dark-picked-not-played", "note": "three pieces, dark. The playhead has just landed at the head of the third piece, so that piece is the one Delete would take and none of it has been watched. It has to be the block the eye lands on, not the faintest thing on the strip" },
    { "do": "snapshot", "name": "1-dark-picked-not-played" },

    { "do": "action", "action": "videoPlay" },
    { "do": "action", "action": "videoPause" },
    { "do": "action", "action": "videoSeekQuarter" },
    { "do": "describe", "stage": "2-dark-picked-part-played", "note": "the playhead is now half way through the first piece, so the picked piece is part played: progress inside it still reads, and the two pieces after it stay quieter than it is" },
    { "do": "snapshot", "name": "2-dark-picked-part-played" },

    { "do": "action", "action": "videoSeekThreeQuarters" },
    { "do": "action", "action": "videoPlay" },
    { "do": "wait", "seconds": 1.6 },
    { "do": "action", "action": "videoPause" },
    { "do": "describe", "stage": "3-dark-picked-fully-played", "note": "the other case that flips it: the picked piece has been watched almost all the way through, so it is full. The mark that says picked has to survive a full block" },
    { "do": "snapshot", "name": "3-dark-picked-fully-played" },

    { "do": "appearance", "value": "light" },
    { "do": "action", "action": "videoPlay" },
    { "do": "action", "action": "videoPause" },
    { "do": "action", "action": "videoSeekThreeQuarters" },
    { "do": "describe", "stage": "4-light-picked-not-played", "note": "the same unplayed pick in light, where the neutral blocks are dark on a light bar instead of light on a dark one" },
    { "do": "snapshot", "name": "4-light-picked-not-played" },

    { "do": "action", "action": "videoPlay" },
    { "do": "action", "action": "videoPause" },
    { "do": "action", "action": "videoSeekQuarter" },
    { "do": "describe", "stage": "5-light-picked-part-played", "note": "light, first piece picked and half watched, two pieces after it that nobody has reached" },
    { "do": "snapshot", "name": "5-light-picked-part-played" }
  ]
}
