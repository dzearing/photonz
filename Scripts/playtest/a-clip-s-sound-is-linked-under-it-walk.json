{
  "out": "/tmp/photonz-playtest/a-clip-s-sound-is-linked-under-it-walk",
  "setup": {
    "timelineOpen": true,
    "forget": [
      "all"
    ]
  },
  "steps": [
    {
      "do": "action",
      "action": "openSampleRecording"
    },
    {
      "do": "wait",
      "seconds": 2.0
    },
    {
      "do": "action",
      "action": "videoPause"
    },
    {
      "do": "wait",
      "seconds": 1.0
    },
    {
      "do": "tool",
      "tool": "select"
    },
    {
      "do": "wait",
      "seconds": 0.6
    },
    {
      "do": "describe",
      "stage": "1-opened",
      "note": "At defaults: the recording on V1, its own sound as the bottom half of the clip, joined to it by a staple and a link mark, both ringed as one pick"
    },
    {
      "do": "panel",
      "stage": "1-opened"
    },
    {
      "do": "snapshot",
      "name": "1-opened"
    },
    {
      "do": "expectClip",
      "clip": "Tutorial Sample",
      "track": "V1",
      "startsAt": 0,
      "endsAt": 8
    },
    {
      "do": "windowDrag",
      "fromLane": "V1 sound",
      "from": 2.9,
      "to": 3.76,
      "steps": 10
    },
    {
      "do": "wait",
      "seconds": 0.6
    },
    {
      "do": "expectClip",
      "clip": "Tutorial Sample",
      "startsAt": 0.86,
      "within": 0.1,
      "endsAt": 8.86
    },
    {
      "do": "describe",
      "stage": "2-sound-dragged",
      "note": "The sound segment dragged along: the picture came with it, because they are linked"
    },
    {
      "do": "panel",
      "stage": "2-sound-dragged"
    },
    {
      "do": "snapshot",
      "name": "2-sound-dragged"
    },
    {
      "do": "shortcut",
      "key": "z",
      "modifiers": [
        "command"
      ],
      "menuItem": "Undo"
    },
    {
      "do": "wait",
      "seconds": 0.6
    },
    {
      "do": "expectClip",
      "clip": "Tutorial Sample",
      "startsAt": 0,
      "endsAt": 8
    },
    {
      "do": "windowDrag",
      "from": [
        1143.5,
        890
      ],
      "to": [
        1143.5,
        895.2
      ],
      "steps": 6
    },
    {
      "do": "wait",
      "seconds": 0.6
    },
    {
      "do": "expect",
      "field": "Volume reading",
      "reads": "-8.7 dB \u00b10.5"
    },
    {
      "do": "describe",
      "stage": "3-volume-down",
      "note": "The level line dragged down: the whole line drops, the clip plays quieter"
    },
    {
      "do": "panel",
      "stage": "3-volume-down"
    },
    {
      "do": "snapshot",
      "name": "3-volume-down"
    },
    {
      "do": "windowDrag",
      "from": [
        165.8,
        888
      ],
      "to": [
        300.9,
        888
      ],
      "steps": 8
    },
    {
      "do": "wait",
      "seconds": 0.6
    },
    {
      "do": "expect",
      "field": "Fade in",
      "reads": "0.7s"
    },
    {
      "do": "describe",
      "stage": "4-faded-in",
      "note": "The handle at the segment's top left corner dragged right: the sound fades in"
    },
    {
      "do": "panel",
      "stage": "4-faded-in"
    },
    {
      "do": "snapshot",
      "name": "4-faded-in"
    },
    {
      "do": "rightClick",
      "on": "Tutorial Sample sound clip",
      "choose": "Detach Audio"
    },
    {
      "do": "wait",
      "seconds": 0.8
    },
    {
      "do": "expectClip",
      "clip": "Tutorial Sample sound",
      "startsAt": 0
    },
    {
      "do": "describe",
      "stage": "5-detached",
      "note": "Right-click, Detach Audio: the sound leaves the clip for an Audio track of its own, named, no longer joined"
    },
    {
      "do": "panel",
      "stage": "5-detached"
    },
    {
      "do": "snapshot",
      "name": "5-detached"
    },
    {
      "do": "dragClip",
      "clip": "Tutorial Sample sound",
      "byMS": 860
    },
    {
      "do": "wait",
      "seconds": 0.6
    },
    {
      "do": "expectClip",
      "clip": "Tutorial Sample sound",
      "track": "Audio",
      "startsAt": 0.86,
      "within": 0.1
    },
    {
      "do": "expectClip",
      "clip": "Tutorial Sample",
      "track": "V1",
      "startsAt": 0,
      "endsAt": 8
    },
    {
      "do": "describe",
      "stage": "6-detached-moves-alone",
      "note": "Dragged again: now only the sound moves, the picture stays at the start"
    },
    {
      "do": "panel",
      "stage": "6-detached-moves-alone"
    },
    {
      "do": "snapshot",
      "name": "6-detached-moves-alone"
    }
  ]
}