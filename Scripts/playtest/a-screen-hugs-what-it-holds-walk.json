{
  "out": "/tmp/photonz-playtest/a-screen-hugs-what-it-holds",
  "setup": { "forget": ["all"] },
  "seed": "A screen set to a column can be told to hug what it holds. Draw a screen, make it a column, pick Hug for Width and Height, then drop a Button from the Library into it: the screen closes around the button. Drop a Card and it grows; delete the Card and it shrinks back; one undo brings it back.",
  "steps": [
    { "do": "blank", "canvasWidth": 1100, "canvasHeight": 800, "width": 1280, "height": 900 },
    { "do": "wait", "seconds": 1.2 },
    { "do": "tool", "tool": "frame" },
    { "do": "drag", "from": [200, 150], "to": [600, 450], "steps": 10 },
    { "do": "wait", "seconds": 0.6 },
    { "do": "tool", "tool": "select" },
    { "do": "action", "action": "showInspector" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "panel", "stage": "1-drawn" },
    { "do": "action", "action": "positionAndSize" },
    { "do": "focus", "field": "W" },
    { "do": "type", "text": "400" },
    { "do": "key", "key": "return" },
    { "do": "focus", "field": "H" },
    { "do": "type", "text": "300" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "press", "control": "Stack", "in": "Arrangement" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "press", "control": "Column", "in": "Direction" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "panel", "stage": "2-column" },
    { "do": "expect", "control": "Hug", "in": "Width", "present": true },
    { "do": "press", "control": "Hug", "in": "Width" },
    { "do": "press", "control": "Hug", "in": "Height" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "action", "action": "positionAndSize" },
    { "do": "expect", "field": "W", "reads": "400" },
    { "do": "expect", "field": "H", "reads": "300" },
    { "do": "snapshot", "name": "screen-hug-1-empty" },
    { "do": "action", "action": "showComponentShelf" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "dragTile", "tile": "Button", "to": [300, 250] },
    { "do": "wait", "seconds": 1.0 },
    { "do": "panel", "stage": "3-button" },
    { "do": "snapshot", "name": "screen-hug-2-button" },
    { "do": "render", "name": "screen-hug-2-button-doc" },
    { "do": "selectRow", "row": "Frame" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "action", "action": "positionAndSize" },
    { "do": "expect", "field": "W", "reads": "97" },
    { "do": "expect", "field": "H", "reads": "32" },
    { "do": "panel", "stage": "4-screen-after-button" },
    { "do": "dragTile", "tile": "Card", "to": [210, 160] },
    { "do": "wait", "seconds": 1.0 },
    { "do": "panel", "stage": "5-card" },
    { "do": "selectRow", "row": "Frame" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "action", "action": "positionAndSize" },
    { "do": "panel", "stage": "6-screen-after-card" },
    { "do": "expect", "field": "W", "reads": "260" },
    { "do": "expect", "field": "H", "reads": "215" },
    { "do": "snapshot", "name": "screen-hug-3-card" },
    { "do": "selectRow", "row": "Card" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "action", "action": "deleteLayer" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expect", "row": "Card", "present": false },
    { "do": "selectRow", "row": "Frame" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "action", "action": "positionAndSize" },
    { "do": "expect", "field": "W", "reads": "97" },
    { "do": "expect", "field": "H", "reads": "32" },
    { "do": "snapshot", "name": "screen-hug-4-card-gone" },
    { "do": "action", "action": "undo" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expect", "row": "Card", "present": true },
    { "do": "selectRow", "row": "Frame" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "action", "action": "positionAndSize" },
    { "do": "expect", "field": "W", "reads": "260" },
    { "do": "expect", "field": "H", "reads": "215" },
    { "do": "press", "control": "Fixed", "in": "Height" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "action", "action": "positionAndSize" },
    { "do": "focus", "field": "H" },
