  {
   "do": "press",
   "control": "Videos",
   "longestUnderMS": 16
  },
  {
   "do": "expectBuilds",
   "view": "historyTile",
   "atMost": 24
  },
  {
   "do": "wait",
   "seconds": 1
  },
  {
   "do": "press",
   "control": "All",
   "longestUnderMS": 16
  },
  {
   "do": "expectBuilds",
   "view": "historyTile",
   "atMost": 24
  },
  {
   "do": "wait",
   "seconds": 1
  },
  {
   "do": "describe",
   "stage": "first-key",
   "note": "The first key the strip is handed after the clicks on the bar costs one pass of about 25ms whatever the key is (measured 2026-10-02 with up, which the strip ignores and which rebuilt no view): AppKit checks the whole menu bar for a shortcut first and revalidates it, the Apple menu's recent items included. That is the menu bar, not the strip, so up goes first here and is not judged; every right after it is held to one frame."
  },
  {
   "do": "appKey",
   "key": "up"
  },
