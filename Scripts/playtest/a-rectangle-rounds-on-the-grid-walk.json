{
  "out": "/tmp/photonz-playtest/a-rectangle-rounds-on-the-grid",
  "setup": { "forget": ["all"] },
  "steps": [
    { "do": "blank", "canvasWidth": 900, "canvasHeight": 600, "width": 1280, "height": 900 },
    { "do": "wait", "seconds": 1 },
    { "do": "key", "key": "r" },
    { "do": "drag", "from": [320, 260], "to": [600, 460] },
    { "do": "key", "key": "v" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "action", "action": "selectCanvas" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "press", "control": "Show grid" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "click", "at": [460, 360] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expectPicked", "layers": ["Rectangle"] },
    { "do": "drag", "from": [332, 272], "to": [370, 310], "steps": 14, "readout": "Radius 64", "hold": "1-mid-pull" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expect", "field": "Corner Radius", "reads": "64" },
    { "do": "describe", "stage": "1-grid", "note": "with the grid on, a pull that asked for 50 landed on 64, the step a drawn shape's knob lands on for the same pull; the pill read Radius 64 while the button was down" },
    { "do": "snapshot", "name": "1-on-the-grid" },
    { "do": "drag", "from": [384, 324], "to": [371, 311], "steps": 8, "modifiers": ["command"], "readout": "Radius 51", "hold": "2-mid-free-pull" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expect", "field": "Corner Radius", "reads": "51" },
    { "do": "describe", "stage": "2-command-frees", "note": "holding Command freed the pull from the grid: the same size of pull landed on 51" },
    { "do": "snapshot", "name": "2-off-the-grid" },
    { "do": "drag", "from": [371, 311], "to": [348, 288], "steps": 10, "readout": "Radius 32" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expect", "field": "Corner Radius", "reads": "32" },
    { "do": "describe", "stage": "3-back-on-the-grid", "note": "with Command let go the next pull is back on the grid: asking for 28 lands on 32" },
    { "do": "snapshot", "name": "3-back-on-the-grid" },
    { "do": "action", "action": "undo" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expect", "field": "Corner Radius", "reads": "51" }
  ]
}
