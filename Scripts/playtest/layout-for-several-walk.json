    { "do": "action", "action": "group" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "0-the-group-itself", "note": "the group alone on the canvas, which is placed by nothing: Layout must still hold its Contents rows for what it holds" },
    { "do": "snapshot", "name": "layout-several-0-the-group-itself" },
