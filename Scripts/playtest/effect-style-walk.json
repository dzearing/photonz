{
  "out": "/tmp/photonz-playtest/effect-style",
  "seed": "An effect saved under a name. One card gets a shadow, the shadow is tuned, and the Style row at the top of that shadow's settings saves it as Card lift. A second card that has NO shadow at all takes the same effect from the plus on the Effects header, wearing the name. Then the style itself is edited once from the Library, and both cards follow: that is the whole point of the feature, and one undo has to put it back.",
  "setup": {
    "forget": ["shapes", "panel", "color", "tools", "text"]
  },
  "steps": [
    { "do": "blank", "canvasWidth": 900, "canvasHeight": 600, "width": 1320, "height": 1000 },
    { "do": "wait", "seconds": 1 },

    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [160, 140], "to": [380, 280] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [160, 360], "to": [380, 500] },
    { "do": "wait", "seconds": 0.6 },

    { "do": "tool", "tool": "select" },
    { "do": "click", "at": [270, 210] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "press", "control": "Position & Size section" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "1-two-cards", "note": "two plain cards. Each arrives with a Border in its Effects list, which the cross takes off, leaving the list empty." },
    { "do": "panel", "stage": "1-two-cards" },
    { "do": "snapshot", "name": "1-two-cards" },

    { "do": "press", "control": "Remove", "in": "Border" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "panelMenu", "menu": "Add Effect", "choose": "Shadow" },
    { "do": "wait", "seconds": 0.9 },
    { "do": "describe", "stage": "2-shadow-added", "note": "one shadow on the first card, and its settings now open with a Style row above the colour" },
    { "do": "panel", "stage": "2-shadow-added" },
    { "do": "snapshot", "name": "2-shadow-added" },

    { "do": "panelMenu", "menu": "Shadow Style", "shot": "3-style-menu" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "panelMenu", "menu": "Shadow Style", "choose": "Save as Style" },
    { "do": "wait", "seconds": 0.9 },
    { "do": "type", "text": "Card lift" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 1 },
    { "do": "expect", "menu": "Shadow Style", "reads": "Card lift" },
    { "do": "describe", "stage": "4-saved", "note": "asked for the name once, in the dock. The shadow's Style row now says Card lift, and the Library has opened on the Styles shelf with the new tile on it beside the saved colours." },
    { "do": "panel", "stage": "4-saved" },
    { "do": "snapshot", "name": "4-saved-and-on-the-shelf" },

    { "do": "click", "at": [270, 430] },
    { "do": "wait", "seconds": 0.8 },
    { "do": "press", "control": "Remove", "in": "Border" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "panelMenu", "menu": "Add Effect", "shot": "5-plus-menu-with-one-saved" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "panelMenu", "menu": "Add Effect", "choose": "Card lift" },
    { "do": "wait", "seconds": 1 },
    { "do": "expect", "menu": "Shadow Style", "reads": "Card lift" },
    { "do": "describe", "stage": "6-worn", "note": "THE ROUTE THAT MATTERS: the second card had no shadow at all, and the plus gave it the saved one wearing the name. One press, no tuning." },
    { "do": "panel", "stage": "6-worn" },
    { "do": "snapshot", "name": "6-worn-by-the-other" },
    { "do": "render", "name": "6-canvas" },

    { "do": "click", "at": [700, 560] },
    { "do": "wait", "seconds": 0.8 },
    { "do": "press", "control": "Card lift" },
    { "do": "wait", "seconds": 1 },
    { "do": "describe", "stage": "7-the-style-itself", "note": "the style's own section: a picture of the effect, its name, its colour, kind, softness, distance, size and opacity, and how much of the document leans on it" },
    { "do": "panel", "stage": "7-the-style-itself" },
    { "do": "snapshot", "name": "7-the-style-itself" },

    { "do": "press", "control": "Slider", "in": "Softness", "across": 0.75 },
    { "do": "wait", "seconds": 1 },
    { "do": "describe", "stage": "8-edited-once", "note": "THE TEST: one pull on the style's Softness, and BOTH cards' shadows follow in the same step" },
    { "do": "panel", "stage": "8-edited-once" },
    { "do": "snapshot", "name": "8-both-followed" },
    { "do": "render", "name": "8-canvas" },

    { "do": "action", "action": "undo" },
    { "do": "wait", "seconds": 1 },
    { "do": "describe", "stage": "9-undone", "note": "ONE undo takes the whole thing back. Undo is asked for as a menu action rather than as command Z, because a synthesized chord does not reach the Edit menu of an app that is not in front (see undo-shortcut-walk): the style is what it was and so are both shadows" },
    { "do": "snapshot", "name": "9-one-undo" },
    { "do": "render", "name": "9-canvas" },

    { "do": "click", "at": [270, 430] },
    { "do": "wait", "seconds": 0.8 },
    { "do": "panelMenu", "menu": "Add Effect", "choose": "Glow" },
    { "do": "wait", "seconds": 0.9 },
    { "do": "panelMenu", "menu": "Glow Style", "choose": "Save as Style" },
    { "do": "wait", "seconds": 0.9 },
    { "do": "type", "text": "Focus ring" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 1.2 },
    { "do": "describe", "stage": "10-two-kinds", "note": "a second kind on the same shelf. The two tiles have to be tellable apart at a glance: a lift and a halo, not two grey squares." },
    { "do": "panel", "stage": "10-two-kinds" },
    { "do": "snapshot", "name": "10-two-kinds-on-the-shelf" },
    { "do": "render", "name": "10-canvas" }
  ]
}
