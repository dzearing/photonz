{
  "out": "/tmp/photonz-playtest/one-corner-radius",
  "steps": [
    { "do": "blank", "canvasWidth": 1100, "canvasHeight": 700, "width": 1400, "height": 1080 },
    { "do": "wait", "seconds": 1 },
    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [180, 160], "to": [520, 400], "steps": 8 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "action", "action": "dragShapeCornersSquare" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "1-one-box-square",
      "note": "one rectangle picked, square: the panel should carry exactly ONE Corner Radius row and it should read 0" },
    { "do": "snapshot", "name": "corner-1-one-row" },
    { "do": "action", "action": "dragShapeCorners" },
    { "do": "wait", "seconds": 0.7 },
    { "do": "describe", "stage": "2-rounded",
      "note": "one pull rounds it: the outline curves round the corners rather than being chopped off at them" },
    { "do": "render", "name": "one-box-rounded" },
    { "do": "snapshot", "name": "corner-2-rounded" },
    { "do": "action", "action": "undo" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "3-one-undo",
      "note": "ONE undo squares it again" },
    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [640, 160], "to": [980, 400], "steps": 8 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "drag", "from": [140, 120], "to": [1030, 450], "steps": 10 },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "4-two-boxes-picked",
      "note": "both boxes picked: still ONE Corner Radius row, now speaking for two layers" },
    { "do": "snapshot", "name": "corner-3-two-boxes" },
    { "do": "action", "action": "dragShapeCorners" },
    { "do": "wait", "seconds": 0.7 },
    { "do": "describe", "stage": "5-both-rounded",
      "note": "one pull rounds both boxes, in one step" },
    { "do": "render", "name": "two-boxes-rounded" },
    { "do": "snapshot", "name": "corner-4-both-rounded" },
    { "do": "action", "action": "undo" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "6-one-undo-both",
      "note": "ONE undo takes both roundings away" }
  ]
}
