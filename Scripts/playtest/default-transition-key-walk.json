      "choose": "Set as Default Transition"
    },
    {
      "do": "wait",
      "seconds": 0.6
    },
    {
      "do": "expect",
      "control": "Default transition Push",
      "present": true
    },
    {
      "do": "expect",
      "control": "Default transition Cross dissolve",
      "present": false
    },
    {
      "do": "describe",
      "stage": "5-push-is-the-default",
      "note": "THE SECOND TEST: right click on Push, Set as Default Transition. Command T moved to the Push tile, and the canvas says Command T now puts Push on a cut"
    },
    {
      "do": "snapshot",
      "name": "5-push-is-the-default"
    },
    {
      "do": "key",
      "key": "escape"
    },
    {
      "do": "wait",
      "seconds": 0.4
    },
    {
      "do": "key",
      "key": "t",
      "modifiers": [
        "command"
      ]
    },
    {
      "do": "wait",
      "seconds": 0.8
    },
    {
      "do": "expect",
      "menu": "Type",
      "reads": "Push"
    },
    {
      "do": "describe",
      "stage": "6-command-t-pushes",
      "note": "the same key on the same cut now puts a push on it"
    },
    {
      "do": "snapshot",
      "name": "6-command-t-push"
    },
    {
      "do": "rightClick",
      "on": "Tutorial Sample join 1",
      "shot": "7-the-cut-menu"
    },
    {
      "do": "describe",
      "stage": "7-the-cut-menu",
      "note": "the right click on the cut offers Apply Default Transition with Command T printed beside it"
    }
  ]
