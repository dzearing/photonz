{
  "out": "/tmp/photonz-playtest/command-s-saves-a-video-project-walk",
  "seed": "Command S on a video saves the project, at Next defaults with no flag touched (the card answered 2026-09-25). A plain trim of one recording: Q trims its first two seconds, closing asks with Save and Export, and Command S writes a .photonz project while the recording on disk stays byte for byte what it was; the project opens again as saved. Then a cut, multi-clip edit: the recording cut in two with b-roll on the end of V1, Command S writes a project, one more cut and Command S saves it in place, and the reopened project is the one last saved.",
  "setup": { "forget": ["all"], "scratch": ["sample:recording as b-roll.mp4"] },
  "steps": [
    { "do": "action", "action": "openSampleRecording" },
    { "do": "wait", "seconds": 2.0 },
    { "do": "action", "action": "videoPause" },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "expectEdited", "edited": false },
    { "do": "expectClip", "clip": "Tutorial Sample", "startsAt": 0.0, "endsAt": 8.0, "count": 1 },
    { "do": "describe", "stage": "1-opened", "note": "the eight second sample recording at Next defaults, untouched, with nothing to save" },
    { "do": "snapshot", "name": "1-opened" },

    { "do": "action", "action": "videoSeekStart" },
    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "key", "key": "q" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectClip", "clip": "Tutorial Sample", "startsAt": 0.0, "endsAt": 6.0, "count": 1 },
    { "do": "expectEdited", "edited": true },
    { "do": "action", "action": "askToClose" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "2-closing-asks", "note": "A PLAIN TRIM: Q took the first two seconds off. Closing now asks the ordinary Mac question, Save, with Export beside it so a trim to send is still one button away" },
    { "do": "snapshot", "name": "2-closing-asks" },
    { "do": "action", "action": "answerCloseExport" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "describe", "stage": "2b-export-from-the-sheet", "note": "Export in that question keeps the window open with the Export sheet on it: trim and send is two steps from here" },
    { "do": "action", "action": "closeSheets" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expectEdited", "edited": true },

    { "do": "action", "action": "save" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expectEdited", "edited": false },
    { "do": "describe", "stage": "3-trim-saved", "note": "THE TEST: Command S on the trimmed recording wrote project.photonz where the save box pointed, the recording on disk is byte for byte what it was, and the window takes the project's name with nothing left unsaved" },
    { "do": "snapshot", "name": "3-trim-saved-as-a-project" },
    { "do": "action", "action": "closeDocument" },
    { "do": "open", "file": "/tmp/photonz-playtest/command-s-saves-a-video-project-walk/project.photonz" },
    { "do": "wait", "seconds": 1.5 },
    { "do": "action", "action": "expectReopenedAsSaved" },
    { "do": "expectClip", "clip": "Tutorial Sample", "startsAt": 0.0, "endsAt": 6.0, "count": 1 },
    { "do": "expectEdited", "edited": false },
    { "do": "describe", "stage": "4-trim-reopened", "note": "the project opened from disk is the six second trim that was saved" },
    { "do": "action", "action": "closeDocument" },

    { "do": "action", "action": "openSampleRecording" },
    { "do": "wait", "seconds": 2.0 },
    { "do": "action", "action": "videoPause" },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "expectClip", "clip": "Tutorial Sample", "startsAt": 0.0, "endsAt": 8.0, "count": 1 },
    { "do": "action", "action": "videoSeekMiddle" },
    { "do": "key", "key": "k", "modifiers": ["command"] },
    { "do": "wait", "seconds": 0.4 },
    { "do": "expectClip", "clip": "Tutorial Sample", "pieces": 2 },
    { "do": "dropOnTimeline", "file": "scratch/b-roll.mp4", "track": "V1", "seconds": 7.8 },
    { "do": "wait", "seconds": 1.0 },
    { "do": "expectClip", "clip": "b-roll", "track": "V1", "startsAt": 7.8, "within": 0.1, "count": 1 },
    { "do": "expectEdited", "edited": true },
    { "do": "describe", "stage": "5-multi-clip", "note": "A BIGGER EDIT: the recording cut in two with Command K and the b-roll let go on the end of V1" },
    { "do": "snapshot", "name": "5-multi-clip-edit" },

    { "do": "action", "action": "save" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expectEdited", "edited": false },
    { "do": "describe", "stage": "6-edit-saved", "note": "Command S wrote the same kind of project: the edit, and where the recording and the b-roll are. Neither file was copied or changed" },
    { "do": "snapshot", "name": "6-edit-saved-as-a-project" },

    { "do": "action", "action": "videoSeekStart" },
    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "selectRow", "row": "Tutorial Sample" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "key", "key": "k", "modifiers": ["command"] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectEdited", "edited": true },
    { "do": "action", "action": "save" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expectEdited", "edited": false },
    { "do": "describe", "stage": "7-saved-in-place", "note": "one more cut and Command S again: now it is a project, it saves in place with no save box" },
    { "do": "action", "action": "closeDocument" },
    { "do": "open", "file": "/tmp/photonz-playtest/command-s-saves-a-video-project-walk/project.photonz" },
    { "do": "wait", "seconds": 1.5 },
    { "do": "action", "action": "expectReopenedAsSaved" },
    { "do": "expectClip", "clip": "Tutorial Sample", "pieces": 3 },
    { "do": "expectClip", "clip": "b-roll", "track": "V1", "startsAt": 7.8, "within": 0.1, "count": 1 },
    { "do": "expectEdited", "edited": false },
    { "do": "describe", "stage": "8-edit-reopened", "note": "the project opened from disk is the edit as last saved: three pieces of the recording and the b-roll after them" },
    { "do": "snapshot", "name": "8-edit-reopened" }
  ]
}
