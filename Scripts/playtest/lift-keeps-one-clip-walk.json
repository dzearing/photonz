{
  "out": "/tmp/photonz-playtest/lift-keeps-one-clip-walk",
  "seed": "The talk sample at Next defaults. I at a quarter, O at the middle, then the semicolon (Lift): the stretch goes and the gap stays, and both halves are still called Sample Talk, the way Command K and Extract leave them; nothing is called Sample Talk copy. One Command Z puts the clip back whole. Then with its sound detached onto its own clip, the same lift leaves two halves of the picture called Sample Talk and two halves of the sound called Sample Talk sound.",
  "setup": {
    "timelineOpen": true,
    "forget": ["all"]
  },
  "steps": [
    { "do": "action", "action": "openSampleTalk" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "action", "action": "videoPause" },
    { "do": "tool", "tool": "select" },
    { "do": "expectClip", "clip": "Sample Talk", "count": 1, "pieces": 1 },

    { "do": "action", "action": "videoSeekQuarter" },
    { "do": "key", "key": "i" },
    { "do": "action", "action": "videoSeekMiddle" },
    { "do": "key", "key": "o" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "snapshot", "name": "0-marked" },

    { "do": "key", "key": ";" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectTimeline", "hasIn": false, "hasOut": false },
    { "do": "expectClip", "clip": "Sample Talk", "count": 2 },
    { "do": "expectClip", "clip": "Sample Talk", "track": "V1", "startsAt": 0, "endsAt": 4.31, "within": 0.1 },
    { "do": "expectClip", "clip": "Sample Talk", "track": "V1", "startsAt": 8.63, "endsAt": 17.25, "within": 0.1 },
    { "do": "expectClip", "clip": "Sample Talk copy", "count": 0 },
    { "do": "describe", "stage": "1-lifted", "note": "the semicolon, Premiere's Lift: the marked stretch is gone and its gap stays on V1, with the clip's two halves either side of it, both called Sample Talk" },
    { "do": "snapshot", "name": "1-lifted-both-halves-sample-talk" },

    { "do": "shortcut", "key": "z", "modifiers": ["command"], "menuItem": "Undo" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectClip", "clip": "Sample Talk", "count": 1, "pieces": 1, "startsAt": 0, "endsAt": 17.25, "within": 0.1 },
    { "do": "describe", "stage": "2-undone", "note": "one Command Z puts the clip back whole, in one piece, with the marks" },

    { "do": "selectRow", "row": "Sample Talk" },
    { "do": "action", "action": "soundDetach" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectClip", "clip": "Sample Talk sound", "count": 1 },
    { "do": "key", "key": ";" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectClip", "clip": "Sample Talk", "count": 2 },
    { "do": "expectClip", "clip": "Sample Talk sound", "count": 2 },
    { "do": "expectClip", "clip": "Sample Talk sound", "startsAt": 8.63, "endsAt": 17.25, "within": 0.1 },
    { "do": "expectClip", "clip": "Sample Talk copy", "count": 0 },
    { "do": "expectClip", "clip": "Sample Talk sound copy", "count": 0 },
    { "do": "describe", "stage": "3-lifted-two-tracks", "note": "with the sound detached onto its own clip, the same lift cuts the picture on V1 and the sound under it, and each keeps its name: Sample Talk twice, Sample Talk sound twice" },
    { "do": "snapshot", "name": "3-lifted-picture-and-sound" }
  ]
}
