    { "do": "wait", "seconds": 0.5 },

    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [300, 300], "to": [600, 500] },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.5 },
