    { "do": "wait", "seconds": 1.5 },
    { "do": "snapshot", "name": "4-history-empty", "window": "Capture History" },
    { "do": "shortcut", "key": "h", "modifiers": ["command", "shift"], "menuItem": "Show History", "checked": true },
