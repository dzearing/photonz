{
  "out": "/tmp/photonz-playtest/width-reads-back",
  "seed": "A button component is dropped on a blank canvas and told it may never be narrower than 160 points. Then a width of 50 is typed into W. The flow refuses it and keeps 160, so the walk reads W back afterwards: the number in the box has to be the number the button actually took, and the arrow key pressed straight after has to step from that same number.",
  "setup": { "forget": ["panel"] },
  "steps": [
    { "do": "blank", "canvasWidth": 1440, "canvasHeight": 1024, "width": 1200, "height": 900 },
    { "do": "action", "action": "showComponentShelf" },
    { "do": "wait", "seconds": 1.2 },
    { "do": "dragTile", "tile": "Button", "to": [400, 300] },
    { "do": "wait", "seconds": 1.0 },
    { "do": "click", "at": [400, 300] },
    { "do": "wait", "seconds": 0.8 },
    { "do": "panel", "stage": "0-button-picked" },
    { "do": "describe", "stage": "0-button-picked", "note": "one button picked, as wide as its words" },

    { "do": "scrollPanel", "by": -200, "row": "Layout section" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "press", "control": "Limits", "in": "Width" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "panel", "stage": "1-limits-open" },
    { "do": "focus", "field": "Smallest width" },
    { "do": "type", "text": "160" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "2-smallest-set", "note": "the button may never go below 160 now" },

    { "do": "scrollPanel", "by": 400, "row": "Layout section" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "focus", "field": "W" },
    { "do": "type", "text": "50" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "3-typed-50", "note": "THE CLAIM: 50 was refused and the button kept 160, so W must read 160 and not 50" },
    { "do": "snapshot", "name": "width-reads-back-1-refused" },

    { "do": "focus", "field": "W" },
    { "do": "key", "key": "down" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "focus", "field": "W" },
    { "do": "describe", "stage": "4-stepped-down", "note": "THE SECOND CLAIM: the arrow steps from 160, so it has nowhere to go and holds at 160 rather than counting on down from 50" },
    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.4 },

    { "do": "focus", "field": "W" },
    { "do": "type", "text": "240" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "5-typed-240", "note": "THE THIRD CLAIM: a width the button accepts changes nothing about how the field behaves, so W reads exactly 240" },
    { "do": "snapshot", "name": "width-reads-back-2-accepted" },
    { "do": "focus", "field": "W" },
    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.4 }
  ]
}
