{
  "out": "/tmp/photonz-playtest/gap-between-drawn-shapes",
  "seed": "Gap mode and alignment checking both read the picture and nothing else, so the space between two rectangles you drew a moment ago could not be measured and a guide drawn across them counted no items at all. The app knows exactly where those boxes are. Stage one draws two rectangles on a blank canvas, measures the space between them, and checks their top edges. Stage two does the same two things to a screenshot, to show that reading the picture is untouched.",
  "setup": { "forget": ["shapes", "measure", "panel"] },
  "steps": [
    { "do": "blank", "canvasWidth": 900, "canvasHeight": 600, "width": 1400, "height": 1000 },
    { "do": "wait", "seconds": 0.6 },

    { "do": "key", "key": "r" },
    { "do": "waitFor", "condition": "tool", "value": "rectangle" },
    { "do": "drag", "from": [200, 240], "to": [380, 420] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "key", "key": "escape" },
    { "do": "key", "key": "r" },
    { "do": "waitFor", "condition": "tool", "value": "rectangle" },
    { "do": "drag", "from": [460, 240], "to": [640, 420] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "describe", "stage": "1-two-drawn-shapes", "note": "THE SETUP: two 180 x 180 rectangles on a blank canvas, 80 px apart, tops both at y = 240. There is no picture anywhere in this document" },

    { "do": "key", "key": "i" },
    { "do": "waitFor", "condition": "tool", "value": "measure" },
    { "do": "measureMode", "mode": "gap" },
    { "do": "move", "at": [420, 330] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "2-hover-the-gap", "note": "THE FIRST CLAIM: the pointer is in the space between the two drawn rectangles and the 80 px gap is lit up under it" },
    { "do": "snapshot", "name": "gap-between-drawn-shapes" },
    { "do": "click", "at": [420, 330] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectMeasures", "count": 1 },
    { "do": "expect", "row": "Gap", "present": true },
    { "do": "describe", "stage": "3-gap-landed", "note": "THE SECOND CLAIM: the click left a Gap measurement of 80 px" },
    { "do": "clearClipboard" },
    { "do": "action", "action": "copySpecList" },
    { "do": "readClipboard", "stage": "4-drawn-gap-spec" },
    { "do": "snapshot", "name": "gap-measured-between-drawn-shapes" },

    { "do": "measureMode", "mode": "alignment" },
    { "do": "drag", "from": [150, 242], "to": [700, 242] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectMeasures", "count": 2 },
    { "do": "expect", "row": "Top edges, 2 items", "present": true },
    { "do": "describe", "stage": "5-alignment-over-drawn", "note": "THE THIRD CLAIM: a guide drawn across the tops of the two rectangles counts them, Top edges, 2 items, rather than finding nothing" },
    { "do": "snapshot", "name": "alignment-across-drawn-shapes" },

    { "do": "action", "action": "closeDocument" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "open", "file": "../../Tests/PhotonzRenderTests/Fixtures/settings-pane-2x.png", "width": 1400, "height": 1000 },
    { "do": "wait", "seconds": 1 },
    { "do": "key", "key": "i" },
    { "do": "waitFor", "condition": "tool", "value": "measure" },
    { "do": "waitFor", "condition": "edgeMap", "timeout": 30 },
    { "do": "measureMode", "mode": "gap" },
    { "do": "move", "at": [720, 432] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "click", "at": [720, 432] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectMeasures", "count": 1 },
    { "do": "expect", "row": "Gap", "present": true },
    { "do": "describe", "stage": "6-gap-in-the-picture", "note": "THE FOURTH CLAIM: nothing about reading a screenshot changed, so the space between the two cards still measures as it did" },
    { "do": "clearClipboard" },
    { "do": "action", "action": "copySpecList" },
    { "do": "readClipboard", "stage": "7-picture-gap-spec" },
    { "do": "snapshot", "name": "gap-still-reads-the-picture" },

    { "do": "key", "key": "r" },
    { "do": "waitFor", "condition": "tool", "value": "rectangle" },
    { "do": "drag", "from": [500, 700], "to": [560, 880] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "key", "key": "escape" },
    { "do": "key", "key": "i" },
    { "do": "waitFor", "condition": "tool", "value": "measure" },
    { "do": "measureMode", "mode": "gap" },
    { "do": "move", "at": [460, 786] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "click", "at": [460, 786] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectMeasures", "count": 2 },
    { "do": "clearClipboard" },
    { "do": "action", "action": "copySpecList" },
    { "do": "readClipboard", "stage": "8-mixed-gap-spec" },
    { "do": "describe", "stage": "8-drawn-against-the-picture", "note": "THE FIFTH CLAIM: the space between a box you drew and the Save Changes button in the screenshot measures across both, since the nearer edge wins whichever it came from" },
    { "do": "snapshot", "name": "gap-from-a-drawn-box-to-the-picture" },

    { "do": "measureMode", "mode": "alignment" },
    { "do": "drag", "from": [96, 170], "to": [96, 700] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectMeasures", "count": 3 },
    { "do": "expect", "row": "Left edges, 6 items", "present": true },
    { "do": "describe", "stage": "9-alignment-in-the-picture", "note": "THE SIXTH CLAIM: the guide down the six labels in the screenshot still counts six, so nothing the drawn boxes added took anything away from reading the picture" },
    { "do": "snapshot", "name": "alignment-still-reads-the-picture" }
  ]
}
