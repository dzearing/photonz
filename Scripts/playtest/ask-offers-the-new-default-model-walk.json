{
  "out": "/tmp/photonz-playtest/ask-offers-the-new-default-model-walk",
  "clock": 120,
  "setup": {
    "forget": [
      "all"
    ],
    "askModelsOnly": [
      "qwen3.6-35b-a3b"
    ]
  },
  "steps": [
    {
      "do": "open",
      "file": "../../Tests/PhotonzRenderTests/Fixtures/settings-pane-2x.png",
      "width": 1280,
      "height": 840
    },
    {
      "do": "wait",
      "seconds": 1
    },
    {
      "do": "shortcut",
      "key": ",",
      "modifiers": [
        "command"
      ],
      "menuItem": "Settings…"
    },
    {
      "do": "wait",
      "seconds": 1.5
    },
    {
      "do": "reveal",
      "control": "Ask Model Qwen3.6 35B"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "expect",
      "control": "Ask Model Qwen3.6 35B",
      "present": true
    },
    {
      "do": "expect",
      "control": "Ask Use Qwen3.6 35B",
      "present": false
    },
    {
      "do": "expect",
      "control": "Ask Delete Qwen3.6 35B",
      "present": true
    },
    {
      "do": "expect",
      "control": "Ask Download Qwen3.8 27B",
      "present": true
    },
    {
      "do": "describe",
      "stage": "1-older-model",
      "note": "Settings > Ask on a Mac that has only Qwen3.6 35B: it is the one in use, and Qwen3.8 27B is a row with its Download beside it"
    },
    {
      "do": "snapshot",
      "name": "1-older-model",
      "window": "Settings"
    }
  ]
}
