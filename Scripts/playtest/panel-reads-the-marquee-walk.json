{
  "out": "/tmp/photonz-playtest/panel-reads-the-marquee",
  "setup": { "forget": ["grid", "tools", "shapes", "panel"] },
  "steps": [
    { "do": "blank", "canvasWidth": 900, "canvasHeight": 700, "width": 1280, "height": 900 },
    { "do": "wait", "seconds": 1 },

    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [120, 100], "to": [280, 160], "steps": 8 },
    { "do": "wait", "seconds": 0.4 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "panel", "stage": "1-layer" },
    { "do": "expect", "field": "X", "reads": "120" },
    { "do": "expect", "field": "Y", "reads": "100" },
    { "do": "expect", "field": "W", "reads": "160" },
    { "do": "expect", "field": "H", "reads": "60" },
    { "do": "describe", "stage": "1-layer", "note": "arrow tool, a rectangle picked: Position & Size must read the rectangle, 120,100 160x60" },
    { "do": "snapshot", "name": "1-layer" },

    { "do": "tool", "tool": "rectSelect" },
    { "do": "drag", "from": [400, 300], "to": [600, 400], "steps": 10 },
    { "do": "wait", "seconds": 0.5 },
    { "do": "panel", "stage": "2-marquee" },
    { "do": "expect", "field": "X", "reads": "400" },
    { "do": "expect", "field": "Y", "reads": "300" },
    { "do": "expect", "field": "W", "reads": "200" },
    { "do": "expect", "field": "H", "reads": "100" },
    { "do": "describe", "stage": "2-marquee", "note": "the marquee tool has the arrow keys, so the panel must read the SELECTION box 400,300 200x100 and not the rectangle that is still picked" },
    { "do": "snapshot", "name": "2-marquee" },

    { "do": "focus", "field": "W" },
    { "do": "type", "text": "300" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expect", "field": "W", "reads": "300" },
    { "do": "describe", "stage": "3-typed-width", "note": "a typed width resized the marquee itself: region must read 400,300 300x100 and the rectangle must still be 120,100 160x60" },
    { "do": "snapshot", "name": "3-typed-width" },

    { "do": "focus", "field": "X" },
    { "do": "type", "text": "500" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expect", "field": "X", "reads": "500" },
    { "do": "describe", "stage": "4-typed-x", "note": "a typed X moved the marquee: region must read 500,300 300x100" },

    { "do": "key", "key": "right" },
    { "do": "key", "key": "right" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "expect", "field": "X", "reads": "502" },
    { "do": "describe", "stage": "5-keys-agree", "note": "Return handed the keyboard back to the picture, so two right arrows walked the marquee and the panel followed it: region 502,300 300x100" },
    { "do": "snapshot", "name": "5-keys-agree" },

    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "panel", "stage": "6-back-to-layer" },
    { "do": "expect", "field": "X", "reads": "120" },
    { "do": "expect", "field": "W", "reads": "160" },
    { "do": "describe", "stage": "6-back-to-layer", "note": "the arrow tool takes the numbers back: the panel must read the rectangle again, 120,100 160x60, with the marquee still up at 502,300" },
    { "do": "snapshot", "name": "6-back-to-layer" },

    { "do": "tool", "tool": "rectSelect" },
    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "panel", "stage": "7-no-selection" },
    { "do": "expect", "field": "X", "reads": "120" },
    { "do": "expect", "field": "W", "reads": "160" },
    { "do": "describe", "stage": "7-no-selection", "note": "Escape took the marquee away with the selection tool still in hand: with no selection the panel reads the rectangle exactly as it always did" },
    { "do": "snapshot", "name": "7-no-selection" },

    { "do": "tool", "tool": "select" },
    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "tool", "tool": "rectSelect" },
    { "do": "drag", "from": [200, 450], "to": [340, 520], "steps": 8 },
    { "do": "wait", "seconds": 0.5 },
    { "do": "panel", "stage": "8-marquee-alone" },
    { "do": "expect", "field": "X", "reads": "200" },
    { "do": "expect", "field": "H", "reads": "70" },
    { "do": "describe", "stage": "8-marquee-alone", "note": "no layer picked at all: the section still comes up for the marquee on its own, reading 200,450 140x70" },
    { "do": "snapshot", "name": "8-marquee-alone" }
  ]
}
