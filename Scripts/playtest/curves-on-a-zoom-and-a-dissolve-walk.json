{
  "out": "/tmp/photonz-playtest/curves-on-a-zoom-and-a-dissolve-walk",
  "seed": "Every transition tuned with the one Curve row, at Next defaults. A zoom reads Smooth, the curve zooms always eased on; Ease in out sine from its Curve row reshapes its way in and out; a curve drawn and saved as Slow start lands on it and the canvas follows it to within 2% at a quarter, a half and three quarters of each way; the way in and out set apart take a curve each. Then a cross dissolve between two clips reads Linear, takes the saved Slow start from the same list, and its incoming shot follows that curve within 2% on the canvas and in the export. One undo puts it back on Linear.",
  "setup": {
    "timelineOpen": true,
    "forget": ["all"],
    "scratch": ["sample:recording as b-roll.mp4"]
  },
  "steps": [
    { "do": "action", "action": "openSampleRecording" },
    { "do": "wait", "seconds": 2.0 },
    { "do": "action", "action": "videoPause" },
    { "do": "tool", "tool": "select" },

    { "do": "clickRuler", "seconds": 2.0 },
    { "do": "wait", "seconds": 0.3 },
    { "do": "action", "action": "zoomAddAtPlayhead" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expect", "menu": "Curve", "reads": "Smooth" },
    { "do": "panelMenu", "menu": "Ease In", "at": ["centre"], "choose": "1.5s" },
    { "do": "panelMenu", "menu": "Ease Out", "at": ["centre"], "choose": "1.0s" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "action", "action": "expectZoomFollowsCurve" },
    { "do": "panel", "stage": "0-zoom-smooth" },

    { "do": "panelMenu", "menu": "Curve", "at": ["centre"], "choose": "Ease in out sine" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "expect", "menu": "Curve", "reads": "Ease in out sine" },
    { "do": "action", "action": "expectZoomFollowsCurve" },

    { "do": "action", "action": "curveDrawOnZoom" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "expect", "menu": "Curve", "reads": "Slow start" },
    { "do": "action", "action": "expectZoomFollowsCurve" },
    { "do": "action", "action": "expectZoomScrubMatchesExport" },
    { "do": "describe", "stage": "1-zoom-on-a-drawn-curve", "note": "THE ZOOM TEST: a curve drawn and saved as Slow start. The Curve row reads Slow start, and at a quarter, a half and three quarters of the way in and the way out the canvas is as far in as the curve says, within 2%, and the canvas is the exported frame" },
    { "do": "clickRuler", "seconds": 2.75 },
    { "do": "wait", "seconds": 0.6 },
    { "do": "snapshot", "name": "1-zoom-half-way-in-on-slow-start" },

    { "do": "clickRuler", "seconds": 3.5 },
    { "do": "wait", "seconds": 0.3 },
    { "do": "panelMenu", "menu": "Curve", "at": ["centre"], "choose": "Set In and Out Apart" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "expect", "menu": "Curve In", "reads": "Slow start" },
    { "do": "expect", "menu": "Curve Out", "reads": "Slow start" },
    { "do": "panelMenu", "menu": "Curve In", "at": ["centre", "start", "end"], "choose": "Slow start" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "panelMenu", "menu": "Curve Out", "at": ["centre"], "choose": "Ease out" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "expect", "menu": "Curve Out", "reads": "Ease out" },
    { "do": "action", "action": "expectZoomFollowsCurve" },
    { "do": "describe", "stage": "2-apart", "note": "Set In and Out Apart turns the one Curve row into Curve In and Curve Out, each starting on Slow start; Ease out on the way out reshapes only the way out" },
    { "do": "panel", "stage": "2-zoom-curves-apart" },
    { "do": "snapshot", "name": "2-zoom-curves-apart" },

    { "do": "action", "action": "clipDragEndIn" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "dropOnTimeline", "file": "scratch/b-roll.mp4", "track": "V1", "seconds": 6.95 },
    { "do": "wait", "seconds": 1.0 },
    { "do": "action", "action": "clipDragStartIn" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expectClip", "clip": "b-roll", "track": "V1", "startsAt": 7.0, "count": 1 },
    { "do": "action", "action": "clipPickEditPoint" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "press", "control": "Add transition" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "press", "control": "Cross dissolve", "in": "At this cut" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expect", "menu": "Type", "reads": "Cross dissolve" },
    { "do": "expect", "menu": "Curve", "reads": "Linear" },
    { "do": "panelMenu", "menu": "Length", "at": ["centre"], "choose": "1.0s" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "panelMenu", "menu": "Curve", "at": ["centre"], "choose": "Slow start" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "expect", "menu": "Curve", "reads": "Slow start" },
    { "do": "action", "action": "expectDissolveFollowsCurve" },
    { "do": "describe", "stage": "3-dissolve-on-the-saved-curve", "note": "THE DISSOLVE TEST: a cross dissolve between the recording and b-roll reads Linear, and Slow start, saved on the zoom, is in its Curve list. Picked, the incoming shot is as far up as the curve says at a quarter, a half and three quarters, within 2%, on the canvas and in the frame the exporter draws" },
    { "do": "panel", "stage": "3-dissolve-curve" },

    { "do": "action", "action": "undo" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "action", "action": "clipPickEditPoint" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "expect", "menu": "Curve", "reads": "Linear" },
    { "do": "action", "action": "redo" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "action", "action": "clipPickEditPoint" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "expect", "menu": "Curve", "reads": "Slow start" },
    { "do": "panelMenu", "menu": "Curve", "at": ["centre"], "choose": "Forget \u201cSlow start\u201d" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "expect", "menu": "Curve", "reads": "Custom" },
    { "do": "describe", "stage": "4-one-undo", "note": "One Command Z puts the dissolve back on Linear and one Shift Command Z brings Slow start back. Forget Slow start takes it off the list; the dissolve keeps the curve, which now reads Custom" },

    { "do": "clickRuler", "seconds": 6.75 },
    { "do": "wait", "seconds": 0.8 },
    { "do": "snapshot", "name": "4-dissolve-a-quarter-through" },
    { "do": "clickRuler", "seconds": 7.0 },
    { "do": "wait", "seconds": 0.8 },
    { "do": "snapshot", "name": "5-dissolve-half-through" }
  ]
}
