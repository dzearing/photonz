    { "do": "expectClip", "clip": "Sample Music", "track": "Audio 2", "startsAt": 0.0, "endsAt": 14.0 },
    { "do": "expectClip", "clip": "Tutorial Sample", "track": "V1", "startsAt": 0.0, "endsAt": 1.0 },
    { "do": "expectTimelinePick", "clips": [], "rangeOn": [] },
    { "do": "describe", "stage": "5-delete-lifts-v1-alone", "note": "Delete with the range in hand: 0:01 to 0:05 of the recording is gone and the gap stays on V1; the music on Audio 2 still runs 0:00 to 0:14, untouched" },
    { "do": "snapshot", "name": "5-delete-lifts-v1-alone" },
