    { "do": "describe", "stage": "2-box-across-three-tracks", "note": "a box from V1 at 0:02 down to Audio 2 at 0:04 touches the first two pieces of the recording (through its picture and its sound) and the music: all three are picked, the last piece is not" },
    { "do": "snapshot", "name": "2-box-across-three-tracks" },
