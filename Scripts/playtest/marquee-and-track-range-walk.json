    { "do": "describe", "stage": "0-two-tracks", "note": "the recording on V1 cut at 0:03 and 0:06, and the sample music under it on its own track from 0:00" },
    { "do": "snapshot", "name": "0-two-tracks" },
    { "do": "dragTracks", "fromTrack": "V1", "from": 3.8, "to": 5.0, "hold": "1-drawing-a-box" },
