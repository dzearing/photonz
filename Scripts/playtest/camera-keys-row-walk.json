{
  "out": "/tmp/photonz-playtest/camera-keys-row-walk",
  "seed": "The camera's keys show on a thin Camera row at the top of the timeline (video-depth.html, Camera A: 'Keyed camera moves show on a thin row at the top of the timeline'), at Next defaults with no flag changed. On a recording, the frame is picked and Camera depth is keyed 0 at one second and 400 at three: a push in over two seconds. The row appears under the ruler with two diamonds; the frames at one, two and three seconds are photographed. A click on the recording lets go of the frame, and a click on the Camera row picks it again. The second diamond is clicked and dragged a second later, undone in one step, then deleted with the delete key, and deleting the last diamond takes the row away. A click on a diamond is a SwiftUI tap, which answers only in the app in front, so this walk takes the front, as key-lanes-walk does.",
  "setup": {
    "forget": [
      "all"
    ],
    "timelineOpen": true,
    "front": true
  },
  "steps": [
    { "do": "action", "action": "openSampleRecording" },
    { "do": "wait", "seconds": 2.0 },
    { "do": "action", "action": "videoPause" },
    { "do": "tool", "tool": "select" },
    { "do": "action", "action": "videoSeekStart" },
    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "action", "action": "selectCanvas" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expect", "control": "Camera row", "present": false },
    { "do": "press", "control": "Key", "in": "Camera depth" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "expect", "control": "Camera row", "present": true },
    { "do": "expect", "control": "Camera key 1", "present": true },
    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "press", "control": "Camera depth Value" },
    { "do": "key", "key": "a", "modifiers": ["command"] },
    { "do": "type", "text": "400" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expect", "field": "Camera depth Value", "reads": "400" },
    { "do": "expect", "control": "Camera key 2", "present": true },
    { "do": "describe", "stage": "1-pushed-in", "note": "THE FIRST TEST: Camera depth keyed 0 at one second and 400 at three. A thin Camera row sits under the ruler, over every track, with a diamond at each key joined by a faint line; the picture at three seconds is pushed in" },
    { "do": "panel", "stage": "1-pushed-in" },
    { "do": "snapshot", "name": "1-push-in-at-3s" },
    { "do": "action", "action": "videoStepBackOneSecond" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "2-halfway", "note": "at two seconds the camera is part of the way in" },
    { "do": "snapshot", "name": "2-push-in-at-2s" },
    { "do": "action", "action": "videoStepBackOneSecond" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "3-start", "note": "at one second the camera has not moved yet" },
    { "do": "snapshot", "name": "3-push-in-at-1s" },
    { "do": "click", "at": [620, 330] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expect", "control": "Camera section", "present": false },
    { "do": "press", "control": "Camera row" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "4-row-picks-the-frame", "note": "THE SECOND TEST: with the recording picked, a click on the Camera row's name picks the frame again and the panel shows the Camera section" },
    { "do": "expect", "control": "Camera section", "present": true },
    { "do": "snapshot", "name": "4-camera-row-picked" },
    { "do": "press", "control": "Camera key 2" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "expect", "field": "Camera depth Value", "reads": "400" },
    { "do": "action", "action": "cameraKeyPickedLater" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "expect", "field": "Camera depth Value", "reads": "400" },
    { "do": "describe", "stage": "5-dragged", "note": "THE THIRD TEST: the diamond at three seconds, clicked and dragged a second later: the push now runs from one second to four" },
    { "do": "snapshot", "name": "5-key-dragged-later" },
    { "do": "shortcut", "key": "z", "modifiers": ["command"], "menuItem": "Undo" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "action", "action": "videoStepBackOneSecond" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "expect", "field": "Camera depth Value", "reads": "400" },
    { "do": "press", "control": "Camera key 2" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "key", "key": "delete" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "6-deleted", "note": "THE FOURTH TEST: the picked diamond goes with the delete key, and the row keeps the one key left" },
    { "do": "expect", "control": "Camera key 2", "present": false },
    { "do": "expect", "control": "Camera key 1", "present": true },
    { "do": "snapshot", "name": "6-key-deleted" },
    { "do": "press", "control": "Camera key 1" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "key", "key": "delete" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "7-row-gone", "note": "deleting the last diamond takes the Camera row away, and the tracks close up under the ruler" },
    { "do": "expect", "control": "Camera row", "present": false },
    { "do": "snapshot", "name": "7-row-gone" }
  ]
}
