{
  "out": "/tmp/photonz-playtest/front-door-recent-documents",
  "setup": {
    "forget": [
      "recent"
    ]
  },
  "seed": "File > Open Recent lists the documents you opened and saved, at Next defaults with no switch changed. A picture is opened, saved as a project the way File > Save As does, and its window closed. File > Open Recent then lists project.photonz, and picking it reopens the project in a window of its own; Clear Menu empties the list. The New window no longer has a Recent section (the user's call on 2026-10-22): opening is File > Open and File > Open Recent.",
  "steps": [
    {
      "do": "appearance",
      "value": "light"
    },
    {
      "do": "open",
      "file": "fixtures/Hero banner.png"
    },
    {
      "do": "wait",
      "seconds": 0.6
    },
    {
      "do": "action",
      "action": "saveProjectAs"
    },
    {
      "do": "action",
      "action": "closeDocument"
    },
    {
      "do": "wait",
      "seconds": 0.4
    },
    {
      "do": "menus",
      "stage": "2-open-recent",
      "menu": "File",
      "choose": "File > Open Recent > project.photonz"
    },
    {
      "do": "wait",
      "seconds": 0.8
    },
    {
      "do": "expectWindows",
      "titled": "project.photonz",
      "count": 1
    },
    {
      "do": "describe",
      "stage": "2-reopened",
      "note": "The project saved a moment ago, reopened from File > Open Recent in a window of its own."
    },
    {
      "do": "menus",
      "stage": "3-open-recent-again",
      "menu": "File",
      "choose": "File > Open Recent > project.photonz"
    },
    {
      "do": "wait",
      "seconds": 0.6
    },
    {
      "do": "expectWindows",
      "titled": "project.photonz",
      "count": 1
    },
    {
      "do": "menus",
      "stage": "4-clear-menu",
      "menu": "File",
      "choose": "File > Open Recent > Clear Menu"
    },
    {
      "do": "wait",
      "seconds": 0.3
    },
    {
      "do": "menus",
      "stage": "5-cleared",
      "menu": "File"
    }
  ]
}
