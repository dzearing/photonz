    {
      "do": "wait",
      "seconds": 0.6
    },
    {
      "do": "expectReadout",
      "absent": true
    },
    {
      "do": "windowClick",
      "at": [
        1282,
        543
      ]
    },
    {
      "do": "wait",
      "seconds": 1
    },
    {
