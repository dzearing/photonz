      "width": 1420,
      "height": 980
    },
    {
      "do": "wait",
      "seconds": 1
    },
    {
      "do": "tool",
      "tool": "rectangle"
    },
    {
      "do": "drag",
      "from": [
        120,
        230
      ],
      "to": [
        260,
        370
      ],
      "steps": 8
    },
    {
