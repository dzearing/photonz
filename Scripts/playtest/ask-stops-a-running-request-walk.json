{
  "out": "/tmp/photonz-playtest/ask-stops-a-running-request-walk",
  "seed": "a-request-typed-while-ask-is-working-waits-its-t: Stop ends the request at work and leaves nothing of it; the one waiting behind it runs next; at Next defaults, no flag touched",
  "clock": 720,
  "setup": { "forget": ["all"] },
  "steps": [
    { "do": "blank", "canvasWidth": 1440, "canvasHeight": 1024, "width": 1280, "height": 840 },
    { "do": "wait", "seconds": 1 },
    { "do": "press", "control": "Ask" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "type", "text": "add a blue rectangle" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "press", "control": "Ask Send" },
    { "do": "waitFor", "condition": "askPhase", "value": "planning", "timeout": 30 },
    { "do": "press", "control": "Ask" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "type", "text": "add a red circle" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "press", "control": "Ask Send" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expect", "control": "Agent Working", "reads": "add a blue rectangle" },
    { "do": "snapshot", "name": "1-before-stop" },
    { "do": "press", "control": "Agent Stop" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expect", "control": "Agent Waiting 1", "present": false },
    { "do": "expect", "control": "Agent Working", "reads": "add a red circle" },
    { "do": "describe", "stage": "2-stopped", "note": "the rectangle stopped; the circle that waited is at work now" },
    { "do": "snapshot", "name": "2-stopped" },
    { "do": "waitFor", "condition": "askSettled", "timeout": 400 },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expect", "control": "Agent Change 1", "present": true },
    { "do": "expect", "control": "Agent Change 2", "present": false },
    { "do": "describe", "stage": "3-one-row", "note": "one row, the circle; nothing of the stopped rectangle in the document" },
    { "do": "snapshot", "name": "3-one-row" },
    { "do": "press", "control": "Ask" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "type", "text": "add a green square" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "press", "control": "Ask Send" },
    { "do": "waitFor", "condition": "askPhase", "value": "planning", "timeout": 30 },
    { "do": "press", "control": "Agent Stop" },
    { "do": "waitFor", "condition": "askSettled", "timeout": 60 },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expect", "control": "Agent Change 2", "present": false },
    { "do": "describe", "stage": "4-stopped-alone", "note": "a stop with nothing waiting: still one row, the document as the circle left it" },
    { "do": "snapshot", "name": "4-stopped-alone" }
  ]
}
