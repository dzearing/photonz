{
 "out": "/tmp/photonz-playtest/track-select-forward-walk",
 "seed": "Premiere's A on the timeline: the Track Select Forward tool. A press on a clip picks it and every clip that starts at or after it, on every track, and dragging carries the lot by the same amount as one undo step. V puts it down. At Next defaults, no flag set.",
 "setup": {"timelineOpen": true, "forget": ["all"], "scratch": ["sample:recording as b-roll.mp4", "sample:music"]},
  "steps": [
    {"do": "action", "action": "openSampleRecording"},
    {"do": "wait", "seconds": 2},
    {"do": "action", "action": "videoPause"},
    {"do": "tool", "tool": "select"},
    {"do": "dropOnTimeline", "file": "scratch/b-roll.mp4", "track": "V1", "seconds": 7.96},
    {"do": "wait", "seconds": 1},
    {"do": "dropOnTimeline", "file": "scratch/Sample Music.m4a", "track": "V1", "seconds": 10},
    {"do": "wait", "seconds": 1},
    {"do": "expectClip", "clip": "Tutorial Sample", "track": "V1", "startsAt": 0, "endsAt": 8},
    {"do": "expectClip", "clip": "b-roll", "track": "V1", "startsAt": 8, "endsAt": 16},
    {"do": "expectClip", "clip": "Sample Music", "startsAt": 10},
    {"do": "describe", "stage": "1-three-clips", "note": "the recording and b-roll on V1, music from ten seconds under them"},
    {"do": "snapshot", "name": "1-three-clips"},
    {"do": "press", "control": "Timeline Select"},
    {"do": "wait", "seconds": 0.3},
    {"do": "expectTimeline", "keyboard": "timeline", "timelineTool": "select"},
    {"do": "key", "key": "a"},
    {"do": "wait", "seconds": 0.3},
    {"do": "expectTimeline", "timelineTool": "trackSelectForward"},
    {"do": "expect", "control": "Track Select b-roll", "present": true},
    {"do": "describe", "stage": "2-a-in-hand", "note": "A with the timeline holding the keyboard picked up Track Select Forward: the second button in the timeline's bar is lit"},
    {"do": "snapshot", "name": "2-a-in-hand"},
    {"do": "dragClip", "clip": "b-roll"},
    {"do": "wait", "seconds": 0.4},
    {"do": "expectPicked", "layers": ["Sample Music", "b-roll"]},
    {"do": "describe", "stage": "3-picked-forward", "note": "THE FIRST TEST: a click on b-roll picked it and the music that starts after it on another track, and left the recording before it alone"},
    {"do": "snapshot", "name": "3-picked-forward"},
    {"do": "dragClip", "clip": "b-roll", "byMS": 2000},
    {"do": "wait", "seconds": 0.5},
    {"do": "expectClip", "clip": "b-roll", "track": "V1", "startsAt": 10.0, "endsAt": 18.0},
    {"do": "expectClip", "clip": "Sample Music", "track": "Audio 2", "startsAt": 12.0},
    {"do": "expectClip", "clip": "Tutorial Sample", "track": "V1", "startsAt": 0.0, "endsAt": 8.0},
    {"do": "describe", "stage": "4-carried", "note": "THE SECOND TEST: dragging b-roll two seconds right carried the music the same two seconds, opening a gap after the recording"},
    {"do": "snapshot", "name": "4-gap-opened"},
    {"do": "action", "action": "undo"},
    {"do": "wait", "seconds": 0.6},
    {"do": "expectClip", "clip": "b-roll", "startsAt": 8.0},
    {"do": "expectClip", "clip": "Sample Music", "startsAt": 10.0},
    {"do": "describe", "stage": "5-one-undo", "note": "one undo puts both back: the whole drag was one step"},
    {"do": "dragClip", "clip": "b-roll", "modifiers": ["shift"]},
    {"do": "wait", "seconds": 0.4},
    {"do": "expectPicked", "layers": ["b-roll"]},
    {"do": "describe", "stage": "6-shift-one-track", "note": "THE THIRD TEST: shift-click on b-roll keeps the pick to V1, so the music on Audio 2 is left out"},
    {"do": "dragClip", "clip": "Tutorial Sample"},
    {"do": "wait", "seconds": 0.4},
    {"do": "expectPicked", "layers": ["Sample Music", "Tutorial Sample", "b-roll"]},
    {"do": "key", "key": "v"},
    {"do": "wait", "seconds": 0.3},
    {"do": "expectTimeline", "timelineTool": "select"},
    {"do": "dragClip", "clip": "Sample Music", "byMS": 1000},
    {"do": "wait", "seconds": 0.5},
    {"do": "expectClip", "clip": "Tutorial Sample", "startsAt": 1.0},
    {"do": "expectClip", "clip": "b-roll", "startsAt": 9.0},
    {"do": "expectClip", "clip": "Sample Music", "startsAt": 11.0},
    {"do": "describe", "stage": "7-select-carries-the-pick", "note": "THE FOURTH TEST: V put the tool down, and with the Select arrow, dragging the music, one of the three still picked, carried all three a second right"},
    {"do": "snapshot", "name": "7-select-carries-the-pick"}
  ]
}
