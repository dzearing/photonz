{
  "out": "/tmp/photonz-playtest/command-frees-snapping-in-an-icon-walk",
  "setup": {
    "forget": [
      "all"
    ]
  },
  "steps": [
    { "do": "blank", "canvasWidth": 1600, "canvasHeight": 1100, "width": 1240, "height": 900 },
    { "do": "action", "action": "newFrameDialog" },
    { "do": "wait", "seconds": 0.9 },
    { "do": "press", "control": "24", "in": "Icons" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "press", "control": "Add Frame" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "pinch", "to": 8 },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "1-frame", "note": "a 24 unit icon frame at 800%, Next defaults: units run 788 to 812 across and 538 to 562 down" },

    { "do": "tool", "tool": "rectangle" },
    { "do": "move", "at": [797.3, 548.4] },
    { "do": "wait", "seconds": 0.3 },
    { "do": "expectLanding", "near": [797, 548], "within": 0.01, "says": "9, 10" },
    { "do": "move", "at": [797.3, 548.4], "modifiers": ["command"] },
    { "do": "wait", "seconds": 0.3 },
    { "do": "expectLanding", "absent": true },
    { "do": "drag", "from": [797.3, 548.4], "to": [803.2, 551.1], "steps": 10, "modifiers": ["command"], "hold": "free-1-dragging" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "describe", "stage": "2-box-freed", "note": "a box drawn with Command held stays exactly where it was dragged: 9.3, 10.4 to 15.2, 13.1, no unit caught it" },
    { "do": "expectBox", "layer": "Rectangle", "at": [797.3, 548.4], "size": [5.9, 2.7], "within": 0.02 },

    { "do": "tool", "tool": "pen" },
    { "do": "key", "key": "escape" },
    { "do": "tool", "tool": "pen" },
    { "do": "move", "at": [800.2, 554.3] },
    { "do": "wait", "seconds": 0.3 },
    { "do": "expectLanding", "near": [800, 554], "within": 0.01, "says": "12, 16 · center" },
    { "do": "snapshot", "name": "free-0-center-readout" },
    { "do": "click", "at": [792.3, 555.4], "modifiers": ["command"] },
    { "do": "click", "at": [796.6, 555.7], "modifiers": ["command"] },
    { "do": "click", "at": [796.6, 559.2] },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "describe", "stage": "3-pen-freed", "note": "two Pen points with Command held stay where they were clicked, and the third without it goes back to a whole unit" },

    { "do": "tool", "tool": "select" },
    { "do": "key", "key": "escape" },
    { "do": "action", "action": "showGrid" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "click", "at": [800, 549.5] },
    { "do": "wait", "seconds": 0.3 },
    { "do": "drag", "from": [800, 549.5], "to": [801.3, 550.7], "steps": 10, "modifiers": ["command"] },
    { "do": "wait", "seconds": 0.4 },
    { "do": "describe", "stage": "4-moved-freed", "note": "a picked box moved with Command held and the Grid on" },
    { "do": "expectBox", "layer": "Rectangle", "at": [798.6, 549.6], "size": [5.9, 2.7], "within": 0.02 },
    { "do": "snapshot", "name": "free-2-drawn" },
    { "do": "writeSVG", "name": "free" },
    { "do": "expectSVG", "contains": "<rect transform=\"translate(10.6 11.6)\"" },
    { "do": "expectSVG", "contains": "<path transform=\"translate(4.3 17.4)\" d=\"M0 0 L4.3 0.3 L4.7 3.6\"" }
  ]
}
