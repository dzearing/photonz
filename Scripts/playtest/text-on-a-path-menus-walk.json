{
  "out": "/tmp/photonz-playtest/text-on-a-path-menus-walk",
  "seed": "Put Text on a Path is where a person looks for it, at Next defaults with no flag changed: on the right-click of a headline picked together with a drawn curve, and in the Layer menu. On the sample recording a headline is typed and a curve drawn with the Pen; both are picked; the right-click's row puts the words on the curve; undo; then Layer > Put Text on a Path does the same. The menu bar is only live with the app in front, so this walk takes the front.",
  "setup": { "timelineOpen": true, "forget": ["all"], "front": true },
  "steps": [
    { "do": "action", "action": "openSampleRecording" },
    { "do": "wait", "seconds": 2.0 },
    { "do": "action", "action": "videoPause" },
    { "do": "tool", "tool": "select" },
    { "do": "action", "action": "videoSeekStart" },
    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "key", "key": "t" },
    { "do": "click", "at": [950, 110] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "type", "text": "Follow the curve" },
    { "do": "key", "key": "return", "modifiers": ["command"] },
    { "do": "wait", "seconds": 1.0 },
    { "do": "tool", "tool": "pen" },
    { "do": "drag", "from": [380, 760], "to": [380, 495], "steps": 8 },
    { "do": "drag", "from": [860, 280], "to": [1125, 280], "steps": 8 },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "click", "at": [1000, 140], "modifiers": ["shift"] },
    { "do": "wait", "seconds": 0.6 },

    { "do": "rightClick", "at": [1000, 140], "shot": "1-right-click" },
    { "do": "describe", "stage": "1-right-click", "note": "the right-click on the picked headline, with the curve picked too, offers Put Text on a Path" },
    { "do": "rightClick", "at": [1000, 140], "choose": "Put Text on a Path" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "action", "action": "expectWordsFollowTheCurve" },
    { "do": "snapshot", "name": "2-from-the-right-click" },

    { "do": "action", "action": "undo" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "click", "at": [1000, 140] },
    { "do": "click", "at": [380, 760], "modifiers": ["shift"] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "menus", "stage": "3-layer-menu", "menu": "Layer", "choose": "Layer > Put Text on a Path" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "action", "action": "expectWordsFollowTheCurve" },
    { "do": "describe", "stage": "4-from-the-layer-menu", "note": "Layer > Put Text on a Path does the same as the right-click" },
    { "do": "snapshot", "name": "4-from-the-layer-menu" }
  ]
}
