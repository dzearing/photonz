{
  "out": "/tmp/photonz-playtest/trim-cancel-after-a-delete-walk",
  "setup": { "forget": ["all"] },
  "steps": [
    { "do": "action", "action": "openSampleRecording" },
    { "do": "action", "action": "videoPause" },
    { "do": "action", "action": "videoSeekQuarter" },
    { "do": "action", "action": "clipSplit" },
    { "do": "action", "action": "videoSeekThreeQuarters" },
    { "do": "action", "action": "clipSplit" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "action", "action": "videoSeekMiddle" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "expectRecording", "pieces": 3 },

    { "do": "action", "action": "clipDeletePiece" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expectRecording", "pieces": 2, "seconds": 4 },
    { "do": "describe", "stage": "1-middle-piece-dropped", "note": "the middle piece is thrown away, so what is left is two two-second pieces, four seconds in all" },
    { "do": "snapshot", "name": "1-middle-piece-dropped" },

    { "do": "action", "action": "videoBeginTrim" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectRecording", "pieces": 2, "seconds": 4 },
    { "do": "describe", "stage": "2-handles-open-on-what-is-left", "note": "Trim opens on what is left, four seconds between the handles, not the eight the recording had before the delete" },
    { "do": "snapshot", "name": "2-handles-open-on-what-is-left" },

    { "do": "action", "action": "videoTrimStart" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "3-start-handle-moved", "note": "the in handle has come in, so there is a trim for Cancel to throw away" },
    { "do": "snapshot", "name": "3-start-handle-moved" },

    { "do": "action", "action": "videoTrimCancel" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectRecording", "pieces": 2, "seconds": 4 },
    { "do": "expectTimeline", "lengthMS": 4000, "tool": "select" },
    { "do": "describe", "stage": "4-cancel-gives-back-what-is-left", "note": "THE TEST: Cancel gives back exactly what the trim opened on, measured against what is left after the delete: four seconds in two pieces. The dropped piece stays dropped" },
    { "do": "snapshot", "name": "4-cancel-gives-back-what-is-left" }
  ]
}
