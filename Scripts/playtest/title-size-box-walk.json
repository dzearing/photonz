{
  "out": "/tmp/photonz-playtest/title-size-box",
  "seed": "A title's Text section gives Size as a box you type a number into, beside the Weight dropdown on one line, the way the title mock draws it (video-title-wt.html, the Size stepper beside Regular). At Next defaults with no flag changed: a title is typed over the sample recording and picked, 30 is typed into Size and lands on Return, an arrow key with Shift nudges it to 40, and the preset sizes are still on the list at the end of the box. Photographed dark and light.",
  "setup": {
    "forget": ["all"],
    "timelineOpen": true
  },
  "steps": [
    { "do": "action", "action": "openSampleRecording" },
    { "do": "wait", "seconds": 2.0 },
    { "do": "action", "action": "videoPause" },
    { "do": "appearance", "value": "dark" },
    { "do": "tool", "tool": "select" },
    { "do": "action", "action": "videoSeekStart" },
    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "tool", "tool": "text" },
    { "do": "click", "at": [620, 330] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "type", "text": "Ship it" },
    { "do": "key", "key": "return", "modifiers": ["command"] },
    { "do": "wait", "seconds": 1.0 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "reveal", "control": "Text section" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "1-picked",
      "note": "a title picked: the Text section shows Size as a box with the word Size inside it and the number at its right, the Weight dropdown beside it on the same line" },
    { "do": "panel", "stage": "1-picked" },
    { "do": "snapshot", "name": "1-size-box-dark" },

    { "do": "focus", "field": "Size" },
    { "do": "type", "text": "30" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "2-typed",
      "note": "THE TEST: 30 typed and Return pressed. 30 is no preset, and the title is now 30 px" },
    { "do": "expect", "field": "Size", "reads": "30" },
    { "do": "expect", "menu": "Size", "reads": "30 px" },
    { "do": "snapshot", "name": "2-typed-30-dark" },

    { "do": "focus", "field": "Size" },
    { "do": "key", "key": "up", "modifiers": ["shift"] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "3-nudged",
      "note": "Shift and the up arrow nudge the size by ten" },
    { "do": "expect", "field": "Size", "reads": "40" },
    { "do": "expect", "menu": "Size", "reads": "40 px" },

    { "do": "panelMenu", "menu": "Size", "choose": "64 px" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "4-preset",
      "note": "the preset sizes are on the list at the end of the box, and 40 is among them while the title wears it" },
    { "do": "expect", "field": "Size", "reads": "64" },
    { "do": "panel", "stage": "4-preset" },

    { "do": "appearance", "value": "light" },
    { "do": "reveal", "control": "Text section" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "snapshot", "name": "5-size-box-light" },
    { "do": "appearance", "value": "dark" }
  ]
}
