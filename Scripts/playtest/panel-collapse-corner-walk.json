{
  "out": "/tmp/photonz-playtest/panel-collapse-corner",
  "setup": { "forget": ["panel", "measure", "shapes"] },
  "steps": [
    { "do": "open", "file": "../../Tests/PhotonzRenderTests/Fixtures/settings-pane-2x.png", "width": 1280, "height": 840 },
    { "do": "wait", "seconds": 1 },
    { "do": "action", "action": "showInspector" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "1-panel-open", "note": "collapse button in the dock's own top right corner, on the Layers header line" },
    { "do": "snapshot", "name": "1-panel-open" },
    { "do": "hover", "label": "Hide Inspector" },
    { "do": "snapshot", "name": "2-tooltip" },
    { "do": "press", "control": "Hide Inspector" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "3-panel-closed", "note": "the way back is the capsule in the canvas corner" },
    { "do": "snapshot", "name": "3-panel-closed" },
    { "do": "key", "key": "l", "modifiers": ["command", "option"] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "action", "action": "showInspector" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "4-shortcut-back", "note": "the same shortcut still brings the dock back" },
    { "do": "snapshot", "name": "4-shortcut-back" },
    { "do": "key", "key": "i" },
    { "do": "waitFor", "condition": "tool", "value": "measure" },
    { "do": "waitFor", "condition": "edgeMap", "timeout": 15 },
    { "do": "measureMode", "mode": "distance" },
    { "do": "click", "at": [100, 80] },
    { "do": "click", "at": [400, 80] },
    { "do": "click", "at": [250, 120] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "measureMode", "mode": "size" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "5-legend-freed-corner", "note": "top left taken, dock open: the legend takes the whole freed top right corner" },
    { "do": "snapshot", "name": "5-legend-freed-corner" }
  ]
}
