{
  "out": "/tmp/photonz-playtest/side-pane-load",
  "seed": "A study, not a claim: how much is the right hand dock actually carrying, measured rather than guessed. The same document is built three times, in a small window, a laptop window and a large one, and at each size the dock's own section offsets and the list of sections a person can see whole are read back. That is the inventory the side pane study is argued from.",
  "setup": { "forget": ["panel", "tools", "shapes", "text", "measure", "color"] },
  "steps": [
    { "do": "blank", "canvasWidth": 900, "canvasHeight": 600, "width": 1000, "height": 640 },
    { "do": "wait", "seconds": 1.0 },
    { "do": "tool", "tool": "text" },
    { "do": "click", "at": [140, 130] },
    { "do": "type", "text": "Sign in" },
    { "do": "key", "key": "return", "modifiers": ["command"] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [420, 120], "to": [600, 240], "steps": 8 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "click", "at": [180, 145] },
    { "do": "wait", "seconds": 1.2 },
    { "do": "panel", "stage": "small-text" },
    { "do": "describe", "stage": "1-small-1000x640", "note": "A small window, text picked. Read dockViewport, dockSections and dockInView." },
    { "do": "snapshot", "name": "side-pane-1-small" },

    { "do": "blank", "canvasWidth": 900, "canvasHeight": 600, "width": 1200, "height": 720 },
    { "do": "wait", "seconds": 1.0 },
    { "do": "tool", "tool": "text" },
    { "do": "click", "at": [140, 130] },
    { "do": "type", "text": "Sign in" },
    { "do": "key", "key": "return", "modifiers": ["command"] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [420, 120], "to": [600, 240], "steps": 8 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "click", "at": [180, 145] },
    { "do": "wait", "seconds": 1.2 },
    { "do": "panel", "stage": "laptop-text" },
    { "do": "describe", "stage": "2-laptop-1200x720", "note": "The laptop window every dock claim is argued at, text picked." },
    { "do": "snapshot", "name": "side-pane-2-laptop" },

    { "do": "blank", "canvasWidth": 900, "canvasHeight": 600, "width": 1680, "height": 1000 },
    { "do": "wait", "seconds": 1.0 },
    { "do": "tool", "tool": "text" },
    { "do": "click", "at": [140, 130] },
    { "do": "type", "text": "Sign in" },
    { "do": "key", "key": "return", "modifiers": ["command"] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [420, 120], "to": [600, 240], "steps": 8 },
    { "do": "tool", "tool": "measure" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "drag", "from": [200, 400], "to": [400, 400], "steps": 8 },
    { "do": "wait", "seconds": 0.6 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "click", "at": [180, 145] },
    { "do": "wait", "seconds": 1.2 },
    { "do": "panel", "stage": "large-text" },
    { "do": "describe", "stage": "3-large-1680x1000", "note": "A large window with a measurement in the document too, text picked. If the dock still does not hold everything here, no window size saves it." },
    { "do": "snapshot", "name": "side-pane-3-large" },

    { "do": "key", "key": "a", "modifiers": ["command"] },
    { "do": "wait", "seconds": 1.2 },
    { "do": "panel", "stage": "large-all" },
    { "do": "describe", "stage": "4-large-select-all", "note": "Everything picked at once in the large window: the fullest the dock gets today, before anything like Motion is added." },
    { "do": "snapshot", "name": "side-pane-4-large-all" }
  ]
