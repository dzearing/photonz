{
  "out": "/tmp/photonz-playtest/a-shape-s-bar-keeps-its-track-walk",
  "seed": "A shape's bar never vanishes from its track, and an empty track can take one back. At Next defaults with no flag changed, this walk draws a rectangle on a recording and finds its bar on its own Rectangle row; deletes it with the Delete key and finds the row gone with it, then undoes and finds the bar back exactly; draws a second rectangle and groups the two, finding neither of their rows left behind empty, then undoes both; adds an empty video track and carries the rectangle's bar up onto it, leaving no empty row where it was; adds another empty track and right-clicks it to Add Text, which lands words on it at the playhead; and adds one more and clears it with Delete Empty Tracks.",
  "setup": { "timelineOpen": true, "forget": ["all"] },
  "steps": [
    { "do": "action", "action": "openSampleRecording" },
    { "do": "wait", "seconds": 2.0 },
    { "do": "action", "action": "videoPause" },
    { "do": "tool", "tool": "select" },
    { "do": "action", "action": "videoSeekStart" },
    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "wait", "seconds": 0.8 },

    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [500, 300], "to": [700, 420], "steps": 10 },
    { "do": "wait", "seconds": 1.0 },
    { "do": "describe", "stage": "1-drawn", "note": "a rectangle drawn on the recording at one second has its bar on a row of its own, named Rectangle" },
    { "do": "expect", "control": "Track Rectangle", "present": true },
    { "do": "expect", "field": "Rectangle clip", "present": true },
    { "do": "snapshot", "name": "1-rectangle-bar" },

    { "do": "key", "key": "delete" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "2-deleted", "note": "THE FIRST TEST: Delete takes the rectangle off the canvas AND its row off the timeline, in one step; no empty Rectangle row is left behind" },
    { "do": "expect", "control": "Track Rectangle", "present": false },
    { "do": "expect", "field": "Rectangle clip", "present": false },
    { "do": "snapshot", "name": "2-deleted-with-its-row" },

    { "do": "key", "key": "z", "modifiers": ["command"] },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "3-undone", "note": "THE SECOND TEST: one undo brings the rectangle, its bar and its row back exactly" },
    { "do": "expect", "control": "Track Rectangle", "present": true },
    { "do": "expect", "field": "Rectangle clip", "present": true },
    { "do": "snapshot", "name": "3-undo-brings-the-bar-back" },

    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [800, 500], "to": [950, 600], "steps": 10 },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expect", "control": "Track Rectangle 2", "present": true },
    { "do": "tool", "tool": "select" },
    { "do": "click", "at": [600, 360] },
    { "do": "click", "at": [870, 550], "modifiers": ["shift"] },
    { "do": "wait", "seconds": 0.3 },
    { "do": "action", "action": "group" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "4-grouped", "note": "THE THIRD TEST: grouping the two rectangles moves their bars to the group's row, and neither of their rows stays behind empty" },
    { "do": "expect", "control": "Track Rectangle", "present": false },
    { "do": "expect", "control": "Track Rectangle 2", "present": false },
    { "do": "panel", "stage": "4-grouped" },
    { "do": "snapshot", "name": "4-grouped-no-empty-rows" },
    { "do": "key", "key": "z", "modifiers": ["command"] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "key", "key": "z", "modifiers": ["command"] },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expect", "control": "Track Rectangle", "present": true },
    { "do": "expect", "control": "Track Rectangle 2", "present": false },

    { "do": "panelMenu", "menu": "Add Track", "choose": "Video Track" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "5-empty-track", "note": "an empty video track, V2, over the rectangle's row" },
    { "do": "expect", "control": "Track V2", "present": true },
    { "do": "snapshot", "name": "5-an-empty-track" },

    { "do": "click", "at": [600, 360] },
    { "do": "wait", "seconds": 0.3 },
    { "do": "action", "action": "clipCarryUpATrackHeld" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "snapshot", "name": "6-carried-over-the-empty-track" },
    { "do": "action", "action": "clipDragRelease" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "6-carried", "note": "THE FOURTH TEST: the rectangle's bar carried up onto the empty V2 lands there, and its old Rectangle row goes rather than staying empty" },
    { "do": "expectClip", "clip": "Rectangle", "track": "V2" },
    { "do": "expect", "control": "Track Rectangle", "present": false },
    { "do": "snapshot", "name": "7-bar-on-the-empty-track" },

    { "do": "panelMenu", "menu": "Add Track", "choose": "Video Track" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expect", "control": "Track V3", "present": true },
    { "do": "rightClick", "on": "Track V3", "shot": "8-empty-track-menu", "choose": "Add Text" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "7-added-text", "note": "THE FIFTH TEST: right-click an empty track, Add Text: a title lands on it from the playhead" },
    { "do": "expectClip", "clip": "Text", "track": "V3", "startsAt": 1.0 },
    { "do": "snapshot", "name": "9-text-added-to-the-empty-track" },

    { "do": "panelMenu", "menu": "Add Track", "choose": "Video Track" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expect", "control": "Track V4", "present": true },
    { "do": "rightClick", "on": "Track V4", "choose": "Delete Empty Tracks" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "8-cleared", "note": "THE SIXTH TEST: Delete Empty Tracks takes the empty V4 and leaves every track with something on it" },
    { "do": "expect", "control": "Track V4", "present": false },
    { "do": "expect", "control": "Track V3", "present": true },
    { "do": "expect", "control": "Track V2", "present": true },
    { "do": "snapshot", "name": "10-empty-tracks-cleared" }
  ]
}
