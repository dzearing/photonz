{
  "out": "/tmp/photonz-playtest/tutorial-make-something-move-walk",
  "seed": "Make something move, the guide: a bell on a frame, Add Key, a turn at each of two moments, and the pivot moved to the crown with the Rotation row picked.",
  "setup": {
    "forget": [
      "tutorials",
      "panel",
      "frames",
      "groups",
      "tools",
      "shapes",
      "grid"
    ]
  },
  "steps": [
    {
      "do": "appearance",
      "value": "light"
    },
    {
      "do": "open",
      "file": "../../Tests/PhotonzRenderTests/Fixtures/settings-pane-2x.png",
      "width": 1280,
      "height": 900
    },
    {
      "do": "wait",
      "seconds": 1
    },
    {
      "do": "startGuide",
      "guide": "make-something-move"
    },
    {
      "do": "waitFor",
      "condition": "tutorialStep",
      "value": "a-bell-that-does-not-ring",
      "timeout": 10
    },
    {
      "do": "wait",
      "seconds": 1
    },
    {
      "do": "describe",
      "stage": "1-a-bell-sitting-still",
      "note": "the sample: a bell on the 24 point frame, drawn in two parts, and nothing about it moving"
    },
    {
      "do": "snapshot",
      "name": "1-a-bell-sitting-still"
    },
    {
      "do": "render",
      "name": "1-a-bell-sitting-still-doc"
    },
    {
      "do": "action",
      "action": "tutorialNext"
    },
    {
      "do": "waitFor",
      "condition": "tutorialStep",
      "value": "pick-the-body",
      "timeout": 5
    },
    {
      "do": "wait",
      "seconds": 0.6
    },
    {
      "do": "click",
      "at": [
        360,
        240
      ]
    },
    {
      "do": "waitFor",
      "condition": "tutorialStep",
      "value": "the-motion-list",
      "timeout": 6
    },
    {
      "do": "wait",
      "seconds": 0.9
    },
    {
      "do": "describe",
      "stage": "2-add-key",
      "note": "the body picked, and the panel's Motion section has Add Key on it: nothing to choose before you start."
    },
    {
      "do": "expect",
      "control": "Add Key",
      "present": true
    },
    {
      "do": "panel",
      "stage": "2-add-key"
    },
    {
      "do": "snapshot",
      "name": "2-add-key"
    },
    {
      "do": "shortcut",
      "key": "k",
      "modifiers": [],
      "menuItem": "Add Key"
    },
    {
      "do": "waitFor",
      "condition": "tutorialStep",
      "value": "add-a-rotation",
      "timeout": 8
    },
    {
      "do": "wait",
      "seconds": 0.6
    },
    {
      "do": "describe",
      "stage": "3-the-first-key",
      "note": "K set a moment: the timeline is up under the picture with one hollow diamond."
    },
    {
      "do": "expect",
      "field": "Key Length",
      "reads": "0:02.00"
    },
    {
      "do": "snapshot",
      "name": "3-the-first-key"
    },
    {
      "do": "panelMenu",
      "menu": "Add Key Menu",
      "choose": "Animate a Property"
    },
    {
      "do": "wait",
      "seconds": 0.4
    },
    {
      "do": "press",
      "control": "Rotation",
      "in": "Animate a property"
    },
    {
      "do": "waitFor",
      "condition": "tutorialStep",
      "value": "turn-it-back",
      "timeout": 8
    },
    {
      "do": "wait",
      "seconds": 0.8
    },
    {
      "do": "action",
      "action": "videoStepOneSecond"
    },
    {
      "do": "wait",
      "seconds": 0.6
    },
    {
      "do": "expect",
      "field": "Key Time",
      "reads": "0:01.00"
    },
    {
      "do": "focus",
      "field": "Rotation"
    },
    {
      "do": "type",
      "text": "20"
    },
    {
      "do": "key",
      "key": "return"
    },
    {
      "do": "waitFor",
      "condition": "tutorialStep",
      "value": "the-bobblehead",
      "timeout": 8
    },
    {
      "do": "wait",
      "seconds": 0.8
    },
    {
      "do": "describe",
      "stage": "4-the-bobblehead",
      "note": "THE PICTURE TO LOOK AT: two keys and it turns, about its own middle, which is wrong for a bell."
    },
    {
      "do": "snapshot",
      "name": "4-the-bobblehead"
    },
    {
      "do": "panel",
      "stage": "4-the-bobblehead"
    },
    {
      "do": "action",
      "action": "tutorialNext"
    },
    {
      "do": "waitFor",
      "condition": "tutorialStep",
      "value": "say-what-it-turns-around",
      "timeout": 5
    },
    {
      "do": "wait",
      "seconds": 0.6
    },
    {
      "do": "action",
      "action": "pickRotationRow"
    },
    {
      "do": "wait",
      "seconds": 0.8
    },
    {
      "do": "snapshot",
      "name": "5-the-rotation-row-picked"
    },
    {
      "do": "panel",
      "stage": "5-row"
    },
    {
      "do": "drag",
      "from": [
        360,
        237.6
      ],
      "to": [
        360,
        232.2
      ],
      "steps": 6
    },
    {
      "do": "waitFor",
      "condition": "tutorialStep",
      "value": "nothing-is-baked-in",
      "timeout": 8
    },
    {
      "do": "wait",
      "seconds": 0.9
    },
    {
      "do": "expect",
      "field": "Key lane Bell Position",
      "present": false
    },
    {
      "do": "describe",
      "stage": "6-it-hangs",
      "note": "THE TEST: the same two angles, now about the crown, read as a bell, and the drag moved the pivot rather than the layer: no Position row."
    },
    {
      "do": "snapshot",
      "name": "6-it-hangs"
    },
    {
      "do": "render",
      "name": "6-the-document-never-moved"
    },
    {
      "do": "action",
      "action": "tutorialNext"
    },
    {
      "do": "wait",
      "seconds": 0.8
    },
    {
      "do": "describe",
      "stage": "7-finished",
      "note": "Done closed the guide"
    }
  ]
}
