{
  "out": "/tmp/photonz-playtest/path-chrome-follows-walk",
  "steps": [
    { "do": "blank", "canvasWidth": 900, "canvasHeight": 700, "width": 1280, "height": 900 },
    { "do": "wait", "seconds": 1 },

    { "do": "key", "key": "p" },
    { "do": "waitFor", "condition": "tool", "value": "pen" },
    { "do": "click", "at": [200, 500] },
    { "do": "wait", "seconds": 0.2 },
    { "do": "drag", "from": [450, 220], "to": [560, 220], "steps": 10 },
    { "do": "wait", "seconds": 0.2 },
    { "do": "click", "at": [700, 500] },
    { "do": "wait", "seconds": 0.2 },
    { "do": "click", "at": [203, 503] },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expectPath", "anchors": 3, "closed": true, "curves": 2, "smooth": 1 },

    { "do": "key", "key": "escape" },
    { "do": "waitFor", "condition": "tool", "value": "select" },
    { "do": "expectPicked", "layers": ["Path"] },
    { "do": "wait", "seconds": 0.4 },

    { "do": "click", "at": [450, 220] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "1-levers-showing", "note": "the smooth point is picked and wearing its two levers" },
    { "do": "snapshot", "name": "1-before-drag" },

    { "do": "drag", "from": [560, 220], "to": [560, 60], "steps": 14, "hold": "2-mid-lever-drag" },
    { "do": "expectChrome" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "2-lever-pulled", "note": "a lever pulled a long way up, past the top of the old box: the points kept up with it every frame" },
    { "do": "snapshot", "name": "3-after-lever-drag" },

    { "do": "drag", "from": [700, 500], "to": [780, 640], "steps": 14, "hold": "4-mid-anchor-drag" },
    { "do": "expectChrome" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectPath", "anchors": 3, "anchor": 2, "near": [780, 640], "within": 8 },
    { "do": "describe", "stage": "3-anchor-dragged", "note": "the same holds for a point rather than a lever" },
    { "do": "snapshot", "name": "5-after-anchor-drag" },

    { "do": "click", "at": [200, 500] },
    { "do": "wait", "seconds": 0.3 },
    { "do": "click", "at": [780, 640], "modifiers": ["shift"] },
    { "do": "wait", "seconds": 0.4 },
    { "do": "drag", "from": [200, 500], "to": [260, 430], "steps": 14, "hold": "6-mid-two-anchor-drag" },
    { "do": "expectChrome" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectPath", "anchors": 3, "anchor": 0, "near": [260, 430], "within": 8 },
    { "do": "expectPath", "anchors": 3, "anchor": 2, "near": [840, 570], "within": 8 },
    { "do": "describe", "stage": "4-two-anchors-dragged", "note": "two points picked and dragged together: both stayed under the chrome" },
    { "do": "snapshot", "name": "7-after-two-anchor-drag" },

    { "do": "action", "action": "zoomIn" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "action", "action": "zoomIn" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "5-zoomed-in", "note": "zoomed in twice: the same claim is made again, because the chrome is placed through the viewport" },
    { "do": "click", "at": [450, 220] },
    { "do": "wait", "seconds": 0.4 },
    { "do": "drag", "from": [560, 60], "to": [620, 140], "steps": 14, "hold": "8-mid-zoomed-drag" },
    { "do": "expectChrome" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "snapshot", "name": "9-after-zoomed-drag" },

    { "do": "action", "action": "zoomOut" },
    { "do": "action", "action": "zoomOut" },
    { "do": "action", "action": "zoomOut" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "click", "at": [450, 220] },
    { "do": "wait", "seconds": 0.4 },
    { "do": "drag", "from": [620, 140], "to": [520, 260], "steps": 14, "hold": "10-mid-zoomed-out-drag" },
    { "do": "expectChrome" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "snapshot", "name": "11-after-zoomed-out-drag" },

    { "do": "render", "name": "12-final-render" }
  ]
}
