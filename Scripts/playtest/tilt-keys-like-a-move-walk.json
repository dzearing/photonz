{
  "out": "/tmp/photonz-playtest/tilt-keys-like-a-move-walk",
  "seed": "3D tilt and depth key as easily as a move, at Next defaults with no flag changed. A title is typed over a recording at nought seconds and keyed from its track's diamond, the way a person keys a layer's place. The flat arc swings it to 90 on Y there: because its place is animating, the tilt is a key, the same as a move would be. A second later the arc swings it back to 0, which is a second key, and the title now swings round over one second: half way, it is still turned, its near edge taller than its far one. A move at one second keys the place too, so tilt and place follow one rule. Then Depth is typed between keys, which adds a Depth key without disturbing the others, and Show Graph opens the Rotation Y lane into its curve.",
  "setup": {
    "forget": [
      "all"
    ],
    "timelineOpen": true
  },
  "steps": [
    { "do": "action", "action": "openSampleRecording" },
    { "do": "wait", "seconds": 2.0 },
    { "do": "action", "action": "videoPause" },
    { "do": "action", "action": "videoSeekStart" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "tool", "tool": "text" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "click", "at": [520, 300] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "type", "text": "Swing me round" },
    { "do": "key", "key": "return", "modifiers": ["command"] },
    { "do": "wait", "seconds": 1.0 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expect", "control": "Key Title", "in": "Track Title", "reads": "not keyed" },
    { "do": "press", "control": "Key Title" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expect", "control": "Key Title", "in": "Track Title", "reads": "on a key" },
    { "do": "spaceHandle", "handle": "swing", "by": [150, 0], "readout": "Rotation Y 90°" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "reveal", "control": "3D section" },
    { "do": "expect", "field": "3D Rotation Y Value", "reads": "90" },
    { "do": "expect", "control": "Key", "in": "3D Rotation Y", "reads": "on a key" },
    { "do": "describe", "stage": "1-keyed-at-90", "note": "THE FIRST TEST: the title keyed from its track's diamond, then swung to 90 on Y with the flat arc at nought seconds. Its place is animating, so the tilt became a key at the playhead without touching the 3D section: its Rotation Y diamond is lit and a Rotation Y lane has joined the title's keys" },
    { "do": "panel", "stage": "1-keyed-at-90" },
    { "do": "snapshot", "name": "1-keyed-at-90" },
    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expect", "control": "Key", "in": "3D Rotation Y", "reads": "between keys" },
    { "do": "spaceHandle", "handle": "swing", "by": [-150, 0], "readout": "Rotation Y 0°" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expect", "field": "3D Rotation Y Value", "reads": "0" },
    { "do": "expect", "control": "Key", "in": "3D Rotation Y", "reads": "on a key" },
    { "do": "expectTilt", "flat": true },
    { "do": "drag", "from": [620, 340], "to": [660, 370], "steps": 8 },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expect", "control": "Key", "in": "Position", "reads": "on a key" },
    { "do": "describe", "stage": "2-back-at-one-second", "note": "at one second the arc swung it back to face you: a second Rotation Y key. A move here keys its place the same way, so the tilt and the move follow one rule" },
    { "do": "snapshot", "name": "2-back-at-one-second" },
    { "do": "action", "action": "videoStepBackOneSecond" },
    { "do": "action", "action": "videoStepQuarterSecond" },
    { "do": "action", "action": "videoStepQuarterSecond" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expectTilt", "atLeast": 1.1 },
    { "do": "describe", "stage": "3-half-way", "note": "THE SECOND TEST: half way through the swing in time, the title is still turned: its near edge is taller than its far one" },
    { "do": "snapshot", "name": "3-half-way" },
    { "do": "press", "control": "3D Depth Value" },
    { "do": "key", "key": "a", "modifiers": ["command"] },
    { "do": "type", "text": "-300" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expect", "field": "3D Depth Value", "reads": "-300" },
    { "do": "expect", "control": "Key", "in": "3D Depth", "reads": "on a key" },
    { "do": "expect", "control": "Key", "in": "3D Rotation Y", "reads": "between keys" },
    { "do": "describe", "stage": "4-depth-typed", "note": "THE THIRD TEST: -300 typed into Depth half way: a Depth key there, and the swing is untouched" },
    { "do": "snapshot", "name": "4-depth-typed" },
    { "do": "action", "action": "videoSeekStart" },
    { "do": "action", "action": "videoPlay" },
    { "do": "wait", "seconds": 1.4, "onTheClock": true },
    { "do": "action", "action": "videoPause" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "describe", "stage": "5-played", "note": "played from the start: the title swings round to face you and sinks back, and stops" },
    { "do": "snapshot", "name": "5-played" }
  ]
}
