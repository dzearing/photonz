{
  "out": "/tmp/photonz-playtest/ask-adds-a-title-page-walk",
  "seed": "Ask on a video at Next defaults: the sample recording open, the title bar's Ask button, 'add a title page that says Case 1 before this clip', the plan in the Agent group with nothing run, Run Plan puts a title page reading Case 1 in front of the clip, and one undo takes it back. Needs Ollama with a model Ask plans with (docs/design/ask.md).",
  "clock": 420,
  "setup": {
    "timelineOpen": true,
    "forget": [
      "all"
    ]
  },
  "steps": [
    {
      "do": "action",
      "action": "openSampleRecording"
    },
    {
      "do": "wait",
      "seconds": 2.0
    },
    {
      "do": "action",
      "action": "videoPause"
    },
    {
      "do": "press",
      "control": "Ask"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "type",
      "text": "add a title page that says Case 1 before this clip"
    },
    {
      "do": "wait",
      "seconds": 0.3
    },
    {
      "do": "press",
      "control": "Ask Send"
    },
    {
      "do": "waitFor",
      "condition": "askPhase",
      "value": "ran|stopped",
      "timeout": 300
    },
    {
      "do": "describe",
      "stage": "run-ended",
      "note": "where the request ended: it runs as soon as the model is done, with no Run Plan"
    },
    {
      "do": "waitFor",
      "condition": "askPhase",
      "value": "ran",
      "timeout": 1
    },
    {
      "do": "wait",
      "seconds": 0.8
    },
    {
      "do": "describe",
      "stage": "1-ran",
      "note": "a title page reading Case 1 in front of the clip, and one row in the Agent group saying what changed"
    },
    {
      "do": "expectLayers",
      "atLeast": 2
    },
    {
      "do": "expect",
      "control": "Agent Change 1",
      "present": true
    },
    {
      "do": "expect",
      "control": "Ask Step 1",
      "present": false
    },
    {
      "do": "expect",
      "control": "Run Plan",
      "present": false
    },
    {
      "do": "snapshot",
      "name": "1-ran"
    },
    {
      "do": "action",
      "action": "undo"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "describe",
      "stage": "2-undone",
      "note": "one Command Z took the whole request back, and its row reads off"
    },
    {
      "do": "expectLayers",
      "count": 1
    },
    {
      "do": "expect",
      "control": "Agent Change 1 Switch",
      "reads": "off"
    },
    {
      "do": "action",
      "action": "redo"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "expect",
      "control": "Agent Change 1 Switch",
      "reads": "on"
    },
    {
      "do": "press",
      "control": "Agent Change 1 Switch"
    },
    {
      "do": "wait",
      "seconds": 0.6
    },
    {
      "do": "describe",
      "stage": "3-off",
      "note": "the row's switch turned the change off: the document reads as before the request"
    },
    {
      "do": "expectLayers",
      "count": 1
    },
    {
      "do": "expect",
      "control": "Agent Change 1 Switch",
      "reads": "off"
    },
    {
      "do": "snapshot",
      "name": "3-off"
    },
    {
      "do": "press",
      "control": "Agent Change 1 Switch"
    },
    {
      "do": "wait",
      "seconds": 0.6
    },
    {
      "do": "describe",
      "stage": "4-on",
      "note": "the switch put the change back"
    },
    {
      "do": "expectLayers",
      "atLeast": 2
    },
    {
      "do": "expect",
      "control": "Agent Change 1 Switch",
      "reads": "on"
    },
    {
      "do": "snapshot",
      "name": "4-on"
    },
    {
      "do": "press",
      "control": "Agent Change 1 Words"
    },
    {
      "do": "wait",
      "seconds": 0.4
    },
    {
      "do": "describe",
      "stage": "4b-picked",
      "note": "clicking the row's words picked the title page it made"
    },
    {
      "do": "expectPicked",
      "layers": [
        "Title Page"
      ]
    },
    {
      "do": "press",
      "control": "Agent Change 1 Delete"
    },
    {
      "do": "wait",
      "seconds": 0.6
    },
    {
      "do": "describe",
      "stage": "5-deleted",
      "note": "delete took the change out and the row went"
    },
    {
      "do": "expectLayers",
      "count": 1
    },
    {
      "do": "expect",
      "control": "Agent Change 1",
      "present": false
    },
    {
      "do": "snapshot",
      "name": "5-deleted"
    },
    {
      "do": "action",
      "action": "undo"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "describe",
      "stage": "6-delete-undone",
      "note": "undoing the delete brought the change and its row back"
    },
    {
      "do": "expectLayers",
      "atLeast": 2
    },
    {
      "do": "expect",
      "control": "Agent Change 1",
      "present": true
    }
  ]
}
