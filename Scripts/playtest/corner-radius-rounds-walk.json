{
  "out": "/tmp/photonz-playtest/corner-radius-rounds",
  "setup": { "forget": ["shapes", "color", "panel"] },
  "steps": [
    { "do": "blank", "canvasWidth": 900, "canvasHeight": 600, "width": 1280, "height": 900 },
    { "do": "wait", "seconds": 1 },
    { "do": "key", "key": "r" },
    { "do": "drag", "from": [340, 300], "to": [560, 460] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "press", "control": "Slider", "in": "Border", "across": 0.3 },
    { "do": "wait", "seconds": 0.5 },
    { "do": "panelMenu", "menu": "Border", "choose": "Outside" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "press", "control": "Color", "in": "Border" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "press", "control": "Shades 9" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "1-square", "note": "a rectangle whose border is thickened, darkened and put outside its edge, both square" },
    { "do": "panel", "stage": "1-square" },
    { "do": "snapshot", "name": "1-square" },
    { "do": "render", "name": "1-canvas-square" },
    { "do": "press", "control": "Slider", "in": "Corner Radius", "across": 0.6 },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "2-rounded-outside", "note": "corner radius pulled up: the shape rounds and the outside border follows it" },
    { "do": "panel", "stage": "2-rounded-outside" },
    { "do": "snapshot", "name": "2-rounded-outside" },
    { "do": "render", "name": "2-canvas-rounded-outside" },
    { "do": "panelMenu", "menu": "Border", "choose": "Inside" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "3-rounded-inside", "note": "the same ring moved inside the edge, still following the corner" },
    { "do": "render", "name": "3-canvas-rounded-inside" },
    { "do": "snapshot", "name": "3-rounded-inside" },
    { "do": "panelMenu", "menu": "Border", "choose": "Center" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "4-rounded-centred", "note": "and centred on the edge" },
    { "do": "render", "name": "4-canvas-rounded-centred" },
    { "do": "panelMenu", "menu": "Border", "choose": "Outside" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "drag", "from": [560, 460], "to": [700, 520] },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "5-resized", "note": "the shape dragged bigger by its corner handle: the curve and the ring hold together" },
    { "do": "render", "name": "5-canvas-resized" },
    { "do": "snapshot", "name": "5-resized" },
    { "do": "action", "action": "zoomIn" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "action", "action": "zoomIn" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "6-zoomed", "note": "zoomed in twice: the ring is still on the corner and still as thick" },
    { "do": "snapshot", "name": "6-zoomed" },
    { "do": "action", "action": "zoomToFit" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "action", "action": "group" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "7-grouped", "note": "the same shape inside a group: nothing about its corner or its ring changed" },
    { "do": "render", "name": "7-canvas-grouped" },
    { "do": "snapshot", "name": "7-grouped" }
  ]
}
