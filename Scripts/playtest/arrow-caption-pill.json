{
  "out": "/tmp/photonz-playtest/arrow-caption-pill",
  "steps": [
    { "do": "open", "file": "../../Tests/PhotonzRenderTests/Fixtures/settings-pane-2x.png", "width": 1280, "height": 840 },
    { "do": "wait", "seconds": 1 },
    { "do": "action", "action": "zoomToFit" },
    { "do": "wait", "seconds": 0.5 },

    { "do": "key", "key": "i" },
    { "do": "waitFor", "condition": "tool", "value": "measure" },
    { "do": "measureMode", "mode": "distance" },
    { "do": "waitFor", "condition": "edgeMap", "timeout": 6 },
    { "do": "click", "at": [300, 300] },
    { "do": "click", "at": [700, 300] },
    { "do": "click", "at": [500, 220] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "0-measure", "note": "a caliper whose pill is the reference look" },
    { "do": "key", "key": "escape" },

    { "do": "key", "key": "a" },
    { "do": "waitFor", "condition": "tool", "value": "arrow" },
    { "do": "drag", "from": [900, 700], "to": [1150, 520], "steps": 12 },
    { "do": "waitFor", "condition": "captionField", "timeout": 3 },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "1-field-empty", "note": "the field just opened, nothing typed" },
    { "do": "snapshot", "name": "1-typing-empty" },
    { "do": "wait", "seconds": 0.35 },
    { "do": "snapshot", "name": "1-typing-empty-b" },
    { "do": "type", "text": "Primary action" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "2-typing", "note": "mid-draft, field holds text" },
    { "do": "snapshot", "name": "2-typing" },
    { "do": "key", "key": "return", "modifiers": ["command"] },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "3-committed", "note": "committed pill in the same spot" },
    { "do": "snapshot", "name": "3-committed" },
    { "do": "render", "name": "3-committed" },

    { "do": "key", "key": "a" },
    { "do": "waitFor", "condition": "tool", "value": "arrow" },
    { "do": "drag", "from": [500, 780], "to": [420, 560], "steps": 12 },
    { "do": "waitFor", "condition": "captionField", "timeout": 3 },
    { "do": "wait", "seconds": 0.4 },
    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "4-escaped", "note": "plain arrow, no bubble" },
    { "do": "snapshot", "name": "4-escaped" },
    { "do": "render", "name": "4-escaped" },

    { "do": "click", "at": [1025, 610], "count": 2 },
    { "do": "waitFor", "condition": "captionField", "timeout": 3 },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "5-reedit", "note": "double-click reopens the caption inside its own bubble" },
    { "do": "snapshot", "name": "5-reedit" },
    { "do": "click", "at": [300, 880] },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "6-click-away", "note": "clicking off commits; no bubble left behind" },
    { "do": "snapshot", "name": "6-click-away" },
    { "do": "render", "name": "6-click-away" }
  ]
}
