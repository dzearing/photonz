{
  "out": "/tmp/photonz-playtest/panel-toggle-titlebar",
  "setup": { "forget": ["panel", "measure", "shapes"] },
  "steps": [
    { "do": "open", "file": "../../Tests/PhotonzRenderTests/Fixtures/settings-pane-2x.png", "width": 1280, "height": 840 },
    { "do": "wait", "seconds": 1 },
    { "do": "action", "action": "showInspector" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "1-panel-open", "note": "the toggle sits at the trailing end of the title bar, level with the traffic lights, and the panel header is clear" },
    { "do": "snapshot", "name": "1-panel-open" },
    { "do": "hover", "label": "Hide Panel" },
    { "do": "snapshot", "name": "2-tooltip" },
    { "do": "press", "control": "Panel" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "3-panel-closed", "note": "the panel goes and the button has not moved: same spot, quieter glyph" },
    { "do": "snapshot", "name": "3-panel-closed" },
    { "do": "press", "control": "Panel" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "4-panel-back", "note": "the same button in the same place brings it back" },
    { "do": "snapshot", "name": "4-panel-back" },
    { "do": "key", "key": "l", "modifiers": ["command", "option"] },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "5-shortcut-closes", "note": "the shortcut still works and the button follows it" },
    { "do": "snapshot", "name": "5-shortcut-closes" },
    { "do": "key", "key": "l", "modifiers": ["command", "option"] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "key", "key": "i" },
    { "do": "waitFor", "condition": "tool", "value": "measure" },
    { "do": "waitFor", "condition": "edgeMap", "timeout": 15 },
    { "do": "measureMode", "mode": "distance" },
    { "do": "click", "at": [100, 80] },
    { "do": "click", "at": [400, 80] },
    { "do": "click", "at": [250, 120] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "measureMode", "mode": "size" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "6-legend-whole-corner", "note": "top left taken: the key takes the whole top right corner of the canvas, no button-shaped hole above it" },
    { "do": "snapshot", "name": "6-legend-whole-corner" }
  ]
}
