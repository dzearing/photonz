{
  "out": "/tmp/photonz-playtest/flip-a-layer-walk",
  "seed": "Flip Horizontal and Flip Vertical at Next defaults with no flag changed. A picture half dark and half light is dropped on a blank canvas and words are typed beside it. The picture is flipped left to right from its own right-click menu, then top to bottom from Edit > Transform, and one undo takes back only the second flip. The words are flipped from the menu bar and read mirrored. Last, both are picked and flipped together about their shared middle, so they swap sides. The menu bar is only live with the app in front, so this walk takes the front.",
  "setup": { "forget": ["all"], "front": true },
  "steps": [
    { "do": "blank", "canvasWidth": 1240, "canvasHeight": 900, "width": 1240, "height": 900 },
    { "do": "dropImage", "file": "fixtures/Half dark half light 900x700.png", "at": [400, 400] },
    { "do": "wait", "seconds": 1.0 },
    { "do": "tool", "tool": "text" },
    { "do": "click", "at": [900, 200] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "type", "text": "Flip me" },
    { "do": "key", "key": "return", "modifiers": ["command"] },
    { "do": "wait", "seconds": 0.8 },
    { "do": "tool", "tool": "select" },
    { "do": "click", "at": [400, 400] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "1-before", "note": "the picture picked, nothing flipped yet" },
    { "do": "snapshot", "name": "1-before" },
    { "do": "rightClick", "at": [400, 400], "shot": "2-right-click-menu", "choose": "Flip Horizontal" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectFlip", "horizontal": true },
    { "do": "snapshot", "name": "3-flipped-from-right-click" },
    { "do": "menus", "stage": "4-edit-transform", "menu": "Edit", "choose": "Edit > Transform > Flip Vertical" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectFlip", "horizontal": true, "vertical": true },
    { "do": "snapshot", "name": "4-flipped-from-the-edit-menu" },
    { "do": "shortcut", "key": "z", "modifiers": ["command"], "menuItem": "Undo" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectFlip", "horizontal": true },
    { "do": "click", "at": [940, 215] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "menus", "stage": "5-words", "menu": "Edit", "choose": "Edit > Transform > Flip Horizontal" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectFlip", "horizontal": true },
    { "do": "describe", "stage": "5-words-mirrored", "note": "the words read mirrored, which is what a flip of words means" },
    { "do": "snapshot", "name": "5-words-mirrored" },
    { "do": "render", "name": "5-document" }
  ]
}
