    {
      "do": "expectTimeline",
      "lengthMS": 90000
    },
    {
      "do": "describe",
      "stage": "6-let-go-on-the-timeline",
      "note": "the same song let go on the timeline at 0:00 lands the same: under the cut on a sound track, stopping at 1:30"
    },
    {
      "do": "snapshot",
      "name": "6-dropped-song-stops-with-the-picture"
