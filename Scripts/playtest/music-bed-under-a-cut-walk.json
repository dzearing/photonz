      "action": "openLongRetinaTalk"
    },
    {
      "do": "action",
      "action": "captionsWriteQuietly"
    },
    {
      "do": "wait",
      "seconds": 1.0
    },
    {
      "do": "expectTimeline",
      "lengthMS": 319240,
      "rate": 0,
      "keyboard": "timeline"
    },
    {
      "do": "describe",
      "stage": "0-opened",
      "note": "the recording as it opens, nothing pressed and not playing: five minutes and nineteen seconds on one track, the captions already written underneath, the timeline holding the keyboard"
    },
    {
      "do": "snapshot",
      "name": "0-five-minutes-opened"
    },
    {
      "do": "describe",
      "stage": "head",
