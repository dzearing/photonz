   "action": "videoPause"
  },
  {
   "do": "action",
   "action": "videoSeekStart"
  },
  {
   "do": "action",
   "action": "videoStepOneSecond"
  },
  {
   "do": "wait",
   "seconds": 0.6
  },
  {
   "do": "tool",
   "tool": "select"
  },
  {
   "do": "wait",
   "seconds": 0.4
  },
  {
   "do": "click",
   "at": [
    520,
    300
   ]
  },
  {
   "do": "wait",
   "seconds": 0.6
  },
