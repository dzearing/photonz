  {
   "do": "press",
   "control": "Transform W"
  },
  {
   "do": "key",
   "key": "a",
   "modifiers": [
    "command"
   ]
  },
  {
   "do": "type",
   "text": "500"
  },
  {
   "do": "key",
   "key": "return"
  },
  {
   "do": "wait",
   "seconds": 0.6
  },
  {
   "do": "expect",
   "field": "Transform W",
   "reads": "500"
  },
  {
   "do": "expect",
   "field": "Transform H",
   "reads": "400"
  },
  {
   "do": "describe",
   "stage": "4-unlinked-typed",
