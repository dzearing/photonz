   "modifiers": [
    "command"
   ]
  },
  {
   "do": "type",
   "text": "640"
  },
  {
   "do": "key",
   "key": "return"
  },
  {
   "do": "wait",
   "seconds": 0.6
  },
  {
   "do": "expect",
   "field": "Transform W",
   "reads": "640"
  },
  {
   "do": "expect",
   "field": "Transform H",
   "reads": "400"
  },
  {
   "do": "describe",
