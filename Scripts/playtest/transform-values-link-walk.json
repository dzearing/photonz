  },
  {
   "do": "type",
   "text": "400"
  },
  {
   "do": "key",
   "key": "return"
  },
  {
   "do": "wait",
   "seconds": 0.6
  },
  {
   "do": "expect",
   "field": "Transform W",
   "reads": "640"
