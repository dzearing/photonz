{
  "out": "/tmp/photonz-playtest/ask-paints-then-edits-walk",
  "seed": "try-drawing-with-a-local-picture-model-then-turn: at Next defaults with the picture model set up in Settings > Ask (Photonz starts it), Ask paints a cat curled up asleep as layers, then a second request recolours it and a third moves it, because the painted drawing is real layers",
  "clock": 900,
  "setup": { "forget": ["all"] },
  "steps": [
    { "do": "blank", "canvasWidth": 1440, "canvasHeight": 1024, "width": 1280, "height": 840 },
    { "do": "wait", "seconds": 1 },
    { "do": "press", "control": "Ask" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "type", "text": "draw a cat curled up asleep" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "press", "control": "Ask Send" },
    { "do": "waitFor", "condition": "askPhase", "value": "planning|running|ran|stopped", "timeout": 15 },
    { "do": "waitFor", "condition": "askPhase", "value": "ran|stopped", "timeout": 300 },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "1-painted", "note": "the cat is painted and traced: one group of named, filled paths" },
    { "do": "snapshot", "name": "1-painted" },
    { "do": "press", "control": "Ask" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "type", "text": "make the cat black" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "press", "control": "Ask Send" },
    { "do": "waitFor", "condition": "askPhase", "value": "planning|running|ran|stopped", "timeout": 15 },
    { "do": "waitFor", "condition": "askPhase", "value": "ran|stopped", "timeout": 300 },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "2-black", "note": "the cat's paths are recoloured" },
    { "do": "snapshot", "name": "2-black" },
    { "do": "press", "control": "Ask" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "type", "text": "move the cat to the left" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "press", "control": "Ask Send" },
    { "do": "waitFor", "condition": "askPhase", "value": "planning|running|ran|stopped", "timeout": 15 },
    { "do": "waitFor", "condition": "askPhase", "value": "ran|stopped", "timeout": 300 },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "3-moved", "note": "the cat's group sits further left" },
    { "do": "snapshot", "name": "3-moved" }
  ]
}
