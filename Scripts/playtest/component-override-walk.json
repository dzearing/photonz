{
  "out": "/tmp/photonz-playtest/component-override-walk",
  "steps": [
    { "do": "blank", "canvasWidth": 1440, "canvasHeight": 1024, "width": 1240, "height": 900 },

    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [200, 200], "to": [520, 300] },
    { "do": "tool", "tool": "text" },
    { "do": "click", "at": [230, 330] },
    { "do": "type", "text": "Auto-enhance" },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "drag", "from": [150, 150], "to": [640, 420] },
    { "do": "wait", "seconds": 0.3 },
    { "do": "action", "action": "group" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "action", "action": "makeComponent" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "type", "text": "Setting" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.8 },

    { "do": "action", "action": "exposeWording" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "1-exposed",
      "note": "the original's section grew an Adjustable list with one wording knob on it" },
    { "do": "snapshot", "name": "component-override-1-exposed" },
    { "do": "menus", "stage": "1-layer-menu", "menu": "Layer" },

    { "do": "action", "action": "pickFirstComponent" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "action", "action": "insertPickedComponent" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "2-copy",
      "note": "a copy is placed and selected, and its section shows the one knob the original exposed" },
    { "do": "snapshot", "name": "component-override-2-copy" },

    { "do": "focus", "field": "Auto-enhance" },
    { "do": "type", "text": "Sharpen" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "3-overridden",
      "note": "this copy alone says Sharpen; the original and its label are untouched" },
    { "do": "snapshot", "name": "component-override-3-overridden" },
    { "do": "render", "name": "component-override-3-overridden-doc" },

    { "do": "action", "action": "pickFirstComponent" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "dropComponent", "at": [1050, 700] },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "4-second-copy",
      "note": "a second copy arrives following the original, so it still says Auto-enhance" },
    { "do": "snapshot", "name": "component-override-4-second-copy" },

    { "do": "click", "at": [400, 250] },
    { "do": "wait", "seconds": 0.3 },
    { "do": "click", "at": [280, 330], "count": 2 },
    { "do": "wait", "seconds": 0.4 },
    { "do": "key", "key": "down" },
    { "do": "key", "key": "down" },
    { "do": "key", "key": "down" },
    { "do": "key", "key": "down" },
    { "do": "key", "key": "down" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "5-original-edited",
      "note": "moving a piece of the original reached BOTH copies, including the one that had overridden its wording" },
    { "do": "snapshot", "name": "component-override-5-original-edited" },
    { "do": "render", "name": "component-override-5-original-edited-doc" },

    { "do": "click", "at": [1050, 700] },
    { "do": "wait", "seconds": 0.4 },
    { "do": "action", "action": "detachInstance" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "6-detached",
      "note": "the second copy is now ordinary layers, and the pill says it stopped following" },
    { "do": "snapshot", "name": "component-override-6-detached" },

    { "do": "action", "action": "undo" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "7-undone", "note": "undo put the copy back on its original" },
    { "do": "render", "name": "component-override-7-undone-doc" }
  ]
}
