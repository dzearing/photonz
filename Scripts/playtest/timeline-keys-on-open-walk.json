{
  "out": "/tmp/photonz-playtest/timeline-keys-on-open-walk",
  "setup": { "forget": ["all"] },
  "steps": [
    { "do": "open", "file": "fixtures/Full screen Retina recording 3456x2234.mp4", "width": 1440, "height": 900 },
    { "do": "key", "key": "l" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "describe", "stage": "1-l-plays", "note": "a recording opened at Next defaults and the very first thing done was a press of L: it plays, as it does in Premiere, and the ring round the timeline says the keys are the timeline's" },
    { "do": "expectTimeline", "keyboard": "timeline", "rate": 1 },
    { "do": "snapshot", "name": "1-l-plays-on-open" },

    { "do": "key", "key": "k" },
    { "do": "wait", "seconds": 0.2 },
    { "do": "expectTimeline", "rate": 0 },
    { "do": "key", "key": "j" },
    { "do": "wait", "seconds": 0.2 },
    { "do": "describe", "stage": "2-k-stops-j-reverses", "note": "K stopped it and J played it backwards" },
    { "do": "expectTimeline", "rate": -1 },
    { "do": "key", "key": "k" },
    { "do": "wait", "seconds": 0.2 },
    { "do": "expectTimeline", "rate": 0 },

    { "do": "key", "key": "home" },
    { "do": "key", "key": "right", "modifiers": ["shift"] },
    { "do": "key", "key": "i" },
    { "do": "key", "key": "end" },
    { "do": "key", "key": "left", "modifiers": ["shift"] },
    { "do": "key", "key": "o" },
    { "do": "key", "key": "m" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "describe", "stage": "3-in-out-marker", "note": "I set the In five frames in, O the Out five frames from the end, and M dropped a marker there, all without a click anywhere first" },
    { "do": "expectTimeline", "hasIn": true, "hasOut": true, "markers": 1 },
    { "do": "snapshot", "name": "3-in-out-and-a-marker" },

    { "do": "key", "key": "b" },
    { "do": "wait", "seconds": 0.2 },
    { "do": "describe", "stage": "4-b-is-the-blade", "note": "B picked up the Blade" },
    { "do": "expectTimeline", "blade": true },
    { "do": "snapshot", "name": "4-b-is-the-blade" },
    { "do": "key", "key": "v" },
    { "do": "wait", "seconds": 0.2 },
    { "do": "expectTimeline", "blade": false },

    { "do": "key", "key": "p" },
    { "do": "waitFor", "condition": "tool", "value": "pen", "timeout": 2 },
    { "do": "describe", "stage": "5-p-is-still-the-pen", "note": "a letter the timeline has no use for still picks its picture tool while the timeline holds the keyboard: P is the Pen" },
    { "do": "expectTimeline", "keyboard": "timeline" },
    { "do": "key", "key": "v" },
    { "do": "waitFor", "condition": "tool", "value": "select", "timeout": 2 },

    { "do": "click", "at": [720, 300] },
    { "do": "wait", "seconds": 0.3 },
    { "do": "expectTimeline", "keyboard": "canvas" },
    { "do": "key", "key": "l" },
    { "do": "waitFor", "condition": "tool", "value": "line", "timeout": 2 },
    { "do": "describe", "stage": "6-canvas-click-gives-picture-keys", "note": "a click on the picture handed the keyboard to the canvas: the ring went, and L picked the Line tool, as it does in Photoshop" },
    { "do": "expectTimeline", "keyboard": "canvas", "rate": 0 },
    { "do": "snapshot", "name": "6-l-after-a-canvas-click-is-the-line" }
  ]
}
