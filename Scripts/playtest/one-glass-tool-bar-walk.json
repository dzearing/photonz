{
  "out": "/tmp/photonz-playtest/one-glass-tool-bar-walk",
  "setup": { "forget": ["all"] },
  "steps": [
    { "do": "action", "action": "openSampleRecording" },
    { "do": "wait", "seconds": 2.0 },
    { "do": "action", "action": "videoPause" },
    { "do": "key", "key": "2", "modifiers": ["command"] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "toolBar", "stage": "1-video", "capsules": 1, "toolGap": 4, "hairline": 18, "height": 38, "zoom": false,
      "slots": ["Select", "Blade", "Text", "Shapes", "Measure", "Selection", "Crop", "Arrow", "Highlight", "Lens", "Frame", "Pen", "Fill"], "more": [] },
    { "do": "describe", "stage": "1-video", "note": "a recording opened at Next defaults, no flag touched: the tools and the grid are ONE glass bar with a hairline between them, as video.html's floating tool bar draws it, tools 4pt apart and 18pt hairlines, the glass 38pt tall. The window has room for every tool, so there is no More, and no zoom: zoom is not a tool" },
    { "do": "snapshot", "name": "1-video-one-bar" },

    { "do": "key", "key": "g" },
    { "do": "waitFor", "condition": "tool", "value": "fill" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "toolBar", "stage": "2-video-painting", "capsules": 1, "lit": "Fill", "zoom": false, "toolGap": 4, "hairline": 18, "height": 38 },
    { "do": "describe", "stage": "2-video-painting", "note": "with the bucket in hand the colour pair joins the same bar after the tools, a hairline before it, rather than floating beside it in a capsule of its own" },
    { "do": "snapshot", "name": "2-video-colour-pair" },

    { "do": "open", "file": "../../Tests/PhotonzRenderTests/Fixtures/settings-pane-2x.png", "width": 1280, "height": 840 },
    { "do": "wait", "seconds": 1.2 },
    { "do": "toolBar", "stage": "3-picture", "capsules": 1, "clearOfPicture": true, "toolGap": 4, "hairline": 18, "height": 38, "zoom": false },
    { "do": "describe", "stage": "3-picture", "note": "a picture's bar is the same one bar: its tool families and the grid, hairlines between, and no zoom" },
    { "do": "snapshot", "name": "3-picture-one-bar" },

    { "do": "open", "file": "../../Tests/PhotonzRenderTests/Fixtures/settings-pane-2x.png", "width": 700, "height": 700 },
    { "do": "wait", "seconds": 1.2 },
    { "do": "toolBar", "stage": "4-picture-narrow", "capsules": 1, "clearOfPicture": true, "toolGap": 4, "hairline": 18, "height": 38 },
    { "do": "describe", "stage": "4-picture-narrow", "note": "a narrow window folds the trailing tools into More before anything clips, and the bar stays one glass bar" },
    { "do": "snapshot", "name": "4-picture-narrow" }
  ]
}
