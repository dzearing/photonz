{
  "out": "/tmp/photonz-playtest/roll-the-cut-between-two-clips-walk",
  "seed": "The cut where one clip ends and the next starts rolls to the playhead from its right-click, the way a join inside one clip does and the way any edit point does in Premiere: the outgoing clip gets longer by exactly what the incoming one gives up and nothing after it moves. At Next defaults, no flag set.",
  "setup": {
    "timelineOpen": true,
    "forget": ["all"],
    "scratch": ["sample:recording as b-roll.mp4"]
  },
  "steps": [
    { "do": "action", "action": "openSampleRecording" },
    { "do": "wait", "seconds": 2.0 },
    { "do": "action", "action": "videoPause" },
    { "do": "tool", "tool": "select" },

    { "do": "action", "action": "videoSeekStart" },
    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "key", "key": "w" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectClip", "clip": "Tutorial Sample", "track": "V1", "startsAt": 0.0, "endsAt": 6.0, "count": 1 },

    { "do": "dropOnTimeline", "file": "scratch/b-roll.mp4", "track": "V1", "seconds": 5.96 },
    { "do": "wait", "seconds": 1.0 },
    { "do": "expectClip", "clip": "b-roll", "track": "V1", "startsAt": 6.0, "endsAt": 14.0, "count": 1 },

    { "do": "action", "action": "videoSeekStart" },
    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "key", "key": "q" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectClip", "clip": "Tutorial Sample", "track": "V1", "startsAt": 0.0, "endsAt": 6.0, "count": 1 },
    { "do": "expectClip", "clip": "b-roll", "track": "V1", "startsAt": 6.0, "endsAt": 13.0, "count": 1 },
    { "do": "describe", "stage": "1-two-clips-meet", "note": "The recording cut down to its first six seconds with W, b-roll butted onto it, and b-roll's first second taken off with Q: two clips meet at six seconds, each with spare footage past the cut (two seconds after the recording, one before the b-roll)" },

    { "do": "action", "action": "videoSeekStart" },
    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "expectTimeline", "playheadMS": 7000 },
    { "do": "snapshot", "name": "1-before-the-roll" },

    { "do": "rightClick", "on": "Edit point Tutorial Sample to b-roll", "shot": "2-edit-point-menu", "choose": "Roll Edit to Playhead" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectClip", "clip": "Tutorial Sample", "track": "V1", "startsAt": 0.0, "endsAt": 7.0, "count": 1 },
    { "do": "expectClip", "clip": "b-roll", "track": "V1", "startsAt": 7.0, "endsAt": 13.0, "count": 1 },
    { "do": "expectWaveform", "clip": "b-roll", "within": 1 },
    { "do": "expect", "control": "Edit point Tutorial Sample to b-roll", "present": true },
    { "do": "describe", "stage": "2-rolled", "note": "Playhead at seven seconds, right-click the cut between the clips, Roll Edit to Playhead: the recording now runs to seven, b-roll starts at seven and still ends at thirteen, the cut is picked on the playhead and each clip's sound is still under it" },
    { "do": "snapshot", "name": "3-after-the-roll" },

    { "do": "action", "action": "undo" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectClip", "clip": "Tutorial Sample", "track": "V1", "startsAt": 0.0, "endsAt": 6.0, "count": 1 },
    { "do": "expectClip", "clip": "b-roll", "track": "V1", "startsAt": 6.0, "endsAt": 13.0, "count": 1 },
    { "do": "describe", "stage": "3-undone", "note": "One Command Z puts the cut back at six seconds: the roll was one step" },

    { "do": "action", "action": "redo" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectClip", "clip": "b-roll", "track": "V1", "startsAt": 7.0, "endsAt": 13.0, "count": 1 },
    { "do": "action", "action": "videoSeekStart" },
    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "rightClick", "on": "Edit point Tutorial Sample to b-roll", "shot": "4-no-spare-menu" },
    { "do": "describe", "stage": "4-too-far", "note": "Playhead at one second, far before what the b-roll has spare: the menu still offers Roll Edit to Playhead, dimmed" }
  ]
}
