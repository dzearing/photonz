{
 "out": "/tmp/photonz-playtest/clicking-a-timeline-item-moves-the-playhead-walk",
 "seed": "At Next defaults, with no switch touched: a click on a clip, its sound, a title bar or a zoom bar picks it AND puts the playhead on the moment clicked. A right click moves the playhead there first, so Split at Playhead cuts where the pointer was, and picks what it landed on. A right click inside a pick of two keeps both picked, and its Delete takes both. A click while it plays jumps the playing there; a drag moves the clip and leaves the playhead alone.",
 "setup": { "timelineOpen": true, "forget": ["all"] },
 "steps": [
  { "do": "action", "action": "openSampleRecording" },
  { "do": "wait", "seconds": 2.0 },
  { "do": "action", "action": "videoPause" },
  { "do": "tool", "tool": "select" },
  { "do": "clickRuler", "seconds": 2.0 },
  { "do": "wait", "seconds": 0.3 },
  { "do": "action", "action": "zoomAddAtPlayhead" },
  { "do": "wait", "seconds": 0.3 },
  { "do": "rightClick", "on": "Track V1", "choose": "Add Track Above" },
  { "do": "wait", "seconds": 0.6 },
  { "do": "rightClick", "on": "Track V2", "choose": "Add Title Page > Stacked Stagger" },
  { "do": "wait", "seconds": 1.2 },
  { "do": "key", "key": "escape" },
  { "do": "key", "key": "escape" },
  { "do": "key", "key": "home" },
  { "do": "wait", "seconds": 0.4 },
  { "do": "expectTimeline", "playheadMS": 0, "withinMS": 40, "rate": 0 },

  { "comment": "A click in the middle of the recording's clip, about five seconds in.", "do": "windowClick", "at": [1107, 868] },
  { "do": "wait", "seconds": 0.4 },
  { "do": "expectPicked", "layers": ["Tutorial Sample"] },
  { "do": "expectTimeline", "playheadMS": 4874, "withinMS": 120, "rate": 0 },
  { "do": "describe", "stage": "1-clip", "note": "One click on the clip five seconds in: the clip is picked and the playhead is on the moment clicked" },
  { "do": "snapshot", "name": "1-clip-clicked" },

  { "comment": "Its sound, about 5.6 seconds in, under its level line.", "do": "windowClick", "at": [1250, 941] },
  { "do": "wait", "seconds": 0.4 },
  { "do": "expectTimeline", "playheadMS": 5612, "withinMS": 120, "rate": 0 },

  { "comment": "The title bar, under three seconds in.", "do": "windowClick", "at": [700, 835] },
  { "do": "wait", "seconds": 0.4 },
  { "do": "expectPicked", "layers": ["Title Page"] },
  { "do": "expectTimeline", "playheadMS": 2775, "withinMS": 120, "rate": 0 },

  { "comment": "The zoom bar, about 4.3 seconds in.", "do": "windowClick", "at": [1000, 897] },
  { "do": "wait", "seconds": 0.4 },
  { "do": "expectTimeline", "playheadMS": 4322, "withinMS": 120, "rate": 0 },
  { "do": "describe", "stage": "2-zoom", "note": "One click on the zoom bar 4.3 seconds in: the zoom is picked and the playhead is there" },
  { "do": "snapshot", "name": "2-zoom-clicked" },

  { "comment": "A right click on the clip, not picked, about 5.9 seconds in: the playhead goes there first, so Split at Playhead cuts there.", "do": "key", "key": "escape" },
  { "do": "key", "key": "home" },
  { "do": "wait", "seconds": 0.3 },
  { "do": "rightClick", "at": [1300, 868], "space": "window", "choose": "Split at Playhead" },
  { "do": "wait", "seconds": 0.5 },
  { "do": "expectClip", "clip": "Tutorial Sample", "pieces": 2 },
  { "do": "expectTimeline", "playheadMS": 5870, "withinMS": 120, "rate": 0 },
  { "do": "windowClick", "at": [1270, 868] },
  { "do": "wait", "seconds": 0.3 },
  { "do": "expectTimelinePick", "clips": ["Tutorial Sample piece 1"] },
  { "do": "windowClick", "at": [1330, 868] },
  { "do": "wait", "seconds": 0.3 },
  { "do": "expectTimelinePick", "clips": ["Tutorial Sample piece 2"] },
  { "do": "describe", "stage": "3-split-where-pointed", "note": "Right click at 5.9 seconds, Split at Playhead: the cut is where the pointer was, a click just left of it picks the first piece and just right of it the second" },
  { "do": "snapshot", "name": "3-split-where-pointed" },
  { "do": "action", "action": "undo" },
  { "do": "wait", "seconds": 0.4 },
  { "do": "expectClip", "clip": "Tutorial Sample", "pieces": 1 },

  { "comment": "A right click on the title, not picked, picks it.", "do": "key", "key": "escape" },
  { "do": "wait", "seconds": 0.3 },
  { "do": "rightClick", "at": [900, 835], "space": "window" },
  { "do": "wait", "seconds": 0.4 },
  { "do": "expectPicked", "layers": ["Title Page"] },
  { "do": "expectTimeline", "playheadMS": 3807, "withinMS": 120, "rate": 0 },

  { "comment": "Shift click the clip: two picked. A right click inside the pick keeps both, and its Delete takes both.", "do": "windowClick", "at": [1500, 868], "modifiers": ["shift"] },
  { "do": "wait", "seconds": 0.3 },
  { "do": "expectPicked", "layers": ["Tutorial Sample", "Title Page"] },
  { "do": "expectTimeline", "playheadMS": 6901, "withinMS": 120, "rate": 0 },
  { "do": "rightClick", "at": [1000, 868], "space": "window", "shot": "4-menu-inside-the-pick" },
  { "do": "wait", "seconds": 0.4 },
  { "do": "expectPicked", "layers": ["Tutorial Sample", "Title Page"] },
  { "do": "expectTimeline", "playheadMS": 4322, "withinMS": 120, "rate": 0 },
  { "do": "describe", "stage": "4-pick-kept", "note": "Two picked, a right click on the clip at 4.3 seconds: the playhead moves there and both stay picked" },
  { "do": "snapshot", "name": "4-pick-kept" },
  { "do": "rightClick", "at": [1000, 868], "space": "window", "choose": "Delete" },
  { "do": "wait", "seconds": 0.5 },
  { "do": "expectClip", "clip": "Tutorial Sample", "count": 0 },
  { "do": "expectClip", "clip": "Title Page", "count": 0 },
  { "do": "action", "action": "undo" },
  { "do": "wait", "seconds": 0.5 },
  { "do": "expectClip", "clip": "Tutorial Sample", "count": 1 },
  { "do": "expectClip", "clip": "Title Page", "count": 1 },

  { "comment": "While it plays, a click on the clip jumps the playing there and it carries on.", "do": "key", "key": "escape" },
  { "do": "key", "key": "home" },
  { "do": "key", "key": "space" },
  { "do": "wait", "seconds": 0.5, "onTheClock": true },
  { "do": "windowClick", "at": [1107, 868] },
  { "do": "expectTimeline", "comment": "From the jump to 4.87 s it plays on while the walk looks: never back near the start.", "playheadMS": 5600, "withinMS": 800, "rate": 1 },
  { "do": "key", "key": "space" },
  { "do": "wait", "seconds": 0.3 },

  { "comment": "A drag on the clip moves the clip and leaves the playhead alone.", "do": "windowClick", "at": [1107, 868] },
  { "do": "wait", "seconds": 0.3 },
  { "do": "expectTimeline", "playheadMS": 4874, "withinMS": 120, "rate": 0 },
  { "do": "windowDrag", "from": [1250, 868], "to": [1300, 868], "steps": 6 },
  { "do": "wait", "seconds": 0.4 },
  { "do": "expectTimeline", "playheadMS": 4874, "withinMS": 120, "rate": 0 }
 ]
}
