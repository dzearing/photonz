    { "do": "wait", "seconds": 1.5 },
    { "do": "action", "action": "expectRecordingAsFirst" },
    { "do": "action", "action": "videoPlay" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "action", "action": "videoPause" },
    { "do": "action", "action": "videoSeekMiddle" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "snapshot", "name": "1-open-on-the-first-file" },
    { "do": "action", "action": "rewriteChangingRecording" },
    { "do": "action", "action": "expectOpenRecordingReloaded" },
    { "do": "expectEdited", "edited": false },
    { "do": "snapshot", "name": "2-written-over-while-open" },
    { "do": "action", "action": "putFirstRecordingBack" },
    { "do": "wait", "seconds": 2.0, "onTheClock": true },
    { "do": "action", "action": "expectRecordingAsFirst" },
    { "do": "action", "action": "replaceChangingRecording" },
    { "do": "action", "action": "expectOpenRecordingReloaded" },
    { "do": "snapshot", "name": "3-replaced-while-open" },
    { "do": "action", "action": "putFirstRecordingBack" },
    { "do": "wait", "seconds": 2.0, "onTheClock": true },
    { "do": "action", "action": "videoSeekMiddle" },
    { "do": "key", "key": "b", "modifiers": ["command"] },
    { "do": "wait", "seconds": 0.6 },
