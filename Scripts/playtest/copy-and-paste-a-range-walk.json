{
  "out": "/tmp/photonz-playtest/copy-and-paste-a-range-walk",
  "seed": "Copy, cut and paste a range of time, the way Final Cut copies a range and Premiere pastes in overwrite. At Next defaults, no flag set: the recording and a b-roll clip meet at 0:07 on V1; a range drawn from 0:05 to 0:09 across that cut is copied with Cmd-C (Edit, Copy: a walk cannot press a menu chord in a background app, so it runs the same command), the playhead goes to 0:12, and Cmd-V lays the four seconds in there on V1, covering what was under them, with the playhead waiting at the end. Both copies play, undo takes the paste back in one step, and Cmd-X on the same range takes it out and closes the gap.",
  "setup": {
    "forget": ["all"],
    "scratch": ["sample:recording as b-roll.mp4"]
  },
  "steps": [
    { "do": "action", "action": "openSampleRecording" },
    { "do": "wait", "seconds": 2.0 },
    { "do": "action", "action": "videoPause" },
    { "do": "tool", "tool": "select" },
    { "do": "action", "action": "clipDragEndIn" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "dropOnTimeline", "file": "scratch/b-roll.mp4", "track": "V1", "seconds": 6.95 },
    { "do": "wait", "seconds": 1.0 },
    { "do": "action", "action": "clipDragStartIn" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expectClip", "clip": "Tutorial Sample", "track": "V1", "startsAt": 0.0, "endsAt": 7.0, "count": 1 },
    { "do": "expectClip", "clip": "b-roll", "track": "V1", "startsAt": 7.0, "count": 1 },

    { "do": "dragRuler", "from": 5.0, "to": 9.0 },
    { "do": "expectTimeline", "markInMS": 5000, "markOutMS": 9000, "withinMS": 40 },
    { "do": "action", "action": "copy" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "expectTimeline", "markInMS": 5000, "markOutMS": 9000, "withinMS": 40 },
    { "do": "expectClip", "clip": "Tutorial Sample", "count": 1 },
    { "do": "describe", "stage": "1-range-copied", "note": "a range from 0:05 to 0:09 across the cut at 0:07, copied with Cmd-C (Edit, Copy: a walk cannot press a menu chord in a background app, so it runs the same command): nothing on the timeline changes and the range stays in hand" },
    { "do": "snapshot", "name": "1-range-copied" },

    { "do": "clickRuler", "seconds": 12.0 },
    { "do": "wait", "seconds": 0.3 },
    { "do": "expectTimeline", "hasIn": false, "hasOut": false, "playheadMS": 12000, "withinMS": 40 },
    { "do": "action", "action": "paste" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expectClip", "clip": "Tutorial Sample", "count": 2 },
    { "do": "expectClip", "clip": "Tutorial Sample", "track": "V1", "startsAt": 12.0, "endsAt": 14.0 },
    { "do": "expectClip", "clip": "b-roll", "track": "V1", "startsAt": 14.0, "endsAt": 16.0 },
    { "do": "expectClip", "clip": "b-roll", "track": "V1", "startsAt": 7.0, "endsAt": 12.0 },
    { "do": "expectTimeline", "playheadMS": 16000, "withinMS": 60 },
    { "do": "expectTimelinePick", "clips": ["Tutorial Sample", "b-roll"] },
    { "do": "describe", "stage": "2-pasted-at-the-playhead", "note": "Cmd-V with the playhead at 0:12: the four copied seconds land on V1 from 0:12 to 0:16, the recording's last two seconds then the b-roll's first two, covering the b-roll that was there. What landed is picked and the playhead waits at its end, so a second Cmd-V would follow straight on" },
    { "do": "snapshot", "name": "2-pasted-at-the-playhead" },

    { "do": "expectPlaybackNeverBlank", "name": "playing", "seconds": 16, "moments": 24 },
    { "do": "action", "action": "videoPause" },

    { "do": "action", "action": "undo" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expectClip", "clip": "Tutorial Sample", "count": 1 },
    { "do": "expectClip", "clip": "b-roll", "count": 1, "startsAt": 7.0 },
    { "do": "describe", "stage": "3-undo-takes-the-paste-back", "note": "one undo takes the whole paste back: one recording clip, one b-roll clip, as before" },

    { "do": "dragRuler", "from": 5.0, "to": 9.0 },
    { "do": "action", "action": "cut" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectTimeline", "hasIn": false, "hasOut": false },
    { "do": "expectClip", "clip": "Tutorial Sample", "endsAt": 5.0 },
    { "do": "expectClip", "clip": "b-roll", "startsAt": 5.0 },
    { "do": "describe", "stage": "4-cut-closes-the-gap", "note": "Cmd-X on the same range: the four seconds come out of every track and the gap closes, the b-roll pulling back to 0:05" },
    { "do": "snapshot", "name": "4-cut-closes-the-gap" },

    { "do": "clickRuler", "seconds": 1.0 },
    { "do": "action", "action": "paste" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectClip", "clip": "Tutorial Sample", "track": "V1", "startsAt": 1.0, "endsAt": 3.0 },
    { "do": "expectClip", "clip": "b-roll", "track": "V1", "startsAt": 3.0, "endsAt": 5.0 },
    { "do": "describe", "stage": "5-pasted-what-was-cut", "note": "Cmd-V at 0:01 lays what was cut back in over the recording from 0:01 to 0:05" },
    { "do": "snapshot", "name": "5-pasted-what-was-cut" },
    { "do": "action", "action": "undo" },
    { "do": "action", "action": "undo" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expectClip", "clip": "Tutorial Sample", "endsAt": 7.0, "count": 1 },
    { "do": "expectClip", "clip": "b-roll", "startsAt": 7.0, "count": 1 }
  ]
}
