{
  "out": "/tmp/photonz-playtest/pen-remembers-its-thickness-walk",
  "seed": "Set a drawn path to a different weight and the next thing the Pen drew came back at four anyway, so an icon built out of five strokes meant drawing five and then fixing five. Every other drawing tool in the app starts at the weight you last picked for it. The walk draws a path, rethickens it, draws again, and claims the number.",
  "setup": {
    "forget": ["shapes", "frames", "tools"]
  },
  "steps": [
    { "do": "blank", "canvasWidth": 1600, "canvasHeight": 1100, "width": 1240, "height": 900 },
    { "do": "wait", "seconds": 1 },

    { "do": "key", "key": "p" },
    { "do": "waitFor", "condition": "tool", "value": "pen" },
    { "do": "click", "at": [240, 640] },
    { "do": "wait", "seconds": 0.2 },
    { "do": "click", "at": [400, 640] },
    { "do": "wait", "seconds": 0.2 },
    { "do": "click", "at": [470, 720] },
    { "do": "wait", "seconds": 0.2 },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expectPath", "anchors": 3, "closed": false, "width": 4 },
    { "do": "describe", "stage": "1-ships-with", "note": "a Pen that has never been told otherwise draws at the four every new line in the app ships with" },

    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "action", "action": "dragThickness" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expectPath", "anchors": 3, "width": 9 },
    { "do": "expect", "field": "Thickness", "reads": "9 px" },
    { "do": "describe", "stage": "2-chosen", "note": "the path is pulled to 9 on the Thickness row, which is the only place a path's weight can be chosen" },
    { "do": "snapshot", "name": "2-chosen" },

    { "do": "key", "key": "p" },
    { "do": "waitFor", "condition": "tool", "value": "pen" },
    { "do": "click", "at": [240, 200] },
    { "do": "wait", "seconds": 0.2 },
    { "do": "click", "at": [400, 200] },
    { "do": "wait", "seconds": 0.2 },
    { "do": "click", "at": [470, 280] },
    { "do": "wait", "seconds": 0.2 },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expectPath", "anchors": 3, "width": 9 },
    { "do": "describe", "stage": "3-kept", "note": "THE TEST: the next path off the same Pen comes out at the 9 that was just chosen. It used to come back at 4, so the second stroke of an icon never matched the first." },
    { "do": "snapshot", "name": "3-kept" },

    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expect", "field": "Thickness", "reads": "9 px" },
    { "do": "action", "action": "dragThicknessThin" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expect", "field": "Thickness", "reads": "3 px" },
    { "do": "describe", "stage": "4-thinner", "note": "changing your mind works the same way round: this one goes to 3" },

    { "do": "key", "key": "p" },
    { "do": "waitFor", "condition": "tool", "value": "pen" },
    { "do": "click", "at": [700, 400] },
    { "do": "wait", "seconds": 0.2 },
    { "do": "click", "at": [860, 400] },
    { "do": "wait", "seconds": 0.2 },
    { "do": "click", "at": [930, 480] },
    { "do": "wait", "seconds": 0.2 },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expectPath", "anchors": 3, "width": 3 },
    { "do": "describe", "stage": "5-thin-kept", "note": "the third path arrives at 3, so the Pen holds the LAST weight chosen rather than the first" },
    { "do": "snapshot", "name": "5-thin-kept" },
    { "do": "render", "name": "6-final-render" }
  ]
}
