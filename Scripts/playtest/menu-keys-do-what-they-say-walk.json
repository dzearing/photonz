      "note": "the rectangle's row menu: Duplicate prints Command J, the key that duplicates, and Delete prints Command Delete"
    },
    {
      "do": "shortcut",
      "key": "j",
      "modifiers": [
        "command"
      ],
      "menuItem": "New Layer via Copy"
    },
    {
      "do": "wait",
      "seconds": 0.8
    },
    {
      "do": "expectLayers",
      "count": 3
    },
    {
      "do": "describe",
      "stage": "2-command-j-duplicates",
      "note": "THE FIRST TEST: the key Duplicate prints duplicates the picked layer. Three layers now"
    },
    {
      "do": "snapshot",
      "name": "2-command-j-duplicates"
    },
    {
      "do": "action",
      "action": "undo"
    },
    {
      "do": "wait",
      "seconds": 0.8
    },
    {
      "do": "expectLayers",
      "count": 2
    },
    {
      "do": "selectRow",
      "row": "Rectangle"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "shortcut",
      "key": "delete",
      "modifiers": [
        "command"
      ],
      "menuItem": "Delete Layer"
    },
    {
      "do": "wait",
      "seconds": 0.8
    },
    {
      "do": "expectLayers",
      "count": 1
    },
    {
      "do": "expect",
      "row": "Rectangle",
      "present": false
    },
    {
      "do": "describe",
      "stage": "3-command-delete-reaches-delete-layer",
      "note": "THE SECOND TEST: Command Delete reached Layer > Delete Layer itself, not only the canvas, and the rectangle is gone"
    },
    {
      "do": "snapshot",
      "name": "3-command-delete-reaches-delete-layer"
    },
    {
      "do": "action",
      "action": "undo"
    },
    {
      "do": "wait",
      "seconds": 0.8
    },
    {
      "do": "expectLayers",
      "count": 2
    },
    {
      "do": "key",
      "key": "escape"
    },
    {
      "do": "wait",
      "seconds": 0.4
    },
    {
      "do": "action",
      "action": "newLayer"
