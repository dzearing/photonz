{
  "out": "/tmp/photonz-playtest/menu-keys-do-what-they-say",
  "seed": "Every key a menu prints beside a row does what the row says. The layer row menu used to print Command D beside Duplicate, and Command D is Deselect; Layer > Delete Layer and Edit > Fill with Foreground printed Command Delete and Option Delete on rows no press could reach, because AppKit matches a real Delete key against a different character from the one those rows held. This reads each printed key and presses it with the menu bar live, as it is for a person. Option Delete is pressed with a key step, since the menu bar reads Fill with Foreground dimmed over a fresh marquee until the press itself brings it up to date; its log line says the menu took it, and the render shows the fill.",
  "setup": {
    "forget": [
      "shapes",
      "color",
      "tools"
    ],
    "front": true
  },
  "steps": [
    {
      "do": "blank",
      "canvasWidth": 1200,
      "canvasHeight": 800,
      "width": 1280,
      "height": 900
    },
    {
      "do": "wait",
      "seconds": 1.0
    },
    {
      "do": "tool",
      "tool": "rectangle"
    },
    {
      "do": "drag",
      "from": [
        220,
        180
      ],
      "to": [
        560,
        420
      ]
    },
    {
      "do": "wait",
      "seconds": 0.8
    },
    {
      "do": "tool",
      "tool": "select"
    },
    {
      "do": "key",
      "key": "escape"
    },
    {
      "do": "wait",
      "seconds": 0.4
    },
    {
      "do": "selectRow",
      "row": "Rectangle"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "expectLayers",
      "count": 2
    },
    {
      "do": "rightClick",
      "on": "Rectangle",
      "shot": "1-layer-row-menu",
      "keys": {
        "Duplicate": "⌘J",
        "Delete": "⌘⌫",
        "Merge Down": "⌘E"
      }
    },
    {
      "do": "describe",
