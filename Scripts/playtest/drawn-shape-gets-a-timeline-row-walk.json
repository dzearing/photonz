{
  "out": "/tmp/photonz-playtest/drawn-shape-gets-a-timeline-row-walk",
  "seed": "Anything drawn on a video is on the timeline. At Next defaults with no flag changed, this walk draws a rectangle on a recording at one second and finds its own row, named Rectangle, running to the end of the shot; ends it at three and a half seconds with End Here; keys it at one second with the diamond on its row; moves the playhead to three seconds and drags it across and bigger on the canvas, which makes the second key by itself; then photographs half a second (not there yet), one, two and three seconds (tweening across and growing) and three and a half (gone).",
  "setup": { "timelineOpen": true, "forget": ["all"] },
  "steps": [
    { "do": "action", "action": "openSampleRecording" },
    { "do": "wait", "seconds": 2.0 },
    { "do": "action", "action": "videoPause" },
    { "do": "tool", "tool": "select" },
    { "do": "action", "action": "videoSeekStart" },
    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "wait", "seconds": 0.8 },

    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [500, 300], "to": [700, 420], "steps": 10 },
    { "do": "wait", "seconds": 1.0 },
    { "do": "describe", "stage": "1-drawn", "note": "THE FIRST TEST: a rectangle drawn on the recording at one second lands on a row of its own, named Rectangle, with a bar from the playhead to the end of the shot" },
    { "do": "expect", "control": "Track Rectangle", "present": true },
    { "do": "expect", "field": "Rectangle clip", "present": true },
    { "do": "reveal", "control": "Properties section" },
    { "do": "expect", "field": "Clip line", "reads": "Rectangle 1.0s → 8.0s · 7.0s · 1.0x" },
    { "do": "expect", "field": "Properties Kind", "reads": "Graphic" },
    { "do": "panel", "stage": "1-drawn" },
    { "do": "snapshot", "name": "1-drawn-its-own-row" },

    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "action", "action": "videoStepQuarterSecond" },
    { "do": "action", "action": "videoStepQuarterSecond" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "reveal", "control": "End Here" },
    { "do": "press", "control": "End Here" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "2-ended", "note": "THE SECOND TEST: its bar is a bar like a title's: End Here at three and a half seconds says when it goes" },
    { "do": "reveal", "control": "Properties section" },
    { "do": "expect", "field": "Clip line", "reads": "Rectangle 1.0s → 3.5s · 2.5s · 1.0x" },

    { "do": "action", "action": "videoSeekStart" },
    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expect", "control": "Key Rectangle", "in": "Track Rectangle", "reads": "not keyed" },
    { "do": "press", "control": "Key Rectangle" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "3-keyed", "note": "THE THIRD TEST: one press on the diamond on its row keys where it is, its size, its angle and its opacity at one second" },
    { "do": "expect", "control": "Key Rectangle", "in": "Track Rectangle", "reads": "on a key" },
    { "do": "snapshot", "name": "2-keyed-at-one-second" },

    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expect", "control": "Key Rectangle", "in": "Track Rectangle", "reads": "between keys" },
    { "do": "tool", "tool": "select" },
    { "do": "drag", "from": [600, 360], "to": [900, 300], "steps": 12 },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "4-moved", "note": "THE FOURTH TEST: at three seconds the rectangle is dragged across, and because it is keyed that drag IS the second key: nobody pressed the diamond again" },
    { "do": "expect", "control": "Key Rectangle", "in": "Track Rectangle", "reads": "on a key" },
    { "do": "snapshot", "name": "3-dragged-at-three-seconds" },
    { "do": "drag", "from": [1000, 360], "to": [1100, 420], "steps": 10 },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "5-grown", "note": "and dragged bigger by its corner at the same moment, which rewrites the same key rather than making another" },
    { "do": "panel", "stage": "5-grown" },
    { "do": "snapshot", "name": "4-grown-at-three-seconds" },

    { "do": "action", "action": "videoSeekStart" },
    { "do": "action", "action": "videoStepQuarterSecond" },
    { "do": "action", "action": "videoStepQuarterSecond" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "6-before", "note": "THE FIFTH TEST, five pictures of the film: at half a second it has not arrived" },
    { "do": "snapshot", "name": "5-half-a-second-absent" },
    { "do": "render", "name": "5-half-a-second-canvas" },
    { "do": "action", "action": "videoStepQuarterSecond" },
    { "do": "action", "action": "videoStepQuarterSecond" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "7-one", "note": "at one second it is where it was drawn" },
    { "do": "snapshot", "name": "6-one-second" },
    { "do": "render", "name": "6-one-second-canvas" },
    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "8-two", "note": "at two seconds it is half way across and part grown" },
    { "do": "expect", "control": "Key Rectangle", "in": "Track Rectangle", "reads": "between keys" },
    { "do": "snapshot", "name": "7-two-seconds-tweening" },
    { "do": "render", "name": "7-two-seconds-canvas" },
    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "9-three", "note": "at three seconds it has arrived, across and bigger" },
    { "do": "snapshot", "name": "8-three-seconds" },
    { "do": "render", "name": "8-three-seconds-canvas" },
    { "do": "action", "action": "videoStepQuarterSecond" },
    { "do": "action", "action": "videoStepQuarterSecond" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "10-gone", "note": "and at three and a half seconds it has gone" },
    { "do": "snapshot", "name": "9-three-and-a-half-gone" },
    { "do": "render", "name": "9-three-and-a-half-canvas" }
  ]
}
