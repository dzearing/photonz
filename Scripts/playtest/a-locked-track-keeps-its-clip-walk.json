{
  "out": "/tmp/photonz-playtest/a-locked-track-keeps-its-clip-walk",
  "seed": "A locked track keeps its clip however the clip was picked. At Next defaults with no flag changed: a rectangle is drawn on a recording, V1 is locked from its header, and the recording is picked by clicking its picture on the canvas. Delete, Delete Layer, Command Delete and Cut each leave it where it is; Select All then Delete leaves its picture untouched; and with the rectangle and the recording picked together, Delete takes the rectangle and keeps the recording.",
  "setup": { "timelineOpen": true, "forget": ["all"] },
  "steps": [
    { "do": "action", "action": "openSampleRecording" },
    { "do": "wait", "seconds": 2.0 },
    { "do": "action", "action": "videoPause" },
    { "do": "tool", "tool": "select" },
    { "do": "action", "action": "videoSeekQuarter" },
    { "do": "wait", "seconds": 0.8 },

    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [900, 520], "to": [1100, 660], "steps": 10 },
    { "do": "wait", "seconds": 0.8 },
    { "do": "tool", "tool": "select" },
    { "do": "key", "key": "escape" },
    { "do": "expect", "field": "Rectangle clip", "present": true },

    { "do": "move", "control": "Track V1" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "press", "control": "Track V1 Lock" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "click", "at": [640, 300] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "1-locked-picked", "note": "V1 locked (its switch lit, its lane striped) and the recording picked by clicking its picture: layers 2" },
    { "do": "snapshot", "name": "1-locked-recording-picked" },

    { "do": "key", "key": "delete" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "2-after-delete-key", "note": "THE FIRST TEST: Delete leaves the recording on its locked track, layers still 2" },
    { "do": "expect", "field": "Tutorial Sample clip", "present": true },

    { "do": "action", "action": "deleteLayer" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "3-after-delete-layer", "note": "THE SECOND TEST: the step above says Delete Layer's row is dimmed and nothing was deleted" },
    { "do": "expect", "field": "Tutorial Sample clip", "present": true },

    { "do": "shortcut", "key": "delete", "modifiers": ["command"], "menuItem": "Delete Layer" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "action", "action": "cut" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "4-after-command-delete-and-cut", "note": "THE THIRD TEST: Command Delete and Cut leave it too" },
    { "do": "expect", "field": "Tutorial Sample clip", "present": true },

    { "comment": "Select All marquees the whole canvas (EditorState.selectAll); the walk has no stand-in for its chord, so the marquee tool draws the same region by hand.", "do": "tool", "tool": "rectSelect" },
    { "do": "drag", "from": [2, 2], "to": [1278, 798], "steps": 10 },
    { "do": "wait", "seconds": 0.4 },
    { "do": "key", "key": "delete" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "5-select-all-delete", "note": "THE FOURTH TEST: the whole canvas marqueed, then Delete, leaves the recording and its picture as they were" },
    { "do": "expect", "field": "Tutorial Sample clip", "present": true },
    { "do": "snapshot", "name": "5-after-select-all-delete" },
    { "do": "key", "key": "escape" },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.3 },

    { "do": "click", "at": [1000, 590] },
    { "do": "click", "at": [640, 300], "modifiers": ["shift"] },
    { "do": "wait", "seconds": 0.4 },
    { "do": "describe", "stage": "6-mixed-picked", "note": "the rectangle and the locked recording picked together" },
    { "do": "key", "key": "delete" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "7-mixed-delete", "note": "THE FIFTH TEST: Delete takes the rectangle and keeps the recording, layers 1" },
    { "do": "expect", "field": "Rectangle clip", "present": false },
    { "do": "expect", "field": "Tutorial Sample clip", "present": true },
    { "do": "snapshot", "name": "7-rectangle-gone-recording-kept" }
  ]
}
