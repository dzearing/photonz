{
  "out": "/tmp/photonz-playtest/picker-controls",
  "steps": [
    { "do": "blank", "canvasWidth": 900, "canvasHeight": 600, "width": 1280, "height": 900 },
    { "do": "wait", "seconds": 1 },

    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [120, 120], "to": [360, 280], "steps": 8 },
    { "do": "tool", "tool": "select" },
    { "do": "click", "at": [240, 200] },
    { "do": "wait", "seconds": 0.5 },

    { "do": "panel", "stage": "1-shut" },
    { "do": "describe", "stage": "1-shut",
      "note": "the picker is not open, so nothing of it is in the listing" },

    { "do": "press", "control": "Color", "in": "Fill" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "panel", "stage": "2-open" },
    { "do": "describe", "stage": "2-open",
      "note": "the picker is a window of its own on top of the panel, and its controls now stand in the same list as the panel's" },
    { "do": "snapshot", "name": "picker-controls-1-open" },

    { "do": "press", "control": "Solid" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "3-solid",
      "note": "start from one flat colour, whatever the shape tool happened to be holding" },

    { "do": "press", "control": "Linear" },
    { "do": "wait", "seconds": 0.7 },
    { "do": "panel", "stage": "4-linear" },
    { "do": "describe", "stage": "4-linear",
      "note": "the Linear tab, pressed by the word on it: the fill is a straight run and the ramp controls have appeared" },
    { "do": "snapshot", "name": "picker-controls-2-linear" },

    { "do": "press", "control": "Add a stop" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "5-stop-added",
      "note": "a third stop on the ramp, added from the picker's own button" },

    { "do": "press", "control": "Radial" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "6-radial", "note": "the same three stops, spreading" },
    { "do": "press", "control": "Angular" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "7-angular", "note": "and sweeping" },
    { "do": "press", "control": "Solid" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "8-solid",
      "note": "back to one flat colour, all four tabs pressed by the words on them" },

    { "do": "press", "control": "RGB" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "panel", "stage": "9-rgb" },
    { "do": "press", "control": "HEX" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "panel", "stage": "10-hex" },
    { "do": "describe", "stage": "10-hex",
      "note": "HSL, RGB and HEX are a real segmented control, so they read off it and the HEX box appears under them" },
    { "do": "snapshot", "name": "picker-controls-3-hex" },
    { "do": "press", "control": "HSL" },
    { "do": "wait", "seconds": 0.4 },

    { "do": "press", "control": "Shades" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "press", "control": "Shades 5" },
    { "do": "wait", "seconds": 0.7 },
    { "do": "panel", "stage": "11-shade-picked" },
    { "do": "describe", "stage": "11-shade-picked",
      "note": "a swatch off the Shades row, pressed: the rectangle is that colour and the swatch now reads already picked" },
    { "do": "snapshot", "name": "picker-controls-4-shade" },

    { "do": "press", "control": "Related" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "press", "control": "Related 5" },
    { "do": "wait", "seconds": 0.7 },
    { "do": "describe", "stage": "12-related-picked",
      "note": "the swatch row switches scope and hands over a colour from the second row too" },

    { "do": "press", "control": "Save style" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "type", "text": "Blush" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "press", "control": "Save", "in": "Style name" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "13-style-saved",
      "note": "Save style, a typed name and the Save beside it, all pressed from a walk: the colour is in the Library under Blush" },
    { "do": "snapshot", "name": "picker-controls-5-saved" },

    { "do": "press", "control": "Close", "in": "the picker" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "panel", "stage": "14-shut-again" },
    { "do": "describe", "stage": "14-shut-again",
      "note": "the picker's own close button shuts it, and its controls leave the listing with it" },
    { "do": "snapshot", "name": "picker-controls-6-shut" }
  ]
}
