{
  "out": "/tmp/photonz-playtest/shape-parts",
  "setup": { "forget": ["shapes", "panel", "color"] },
  "steps": [
    { "do": "blank", "canvasWidth": 1100, "canvasHeight": 720, "width": 1420, "height": 980 },
    { "do": "wait", "seconds": 1 },

    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [140, 150], "to": [460, 340], "steps": 8 },
    { "do": "wait", "seconds": 0.8 },
    { "do": "panel", "stage": "rectangle" },
    { "do": "describe", "stage": "rectangle", "note": "one rectangle picked: every setting it has, and which section holds it" },
    { "do": "snapshot", "name": "1-rectangle" },

    { "do": "press", "control": "Switch", "in": "Fill" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "fill-off", "note": "the fill switched off: what a part that is off looks like" },
    { "do": "snapshot", "name": "2-fill-off" },
    { "do": "press", "control": "Switch", "in": "Fill" },
    { "do": "wait", "seconds": 0.5 },

    { "do": "tool", "tool": "ellipse" },
    { "do": "drag", "from": [560, 150], "to": [860, 340], "steps": 8 },
    { "do": "wait", "seconds": 0.8 },
    { "do": "panel", "stage": "ellipse" },
    { "do": "snapshot", "name": "3-ellipse" },

    { "do": "tool", "tool": "arrow" },
    { "do": "drag", "from": [200, 460], "to": [540, 620], "steps": 8 },
    { "do": "wait", "seconds": 0.8 },
    { "do": "panel", "stage": "arrow" },
    { "do": "snapshot", "name": "4-arrow" }
  ]
}
