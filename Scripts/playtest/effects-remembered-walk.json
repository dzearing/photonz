{
  "out": "/tmp/photonz-playtest/effects-remembered",
  "seed": "Everything you do to a shape's effects should stick for the next shape of that kind. Reported by the user on 2026-09-07: a rectangle arrived with a blur, they took the blur off, drew another, and the blur was back. Adding reached the tool and removing did not. This walk draws a fresh shape after every move (add, remove, switch off, reorder) and holds the new shape to what the last one was left wearing. It also draws ellipses in the middle, which must keep their own effects and never take a rectangle's.",
  "setup": { "forget": ["panel", "shapes", "tools"] },
  "steps": [
    { "do": "blank", "canvasWidth": 900, "canvasHeight": 620, "width": 1400, "height": 1300 },
    { "do": "wait", "seconds": 1.2 },
    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [120, 120], "to": [300, 240], "steps": 10 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "1-fresh-box",
      "note": "a rectangle out of the box on a machine that has never styled one: the Effects list is empty, so nothing here comes with a blur." },
    { "do": "expect", "control": "Add Effect", "present": true },
    { "do": "expect", "control": "Remove", "present": false },
    { "do": "panel", "stage": "1-fresh-box" },
    { "do": "snapshot", "name": "effects-remembered-1-fresh-box" },

    { "do": "panelMenu", "menu": "Add Effect", "choose": "Blur" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expect", "control": "Switch", "in": "Blur", "reads": "Blur, on" },
    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [340, 120], "to": [520, 240], "steps": 10 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "2-blur-inherited",
      "note": "the next box takes the blur that was added to the one before it. This half already worked." },
    { "do": "expect", "control": "Switch", "in": "Blur", "reads": "Blur, on" },

    { "do": "press", "control": "Remove", "in": "Blur" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expect", "control": "Remove", "present": false },
    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [560, 120], "to": [740, 240], "steps": 10 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "3-blur-gone",
      "note": "the box drawn after the blur was taken off. Its Effects list has to be empty: this is the bug the user reported." },
    { "do": "expect", "control": "Remove", "present": false },
    { "do": "panel", "stage": "3-blur-gone" },
    { "do": "snapshot", "name": "effects-remembered-3-blur-gone" },

    { "do": "tool", "tool": "ellipse" },
    { "do": "drag", "from": [120, 300], "to": [300, 420], "steps": 10 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expect", "control": "Remove", "present": false },
    { "do": "panelMenu", "menu": "Add Effect", "choose": "Shadow" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "tool", "tool": "ellipse" },
    { "do": "drag", "from": [340, 300], "to": [520, 420], "steps": 10 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "4-ellipse-keeps-its-own",
      "note": "an ellipse remembers the shadow put on the ellipse before it." },
    { "do": "expect", "control": "Switch", "in": "Shadow", "reads": "Shadow, on" },
    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [560, 300], "to": [740, 420], "steps": 10 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "5-rectangle-untouched",
      "note": "and a rectangle does not take the ellipse's shadow: this is per kind of shape." },
    { "do": "expect", "control": "Remove", "present": false },

    { "do": "panelMenu", "menu": "Add Effect", "choose": "Border" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "panelMenu", "menu": "Border", "choose": "Inside" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expect", "control": "Position", "in": "Border", "reads": "Border, Inside" },
    { "do": "press", "control": "Switch", "in": "Border" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expect", "control": "Switch", "in": "Border", "reads": "Border, off" },
    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [120, 470], "to": [300, 580], "steps": 10 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "6-border-off-inherited",
      "note": "the border was switched off rather than removed, so the next box starts with it, off." },
    { "do": "expect", "control": "Switch", "in": "Border", "reads": "Border, off" },
    { "do": "press", "control": "Switch", "in": "Border" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expect", "control": "Position", "in": "Border", "reads": "Border, Inside" },
    { "do": "snapshot", "name": "effects-remembered-6-border-off" },

    { "do": "press", "control": "Remove", "in": "Border" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "panelMenu", "menu": "Add Effect", "choose": "Shadow" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "panelMenu", "menu": "Add Effect", "choose": "Shadow" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "panelMenu", "menu": "Shadow 2", "choose": "Inner" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expect", "control": "Kind", "in": "Shadow 2", "reads": "Shadow 2, Inner" },
    { "do": "panel", "stage": "7-before-reorder" },
    { "do": "rightClick", "on": "Shadow 2", "choose": "Move Up" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "7-order-changed",
      "note": "the inner shadow was carried above the drop shadow, so the top row is now the inner one." },
    { "do": "expect", "control": "Kind", "in": "Shadow 1", "reads": "Shadow 1, Inner" },
    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [340, 470], "to": [520, 580], "steps": 10 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "8-order-remembered",
      "note": "the next box paints them in the order the last one was left in: inner on top, drop below." },
    { "do": "expect", "control": "Kind", "in": "Shadow 1", "reads": "Shadow 1, Inner" },
    { "do": "expect", "control": "Kind", "in": "Shadow 2", "reads": "Shadow 2, Drop" },
    { "do": "panel", "stage": "8-order-remembered" },
    { "do": "snapshot", "name": "effects-remembered-8-order" }
  ]
}
