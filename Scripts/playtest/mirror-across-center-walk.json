{
  "out": "/tmp/photonz-playtest/mirror-across-center-walk",
  "seed": "The 24 unit frame lands at 788, 538 on the canvas, so frame units 6, 7 are canvas 794, 545 and the mirrored copy at frame 12, 7 is canvas 800, 545. icon-draw-wt.html step 7 at Next defaults, no flags: a 24 unit icon frame, one shoulder (a circle of diameter 6 centred on 9, 10), then Mirror Across Center from the menu bar key and again from the Layers panel menu. Each time the copy must sit centred on 15, 10 at the same size, picked, and one undo must take it away. Last, on a video, Shift Command M must stay Go to Previous Marker with no second row printing it.",
  "setup": { "forget": ["all"] },
  "steps": [
    { "do": "blank", "canvasWidth": 1600, "canvasHeight": 1100, "width": 1240, "height": 900 },

    { "do": "action", "action": "newFrameDialog" },
    { "do": "wait", "seconds": 0.9 },
    { "do": "press", "control": "24", "in": "Icons" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "press", "control": "Add Frame" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "expectLayers", "count": 2 },

    { "do": "tool", "tool": "ellipse" },
    { "do": "drag", "from": [792, 542], "to": [806, 556] },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "action", "action": "positionAndSize" },
    { "do": "focus", "field": "X" },
    { "do": "type", "text": "6" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "focus", "field": "Y" },
    { "do": "type", "text": "7" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "focus", "field": "W" },
    { "do": "type", "text": "6" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "focus", "field": "H" },
    { "do": "type", "text": "6" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "expect", "field": "X", "reads": "6" },
    { "do": "expect", "field": "Y", "reads": "7" },
    { "do": "expect", "field": "W", "reads": "6" },
    { "do": "expect", "field": "H", "reads": "6" },
    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "expectBox", "layer": "Ellipse", "at": [794, 545], "size": [6, 6], "within": 0.01 },
    { "do": "describe", "stage": "1-one-shoulder", "note": "one circle of diameter 6 centred on 9, 10 inside the 24 unit icon frame, picked" },
    { "do": "snapshot", "name": "1-one-shoulder" },

    { "do": "menus", "stage": "2-layer-menu", "menu": "Layer", "oneKeyEach": true },
    { "do": "shortcut", "key": "m", "modifiers": ["command", "shift"], "menuItem": "Mirror Across Center" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectLayers", "count": 4 },
    { "do": "expectBox", "layer": "Ellipse 2", "at": [800, 545], "size": [6, 6], "within": 0.01 },
    { "do": "expectBox", "layer": "Ellipse", "at": [794, 545], "size": [6, 6], "within": 0.01 },
    { "do": "expectPicked", "layers": ["Ellipse 2"] },
    { "do": "describe", "stage": "2-mirrored-by-key", "note": "Shift Command M made the other shoulder centred on 15, 10, the same size and colour, and picked it" },
    { "do": "snapshot", "name": "2-mirrored-by-key" },

    { "do": "shortcut", "key": "z", "modifiers": ["command"], "menuItem": "Undo" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectLayers", "count": 3 },

    { "do": "selectRow", "row": "Ellipse" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "panelMenu", "menu": "Layers Menu", "choose": "Mirror Across Center" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectLayers", "count": 4 },
    { "do": "expectBox", "layer": "Ellipse 2", "at": [800, 545], "size": [6, 6], "within": 0.01 },
    { "do": "expectPicked", "layers": ["Ellipse 2"] },
    { "do": "describe", "stage": "3-mirrored-from-the-layers-menu", "note": "the Layers panel menu's Mirror Across Center, under Group Selection, did the same: one copy at 15, 10, picked" },
    { "do": "snapshot", "name": "3-mirrored-from-the-layers-menu" },
    { "do": "render", "name": "3-document" },

    { "do": "appearance", "value": "light" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "snapshot", "name": "3b-light" },
    { "do": "appearance", "value": "dark" },

    { "do": "blankVideo", "width": 1240, "height": 900 },
    { "do": "wait", "seconds": 1.5 },
    { "do": "menus", "stage": "4-a-video-keeps-previous-marker", "oneKeyEach": true }
  ]
}
