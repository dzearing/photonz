{
  "out": "/tmp/photonz-playtest/pick-several-zooms-walk",
  "seed": "Four zooms on a recording at Next defaults. Shift click picks three of them together, their bars lit and no box on the picture; the panel says Mixed for the way in they disagree on, and one pick from it sets all three. A click on the Zoom lane's label picks every zoom. Two picked and Delete takes both in one step, and one undo brings both back.",
  "setup": {
    "timelineOpen": true,
    "forget": ["all"]
  },
  "steps": [
    { "do": "action", "action": "openSampleRecording" },
    { "do": "wait", "seconds": 2.0 },
    { "do": "action", "action": "videoPause" },
    { "do": "tool", "tool": "select" },

    { "do": "clickRuler", "seconds": 6.0 },
    { "do": "wait", "seconds": 0.3 },
    { "do": "action", "action": "zoomAddAtPlayhead" },
    { "do": "clickRuler", "seconds": 4.0 },
    { "do": "wait", "seconds": 0.3 },
    { "do": "action", "action": "zoomAddAtPlayhead" },
    { "do": "clickRuler", "seconds": 2.0 },
    { "do": "wait", "seconds": 0.3 },
    { "do": "action", "action": "zoomAddAtPlayhead" },
    { "do": "clickRuler", "seconds": 0.2 },
    { "do": "wait", "seconds": 0.3 },
    { "do": "action", "action": "zoomAddAtPlayhead" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "action", "action": "expectFourZooms" },
    { "do": "panelMenu", "menu": "Ease In", "at": ["centre"], "choose": "1.5s" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "snapshot", "name": "0-four-zooms" },

    { "do": "windowClick", "at": [743, 897], "modifiers": ["shift"] },
    { "do": "windowClick", "at": [1132, 897], "modifiers": ["command"] },
    { "do": "wait", "seconds": 0.4 },
    { "do": "action", "action": "expectThreeZoomsPicked" },
    { "do": "expect", "menu": "Ease In", "reads": "Mixed" },
    { "do": "describe", "stage": "1-three-picked", "note": "The first zoom picked, then Shift click on the second and Command click on the third: three bars lit together, no box on the picture, and the panel's Ease In says Mixed because the first eases in slower" },
    { "do": "snapshot", "name": "1-three-zooms-picked" },

    { "do": "panelMenu", "menu": "Ease In", "at": ["centre"], "choose": "0.3s" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "action", "action": "expectPickedZoomsEaseInAlike" },
    { "do": "expect", "menu": "Ease In", "reads": "0.3s" },
    { "do": "action", "action": "undo" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "expect", "menu": "Ease In", "reads": "Mixed" },
    { "do": "action", "action": "redo" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "action", "action": "expectPickedZoomsEaseInAlike" },
    { "do": "describe", "stage": "2-one-change", "note": "Ease In 0.3s from the panel sets the way in on all three picked zooms and leaves the fourth alone; one undo takes it off all three at once" },
    { "do": "snapshot", "name": "2-three-share-one-ease" },

    { "do": "windowClick", "at": [52, 897] },
    { "do": "wait", "seconds": 0.4 },
    { "do": "action", "action": "expectEveryZoomPicked" },
    { "do": "describe", "stage": "3-label-picks-all", "note": "A click on the Zoom lane's label picks all four zooms" },
    { "do": "snapshot", "name": "3-label-picks-every-zoom" },

    { "do": "windowClick", "at": [743, 897] },
    { "do": "windowClick", "at": [1132, 897], "modifiers": ["shift"] },
    { "do": "wait", "seconds": 0.3 },
    { "do": "key", "key": "delete" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "action", "action": "expectTwoZoomsLeft" },
    { "do": "snapshot", "name": "4-two-deleted" },
    { "do": "action", "action": "undo" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "action", "action": "expectFourZooms" },
    { "do": "windowClick", "at": [52, 897] },
    { "do": "wait", "seconds": 0.4 },
    { "do": "action", "action": "expectEveryZoomPicked" },
    { "do": "rightClick", "at": [1132, 897], "space": "window", "choose": "Delete Zoom" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "action", "action": "expectNoZooms" },
    { "do": "action", "action": "undo" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "action", "action": "expectFourZooms" },
    { "do": "describe", "stage": "5-undone", "note": "Two zooms picked and Delete takes both, and the label then right-click Delete Zoom takes all four; one undo brings each lot back" },
    { "do": "snapshot", "name": "5-both-back" }
  ]
}
