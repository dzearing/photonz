{
  "out": "/tmp/photonz-playtest/picture-keys-back-to-a-still-walk",
  "seed": "The other half of keys on a picture (picture-keys.html), at Next defaults: Add Key from the layer's right-click, two moments, the animated SVG carries them, Delete takes a key, the last key going leaves a still, and undo brings the timeline back.",
  "setup": { "forget": ["tools", "panel"] },
  "steps": [
    { "do": "blank", "canvasWidth": 900, "canvasHeight": 700, "width": 1420, "height": 980 },
    { "do": "wait", "seconds": 1 },
    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [120, 230], "to": [260, 370], "steps": 8 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "rightClick", "at": [190, 300], "shot": "1-the-layers-right-click", "choose": "Add Key" },
    { "do": "wait", "seconds": 1 },
    { "do": "expect", "field": "Key Length", "reads": "0:02.00" },
    { "do": "drag", "from": [190, 300], "to": [190, 340], "steps": 6 },
    { "do": "wait", "seconds": 0.8 },
    { "do": "windowClick", "at": [625, 913] },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expect", "field": "Key Time", "reads": "0:01.00" },
    { "do": "drag", "from": [190, 340], "to": [600, 340], "steps": 6 },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expect", "control": "Key 2", "in": "Rectangle", "present": true },
    { "do": "writeSVG", "name": "2-keys-in-the-file" },
    { "do": "snapshot", "name": "2-two-moments" },

    { "do": "press", "control": "Repeat" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expect", "control": "Repeat", "reads": "plays once" },
    { "do": "expect", "control": "Key Lap End", "reads": "ends at 0:02.00" },
    { "do": "writeSVG", "name": "3-plays-once" },
    { "do": "snapshot", "name": "3-plays-once" },
    { "do": "press", "control": "Repeat" },
    { "do": "wait", "seconds": 0.5 },

    { "do": "windowClick", "at": [625, 934] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "key", "key": "delete" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "4-a-key-went", "note": "Delete takes the picked key and leaves the layer." },
    { "do": "expect", "control": "Key 2", "in": "Rectangle", "present": false },
    { "do": "expect", "control": "Key 1", "in": "Rectangle", "present": true },
    { "do": "snapshot", "name": "4-a-key-went" },

    { "do": "windowClick", "at": [154, 934] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "key", "key": "delete" },
    { "do": "wait", "seconds": 1 },
    { "do": "describe", "stage": "5-a-still-again", "note": "THE TEST: the last key going takes the timeline with it. It is a still picture, the layer keeping the place it had." },
    { "do": "expect", "field": "Key Time", "present": false },
    { "do": "expect", "control": "Add Key", "present": true },
    { "do": "snapshot", "name": "5-a-still-again" },

    { "do": "action", "action": "undo" },
    { "do": "wait", "seconds": 1 },
    { "do": "describe", "stage": "6-undo-brings-it-back", "note": "undo brings the last key back and the timeline with it." },
    { "do": "expect", "field": "Key Length", "reads": "0:02.00" },
    { "do": "snapshot", "name": "6-undo-brings-it-back" }
  ]
}
