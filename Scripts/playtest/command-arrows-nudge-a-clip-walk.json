    { "do": "describe", "stage": "1-piece-2-picked", "note": "the recording cut at 0:04 with Command K, piece 2 picked with a click on its bar; the Clip line reads 4.0s to 8.0s" },
    { "do": "snapshot", "name": "1-piece-2-picked" },

    { "do": "key", "key": "right", "modifiers": ["command"] },
    { "do": "key", "key": "right", "modifiers": ["command"] },
    { "do": "key", "key": "right", "modifiers": ["command"] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expectClip", "clip": "Tutorial Sample", "track": "V1", "startsAt": 0.099, "within": 0.001, "pieces": 2 },
    { "do": "expect", "field": "Clip line", "reads": "Tutorial Sample 4.1s → 8.1s · 4.0s · 1.0x" },
    { "do": "expectTimelinePick", "clips": ["Tutorial Sample piece 2"] },
    { "do": "describe", "stage": "2-three-frames-later", "note": "THE FIRST TEST: three presses of Command Right moved the clip three frames later, 0.099s, the pieces and the pick unchanged, and the Clip line reads 4.1s to 8.1s" },
    { "do": "snapshot", "name": "2-three-frames-later" },

    { "do": "key", "key": "left", "modifiers": ["command", "shift"] },
    { "do": "wait", "seconds": 0.4 },
    { "do": "expectClip", "clip": "Tutorial Sample", "startsAt": 0.0, "within": 0.001 },
    { "do": "describe", "stage": "3-stopped-at-the-start", "note": "THE SECOND TEST: Shift Command Left asked for five frames earlier and stopped at the start of the document, three frames back" },

    { "do": "shortcut", "key": "z", "modifiers": ["command"], "menuItem": "Undo" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expectClip", "clip": "Tutorial Sample", "startsAt": 0.099, "within": 0.001 },
    { "do": "shortcut", "key": "z", "modifiers": ["command"], "menuItem": "Undo" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expectClip", "clip": "Tutorial Sample", "startsAt": 0.066, "within": 0.001 },
    { "do": "describe", "stage": "4-one-step-each", "note": "THE THIRD TEST: each Command Z took back one press, the Shift Command Left and then one Command Right" },

    { "comment": "The timeline takes the key before the menu does, so the row is picked the way a click picks it.", "do": "menus", "stage": "5-clip-menu", "menu": "Clip", "oneKeyEach": true, "choose": "Clip > Nudge Later" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "expectClip", "clip": "Tutorial Sample", "startsAt": 0.099, "within": 0.001 },
    { "do": "describe", "stage": "5-menu-row", "note": "the Clip menu carries Nudge Earlier and Nudge Later on Command Left and Right, and picking Nudge Later nudged the clip a frame" },

    { "do": "key", "key": "right" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "expectClip", "clip": "Tutorial Sample", "startsAt": 0.099, "within": 0.001 },
    { "do": "describe", "stage": "6-plain-arrow", "note": "plain Right stepped the playhead and left the clip where it was" },

    { "do": "key", "key": "escape" },
