    { "do": "wait", "seconds": 0.4 },
    { "do": "expectClip", "clip": "Tutorial Sample", "startsAt": 0.099, "within": 0.001 },
    { "do": "menus", "stage": "7-clip-menu-nothing-picked", "menu": "Clip" },
    { "do": "describe", "stage": "7-nothing-picked", "note": "with nothing picked Command Right moved nothing" },
    { "do": "snapshot", "name": "7-nothing-picked" },

    { "do": "windowClick", "at": [1300, 894] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expectTimelinePick", "clips": ["Tutorial Sample piece 2"] },
    { "do": "menus", "stage": "8-rename", "menu": "Clip", "choose": "Clip > Rename…" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "key", "key": "left", "modifiers": ["command"] },
    { "do": "type", "text": "My " },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expectClip", "clip": "My Tutorial Sample", "startsAt": 0.099, "within": 0.001 },
    { "do": "describe", "stage": "8-caret-in-a-field", "note": "renaming the clip, Command Left moved the caret to the front of the name and the clip stayed where it was: a field being typed in keeps the key" }
  ]
