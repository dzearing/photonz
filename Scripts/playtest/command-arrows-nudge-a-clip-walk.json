{
  "out": "/tmp/photonz-playtest/command-arrows-nudge-a-clip-walk",
  "seed": "Command and an arrow key nudge a picked clip a frame in time (task command-and-an-arrow-key-nudge-a-picked-clip-a-f), Premiere's Nudge Clip Selection on its Mac keys, at Next defaults with no flag touched. The sample recording is cut in two with Command K, piece 2 is clicked with a real press on its bar, and Command Right three times moves the clip three frames later (0.099s), the Clip line reading 4.1s where it read 4.0s. Shift Command Left asks for five frames earlier and stops at the start of the document. One Command Z takes back one press. Plain Right still steps the playhead, and with nothing picked Command Right moves nothing.",
  "setup": {
    "forget": [
      "all"
    ],
    "front": true
  },
  "steps": [
    { "do": "action", "action": "openSampleRecording" },
    { "do": "wait", "seconds": 2.0 },
    { "do": "action", "action": "videoPause" },
    { "do": "key", "key": "2", "modifiers": ["command"] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.8 },
    { "comment": "One cut at 0:04 with Command K.", "do": "action", "action": "videoSeekMiddle" },
    { "do": "key", "key": "k", "modifiers": ["command"] },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expectClip", "clip": "Tutorial Sample", "pieces": 2, "startsAt": 0.0, "within": 0.001 },
    { "do": "action", "action": "videoSeekThreeQuarters" },
    { "do": "wait", "seconds": 0.4 },
    {
      "comment": "The middle of piece 2 on V1 in the 1728x990 probe window, clicked the way a hand clicks it.",
      "do": "windowClick",
      "at": [1300, 894]
    },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expectTimelinePick", "clips": ["Tutorial Sample piece 2"] },
    { "do": "reveal", "control": "Time section" },
    { "do": "wait", "seconds": 0.4 },
