{
  "out": "/tmp/photonz-playtest/sound-effects-eq-compressor-walk",
  "seed": "The noisy screen recording at Next defaults with no flag set. Its clip picked, the plus on Audio Effects, clicked by the pointer, puts an EQ on that reads low cut 80 with Low cut, Low and High under it, and a Compressor that reads 3:1. The EQ's eye, clicked, switches it off: the row reads off and keeps its settings, and clicked again it is back at low cut 80. The cross takes the EQ off and leaves the Compressor.",
  "setup": {
    "timelineOpen": true,
    "forget": [
      "all"
    ]
  },
  "steps": [
    {
      "do": "open",
      "file": "fixtures/Noisy voice recording 1280x800.mp4",
      "width": 1440,
      "height": 900
    },
    {
      "do": "wait",
      "seconds": 1.5
    },
    {
      "do": "selectRow",
      "row": "Noisy voice recording 1280x800"
    },
    {
      "do": "wait",
      "seconds": 0.6
    },
    {
      "do": "expect",
      "field": "Audio Effects Empty",
      "reads": "No effects"
    },
    {
      "do": "panelMenu",
      "menu": "Add Audio Effect",
      "at": [
        "centre"
      ],
      "choose": "EQ"
    },
    {
      "do": "waitFor",
      "condition": "soundSettled",
      "timeout": 60
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "expect",
      "field": "EQ reading",
      "reads": "low cut 80"
    },
    {
      "do": "expect",
      "field": "Low cut reading",
      "reads": "80 Hz"
    },
    {
      "do": "expect",
      "field": "Audio Effects Count",
      "reads": "1"
    },
    {
      "do": "expectInView",
      "field": "EQ",
      "whole": true
    },
    {
      "do": "describe",
      "stage": "1-eq",
      "note": "EQ added from the plus: a row reading low cut 80, its eye and cross at the end, Low cut, Low and High under it"
    },
    {
      "do": "panel",
      "stage": "1-eq"
    },
    {
      "do": "snapshot",
      "name": "1-eq"
    },
    {
      "do": "panelMenu",
      "menu": "Add Audio Effect",
      "at": [
        "centre"
      ],
      "choose": "Compressor"
    },
    {
      "do": "waitFor",
      "condition": "soundSettled",
      "timeout": 60
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "expect",
      "field": "Compressor reading",
      "reads": "3:1"
    },
    {
      "do": "expect",
      "field": "Audio Effects Count",
      "reads": "2"
    },
    {
      "do": "describe",
      "stage": "2-both",
      "note": "EQ and Compressor, as the mock draws them, the compressor reading 3:1 with Threshold and Ratio under it"
    },
    {
      "do": "panel",
      "stage": "2-both"
    },
    {
      "do": "snapshot",
      "name": "2-both"
    },
    {
      "do": "press",
      "control": "Switch",
      "in": "EQ"
    },
    {
      "do": "waitFor",
      "condition": "soundSettled",
      "timeout": 60
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "expect",
      "field": "EQ reading",
      "reads": "off"
    },
    {
      "do": "expect",
      "field": "Low cut reading",
      "reads": "80 Hz"
    },
    {
      "do": "describe",
      "stage": "3-eq-off",
      "note": "The EQ's eye clicked: the row reads off, its name and settings fade, the settings are kept"
    },
    {
      "do": "snapshot",
      "name": "3-eq-off"
    },
    {
      "do": "press",
      "control": "Switch",
      "in": "EQ"
    },
    {
      "do": "waitFor",
      "condition": "soundSettled",
      "timeout": 60
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "expect",
      "field": "EQ reading",
      "reads": "low cut 80"
    },
    {
      "do": "press",
      "control": "Remove",
      "in": "EQ"
    },
    {
      "do": "waitFor",
      "condition": "soundSettled",
      "timeout": 60
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "expect",
      "field": "Audio Effects Count",
      "reads": "1"
    },
    {
      "do": "expect",
      "field": "Compressor reading",
      "reads": "3:1"
    },
    {
      "do": "describe",
      "stage": "4-eq-removed",
      "note": "The cross on the EQ: the Compressor is left on its own"
    },
    {
      "do": "snapshot",
      "name": "4-eq-removed"
    },
    {
      "do": "shortcut",
      "key": "z",
      "modifiers": [
        "command"
      ],
      "menuItem": "Undo"
    },
    {
      "do": "wait",
      "seconds": 0.6
    },
    {
      "do": "expect",
      "field": "EQ reading",
      "reads": "low cut 80"
    }
  ]
}
