{
  "out": "/tmp/photonz-playtest/default-transition-on-picked-clips-walk",
  "seed": "Premiere's Apply Default Transitions to Selection: with several clips picked, Command T puts the default transition on every cut inside them and between them, as one undo step, and the canvas says how many. At Next defaults, no flag set.",
  "setup": {
    "forget": ["all"],
    "scratch": ["sample:recording as b-roll.mp4"]
  },
  "steps": [
    { "do": "action", "action": "openSampleRecording" },
    { "do": "wait", "seconds": 2.0 },
    { "do": "action", "action": "videoPause" },
    { "do": "tool", "tool": "select" },
    { "do": "action", "action": "clipDragEndIn" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectClip", "clip": "Tutorial Sample", "track": "V1", "startsAt": 0.0, "endsAt": 7.0, "count": 1 },
    { "do": "action", "action": "videoSeekQuarter" },
    { "do": "action", "action": "clipSplit" },
    { "do": "action", "action": "videoSeekMiddle" },
    { "do": "action", "action": "clipSplit" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "dropOnTimeline", "file": "scratch/b-roll.mp4", "track": "V1", "seconds": 6.95 },
    { "do": "wait", "seconds": 1.0 },
    { "do": "action", "action": "clipDragStartIn" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expectClip", "clip": "b-roll", "track": "V1", "startsAt": 7.0, "count": 1 },
    { "do": "describe", "stage": "0-three-cuts", "note": "the recording cut twice, and b-roll butted onto its end: two joins inside the recording and one edit point between the two clips, all hard" },
    { "do": "action", "action": "clipPickEveryClip" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "key", "key": "t", "modifiers": ["command"] },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expectNotice", "says": "On 3 cuts" },
    { "do": "describe", "stage": "1-command-t-on-every-cut", "note": "THE TEST: both clips picked, Command T once. A cross dissolve on each of the three cuts, drawn as a band over each, and the canvas says Cross dissolve, On 3 cuts" },
    { "do": "snapshot", "name": "1-command-t-on-every-cut" },
    { "do": "action", "action": "clipPickEditPoint" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expect", "menu": "Type", "reads": "Cross dissolve" },
    { "do": "action", "action": "clipPickFirstCut" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expect", "menu": "Type", "reads": "Cross dissolve" },
    { "do": "action", "action": "undo" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "action", "action": "clipPickEditPoint" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expect", "field": "Transition header", "reads": "None" },
    { "do": "action", "action": "clipPickFirstCut" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expect", "field": "Transition header", "reads": "None" },
    { "do": "describe", "stage": "2-one-undo", "note": "one Command Z and all three cuts are hard again: the whole spread was one step to undo" },
    { "do": "snapshot", "name": "2-one-undo-takes-them-all-off" }
  ]
}
