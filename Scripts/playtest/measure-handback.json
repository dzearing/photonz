{
  "out": "/tmp/photonz-playtest/measure-handback",
  "seed": "Which Measure modes keep the tool in hand once a measurement lands. The user's answer on 2026-10-11: after a Size or Gap click the ruler stays in hand in the same mode with nothing picked, so the next click measures the next thing (level with Shottr), and V or Escape puts it down. Distance, placed by hand and often adjusted, still hands back to Select with the caliper it drew picked, like every other tool that makes something.",
  "setup": { "forget": ["all"] },
  "steps": [
    { "do": "open", "file": "../../Tests/PhotonzRenderTests/Fixtures/settings-pane-2x.png", "width": 1280, "height": 840 },
    { "do": "wait", "seconds": 1 },
    { "do": "key", "key": "i" },
    { "do": "waitFor", "condition": "tool", "value": "measure" },
    { "do": "waitFor", "condition": "edgeMap", "timeout": 15 },

    { "do": "measureMode", "mode": "size" },
    { "do": "describe", "stage": "0-baseline", "note": "Measure in hand, Size mode, nothing measured yet" },

    { "do": "move", "at": [356, 786] },
    { "do": "wait", "seconds": 0.4 },
    { "do": "click", "at": [356, 786] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expectMeasures", "count": 2 },
    { "do": "waitFor", "condition": "tool", "value": "measure" },
    { "do": "waitFor", "condition": "measureMode", "value": "size" },
    { "do": "expectPicked", "layers": [] },
    { "do": "describe", "stage": "1-size-landed", "note": "the Size landed and the ruler is still in hand, still in Size, with nothing picked" },
    { "do": "snapshot", "name": "1-size-landed" },

    { "do": "move", "at": [136, 786] },
    { "do": "wait", "seconds": 0.4 },
    { "do": "click", "at": [136, 786] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expectMeasures", "count": 4 },
    { "do": "waitFor", "condition": "tool", "value": "measure" },
    { "do": "describe", "stage": "2-second-size-landed", "note": "the very next click measures the Reset button, no press of I in between" },
    { "do": "snapshot", "name": "2-second-size-landed" },

    { "do": "measureMode", "mode": "gap" },
    { "do": "key", "key": "escape" },
    { "do": "waitFor", "condition": "tool", "value": "select" },
    { "do": "describe", "stage": "3-escape-puts-it-down", "note": "Esc puts the Measure tool down and keeps the mode" },

    { "do": "move", "at": [720, 432] },
    { "do": "wait", "seconds": 0.4 },
    { "do": "click", "at": [720, 432] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expectMeasures", "count": 4 },
    { "do": "describe", "stage": "4-arrow-click-in-gap", "note": "arrow in hand over a gap: nothing lands" },

    { "do": "key", "key": "i" },
    { "do": "waitFor", "condition": "tool", "value": "measure" },
    { "do": "waitFor", "condition": "measureMode", "value": "gap" },
    { "do": "move", "at": [720, 432] },
    { "do": "wait", "seconds": 0.4 },
    { "do": "click", "at": [720, 432] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expectMeasures", "count": 5 },
    { "do": "waitFor", "condition": "tool", "value": "measure" },
    { "do": "waitFor", "condition": "measureMode", "value": "gap" },
    { "do": "expectPicked", "layers": [] },
    { "do": "describe", "stage": "5-gap-landed", "note": "Gap stays in hand the same way Size does" },
    { "do": "snapshot", "name": "5-gap-landed" },

    { "do": "key", "key": "v" },
    { "do": "waitFor", "condition": "tool", "value": "select" },
    { "do": "key", "key": "i" },
    { "do": "waitFor", "condition": "tool", "value": "measure" },
    { "do": "waitFor", "condition": "measureMode", "value": "gap" },
    { "do": "describe", "stage": "6-v-then-one-press-back", "note": "V puts it down, one press of I comes back in Gap" },

    { "do": "measureMode", "mode": "distance" },
    { "do": "click", "at": [236, 696] },
    { "do": "click", "at": [476, 696] },
    { "do": "click", "at": [476, 656] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expectMeasures", "count": 6 },
    { "do": "waitFor", "condition": "tool", "value": "select" },
    { "do": "describe", "stage": "7-distance-landed", "note": "the three-click mode still hands back to Select on the click that places the number" },

    { "do": "move", "at": [236, 620] },
    { "do": "wait", "seconds": 0.4 },
    { "do": "click", "at": [236, 620] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expectMeasures", "count": 6 },
    { "do": "describe", "stage": "8-arrow-click-after-distance", "note": "the click that would have started the next caliper starts nothing" },

    { "do": "key", "key": "i" },
    { "do": "waitFor", "condition": "tool", "value": "measure" },
    { "do": "waitFor", "condition": "measureMode", "value": "distance" },
    { "do": "describe", "stage": "9-one-press-back-distance", "note": "one press of I comes back in Distance" },
    { "do": "snapshot", "name": "9-final" }
  ]
}
