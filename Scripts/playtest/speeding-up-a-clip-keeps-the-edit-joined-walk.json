{
  "out": "/tmp/photonz-playtest/speeding-up-a-clip-keeps-the-edit-joined-walk",
  "seed": "Two recordings back to back on V1 with a cross dissolve on the cut between them, at Next defaults with no flag set. The first is played at double speed (Clip > Speed > 2x) and takes half as long, and the second moves up to meet it: no black where the first clip used to be, and the dissolve is still on the cut. One Command Z puts both back. Then half speed: the first clip takes twice as long and pushes the second along rather than running over it.",
  "setup": {
    "timelineOpen": true,
    "forget": [
      "all"
    ],
    "scratch": [
      "sample:recording as b-roll.mp4"
    ]
  },
  "steps": [
    { "do": "action", "action": "openSampleRecording" },
    { "do": "wait", "seconds": 2.0 },
    { "do": "action", "action": "videoPause" },
    { "do": "tool", "tool": "select" },
    { "do": "action", "action": "clipDragEndIn" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectClip", "clip": "Tutorial Sample", "track": "V1", "startsAt": 0.0, "endsAt": 7.0, "count": 1 },
    { "do": "dropOnTimeline", "file": "scratch/b-roll.mp4", "track": "V1", "seconds": 6.95 },
    { "do": "wait", "seconds": 1.0 },
    { "do": "action", "action": "clipDragStartIn" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expectClip", "clip": "b-roll", "track": "V1", "startsAt": 7.0, "count": 1 },
    { "do": "action", "action": "clipPickEditPoint" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "action", "action": "clipTransitionDissolve" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expect", "menu": "Type", "reads": "Cross dissolve" },
    { "do": "key", "key": "escape" },
    { "do": "action", "action": "videoSeekStart" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "0-two-clips-dissolving", "note": "the sample recording from 0 to 7s and b-roll from 7s, meeting at 7s with a cross dissolve on the cut, playhead at the start" },
    { "do": "snapshot", "name": "0-two-clips-with-a-dissolve" },

    { "do": "action", "action": "clipSpeedDouble" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expectClip", "clip": "Tutorial Sample", "track": "V1", "startsAt": 0.0, "endsAt": 3.5, "count": 1 },
    { "do": "expectClip", "clip": "b-roll", "track": "V1", "startsAt": 3.5, "count": 1 },
    { "do": "action", "action": "clipPickEditPoint" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expect", "menu": "Type", "reads": "Cross dissolve" },
    { "do": "describe", "stage": "1-double-speed", "note": "THE TEST: Clip > Speed > 2x on the first clip. It takes three and a half seconds instead of seven and b-roll moves up to start at 3.5s, so there is no black between them, and the cut at 3.5s still carries its cross dissolve" },
    { "do": "snapshot", "name": "1-double-speed-b-roll-moved-up" },

    { "do": "action", "action": "undo" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expectClip", "clip": "Tutorial Sample", "track": "V1", "startsAt": 0.0, "endsAt": 7.0, "count": 1 },
    { "do": "expectClip", "clip": "b-roll", "track": "V1", "startsAt": 7.0, "count": 1 },
    { "do": "describe", "stage": "2-one-undo", "note": "one Command Z and both clips are back where they were: the speed and the move were one step" },

    { "do": "key", "key": "escape" },
    { "do": "action", "action": "videoSeekStart" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "action", "action": "clipSpeedHalf" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expectClip", "clip": "Tutorial Sample", "track": "V1", "startsAt": 0.0, "endsAt": 14.0, "count": 1 },
    { "do": "expectClip", "clip": "b-roll", "track": "V1", "startsAt": 14.0, "count": 1 },
    { "do": "action", "action": "clipPickEditPoint" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expect", "menu": "Type", "reads": "Cross dissolve" },
    { "do": "describe", "stage": "3-half-speed", "note": "half speed: the first clip takes fourteen seconds and pushes b-roll along to 14s rather than running over it, with the dissolve still on the cut" },
    { "do": "snapshot", "name": "2-half-speed-b-roll-pushed-along" }
  ]
}
