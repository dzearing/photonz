{
  "out": "/tmp/photonz-playtest/opening-an-svg",
  "seed": "Opening an SVG gives you its drawing. A 24 unit icon opens as an Icon picture, each line a layer you can click and pick, sharp however far in you go, and it writes its 24 units again. A wider logo opens at its own size. A file with words in it opens whole as one sharp picture and says so. A damaged file and a compressed one say why, and leave no window behind. No switches: this is Next as it comes.",
  "setup": {
    "forget": ["all"]
  },
  "steps": [
    { "do": "open", "file": "fixtures/svg/cloud-upload.svg", "width": 1280, "height": 900 },
    { "do": "wait", "seconds": 1.2 },
    { "do": "expect", "control": "Mode", "reads": "Icon" },
    { "do": "expectLayers", "count": 4 },
    { "do": "expectIconPreviews", "sides": [16, 24, 32, 48, 64], "bothGrounds": true, "inked": true },
    { "do": "describe", "stage": "1-icon", "note": "THE FIRST TEST: the file opened as a document, in Icon, its three lines on layers over the canvas" },
    { "do": "snapshot", "name": "1-icon" },
    { "do": "tool", "tool": "select" },
    { "do": "click", "at": [256, 384] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expectPicked", "layers": ["cloud-upload 2"] },
    { "do": "describe", "stage": "2-a-line-picked", "note": "THE SECOND TEST: a click on the arrow's stem picks that line and only that line, as a person's would" },
    { "do": "snapshot", "name": "2-a-line-picked" },
    { "do": "action", "action": "zoomIn" },
    { "do": "action", "action": "zoomIn" },
    { "do": "action", "action": "zoomIn" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectSharp" },
    { "do": "describe", "stage": "2b-close-up", "note": "zoomed well past 1:1 the lines are drawn at the size they are shown, not a small picture blown up" },
    { "do": "snapshot", "name": "2b-close-up" },
    { "do": "writeSVG", "name": "cloud-upload-again" },
    { "do": "expectSVG", "pictured": 0, "contains": "viewBox=\"0 0 24 24\"" },
    { "do": "open", "file": "fixtures/svg/Wide logo 300x120.svg", "width": 1100, "height": 800 },
    { "do": "wait", "seconds": 1.0 },
    { "do": "expectLayers", "count": 5 },
    { "do": "describe", "stage": "3-a-logo", "note": "THE THIRD TEST: a logo that says it is 300 by 120 opens that size, its plate and its named group kept" },
    { "do": "snapshot", "name": "3-a-logo" },
    { "do": "open", "file": "fixtures/svg/Badge with words.svg", "width": 1100, "height": 800 },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expectNotice", "says": "Its shapes can't be edited" },
    { "do": "expectLayers", "count": 2 },
    { "do": "describe", "stage": "4-words-stay-whole", "note": "THE FOURTH TEST: the words in this file are not something shapes hold, so it opened whole as one picture and said so" },
    { "do": "snapshot", "name": "4-words-stay-whole" },
    { "do": "action", "action": "zoomIn" },
    { "do": "action", "action": "zoomIn" },
    { "do": "action", "action": "zoomIn" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectSharp" },
    { "do": "describe", "stage": "4b-picture-close-up", "note": "the picture is the drawing itself, so its words stay hard edged however far in you go" },
    { "do": "snapshot", "name": "4b-picture-close-up" },
    { "do": "expectOpenRefused", "file": "fixtures/svg/damaged.svg", "says": "damaged" },
    { "do": "expectOpenRefused", "file": "fixtures/svg/compressed.svgz", "says": "compressed SVG" }
  ]
}
