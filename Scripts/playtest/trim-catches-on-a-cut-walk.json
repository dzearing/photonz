{
  "out": "/tmp/photonz-playtest/trim-catches-on-a-cut-walk",
  "setup": { "forget": ["all"] },
  "steps": [
    { "do": "action", "action": "openSampleRecording" },
    { "do": "action", "action": "videoPause" },
    { "do": "action", "action": "videoSeekQuarter" },
    { "do": "action", "action": "clipSplit" },
    { "do": "action", "action": "videoSeekThreeQuarters" },
    { "do": "action", "action": "clipSplit" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expectRecording", "pieces": 3, "seconds": 8 },

    { "do": "action", "action": "videoBeginTrim" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectRecording", "pieces": 3, "seconds": 8, "starts": 0 },
    { "do": "describe", "stage": "1-handles-open", "note": "an eight second recording cut at two and six seconds, Trim in hand: one handle at each end of the clip's bar, the two cuts between them" },
    { "do": "snapshot", "name": "1-handles-open" },

    { "do": "action", "action": "videoTrimStart" },
    { "do": "action", "action": "videoTrimEnd" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expectRecording", "starts": 2, "seconds": 4 },
    { "do": "describe", "stage": "2-handles-on-the-cuts", "note": "both handles stand on the cuts, so the capsule keeps four seconds and the outer pieces are drawn as spare" },
    { "do": "snapshot", "name": "2-handles-on-the-cuts" },

    { "do": "action", "action": "videoTrimDone" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "expectRecording", "pieces": 1, "picked": 0, "seconds": 4 },
    { "do": "expectTimeline", "lengthMS": 4000, "tool": "select" },
    { "do": "describe", "stage": "3-trim-keeps-exactly-that", "note": "THE TEST: Trim keeps exactly the middle piece, one piece and four seconds with no sliver of either neighbour. Until 2026-09-26 this press did nothing at all on a cut clip, because a handle on a cut was refused" },
    { "do": "snapshot", "name": "3-trim-keeps-exactly-that" },

    { "do": "action", "action": "videoBeginTrim" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectRecording", "seconds": 4, "starts": 2 },
    { "do": "describe", "stage": "4-the-pieces-are-spare-not-gone", "note": "trimming again lays the whole eight seconds back out: the two pieces the trim dropped are spare at each end, because the frames are still in the recording" },
    { "do": "snapshot", "name": "4-the-pieces-are-spare-not-gone" },
    { "do": "action", "action": "videoTrimCancel" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "action", "action": "undo" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expectRecording", "pieces": 3, "seconds": 8 }
  ]
}
