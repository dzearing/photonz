{
  "out": "/tmp/photonz-playtest/undo-while-trimming-walk",
  "setup": { "forget": ["all"] },
  "steps": [
    { "do": "action", "action": "openSampleRecording" },
    { "do": "action", "action": "videoPause" },
    { "do": "action", "action": "videoSeekQuarter" },
    { "do": "action", "action": "clipSplit" },
    { "do": "action", "action": "videoSeekThreeQuarters" },
    { "do": "action", "action": "clipSplit" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectRecording", "pieces": 3 },

    { "do": "action", "action": "videoBeginTrim" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "action", "action": "videoTrimStart" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "expectRecording", "pieces": 3, "seconds": 6, "starts": 2 },
    { "do": "describe", "stage": "1-trimming-a-cut-clip", "note": "an eight second recording cut in three, Trim in hand, the in handle brought to the first cut" },
    { "do": "snapshot", "name": "1-trimming-a-cut-clip" },

    { "do": "action", "action": "undo" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expectRecording", "pieces": 2, "seconds": 6, "starts": 2 },
    { "do": "expectTimeline", "tool": "trim" },
    { "do": "describe", "stage": "2-undo-takes-the-last-cut-back", "note": "THE TEST: Command Z with Trim in hand undoes the last thing written, the second split, and leaves the session exactly where the hand had it: still trimming, the in handle still on the first cut, six seconds kept" },
    { "do": "snapshot", "name": "2-undo-takes-the-last-cut-back" },

    { "do": "action", "action": "redo" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expectRecording", "pieces": 3, "starts": 2 },

    { "do": "action", "action": "videoTrimDone" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "expectRecording", "pieces": 2, "seconds": 6 },
    { "do": "action", "action": "undo" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expectRecording", "pieces": 3, "seconds": 8 },
    { "do": "describe", "stage": "3-a-trim-is-one-undo", "note": "the trim landed as one step, and one Command Z puts the first piece back" },
    { "do": "snapshot", "name": "3-a-trim-is-one-undo" }
  ]
}
