{
  "out": "/tmp/photonz-playtest/agent-keys-walk",
  "seed": "An agent keys a layer with the keys a person sets (task an-agent-can-set-read-and-change-a-layer-s-keys). The tools land on the strip, where a person picks a key and changes it, at Next defaults with no flag.",
  "setup": { "forget": ["tools", "panel"] },
  "steps": [
    { "do": "blank", "canvasWidth": 900, "canvasHeight": 700, "width": 1420, "height": 980 },
    { "do": "wait", "seconds": 1 },
    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [120, 230], "to": [260, 370], "steps": 8 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "click", "at": [190, 300] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "snapshot", "name": "1-a-still-picture" },
    { "do": "agentTool", "tool": "set_keys", "arguments": "{\"layer\": \"$picked\", \"property\": \"rotation\", \"keys\": [{\"seconds\": 0, \"value\": 0, \"curve\": \"Linear\"}, {\"seconds\": 1, \"value\": 90}]}" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expect", "field": "Key Time", "reads": "0:00.00" },
    { "do": "expect", "field": "Key Length", "reads": "0:02.00" },
    { "do": "expect", "control": "Key 1", "in": "Rectangle", "present": true },
    { "do": "expect", "control": "Key 2", "in": "Rectangle", "present": true },
    { "do": "expect", "field": "Key lane Rectangle Rotation", "present": true },
    { "do": "snapshot", "name": "2-keys-from-the-tool-on-the-strip" },
    { "do": "windowClick", "at": [625, 937] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expect", "field": "Key Time", "reads": "0:01.00" },
    { "do": "snapshot", "name": "3-a-person-picks-the-second-key" },
    { "do": "focus", "field": "Opacity" },
    { "do": "type", "text": "30" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expect", "field": "Key lane Rectangle Opacity", "present": true },
    { "do": "snapshot", "name": "4-a-persons-change-keys-itself" },
    { "do": "agentTool", "tool": "set_timing", "arguments": "{\"seconds\": 1.5}" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expect", "field": "Key Length", "reads": "0:01.50" },
    { "do": "agentTool", "tool": "read_document" },
    { "do": "agentTool", "tool": "run_command", "arguments": "{\"command\": \"play_pause\"}" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expect", "control": "Pause", "present": true },
    { "do": "expectPictureMoves" },
    { "do": "snapshot", "name": "5-playing" },
    { "do": "agentTool", "tool": "run_command", "arguments": "{\"command\": \"play_pause\"}" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "expect", "control": "Play", "present": true },
    { "do": "writeSVG", "name": "keyed", "carries": "animateTransform" },
    { "do": "action", "action": "undo" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expect", "field": "Key Length", "reads": "0:02.00" }
  ]
}
