{
  "out": "/tmp/photonz-playtest/ask-changes-what-is-picked-walk",
  "seed": "ask-works-on-what-you-have-picked-so-make-this-b: at Next defaults, a rectangle and a circle are drawn, the circle is picked, the composer says 1 selected, make this bigger grows only the circle, and one Command Z takes it back",
  "clock": 480,
  "setup": { "forget": ["all"] },
  "steps": [
    { "do": "blank", "canvasWidth": 1000, "canvasHeight": 700, "width": 1280, "height": 840 },
    { "do": "wait", "seconds": 1 },
    { "do": "press", "control": "Ask" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expect", "control": "Ask Scope", "present": false },
    { "do": "snapshot", "name": "1-nothing-picked" },
    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [200, 200], "to": [420, 340] },
    { "do": "tool", "tool": "ellipse" },
    { "do": "drag", "from": [560, 220], "to": [720, 380] },
    { "do": "tool", "tool": "select" },
    { "do": "selectRow", "row": "Ellipse" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "expectLayers", "count": 3 },
    { "do": "expectPicked", "layers": ["Ellipse"] },
    { "do": "expectBox", "layer": "Ellipse", "at": [560, 220], "size": [160, 160] },
    { "do": "expectBox", "layer": "Rectangle", "at": [200, 200], "size": [220, 140] },
    { "do": "describe", "stage": "2-before", "note": "the circle is picked, 160 wide; the rectangle is 220 by 140" },
    { "do": "snapshot", "name": "2-before" },
    { "do": "press", "control": "Ask" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expect", "control": "Ask Scope", "present": true },
    { "do": "type", "text": "make this bigger" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "snapshot", "name": "3-composer-scope" },
    { "do": "press", "control": "Ask Send" },
    { "do": "waitFor", "condition": "askPhase", "value": "planning|running|ran|stopped", "timeout": 15 },
    { "do": "waitFor", "condition": "askPhase", "value": "ran|stopped", "timeout": 300 },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "4-after", "note": "only the circle grew" },
    { "do": "expectBox", "layer": "Ellipse", "size": [240, 240], "within": 79 },
    { "do": "expectBox", "layer": "Rectangle", "at": [200, 200], "size": [220, 140] },
    { "do": "snapshot", "name": "4-after" },
    { "do": "shortcut", "key": "z", "modifiers": ["command"] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "5-undone", "note": "one Command Z puts the circle back" },
    { "do": "expectBox", "layer": "Ellipse", "at": [560, 220], "size": [160, 160] },
    { "do": "expectBox", "layer": "Rectangle", "at": [200, 200], "size": [220, 140] },
    { "do": "snapshot", "name": "5-undone" }
  ]
}
