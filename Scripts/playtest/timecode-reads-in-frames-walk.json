{
  "out": "/tmp/photonz-playtest/timecode-reads-in-frames-walk",
  "seed": "Time on a video reads in frames where an editor expects frames. At Next defaults with no flag changed: a cross dissolve goes across a cut and reads in seconds, then View > Timecode is turned on and the panel's Length reads timecode; one end of the band is dragged and the bubble by the pointer and the Length row say the same whole number of frames. The transport and the ruler at fit and at their closest zoom are photographed in timecode, and turning Timecode off puts seconds back.",
  "setup": { "front": true, "timelineOpen": true, "forget": ["all"], "scratch": ["sample:recording as b-roll.mp4"] },
  "steps": [
    { "do": "action", "action": "openSampleRecording" },
    { "do": "wait", "seconds": 2.0 },
    { "do": "action", "action": "videoPause" },
    { "do": "tool", "tool": "select" },
    { "do": "action", "action": "clipDragEndIn" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "dropOnTimeline", "file": "scratch/b-roll.mp4", "track": "V1", "seconds": 6.95 },
    { "do": "wait", "seconds": 1.0 },
    { "do": "selectRow", "row": "b-roll" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "action", "action": "clipDragStartIn" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "press", "control": "Edit point Tutorial Sample to b-roll" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "press", "control": "Cross dissolve", "in": "At this cut" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expect", "menu": "Length", "reads": "0.4s" },
    { "do": "snapshot", "name": "1-seconds-by-default" },

    { "do": "menus", "stage": "2-view-menu", "menu": "View", "choose": "View > Timecode" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expect", "menu": "Length", "reads": "00:00:00:12" },
    { "do": "snapshot", "name": "2-timecode-on" },

    { "do": "dragGrip", "control": "Transition Tutorial Sample to b-roll end", "by": 24, "steps": 20, "within": 2, "hold": "3-end-mid-drag", "says": "00:00:00:24" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expect", "menu": "Length", "reads": "00:00:00:24" },
    { "do": "describe", "stage": "3-dragged", "note": "THE TEST: the band's end pulled by real mouse moves with Timecode on. The bubble by the pointer said a whole number of frames before letting go, and the panel's Length row says the same frames after" },
    { "do": "snapshot", "name": "4-after-the-drag" },

    { "do": "action", "action": "videoSeekStart" },
    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "snapshot", "name": "5-transport-and-ruler-at-fit" },
    { "do": "action", "action": "timelineZoomIn" },
    { "do": "action", "action": "timelineZoomIn" },
    { "do": "action", "action": "timelineZoomIn" },
    { "do": "action", "action": "timelineZoomIn" },
    { "do": "action", "action": "timelineZoomIn" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "snapshot", "name": "6-ruler-at-closest-zoom" },

    { "do": "menus", "stage": "7-view-menu-again", "menu": "View", "choose": "View > Timecode" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expect", "menu": "Length", "reads": "0.8s" },
    { "do": "snapshot", "name": "7-seconds-again" }
  ]
}
