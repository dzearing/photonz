{
  "out": "/tmp/photonz-playtest/text-on-a-path-walk",
  "seed": "A title's words follow a drawn curve (video-motion.html, 'Text on a path: A headline flows along any vector path. The path is editable, so the type reflows as you reshape the curve.'), at Next defaults with no flag changed. On the sample recording at 0:01: T, type a headline, draw a quarter circle with the Pen, pick both, Put Text on a Path. The measured bar: every letter as the canvas drew it is turned within 5 degrees of the curve's own direction under it and its baseline is within 2 points of the curve. Then a point of the curve is dragged and the words reflow, Start moves them along the curve, and two keys on Start make them travel.",
  "setup": { "timelineOpen": true, "forget": ["all"] },
  "steps": [
    { "do": "action", "action": "openSampleRecording" },
    { "do": "wait", "seconds": 2.0 },
    { "do": "action", "action": "videoPause" },
    { "do": "tool", "tool": "select" },
    { "do": "action", "action": "videoSeekStart" },
    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "wait", "seconds": 0.8 },

    { "do": "key", "key": "t" },
    { "do": "click", "at": [950, 110] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "type", "text": "Follow the curve" },
    { "do": "key", "key": "return", "modifiers": ["command"] },
    { "do": "wait", "seconds": 1.0 },
    { "do": "describe", "stage": "1-a-headline", "note": "a headline typed with T over the recording at 0:01, set straight in its box" },
    { "do": "snapshot", "name": "1-a-headline" },

    { "do": "tool", "tool": "pen" },
    { "do": "drag", "from": [380, 760], "to": [380, 495], "steps": 8 },
    { "do": "drag", "from": [860, 280], "to": [1125, 280], "steps": 8 },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expectPath", "anchors": 2, "closed": false, "curves": 1 },
    { "do": "describe", "stage": "2-a-curve", "note": "a quarter circle drawn with the Pen: from (380, 760) rising to (860, 280), its two levers making the arc" },
    { "do": "snapshot", "name": "2-a-curve" },

    { "do": "click", "at": [1000, 140], "modifiers": ["shift"] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "3-both-picked", "note": "the curve and the headline picked together" },
    { "do": "action", "action": "putTextOnPath" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "describe", "stage": "4-on-the-curve", "note": "THE PICTURE TO LOOK AT. Put Text on a Path: the headline's letters stand on the curve one by one, each turned to it, and the curve's two points and its dashed line are on the words, ready to reshape. The curve itself draws nothing." },
    { "do": "action", "action": "expectWordsFollowTheCurve" },
    { "do": "expect", "field": "Path start Value", "reads": "0" },
    { "do": "panel", "stage": "4-on-the-curve" },
    { "do": "render", "name": "doc-4-on-the-curve" },
    { "do": "snapshot", "name": "4-on-the-curve" },

    { "do": "drag", "from": [860, 280], "to": [1000, 360], "steps": 12 },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "5-reshaped", "note": "the curve's end point dragged down and right: the letters reflow along the new curve, still each turned to it" },
    { "do": "action", "action": "expectWordsFollowTheCurve" },
    { "do": "render", "name": "doc-5-reshaped" },
    { "do": "snapshot", "name": "5-reshaped" },

    { "do": "focus", "field": "Path start" },
    { "do": "key", "key": "a", "modifiers": ["command"] },
    { "do": "type", "text": "25" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expect", "field": "Path start Value", "reads": "25" },
    { "do": "action", "action": "expectWordsFollowTheCurve" },
    { "do": "describe", "stage": "6-start-25", "note": "Start 25: the words begin a quarter of the way along the curve" },
    { "do": "snapshot", "name": "6-start-25" },

    { "do": "focus", "field": "Path start" },
    { "do": "key", "key": "a", "modifiers": ["command"] },
    { "do": "type", "text": "-60" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "press", "control": "Key", "in": "Path start" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "7-key-at-1s", "note": "Start -60 keyed at 0:01: most of the words are still on their way, only the last few on the curve" },
    { "do": "snapshot", "name": "7-key-at-1s" },
    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "focus", "field": "Path start" },
    { "do": "key", "key": "a", "modifiers": ["command"] },
    { "do": "type", "text": "0" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expect", "field": "Path start Value", "reads": "0" },
    { "do": "action", "action": "expectWordsFollowTheCurve" },
    { "do": "describe", "stage": "8-key-at-2s", "note": "a second key at 0:02 with Start 0: every word has arrived on the curve" },
    { "do": "snapshot", "name": "8-key-at-2s" },
    { "do": "action", "action": "videoStepBackOneSecond" },
    { "do": "action", "action": "videoStepQuarterSecond" },
    { "do": "action", "action": "videoStepQuarterSecond" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "9-half-way", "note": "THE MOTION: at 0:01.5, between the two keys, the words are part way along the curve, travelling on it rather than sliding across the picture" },
    { "do": "action", "action": "expectWordsFollowTheCurve" },
    { "do": "render", "name": "doc-9-half-way" },
    { "do": "snapshot", "name": "9-half-way" },

    { "do": "action", "action": "videoStepQuarterSecond" },
    { "do": "action", "action": "videoStepQuarterSecond" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "click", "at": [700, 600], "count": 2 },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "10-editing", "note": "a double click on the words opens them for typing, in their own font" },
    { "do": "snapshot", "name": "10-editing" },
    { "do": "key", "key": "a", "modifiers": ["command"] },
    { "do": "type", "text": "Ride the curve" },
    { "do": "key", "key": "return", "modifiers": ["command"] },
    { "do": "wait", "seconds": 1.0 },
    { "do": "render", "name": "doc-11-committed" },
    { "do": "click", "at": [700, 600] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "action", "action": "expectWordsFollowTheCurve" },
    { "do": "describe", "stage": "11-reworded", "note": "re-worded by double click: the new words are on the same curve, in the same font, colour and shadow" },
    { "do": "render", "name": "doc-11-reworded" },
    { "do": "snapshot", "name": "11-reworded" },

    { "do": "writeVideo", "name": "12-export", "format": "mp4", "seconds": 8.0, "within": 0.6, "copied": false },
    { "do": "describe", "stage": "12-exported", "note": "the edit written out as an MP4 the way Export does: its frames between 0:01 and 0:02 carry the words travelling along the curve" }
  ]
}
