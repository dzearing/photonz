    { "do": "tool", "tool": "select" },
    { "do": "action", "action": "videoSeekStart" },
    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "key", "key": "t" },
    { "do": "click", "at": [620, 330] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "type", "text": "Lift off" },
    { "do": "key", "key": "return", "modifiers": ["command"] },
    { "do": "wait", "seconds": 1.0 },
    { "do": "tool", "tool": "select" },
    { "do": "reveal", "control": "Properties section" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "press", "control": "Animate a property" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "1-the-list-open", "note": "THE FIRST PICTURE: the list open over the Properties section, its find box ready, every value the title can key under it" },
    { "do": "expect", "field": "Find a property", "reads": "Find a property" },
    { "do": "expect", "control": "Position", "in": "Animate a property", "present": true },
    { "do": "snapshot", "name": "1-the-list-open" },
    { "do": "key", "key": "s" },
    { "do": "key", "key": "c" },
    { "do": "key", "key": "a" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "describe", "stage": "2-typed-sca", "note": "THE FIRST TEST: typing sca into the open list narrows it to Scale, with no click into the box first" },
    { "do": "expect", "field": "Find a property", "reads": "sca" },
    { "do": "expect", "control": "Scale", "in": "Animate a property", "present": true },
    { "do": "expect", "control": "Position", "in": "Animate a property", "present": false },
    { "do": "snapshot", "name": "2-typed-sca" },
    { "do": "key", "key": "delete" },
    { "do": "key", "key": "delete" },
    { "do": "key", "key": "delete" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "describe", "stage": "3-deleted", "note": "THE SECOND TEST: Delete takes the letters back off and the whole list returns" },
    { "do": "expect", "field": "Find a property", "reads": "Find a property" },
    { "do": "expect", "control": "Position", "in": "Animate a property", "present": true },
    { "do": "key", "key": "b" },
    { "do": "key", "key": "l" },
    { "do": "key", "key": "u" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "describe", "stage": "4-typed-blu", "note": "THE THIRD TEST: B typed into the list is a letter, not the blade: the box reads blu and Blur is offered" },
    { "do": "expect", "field": "Find a property", "reads": "blu" },
    { "do": "expect", "control": "Blur", "in": "Animate a property", "present": true },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "5-return-keys-blur", "note": "THE FOURTH TEST: Return keys the first value left, Blur, at the playhead, and the list closes" },
    { "do": "expect", "control": "Key", "in": "Blur", "reads": "on a key" },
    { "do": "expect", "control": "Position", "in": "Animate a property", "present": false },
    { "do": "press", "control": "Animate a property" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expect", "control": "Position", "in": "Animate a property", "present": true },
    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "6-escape-closes", "note": "THE FIFTH TEST: Escape closes the list" },
    { "do": "expect", "control": "Position", "in": "Animate a property", "present": false },
    { "do": "press", "control": "Animate a property" },
    { "do": "wait", "seconds": 0.6 },
