{
  "out": "/tmp/photonz-playtest/animate-a-property-find-walk",
  "seed": "Animate a property's list opens over the Properties section, the mock's way, and its find box takes typing the moment it opens, at Next defaults with no flag changed. Typing narrows the list, Delete widens it again, Return keys the first value left, Escape closes it, and a pointer click outside it closes it too. Letters typed into it never reach the timeline or the canvas: B is typed here and the blade must not be picked up.",
  "setup": { "timelineOpen": true, "forget": ["all"] },
  "steps": [
