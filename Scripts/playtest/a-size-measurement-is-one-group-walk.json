{
  "out": "/tmp/photonz-playtest/a-size-measurement-is-one-group-walk",
  "seed": "The user, 2026-10-13: when I measure the size of a box I would like a semitransparent (10% opacity) red box over the space being measured, and the size to be one layer group that can be expanded to change its three parts. At Next defaults, with no switch touched, Size mode measures the purple download pill on a real Retina screenshot. The click has to leave ONE group named for its size, holding a Box tinted in the calipers' ink (blue by default since 2026-10-13, it was red) at 10% opacity exactly over the pill, a Width and a Height. The group is picked whole, nudged as one, listed as one Size row in Measurements, and the spec list still says Width and Height. Then the group is opened in the layers list, its Box picked, and the Box's opacity changed to 25%.",
  "setup": { "forget": ["all"] },
  "steps": [
    { "do": "open", "file": "../../Tests/PhotonzRenderTests/Fixtures/download-pill-2x.png", "width": 1280, "height": 840 },
    { "do": "wait", "seconds": 1 },
    { "do": "key", "key": "i" },
    { "do": "waitFor", "condition": "tool", "value": "measure" },
    { "do": "waitFor", "condition": "edgeMap", "timeout": 15 },
    { "do": "measureMode", "mode": "size" },

    { "do": "move", "at": [520, 330] },
    { "do": "wait", "seconds": 0.4 },
    { "do": "click", "at": [520, 330] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expectMeasures", "count": 2, "reads": ["274 px", "62 px"] },
    { "do": "expectSizeMeasure", "count": 1, "name": "Size 274 × 62", "boxOpacity": 0.1, "boxInSizeInk": true, "at": [492, 270] },
    { "do": "expectPicked", "layers": [] },
    { "do": "waitFor", "condition": "tool", "value": "measure" },
    { "do": "key", "key": "v" },
    { "do": "waitFor", "condition": "tool", "value": "select" },
    { "do": "selectRow", "row": "Size 274 × 62" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "expectPicked", "layers": ["Size 274 × 62"] },
    { "do": "describe", "stage": "1-measured", "note": "THE FIRST CLAIM: one click on the pill left one group, Size 274 × 62, holding a faint Box in the calipers' blue, a Width and a Height, and Measure stays in hand with nothing picked (the user's answer on 2026-10-11); V and the group's row pick it whole" },
    { "do": "snapshot", "name": "1-one-size-group" },

    { "do": "panel", "stage": "2-panel" },
    { "do": "expect", "row": "Size", "present": true },
    { "do": "expect", "row": "Width", "present": false },
    { "do": "clearClipboard" },
    { "do": "action", "action": "copySpecList" },
    { "do": "readClipboard", "stage": "2-spec" },

    { "do": "key", "key": "right", "modifiers": ["shift"] },
    { "do": "wait", "seconds": 0.4 },
    { "do": "expectSizeMeasure", "count": 1, "name": "Size 274 × 62", "at": [502, 270] },
    { "do": "expectMeasures", "count": 2, "reads": ["274 px", "62 px"] },
    { "do": "describe", "stage": "3-moved", "note": "THE SECOND CLAIM: Shift-Right moved the group ten points, box and both calipers together" },
    { "do": "snapshot", "name": "3-moved-as-one" },

    { "do": "action", "action": "undo" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "expectSizeMeasure", "count": 1, "at": [492, 270] },
    { "do": "action", "action": "undo" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "expectSizeMeasure", "count": 0 },
    { "do": "expectMeasures", "count": 0 },
    { "do": "action", "action": "redo" },
    { "do": "action", "action": "redo" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "expectSizeMeasure", "count": 1, "name": "Size 274 × 62", "at": [502, 270] },
    { "do": "describe", "stage": "3b-undo", "note": "one undo puts the nudge back, one more takes the whole measurement away, box and both calipers, and redo brings it all back" },

    { "do": "reveal", "control": "Twist", "in": "Size 274 × 62" },
    { "do": "press", "control": "Twist", "in": "Size 274 × 62" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "expectRows", "rows": ["Size 274 × 62", "  Height", "  Width", "  Box", "Background"] },
    { "do": "selectRow", "row": "Box" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "expectPicked", "layers": ["Box"] },
    { "do": "focus", "field": "Opacity" },
    { "do": "type", "text": "25" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "expectSizeMeasure", "count": 1, "boxOpacity": 0.25, "boxInSizeInk": true },
    { "do": "describe", "stage": "4-box-opacity", "note": "THE THIRD CLAIM: opened in the layers list, the group shows Box, Width and Height; the Box picked on its own takes 25% opacity like any shape" },
    { "do": "snapshot", "name": "4-box-at-25" },

    { "do": "selectRow", "row": "Size 274 × 62" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "expectPicked", "layers": ["Size 274 × 62"] },
    { "do": "key", "key": "delete" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "expectSizeMeasure", "count": 0 },
    { "do": "expectMeasures", "count": 0 },
    { "do": "describe", "stage": "5-deleted", "note": "Delete on the picked group takes the box and both calipers in one go" },

    { "do": "key", "key": "i" },
    { "do": "waitFor", "condition": "tool", "value": "measure" },
    { "do": "measureMode", "mode": "size" },
    { "do": "move", "at": [520, 330] },
    { "do": "wait", "seconds": 0.4 },
    { "do": "click", "at": [520, 330] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expectSizeMeasure", "count": 1, "name": "Size 274 × 62", "boxOpacity": 0.25, "boxInSizeInk": true },
    { "do": "describe", "stage": "6-remembered", "note": "THE LAST CLAIM: the next Size measurement's box starts at the 25% the last box was given" }
  ]
}
