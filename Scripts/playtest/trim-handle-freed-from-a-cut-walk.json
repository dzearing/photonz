{
  "out": "/tmp/photonz-playtest/trim-handle-freed-from-a-cut-walk",
  "setup": { "forget": ["all"] },
  "steps": [
    { "do": "action", "action": "openSampleRecording" },
    { "do": "action", "action": "videoPause" },
    { "do": "action", "action": "videoSeekQuarter" },
    { "do": "action", "action": "clipSplit" },
    { "do": "action", "action": "videoSeekThreeQuarters" },
    { "do": "action", "action": "clipSplit" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "action", "action": "videoBeginTrim" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectRecording", "pieces": 3, "seconds": 8, "starts": 0 },
    { "do": "expectTimeline", "snapping": true, "tool": "trim" },

    { "do": "action", "action": "videoDragTrimNearCut" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "expectRecording", "starts": 2, "seconds": 6 },
    { "do": "describe", "stage": "1-the-cut-takes-it", "note": "THE TEST: the in handle was dragged by hand to a few frames short of the cut at two seconds and landed exactly on it, the way a Premiere trim snaps to an edit point while snapping is on" },
    { "do": "snapshot", "name": "1-the-cut-takes-it" },

    { "do": "action", "action": "videoDragTrimClearOfCut" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "expectRecording", "starts": 1.841 },
    { "do": "describe", "stage": "2-clear-of-it-goes-where-the-hand-is", "note": "three times as far short is a move rather than a wobble, and the handle goes exactly where the hand has it: the magnet never pulls from across the track" },
    { "do": "snapshot", "name": "2-clear-of-it" },

    { "do": "action", "action": "videoDragTrimNearCut" },
    { "do": "action", "action": "videoDragTrimEndNearCut" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "expectRecording", "starts": 2, "seconds": 4 },
    { "do": "describe", "stage": "3-both-ends-catch", "note": "the out handle catches on the last cut coming the other way, so the handles bracket exactly the middle piece" },
    { "do": "snapshot", "name": "3-both-ends-catch" },

    { "do": "action", "action": "videoTrimDone" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "expectRecording", "pieces": 1, "seconds": 4 },
    { "do": "describe", "stage": "4-trim-keeps-what-caught", "note": "Trim keeps the middle piece whole: one piece, four seconds, no sliver of either neighbour" },
    { "do": "snapshot", "name": "4-trim-keeps-what-caught" }
  ]
}
