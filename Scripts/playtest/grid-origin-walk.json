{
  "out": "/tmp/photonz-playtest/grid-origin-walk",
  "setup": {
    "forget": ["grid", "shapes", "tools", "panel"]
  },
  "steps": [
    { "do": "appearance", "value": "light" },
    { "do": "blank", "canvasWidth": 900, "canvasHeight": 700, "width": 1560, "height": 940 },
    { "do": "wait", "seconds": 0.8 },

    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [300, 260], "to": [620, 420] },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.5 },

    { "do": "action", "action": "showGrid" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "1-before", "note": "grid on, starting at the corner of the picture as it always has: expect gridStart 0, 0 and no guides" },
    { "do": "snapshot", "name": "1-grid-before" },

    { "do": "press", "control": "Adjust Grid" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "2-mode", "note": "the tool bar has been replaced by the grid bar: the cell button, Clear Guides, Cancel and Done" },
    { "do": "snapshot", "name": "2-mode-entered" },

    { "do": "press", "control": "Cell" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "press", "control": "16 px" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "describe", "stage": "3-cell", "note": "cell 16 so the lines are in a known place: every guide below lands on a multiple of 16" },

    { "do": "move", "at": [416, 300] },
    { "do": "wait", "seconds": 0.3 },
    { "do": "click", "at": [416, 300] },
    { "do": "wait", "seconds": 0.4 },
    { "do": "describe", "stage": "4-pinned", "note": "a click away from the markers pins a guide on the line it was lighting: expect x416, held" },
    { "do": "snapshot", "name": "4-guide-pinned" },

    { "do": "move", "at": [504, 288] },
    { "do": "wait", "seconds": 0.3 },
    { "do": "click", "at": [504, 288] },
    { "do": "wait", "seconds": 0.4 },
    { "do": "describe", "stage": "5-second", "note": "a second guide, this one horizontal: expect x416 y288, and the hold has moved to the new one" },

    { "do": "move", "at": [416, 500] },
    { "do": "wait", "seconds": 0.3 },
    { "do": "click", "at": [416, 500] },
    { "do": "wait", "seconds": 0.4 },
    { "do": "describe", "stage": "6-selected", "note": "clicking the first guide takes hold of it again: expect the star back on x416, and still exactly two guides" },
    { "do": "snapshot", "name": "6-guide-selected" },

    { "do": "key", "key": "backspace" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "describe", "stage": "7-deleted", "note": "the held guide comes off and the other stays: expect y288 alone" },

    { "do": "drag", "from": [0, 300], "to": [500, 560], "steps": 12 },
    { "do": "wait", "seconds": 0.4 },
    { "do": "describe", "stage": "8-placed", "note": "the zero point is dragged by its markers, which is anywhere along either of them: expect gridStart 500, 560" },
    { "do": "snapshot", "name": "8-zero-placed" },

    { "do": "drag", "from": [500, 560], "to": [617, 417], "steps": 16, "hold": "9-caught-held" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "9-caught", "note": "dragged at the rectangle's bottom right corner: the markers should have caught its two edges, with yellow guides saying so. Expect gridStart 620, 420" },
    { "do": "snapshot", "name": "9-caught-on-a-layer-edge" },

    { "do": "key", "key": "right" },
    { "do": "key", "key": "right" },
    { "do": "key", "key": "down" },
    { "do": "key", "key": "down", "modifiers": ["shift"] },
    { "do": "wait", "seconds": 0.4 },
    { "do": "describe", "stage": "10-nudged", "note": "four arrow presses: two points across, one down, then ten more down with Shift. Expect gridStart 622, 431" },
    { "do": "snapshot", "name": "10-nudged" },

    { "do": "press", "control": "Done" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "11-kept", "note": "back to the tools, and the grid keeps its new zero point and its one guide: expect gridStart 622, 431 and y288" },
    { "do": "snapshot", "name": "11-kept" },

    { "do": "press", "control": "Adjust Grid" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "drag", "from": [622, 200], "to": [100, 120], "steps": 12 },
    { "do": "wait", "seconds": 0.4 },
    { "do": "describe", "stage": "12-about-to-cancel", "note": "the zero point moved again, this time on the way to being thrown away: expect gridStart 100, 120" },
    { "do": "snapshot", "name": "12-about-to-cancel" },
    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "13-cancelled", "note": "Escape put the zero point back exactly as it was before the mode: expect gridStart 622, 431 and the guide still y288" },
    { "do": "snapshot", "name": "13-cancelled" }
  ]
}
