{
  "out": "/tmp/photonz-playtest/tutorial-component-versions-walk",
  "seed": "The fourth guide of the Components track: a component holds more than one drawing of itself, and every copy says which one it is showing. A button needs a switched off look as well, and keeping both under one name is what stops the two drifting apart. The guide is called One name, two looks, and the panel asks the question as one PROPERTY of the component called Variant.",
  "setup": { "forget": ["tutorials", "panel", "color", "groups"] },
  "steps": [
    { "do": "open", "file": "../../Tests/PhotonzRenderTests/Fixtures/settings-pane-2x.png", "width": 1280, "height": 900 },
    { "do": "wait", "seconds": 1 },

    { "do": "startGuide", "guide": "component-versions" },
    { "do": "waitFor", "condition": "tutorialStep", "value": "pick-the-original", "timeout": 10 },
    { "do": "wait", "seconds": 1 },
    { "do": "describe", "stage": "1-pick-the-original", "note": "the same desk the override guide uses: one original and two copies" },
    { "do": "snapshot", "name": "1-pick-the-original" },

    { "do": "click", "at": [176, 112] },
    { "do": "waitFor", "condition": "tutorialStep", "value": "add-a-version", "timeout": 6 },
    { "do": "wait", "seconds": 0.9 },
    { "do": "describe", "stage": "2-add-a-version", "note": "the Properties list on the original, empty, saying what goes in it" },
    { "do": "panel", "stage": "2-add-a-version" },
    { "do": "snapshot", "name": "2-add-a-version" },

    { "do": "action", "action": "addComponentVersion" },
    { "do": "waitFor", "condition": "tutorialStep", "value": "name-it", "timeout": 6 },
    { "do": "wait", "seconds": 1 },
    { "do": "describe", "stage": "3-second-drawing", "note": "a second drawing landed beside the first on clear page, it is the one selected, and its name is waiting to be typed over" },
    { "do": "snapshot", "name": "3-second-drawing" },
    { "do": "render", "name": "3-second-drawing-doc" },

    { "do": "type", "text": "Disabled" },
    { "do": "key", "key": "return" },
    { "do": "waitFor", "condition": "tutorialStep", "value": "grey-it-out", "timeout": 6 },
    { "do": "wait", "seconds": 1 },
    { "do": "describe", "stage": "4-named", "note": "both drawings say Save Button, and the new one says Disabled beside it" },
    { "do": "panel", "stage": "4-named" },
    { "do": "snapshot", "name": "4-named" },

    { "do": "click", "at": [380, 114], "count": 2 },
    { "do": "wait", "seconds": 0.8 },
    { "do": "press", "control": "Color", "in": "@fill" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "press", "control": "Shades 5" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "key", "key": "escape" },
    { "do": "waitFor", "condition": "tutorialStep", "value": "pick-a-copy", "timeout": 6 },
    { "do": "wait", "seconds": 1 },
    { "do": "describe", "stage": "5-greyed", "note": "THE TEST for variants being whole drawings: only the Disabled drawing changed. The first drawing and both copies are untouched" },
    { "do": "snapshot", "name": "5-greyed" },
    { "do": "render", "name": "5-greyed-doc" },

    { "do": "click", "at": [176, 216] },
    { "do": "waitFor", "condition": "tutorialStep", "value": "switch-it", "timeout": 6 },
    { "do": "wait", "seconds": 0.9 },
    { "do": "describe", "stage": "6-copy-picked", "note": "a copy's own section, with Variant as its top row" },
    { "do": "panel", "stage": "6-copy-picked" },
    { "do": "snapshot", "name": "6-copy-picked" },

    { "do": "action", "action": "showNextComponentVersion" },
    { "do": "waitFor", "condition": "tutorialStep", "value": "under-one-name", "timeout": 6 },
    { "do": "wait", "seconds": 1 },
    { "do": "describe", "stage": "7-switched", "note": "THE TEST: this copy alone now draws the Disabled look, and the other copy carries on showing the first drawing. One tile, one name, two looks" },
    { "do": "panel", "stage": "7-switched" },
    { "do": "snapshot", "name": "7-switched" },
    { "do": "render", "name": "7-switched-doc" },

    { "do": "action", "action": "tutorialNext" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "8-finished", "note": "Done closed the guide" }
  ]
}
