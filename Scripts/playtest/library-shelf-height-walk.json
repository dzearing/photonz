{
  "out": "/tmp/photonz-playtest/library-shelf-height",
  "setup": {
    "forget": [
      "all"
    ]
  },
  "steps": [
    {
      "do": "blank",
      "canvasWidth": 1440,
      "canvasHeight": 1024,
      "width": 1240,
      "height": 900
    },
    {
      "do": "action",
      "action": "showComponentShelf"
    },
    {
      "do": "wait",
      "seconds": 1.4
    },
    {
      "do": "describe",
      "stage": "1-two-rows",
      "note": "five starters wrap into three rows of cards: two whole rows show and a sliver of the third says there is more"
    },
    {
      "do": "snapshot",
      "name": "shelf-1-two-rows"
    },
    {
      "do": "focus",
      "field": "Search components"
    },
    {
      "do": "type",
      "text": "badge"
    },
    {
      "do": "wait",
      "seconds": 0.9
    },
    {
      "do": "describe",
      "stage": "2-one-tile",
      "note": "narrowed to one tile: the shelf is one tile tall, not a tall empty box"
    },
    {
      "do": "snapshot",
      "name": "shelf-2-one-tile"
    },
    {
      "do": "key",
      "key": "delete"
    },
    {
      "do": "key",
      "key": "delete"
    },
    {
      "do": "key",
      "key": "delete"
    },
    {
      "do": "key",
      "key": "delete"
    },
    {
      "do": "key",
      "key": "delete"
    },
    {
      "do": "wait",
      "seconds": 0.9
    },
    {
      "do": "describe",
      "stage": "3-back",
      "note": "clearing the search puts all five back: two whole rows and a sliver again"
    },
    {
      "do": "snapshot",
      "name": "shelf-3-back"
    },
    {
      "comment": "In the pane of lists the shelf has no grab bar of its own: it fills the room the pane holds, and the pane's grip sets that room.",
      "do": "dragHandle",
      "area": "Library",
      "expect": "absent"
    },
    {
      "do": "dragHandle",
      "area": "Lists",
      "by": -30
    },
    {
      "do": "wait",
      "seconds": 0.8
    },
    {
      "do": "describe",
      "stage": "4-capped",
      "note": "the pane's grip pulled down: the shelf still runs to the pane's foot, caps short of its rows and scrolls on its own"
    },
    {
      "do": "snapshot",
      "name": "shelf-4-capped"
    },
    {
      "do": "dragHandle",
      "area": "Lists",
      "by": 130
    },
    {
      "do": "wait",
      "seconds": 0.8
    },
    {
      "do": "describe",
      "stage": "5-restored",
      "note": "pulling the grip back up gives the pane more room, and the shelf grows with it to show more of its rows"
    },
    {
      "do": "snapshot",
      "name": "shelf-5-restored"
    }
  ]
}
