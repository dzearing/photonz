{
  "out": "/tmp/photonz-playtest/pen-draws-a-path-walk",
  "setup": { "forget": ["all"] },
  "steps": [
    { "do": "blank", "canvasWidth": 900, "canvasHeight": 700, "width": 1280, "height": 900 },
    { "do": "wait", "seconds": 1 },

    { "do": "key", "key": "p" },
    { "do": "waitFor", "condition": "tool", "value": "pen" },
    { "do": "describe", "stage": "1-pen", "note": "P picked up the Pen and the chip under the canvas says what a click does" },
    { "do": "snapshot", "name": "1-pen-in-hand" },

    { "do": "click", "at": [200, 500] },
    { "do": "wait", "seconds": 0.3 },
    { "do": "move", "at": [350, 260] },
    { "do": "wait", "seconds": 0.3 },
    { "do": "describe", "stage": "2-rubber-band", "note": "one anchor down, and the run to the pointer is drawn before anything is committed" },
    { "do": "snapshot", "name": "2-first-anchor-and-preview" },

    { "do": "drag", "from": [450, 220], "to": [560, 220], "steps": 10 },
    { "do": "wait", "seconds": 0.3 },
    { "do": "describe", "stage": "3-curve", "note": "the second anchor placed with a drag: handles pulled out of it, so the run behind it bends" },
    { "do": "snapshot", "name": "3-handles-pulled" },

    { "do": "click", "at": [700, 500] },
    { "do": "wait", "seconds": 0.3 },
    { "do": "move", "at": [203, 503] },
    { "do": "wait", "seconds": 0.3 },
    { "do": "describe", "stage": "4-close-ring", "note": "the pointer back on the first anchor: it wears a ring, and the preview shows the shape closed and filled" },
    { "do": "snapshot", "name": "4-close-offered" },

    { "do": "click", "at": [203, 503] },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expectPath", "anchors": 3, "closed": true, "curves": 2 },
    { "do": "expectPicked", "layers": ["Path"] },
    { "do": "waitFor", "condition": "tool", "value": "select", "timeout": 2 },
    { "do": "describe", "stage": "5-closed", "note": "three anchors, closed, two curved runs; the new path is picked and the POINTER is back, the way every tool that makes something ends (pen-hands-back-walk is the walk about that)" },
    { "do": "snapshot", "name": "5-path-closed" },
    { "do": "expectLayers", "count": 2 },

    { "do": "action", "action": "undo" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expectLayers", "count": 1 },
    { "do": "describe", "stage": "6-undo", "note": "one undo step takes the whole path away, however many anchors went into it" },

    { "do": "action", "action": "redo" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expectPath", "anchors": 3, "closed": true, "curves": 2 },

    { "do": "key", "key": "p" },
    { "do": "waitFor", "condition": "tool", "value": "pen" },
    { "do": "click", "at": [300, 120] },
    { "do": "wait", "seconds": 0.2 },
    { "do": "click", "at": [500, 120] },
    { "do": "wait", "seconds": 0.2 },
    { "do": "click", "at": [600, 180] },
    { "do": "wait", "seconds": 0.2 },
    { "do": "key", "key": "z", "modifiers": ["command"] },
    { "do": "wait", "seconds": 0.4 },
    { "do": "expectLayers", "count": 2 },
    { "do": "describe", "stage": "7-undo-one-point", "note": "Command Z while drawing steps back ONE anchor: the closed path from before is still the only path in the document, so undo did not reach the document at all" },

    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expectLayers", "count": 2 },
    { "do": "expectPath", "anchors": 3, "closed": true },
    { "do": "describe", "stage": "8-escape", "note": "Escape threw the half-drawn line away and left the finished path alone" },
    { "do": "snapshot", "name": "8-after-escape" },

    { "do": "key", "key": "p" },
    { "do": "waitFor", "condition": "tool", "value": "pen" },
    { "do": "click", "at": [300, 620] },
    { "do": "wait", "seconds": 0.2 },
    { "do": "click", "at": [520, 620] },
    { "do": "wait", "seconds": 0.2 },
    { "do": "click", "at": [640, 660] },
    { "do": "wait", "seconds": 0.2 },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expectPath", "anchors": 3, "closed": false, "curves": 0 },
    { "do": "expectLayers", "count": 3 },
    { "do": "describe", "stage": "9-open", "note": "Return finished an open path: a line of three corners, kept rather than discarded" },
    { "do": "snapshot", "name": "9-open-path-kept" },
    { "do": "render", "name": "10-final-render" }
  ]
}
