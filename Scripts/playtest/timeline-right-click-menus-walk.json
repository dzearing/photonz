{
  "out": "/tmp/photonz-playtest/timeline-right-click-menus-walk",
  "seed": "At Next defaults, with no switch touched: every kind of thing on the timeline has its own short right-click menu, laid out by one table (docs/design/timeline-right-click.md). The tutorial recording with a zoom, a title page on V2, a picture on V3 and music under it, the playhead parked at two seconds. A video clip leads with Split at 0:02.00, Freeze Frame at 0:02.00… and Speed, then Add Transition, Detach Audio and Audio, then Cut, Copy, Delete and Ripple Delete, and the rest under More; its sound, a sound of its own, the title, the picture, the zoom bar, a join, a gap and empty space each read exactly as the table says. Rows that cannot act are left out, not greyed: the music starts after the playhead so it has no Split, and the picture offers Start at 0:02.00 and no End. The user, 2026-10-17: the clip menu was enormous and made nearly no sense.",
  "setup": {
    "timelineOpen": true,
    "forget": ["all"],
    "scratch": ["sample:recording as b-roll.mp4"]
  },
  "steps": [
    { "comment": "Nothing left on the clipboard by an earlier walk: the clip's More lists Paste Keys while keys are on it.", "do": "clearClipboard" },
    { "do": "action", "action": "openSampleRecording" },
    { "do": "wait", "seconds": 2.0 },
    { "do": "action", "action": "videoPause" },
    { "do": "tool", "tool": "select" },
    { "do": "clickRuler", "seconds": 1.0 },
    { "do": "action", "action": "zoomAddAtPlayhead" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "rightClick", "on": "Track V1", "choose": "Add Track Above" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "rightClick", "on": "Track V2", "choose": "Add Title Page > More Styles > Stacked Stagger" },
    { "do": "wait", "seconds": 1.2 },
    { "do": "key", "key": "escape" },
    { "do": "key", "key": "escape" },
    { "do": "rightClick", "on": "Track V2", "choose": "Add Track Above" },
    { "do": "wait", "seconds": 0.5 },
    { "comment": "Empty space on an empty picture track: somewhere to put something, and the track one level down.",
      "do": "rightClick", "at": [800, 825], "space": "window", "shot": "9-empty-track-space",
      "rows": ["Add Title Page", "Add Name Card", "Add Chart", "Add Text", "Add Rectangle", "—", "Track"] },
    { "do": "dropOnTimeline", "file": "fixtures/Plain blue tile 200x140.png", "track": "V3", "seconds": 4.0 },
    { "do": "wait", "seconds": 0.8 },
    { "do": "key", "key": "escape" },
    { "do": "action", "action": "soundAddSample" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "clickRuler", "seconds": 2.0 },
    { "do": "wait", "seconds": 0.4 },
    { "do": "snapshot", "name": "0-timeline" },
    { "comment": "THE FIRST TEST: the video clip, eleven rows in four groups, the long tail under More.",
      "do": "rightClick", "on": "Tutorial Sample clip", "across": 0.6, "shot": "1-video-clip",
      "rows": ["Split at 0:02.00", "Freeze Frame at 0:02.00…", "Speed", "—",
               "Add Transition", "Detach Audio", "Audio", "—",
               "Cut", "Copy", "Delete", "Ripple Delete", "—", "More"],
      "more": ["Ripple Trim Start to Playhead", "Ripple Trim End to Playhead", "—",
               "Fade In and Out", "Fade In", "Fade Out", "Punch In", "Add Click at 0:02.00…", "—",
               "Animate", "Add Key at 0:02.00", "—",
               "Select Forward", "Duplicate", "Rename…", "Reveal in Finder"],
      "keys": { "Split at 0:02.00": "⌘B", "Freeze Frame at 0:02.00…": "⌥⇧F", "Detach Audio": "⌃⇧D", "Cut": "⌘X", "Copy": "⌘C",
                "Delete": "⌫", "Ripple Delete": "⇧⌫" } },
    { "comment": "The sound drawn under the video answers like a sound: no picture rows.",
      "do": "rightClick", "at": [518, 916], "space": "window", "shot": "2-linked-sound",
      "rows": ["Split at 0:02.00", "Speed", "—", "Detach Audio", "Normalize", "Clean Noise", "—",
               "Cut", "Copy", "Delete", "Ripple Delete", "—", "More"],
      "more": ["Ripple Trim Start to Playhead", "Ripple Trim End to Playhead", "—", "Add Captions", "—",
               "Select Forward", "Duplicate", "Rename…", "Reveal in Finder"] },
    { "comment": "The music starts after the playhead: no Split, rather than a greyed one.",
      "do": "rightClick", "on": "Sample Music clip", "across": 0.3, "shot": "3-sound-clip",
      "rows": ["Speed", "—", "Normalize", "Clean Noise", "—", "Cut", "Copy", "Delete", "Ripple Delete", "—", "More"],
      "lacks": ["Split at 0:02.00"] },
    { "do": "rightClick", "on": "Title Page clip", "across": 0.5, "shot": "4-title",
      "rows": ["Split at 0:02.00", "Start at 0:02.00", "End at 0:02.00", "—", "Fade In and Out", "Animate In", "Animate Out", "—",
               "Cut", "Copy", "Delete", "Ripple Delete", "—", "More"],
      "more": ["Fade In", "Fade Out", "Animate", "Add Key at 0:02.00", "—",
               "Replay Title", "Save as Preset…", "—", "Select Forward", "Duplicate", "Rename…"] },
    { "comment": "The picture starts at four seconds: it can start at the playhead, not end there.",
      "do": "rightClick", "on": "Plain blue tile 200x140 clip", "across": 0.5, "shot": "5-picture",
      "rows": ["Start at 0:02.00", "—", "Fade In and Out", "Animate In", "Animate Out", "—",
               "Cut", "Copy", "Delete", "Ripple Delete", "—", "More"] },
    { "do": "rightClick", "on": "Zoom lane", "shot": "7-zoom-bar", "rows": ["Zoom", "—", "Delete Zoom"] },
    { "comment": "Empty space on a busy track: nothing to put there, so the track's own rows.",
      "do": "rightClick", "at": [1123, 785], "space": "window", "shot": "10-empty-lane", "first": "Rename…",
      "lacks": ["Track"] },
    { "do": "rightClick", "on": "Tutorial Sample clip", "across": 0.6, "choose": "Split at 0:02.00" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "rightClick", "on": "Tutorial Sample join 1", "shot": "6-join",
      "first": "Apply Default Transition",
      "lacks": ["Copy Transition", "Roll Edit to 0:02.00", "Remove Transition"] },
    { "do": "dropOnTimeline", "file": "scratch/b-roll.mp4", "track": "V1", "seconds": 10.0 },
    { "do": "wait", "seconds": 1.0 },
    { "do": "key", "key": "escape" },
    { "do": "snapshot", "name": "11-with-gap" },
    { "comment": "A gap: Ripple Delete, and the track one level down, not the whole header.",
      "do": "rightClick", "at": [992, 854], "space": "window", "shot": "8-gap",
      "rows": ["Ripple Delete", "—", "Track"],
      "keys": { "Ripple Delete": "⇧⌫" } },
    { "comment": "Cut from the right click takes the clip and leaves a gap; Undo puts it back.",
      "do": "rightClick", "on": "b-roll clip", "across": 0.5, "choose": "Cut" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expectClip", "clip": "Tutorial Sample", "track": "V1", "startsAt": 0.0 },
    { "comment": "...and Paste in the empty track space it left would put it back; Undo does here.",
      "do": "action", "action": "undo" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expectClip", "clip": "b-roll", "track": "V1", "startsAt": 10.0 },
    { "do": "describe", "stage": "12-every-menu", "note": "Each kind of thing on the timeline answered a right click with its own short menu, as docs/design/timeline-right-click.md lays out" }
  ]
}
