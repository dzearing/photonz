{
  "out": "/tmp/photonz-playtest/gradient-paint",
  "steps": [
    { "do": "blank", "canvasWidth": 1100, "canvasHeight": 700, "width": 1500, "height": 950 },
    { "do": "wait", "seconds": 1 },

    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [140, 160], "to": [420, 340], "steps": 8 },
    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [470, 160], "to": [750, 340], "steps": 8 },
    { "do": "tool", "tool": "frame" },
    { "do": "drag", "from": [140, 400], "to": [560, 640], "steps": 8 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "1-drew", "note": "two boxes and a screen, all painted flat" },

    { "do": "click", "at": [280, 250] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "action", "action": "openColorPicker" },
    { "do": "wait", "seconds": 0.9 },
    { "do": "describe", "stage": "2-picker-solid", "note": "the picker over a flat fill: the type row shows four pictures of THIS colour, Solid selected" },
    { "do": "snapshot", "name": "gradient-1-type-row" },
    { "do": "action", "action": "closeColorPicker" },
    { "do": "wait", "seconds": 0.5 },

    { "do": "action", "action": "paintSelectionGradient" },
    { "do": "wait", "seconds": 0.7 },
    { "do": "describe", "stage": "3-linear", "note": "the first box's fill is now a straight gradient out of the colour it already had" },
    { "do": "action", "action": "openColorPicker" },
    { "do": "wait", "seconds": 0.9 },
    { "do": "snapshot", "name": "gradient-2-ramp-and-aim" },
    { "do": "describe", "stage": "4-picker-gradient", "note": "the picker on a gradient: the ramp with its stop keys, the aim pad, and the header naming the stop the square edits" },
    { "do": "action", "action": "closeColorPicker" },
    { "do": "wait", "seconds": 0.5 },

    { "do": "click", "at": [610, 250] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "action", "action": "paintSelectionAngularGradient" },
    { "do": "wait", "seconds": 0.7 },
    { "do": "describe", "stage": "5-angular", "note": "the second box sweeps around instead" },

    { "do": "click", "at": [350, 520] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "action", "action": "paintSelectionGradient" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "6-screen-surface", "note": "a screen's surface takes one too" },
    { "do": "render", "name": "gradient-3-canvas" },
    { "do": "snapshot", "name": "gradient-4-window" },

    { "do": "action", "action": "undo" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "7-undone", "note": "one undo puts the screen's flat surface back: a gradient is one step, not a transcript" },
    { "do": "render", "name": "gradient-5-undone" },

    { "do": "action", "action": "redo" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "click", "at": [280, 250] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "action", "action": "openShadowColorPicker" },
    { "do": "wait", "seconds": 0.9 },
    { "do": "describe", "stage": "8-shadow", "note": "a drop shadow can only be one colour, so its picker has no type row at all" },
    { "do": "snapshot", "name": "gradient-6-shadow-has-no-row" },
    { "do": "action", "action": "closeColorPicker" },
    { "do": "wait", "seconds": 0.4 }
  ]
}
