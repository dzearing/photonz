{
  "out": "/tmp/photonz-playtest/a-border-on-a-full-frame-picture-shows-walk",
  "seed": "A Border added to a picture that fills the frame can be seen: at Next defaults with no flag changed, the sample recording is picked and given a Border from the Effects plus, and nothing else. It lands Inside, inked to stand out from the recording's dark edge, so the ring is on the canvas and in the MP4 that comes out. A box drawn over it and given a Border of its own still lands Outside, as every shape has.",
  "setup": { "timelineOpen": true, "forget": ["all"] },
  "steps": [
    { "do": "action", "action": "openSampleRecording" },
    { "do": "wait", "seconds": 2.0 },
    { "do": "action", "action": "videoPause" },
    { "do": "tool", "tool": "select" },
    { "do": "action", "action": "videoSeekStart" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "selectRow", "row": "Tutorial Sample" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "reveal", "control": "Effects section" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "panelMenu", "menu": "Add Effect", "choose": "Border" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "1-border-on-the-recording", "note": "THE FIRST TEST: the recording fills the frame, so its new Border lands Inside without anybody touching Position, and a light ring shows round the dark picture" },
    { "do": "expect", "control": "Position", "in": "Border", "reads": "Inside" },
    { "do": "panel", "stage": "1-border-on-the-recording" },
    { "do": "snapshot", "name": "1-border-on-the-recording" },
    { "do": "render", "name": "1-canvas-border-on-the-recording" },
    { "do": "writeVideo", "name": "1-with-the-border", "format": "mp4", "seconds": 8.0, "within": 0.6, "copied": false },
    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [520, 200], "to": [720, 340], "steps": 8 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "reveal", "control": "Effects section" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "panel", "stage": "2-a-box-before" },
    { "do": "panelMenu", "menu": "Add Effect", "choose": "Border" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "2-border-on-a-box", "note": "THE SECOND TEST: a box that leaves room round it gets its added Border Outside, as before" },
    { "do": "expect", "control": "Position", "in": "Border", "reads": "Outside" },
    { "do": "panel", "stage": "2-border-on-a-box" },
    { "do": "snapshot", "name": "2-border-on-a-box" }
  ]
