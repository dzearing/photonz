{
  "out": "/tmp/photonz-playtest/frames-walk",
  "steps": [
    { "do": "blank", "canvasWidth": 1600, "canvasHeight": 1100, "width": 1240, "height": 900 },

    { "do": "tool", "tool": "frame" },
    { "do": "waitFor", "condition": "tool", "value": "frame" },
    { "do": "describe", "stage": "1-tool", "note": "the frame tool is in hand" },
    { "do": "snapshot", "name": "frames-1-tool" },

    { "do": "drag", "from": [160, 180], "to": [560, 760] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "2-drawn", "note": "a frame dragged out: white surface, name above its top left" },
    { "do": "snapshot", "name": "frames-2-drawn" },
    { "do": "render", "name": "frames-2-drawn-doc" },

    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [200, 240], "to": [520, 380] },
    { "do": "tool", "tool": "text" },
    { "do": "click", "at": [220, 430] },
    { "do": "type", "text": "Sign in" },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "3-built", "note": "a card and a label drawn on the frame" },
    { "do": "snapshot", "name": "frames-3-built" },
    { "do": "render", "name": "frames-3-built-doc" },

    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [380, 620], "to": [700, 720] },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "4-clipped", "note": "a bar drawn across the frame edge is cut off at it" },
    { "do": "snapshot", "name": "frames-4-clipped" },
    { "do": "render", "name": "frames-4-clipped-doc" },

    { "do": "action", "action": "newFrameDialog" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "5-sheet", "note": "the New Frame sheet, opened on the size made last" },
    { "do": "snapshot", "name": "frames-5-sheet" },
    { "do": "action", "action": "closeSheets" },
    { "do": "wait", "seconds": 0.6 },

    { "do": "tool", "tool": "frame" },
    { "do": "click", "at": [700, 180] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "tool", "tool": "select" },
    { "do": "describe", "stage": "6-second", "note": "a plain click dropped a second frame at the last size" },
    { "do": "snapshot", "name": "frames-6-second" },
    { "do": "render", "name": "frames-6-second-doc" },

    { "do": "click", "at": [300, 700] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "7-selected", "note": "clicking the empty room inside a frame picks the frame; the inspector shows its Frame section" },
    { "do": "snapshot", "name": "frames-7-selected" },

    { "do": "drag", "from": [300, 700], "to": [340, 660] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "8-moved", "note": "the frame carried everything on it" },
    { "do": "snapshot", "name": "frames-8-moved" },
    { "do": "render", "name": "frames-8-moved-doc" },

    { "do": "action", "action": "exportDialog" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "9-export", "note": "Export offers the selected frame as its scope" },
    { "do": "snapshot", "name": "frames-9-export" },
    { "do": "action", "action": "closeSheets" },
    { "do": "wait", "seconds": 0.6 },

    { "do": "action", "action": "undo" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "describe", "stage": "10-undo", "note": "one undo takes the move back" },
    { "do": "render", "name": "frames-10-undo-doc" },
    { "do": "snapshot", "name": "frames-10-undo" },

    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [1120, 760], "to": [1400, 900] },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "action", "action": "frameSelection" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "11-frame-selection", "note": "Frame Selection put a frame around a loose shape, fitted to it" },
    { "do": "snapshot", "name": "frames-11-frame-selection" },
    { "do": "render", "name": "frames-11-frame-selection-doc" }
  ]
}
