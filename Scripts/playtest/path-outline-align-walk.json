{
  "out": "/tmp/photonz-playtest/path-outline-align",
  "seed": "A drawn path had an outline width, caps and joins in the panel but nowhere to say where the outline sits. The icon drawing mock puts an Align dropdown under its Stroke reading Center, and a Figma or Illustrator user expects Inside, Center and Outside. The walk draws two closed shapes with the Pen at Next defaults, gives the first a 4pt outline, opens Align with a click on its face and picks Outside, reads it back and photographs it, then Inside, then sets both shapes at once and takes it back with one undo. It ends on an open path, whose Align reads Center because a line has no inside.",
  "setup": {
    "forget": ["shapes", "frames", "tools"]
  },
  "steps": [
    { "do": "blank", "canvasWidth": 1600, "canvasHeight": 1100, "width": 1240, "height": 900 },
    { "do": "wait", "seconds": 1 },

    { "do": "key", "key": "p" },
    { "do": "waitFor", "condition": "tool", "value": "pen" },
    { "do": "click", "at": [300, 260] },
    { "do": "wait", "seconds": 0.2 },
    { "do": "click", "at": [560, 260] },
    { "do": "wait", "seconds": 0.2 },
    { "do": "click", "at": [430, 470] },
    { "do": "wait", "seconds": 0.2 },
    { "do": "click", "at": [300, 260] },
    { "do": "wait", "seconds": 0.9 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expectPath", "anchors": 3, "closed": true, "width": 0 },
    { "do": "action", "action": "togglePathOutline" },
    { "do": "wait", "seconds": 0.7 },
    { "do": "expectPath", "anchors": 3, "closed": true, "width": 4 },
    { "do": "action", "action": "paintSelectionColor" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expect", "field": "Thickness", "reads": "4" },
    { "do": "expect", "control": "Align", "reads": "Center" },
    { "do": "describe", "stage": "1-center", "note": "THE FIRST TEST: a closed shape off the Pen, given a 4pt outline, shows Align under its outline settings, reading Center, the way the mock's Stroke section draws it" },
    { "do": "panel", "stage": "1-center" },
    { "do": "snapshot", "name": "1-center" },
    { "do": "render", "name": "1-center-doc" },

    { "do": "panelMenu", "menu": "Align", "choose": "Outside" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expect", "control": "Align", "reads": "Outside" },
    { "do": "describe", "stage": "2-outside", "note": "THE SECOND TEST: a click on the dropdown's face opens it and Outside is picked. The outline now sits wholly past the shape's edge, so the shape's fill keeps its whole size and the line grows it" },
    { "do": "snapshot", "name": "2-outside" },
    { "do": "render", "name": "2-outside-doc" },
    { "do": "writeSVG", "name": "2-outside" },

    { "do": "panelMenu", "menu": "Align", "choose": "Inside" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expect", "control": "Align", "reads": "Inside" },
    { "do": "describe", "stage": "3-inside", "note": "Inside keeps the outline within the shape: its outer edge lands on the path itself" },
    { "do": "snapshot", "name": "3-inside" },
    { "do": "render", "name": "3-inside-doc" },
    { "do": "writeSVG", "name": "3-inside" },

    { "do": "action", "action": "undo" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expect", "control": "Align", "reads": "Outside" },
    { "do": "describe", "stage": "4-undone", "note": "one undo takes Inside back to Outside: each pick is one step" },

    { "do": "key", "key": "p" },
    { "do": "waitFor", "condition": "tool", "value": "pen" },
    { "do": "click", "at": [720, 260] },
    { "do": "wait", "seconds": 0.2 },
    { "do": "click", "at": [960, 260] },
    { "do": "wait", "seconds": 0.2 },
    { "do": "click", "at": [840, 470] },
    { "do": "wait", "seconds": 0.2 },
    { "do": "click", "at": [720, 260] },
    { "do": "wait", "seconds": 0.9 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "action", "action": "togglePathOutline" },
    { "do": "wait", "seconds": 0.7 },
    { "do": "action", "action": "paintSelectionColor" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "selectRow", "row": "Path", "modifiers": ["shift"] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectPicked", "layers": ["Path", "Path 2"] },
    { "do": "expect", "control": "Align", "reads": "mixed" },
    { "do": "describe", "stage": "5-two-picked", "note": "both shapes picked: one is Outside and one Center, so Align says they differ rather than naming one of them" },
    { "do": "panelMenu", "menu": "Align", "choose": "Outside" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expect", "control": "Align", "reads": "Outside" },
    { "do": "describe", "stage": "6-both-outside", "note": "THE THIRD TEST: one pick sets both shapes Outside" },
    { "do": "snapshot", "name": "6-both-outside" },
    { "do": "render", "name": "6-both-outside-doc" },
    { "do": "action", "action": "undo" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expect", "control": "Align", "reads": "mixed" },
    { "do": "describe", "stage": "7-both-undone", "note": "and one undo takes both back together" },

    { "do": "key", "key": "p" },
    { "do": "waitFor", "condition": "tool", "value": "pen" },
    { "do": "click", "at": [300, 640] },
    { "do": "wait", "seconds": 0.2 },
    { "do": "click", "at": [520, 640] },
    { "do": "wait", "seconds": 0.2 },
    { "do": "click", "at": [600, 760] },
    { "do": "wait", "seconds": 0.2 },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.9 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expectPath", "anchors": 3, "closed": false },
    { "do": "expect", "control": "Align", "reads": "Center" },
    { "do": "describe", "stage": "8-open-path", "note": "THE LAST TEST: an open path is a line with no inside, so Align reads Center, Inside and Outside are dimmed in its list, and its tip says why" },
    { "do": "panel", "stage": "8-open-path" },
    { "do": "snapshot", "name": "8-open-path" }
  ]
}
