{
  "out": "/tmp/photonz-playtest/merge-a-range-into-one-clip-walk",
  "seed": "A range drawn on the ruler across a cut merges into one clip, the way Premiere nests a sequence and Final Cut makes a compound clip, and the merged clip breaks apart again. At Next defaults, no flag set: the recording and a b-roll clip meet at 0:07 on V1; a range from 0:05 to 0:09 across that cut, right click, Merge into One Clip: one clip from 0:05 to 0:09 on V1, the recording before it and the b-roll after it. Undo puts the two clips back, Merge again makes it again, and Break Apart from the merged clip's own right click puts the two clips back where they were, each whole.",
  "setup": {
    "forget": ["all"],
    "scratch": ["sample:recording as b-roll.mp4"]
  },
  "steps": [
    { "do": "action", "action": "openSampleRecording" },
    { "do": "wait", "seconds": 2.0 },
    { "do": "action", "action": "videoPause" },
    { "do": "tool", "tool": "select" },
    { "do": "action", "action": "clipDragEndIn" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "dropOnTimeline", "file": "scratch/b-roll.mp4", "track": "V1", "seconds": 6.95 },
    { "do": "wait", "seconds": 1.0 },
    { "do": "action", "action": "clipDragStartIn" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expectClip", "clip": "Tutorial Sample", "track": "V1", "startsAt": 0.0, "endsAt": 7.0 },
    { "do": "expectClip", "clip": "b-roll", "track": "V1", "startsAt": 7.0, "count": 1 },
    { "do": "clickRuler", "seconds": 2.0 },
    { "do": "wait", "seconds": 0.3 },
    { "do": "describe", "stage": "0-two-clips", "note": "the recording trimmed to seven seconds with b-roll butted on at 0:07, nothing marked" },
    { "do": "snapshot", "name": "0-two-clips" },

    { "do": "dragRuler", "from": 5.0, "to": 9.0 },
    { "do": "expectTimeline", "markInMS": 5000, "markOutMS": 9000, "withinMS": 40 },
    { "do": "clickRuler", "seconds": 6.0 },
    { "do": "wait", "seconds": 0.3 },
    { "do": "expectTimeline", "markInMS": 5000, "markOutMS": 9000, "playheadMS": 6000, "withinMS": 40 },
    { "do": "describe", "stage": "1-range-across-the-cut", "note": "a range from 0:05 to 0:09 across the cut at 0:07, the playhead inside it at 0:06. A walk's right click cannot put the pointer over the ruler, so the ruler's menu acts at the playhead, which is inside the range" },
    { "do": "snapshot", "name": "1-range-across-the-cut" },

    { "do": "rightClick", "at": [750, 860], "space": "window", "choose": "Merge into One Clip" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectClip", "clip": "Merged Clip", "track": "V1", "startsAt": 5.0, "endsAt": 9.0, "count": 1 },
    { "do": "expectClip", "clip": "Tutorial Sample", "track": "V1", "startsAt": 0.0, "endsAt": 5.0, "count": 1 },
    { "do": "expectClip", "clip": "b-roll", "track": "V1", "startsAt": 9.0, "count": 1 },
    { "do": "describe", "stage": "2-merged", "note": "Merge into One Clip: one clip called Merged Clip from 0:05 to 0:09 on V1, picked, with the recording before it and the rest of the b-roll after it. The canvas at 0:06 still shows the recording" },
    { "do": "snapshot", "name": "2-merged" },
    { "do": "clickRuler", "seconds": 8.0 },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "2-merged-playing-the-b-roll", "note": "the playhead at 0:08, inside the merged clip past where the cut was: the canvas shows the b-roll, as it did before the merge" },
    { "do": "snapshot", "name": "2-merged-at-8s" },
    { "do": "clickRuler", "seconds": 5.2 },
    { "do": "wait", "seconds": 0.4 },
    { "do": "expectPlaybackNeverBlank", "name": "playing-the-merged-clip", "seconds": 3, "moments": 24 },
    { "do": "action", "action": "videoPause" },
    { "do": "wait", "seconds": 0.3 },

    { "do": "action", "action": "undo" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expectClip", "clip": "Merged Clip", "count": 0 },
    { "do": "expectClip", "clip": "Tutorial Sample", "track": "V1", "startsAt": 0.0, "endsAt": 7.0, "count": 1 },
    { "do": "expectClip", "clip": "b-roll", "track": "V1", "startsAt": 7.0, "count": 1 },
    { "do": "describe", "stage": "3-undone", "note": "one undo and the two clips are back as they were, meeting at 0:07" },
    { "do": "snapshot", "name": "3-undone" },

    { "do": "clickRuler", "seconds": 6.0 },
    { "do": "wait", "seconds": 0.3 },
    { "do": "expectTimeline", "markInMS": 5000, "markOutMS": 9000, "withinMS": 40 },
    { "do": "rightClick", "at": [750, 860], "space": "window", "choose": "Merge into One Clip" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectClip", "clip": "Merged Clip", "track": "V1", "startsAt": 5.0, "endsAt": 9.0, "count": 1 },
    { "do": "describe", "stage": "4-merged-again", "note": "Merge into One Clip again from the range's right click: the merged clip is back" },
    { "do": "snapshot", "name": "4-merged-again" },

    { "do": "rightClick", "on": "Merged Clip clip", "choose": "Break Apart" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectClip", "clip": "Merged Clip", "count": 0 },
    { "do": "expectClip", "clip": "Tutorial Sample", "track": "V1", "startsAt": 0.0, "endsAt": 7.0, "count": 1 },
    { "do": "expectClip", "clip": "b-roll", "track": "V1", "startsAt": 7.0, "count": 1 },
    { "do": "describe", "stage": "5-broken-apart", "note": "Break Apart from the merged clip's right click: the recording and the b-roll come back out, each one clip again, meeting at 0:07 exactly as before the merge" },
    { "do": "snapshot", "name": "5-broken-apart" }
  ]
}
