{
  "out": "/tmp/photonz-playtest/tracks-you-can-add-rename-group-walk",
  "seed": "A recording's timeline has real tracks: a + at the foot of the gutter adds a video, audio or captions track; double clicking a track's name renames it; each header has hide (or mute for sound), solo and lock; a clip carried up lands on the track above, and carried past the top makes a new track; tracks picked together group under a chevron that folds them away. At Next defaults, no flag set.",
  "setup": {
    "timelineOpen": true,
    "forget": ["all"]
  },
  "steps": [
    { "do": "action", "action": "openSampleRecording" },
    { "do": "wait", "seconds": 2.0 },
    { "do": "action", "action": "videoPause" },
    { "do": "tool", "tool": "select" },
    { "do": "action", "action": "videoSeekQuarter" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "1-one-track", "note": "THE FIRST TEST, at defaults: the recording sits on a track called V1, the way V1 is the bottom picture track in every editor, and under the tracks the gutter has a + to add one" },
    { "do": "expect", "control": "Track V1", "present": true },
    { "do": "expect", "control": "Add Track", "present": true },
    { "do": "snapshot", "name": "tracks-1-v1" },

    { "do": "panelMenu", "menu": "Add Track", "shot": "tracks-2-add-menu", "choose": "Video Track" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "action", "action": "soundAddSample" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "describe", "stage": "2-added", "note": "THE SECOND TEST: Video Track off the + made an empty V2 over V1, and the music landed on its own Audio track under the picture" },
    { "do": "expect", "control": "Track V2", "present": true },
    { "do": "expect", "control": "Track Audio", "present": true },
    { "do": "panel", "stage": "2-added" },
    { "do": "snapshot", "name": "tracks-3-added" },

    { "do": "press", "control": "Track V2", "count": 2 },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expect", "control": "Track name", "present": true },
    { "do": "type", "text": "Overlay" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "3-renamed", "note": "THE THIRD TEST: double clicking V2's name opened it for typing, and Return kept the new name" },
    { "do": "expect", "control": "Track Overlay", "present": true },
    { "do": "snapshot", "name": "tracks-4-renamed" },

    { "do": "expect", "control": "Track V1 Lock", "present": false },
    { "do": "move", "control": "Track V1" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "expect", "control": "Track V1 Lock", "present": true },
    { "do": "press", "control": "Track V1 Lock" },
    { "do": "move", "control": "Track Audio" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "press", "control": "Track Audio Mute" },
    { "do": "press", "control": "Track Audio Solo" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "4-switches", "note": "THE FOURTH TEST: a track's switches are not up until the pointer rests on it; then V1 locked (its switch lit and its lane striped) and the Audio track muted and soloed, the lit switches staying up on their headers" },
    { "do": "panel", "stage": "4-switches" },
    { "do": "snapshot", "name": "tracks-5-lock-mute-solo" },
    { "do": "press", "control": "Track Audio Solo" },
    { "do": "press", "control": "Track Audio Mute" },
    { "do": "press", "control": "Track V1 Lock" },
    { "do": "move", "control": "Track V1" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "press", "control": "Track V1 Hide" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "5-hidden", "note": "THE FIFTH TEST: V1 hidden takes the recording off the picture, and its lane goes faint" },
    { "do": "snapshot", "name": "tracks-6-v1-hidden" },
    { "do": "press", "control": "Track V1 Hide" },
    { "do": "wait", "seconds": 0.6 },

    { "do": "press", "control": "Track V1" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "action", "action": "clipCarryUpATrackHeld" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "snapshot", "name": "tracks-7-carry-up-held" },
    { "do": "action", "action": "clipDragRelease" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "6-carried-up", "note": "THE SIXTH TEST: the recording carried up onto Overlay, V1 left empty behind it" },
    { "do": "panel", "stage": "6-carried-up" },
    { "do": "action", "action": "clipCarryToNewTrackOnTopHeld" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "snapshot", "name": "tracks-8-new-track-held" },
    { "do": "action", "action": "clipDragRelease" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "7-new-track", "note": "THE SEVENTH TEST: carried past the top track, the recording made a new track there and moved onto it" },
    { "do": "expect", "control": "Track V2", "present": true },
    { "do": "panel", "stage": "7-new-track" },
    { "do": "snapshot", "name": "tracks-9-new-track" },

    { "do": "press", "control": "Track Overlay" },
    { "do": "press", "control": "Track V1", "modifiers": ["shift"] },
    { "do": "wait", "seconds": 0.3 },
    { "do": "rightClick", "on": "Track V1", "shot": "tracks-10-menu", "choose": "Group 2 Tracks" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "8-grouped", "note": "THE EIGHTH TEST: the two picked tracks gathered under Group 1, indented under its chevron" },
    { "do": "expect", "control": "Track group Group 1", "present": true },
    { "do": "snapshot", "name": "tracks-11-grouped" },
    { "do": "press", "control": "Track group Group 1" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "9-folded", "note": "THE NINTH TEST: the chevron folded the group to one row, its clips drawn thin along it" },
    { "do": "expect", "control": "Track Overlay", "present": false },
    { "do": "panel", "stage": "9-folded" },
    { "do": "snapshot", "name": "tracks-12-folded" },

    { "do": "key", "key": "z", "modifiers": ["command"] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "10-undo-group", "note": "THE TENTH TEST: Cmd-Z takes the group back off in one step, the two tracks still there" },
    { "do": "expect", "control": "Track group Group 1", "present": false },
    { "do": "expect", "control": "Track Overlay", "present": true },
    { "do": "key", "key": "z", "modifiers": ["command"] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "11-undo-new-track", "note": "THE ELEVENTH TEST: Cmd-Z again puts the recording back on Overlay and the track it made is gone" },
    { "do": "expect", "control": "Track V2", "present": false },
    { "do": "panel", "stage": "11-undo-new-track" }
  ]
}
