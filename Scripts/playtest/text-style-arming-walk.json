{
  "out": "/tmp/photonz-playtest/text-style-arming",
  "seed": "The text tool comes away holding the NAME of the style you just used, not a copy of the type behind it. A heading is set up by hand and saved as Heading; the next block typed comes out wearing Heading, so one edit to the style re-sets it too. Then that block is unlinked, which takes the tool off the style as well, and the block typed after it is type of its own: a second edit to the style leaves it exactly where it was.",
  "setup": {
    "forget": ["text", "panel", "shapes", "color", "tools"]
  },
  "steps": [
    { "do": "blank", "canvasWidth": 900, "canvasHeight": 600, "width": 1320, "height": 1000 },
    { "do": "wait", "seconds": 1 },

    { "do": "tool", "tool": "text" },
    { "do": "click", "at": [140, 130] },
    { "do": "type", "text": "Sign in" },
    { "do": "key", "key": "return", "modifiers": ["command"] },
    { "do": "wait", "seconds": 0.6 },

    { "do": "tool", "tool": "select" },
    { "do": "click", "at": [180, 145] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "press", "control": "Position & Size section" },
    { "do": "press", "control": "Effects section" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "panelMenu", "menu": "Font", "choose": "Georgia" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "panelMenu", "menu": "Size", "choose": "32 px" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "panelMenu", "menu": "Weight", "choose": "Bold" },
    { "do": "wait", "seconds": 0.7 },

    { "do": "panelMenu", "menu": "Style", "choose": "Save as Style" },
    { "do": "wait", "seconds": 0.9 },
    { "do": "type", "text": "Heading" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 1 },
    { "do": "expect", "menu": "Style", "reads": "Heading" },
    { "do": "describe", "stage": "1-saved", "note": "one heading, set up by hand and saved under the name Heading. The text tool is now holding that name." },
    { "do": "panel", "stage": "1-saved" },

    { "do": "tool", "tool": "text" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "2-tool-holds-it", "note": "THE POINT: the text tool's swatch on the bar carries the type mark, because what it types now comes from a name rather than from the menus." },
    { "do": "snapshot", "name": "2-tool-holds-it" },
    { "do": "click", "at": [140, 300] },
    { "do": "type", "text": "Create account" },
    { "do": "key", "key": "return", "modifiers": ["command"] },
    { "do": "wait", "seconds": 0.8 },

    { "do": "tool", "tool": "select" },
    { "do": "click", "at": [200, 315] },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expect", "menu": "Style", "reads": "Heading" },
    { "do": "expect", "menu": "Size", "reads": "32 px" },
    { "do": "describe", "stage": "3-typed-wearing-it", "note": "the block typed AFTER the style was saved wears Heading by name, without anybody putting it on. Before this it came out merely matching, and stopped following the moment the style was edited." },
    { "do": "panel", "stage": "3-typed-wearing-it" },
    { "do": "snapshot", "name": "3-typed-wearing-it" },

    { "do": "click", "at": [650, 560] },
    { "do": "wait", "seconds": 0.7 },
    { "do": "press", "control": "Heading" },
    { "do": "wait", "seconds": 0.9 },
    { "do": "panelMenu", "menu": "Size", "choose": "48 px" },
    { "do": "wait", "seconds": 1 },
    { "do": "tool", "tool": "select" },
    { "do": "click", "at": [200, 315] },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expect", "menu": "Size", "reads": "48 px" },
    { "do": "expect", "menu": "Style", "reads": "Heading" },
    { "do": "describe", "stage": "4-it-followed", "note": "one edit to the style and the block typed after it followed, which is the whole difference between wearing a name and matching one" },
    { "do": "panel", "stage": "4-it-followed" },
    { "do": "snapshot", "name": "4-it-followed" },
    { "do": "render", "name": "4-canvas" },

    { "do": "panelMenu", "menu": "Style", "choose": "Unlink" },
    { "do": "wait", "seconds": 0.9 },
    { "do": "tool", "tool": "text" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "5-tool-let-go", "note": "taking the text off the style took the TOOL off it too: the swatch carries no mark now" },
    { "do": "snapshot", "name": "5-tool-let-go" },
    { "do": "click", "at": [140, 450] },
    { "do": "type", "text": "Forgot password" },
    { "do": "key", "key": "return", "modifiers": ["command"] },
    { "do": "wait", "seconds": 0.8 },

    { "do": "click", "at": [650, 560] },
    { "do": "wait", "seconds": 0.7 },
    { "do": "press", "control": "Heading" },
    { "do": "wait", "seconds": 0.9 },
    { "do": "panelMenu", "menu": "Size", "choose": "96 px" },
    { "do": "wait", "seconds": 1 },
    { "do": "tool", "tool": "select" },
    { "do": "click", "at": [200, 465] },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expect", "menu": "Size", "reads": "48 px" },
    { "do": "describe", "stage": "6-its-own", "note": "the block typed after Unlink is type of its own: the style grew to 96 px and it stayed at the 48 px it was typed in" },
    { "do": "panel", "stage": "6-its-own" },
    { "do": "snapshot", "name": "6-its-own" },
    { "do": "render", "name": "6-canvas" }
  ]
}
