{
  "out": "/tmp/photonz-playtest/corner-drag-rounds",
  "setup": {
    "forget": [
      "shapes",
      "color",
      "panel"
    ]
  },
  "steps": [
    {
      "do": "blank",
      "canvasWidth": 900,
      "canvasHeight": 600,
      "width": 1280,
      "height": 900
    },
    {
      "do": "wait",
      "seconds": 1
    },
    {
      "do": "key",
      "key": "r"
    },
    {
      "do": "drag",
      "from": [
        320,
        260
      ],
      "to": [
        600,
        460
      ]
    },
    {
      "do": "key",
      "key": "v"
    },
    {
      "do": "wait",
      "seconds": 0.8
    },
    {
      "do": "describe",
      "stage": "1-picked",
      "note": "a square cornered rectangle, picked. Four dots rest 12 screen points inside its corners, clear of the resize squares sitting on the corners themselves"
    },
    {
      "do": "snapshot",
      "name": "1-picked"
    },
    {
      "do": "render",
      "name": "1-canvas-picked"
    },
    {
      "do": "drag",
      "from": [
        332,
        272
      ],
      "to": [
        370,
        310
      ],
      "steps": 14,
      "readout": "Radius 50",
      "hold": "2-mid-pull"
    },
    {
      "do": "wait",
      "seconds": 0.8
    },
    {
      "do": "describe",
      "stage": "2-all-four",
      "note": "THE TEST: a plain pull on the top left dot rounds ALL FOUR corners to 50, the way a drawn shape's knob does, the pill under the shape read Radius 50 while the button was down, and the row reads one number"
    },
    {
      "do": "expect",
      "field": "Corner Radius",
      "reads": "50"
    },
    {
      "do": "snapshot",
      "name": "2-all-four"
    },
    {
      "do": "render",
      "name": "2-canvas-all-four"
    },
    {
      "do": "press",
      "control": "Twist",
      "in": "Corner Radius"
    },
    {
      "do": "wait",
      "seconds": 0.6
    },
    {
      "do": "expect",
      "field": "Top Left",
      "reads": "50"
    },
    {
      "do": "expect",
      "field": "Top Right",
      "reads": "50"
    },
    {
      "do": "expect",
      "field": "Bottom Right",
      "reads": "50"
    },
    {
      "do": "expect",
      "field": "Bottom Left",
      "reads": "50"
    },
    {
      "do": "panel",
      "stage": "2-all-four"
    },
    {
      "do": "key",
      "key": "escape"
    },
    {
      "do": "wait",
      "seconds": 0.4
    },
    {
      "do": "drag",
      "from": [
        550,
        310
      ],
      "to": [
        575,
        285
      ],
      "steps": 14,
      "modifiers": [
        "option"
      ],
      "readout": "Radius 25",
      "hold": "3-mid-option-pull"
    },
    {
      "do": "wait",
      "seconds": 0.8
    },
    {
      "do": "describe",
      "stage": "3-one-corner",
      "note": "THE TEST: holding Option while pulling the top right dot takes that corner alone to 25, the other three stay at 50, and the row reads Mixed"
    },
    {
      "do": "expect",
      "field": "Corner Radius",
      "reads": "Mixed"
    },
    {
      "do": "press",
      "control": "Twist",
      "in": "Corner Radius"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "expect",
      "field": "Top Left",
      "reads": "50"
    },
    {
      "do": "expect",
      "field": "Top Right",
      "reads": "25"
    },
    {
      "do": "expect",
      "field": "Bottom Right",
      "reads": "50"
    },
    {
      "do": "expect",
      "field": "Bottom Left",
      "reads": "50"
    },
    {
      "do": "snapshot",
      "name": "3-one-corner"
    },
    {
      "do": "render",
      "name": "3-canvas-one-corner"
    },
    {
      "do": "panel",
      "stage": "3-one-corner"
    },
    {
      "do": "key",
      "key": "escape"
    },
    {
      "do": "wait",
      "seconds": 0.4
    },
    {
      "do": "drag",
      "from": [
        575,
        285
      ],
      "to": [
        577,
        286
      ],
      "steps": 3
    },
    {
      "do": "wait",
      "seconds": 0.6
    },
    {
      "do": "describe",
      "stage": "3b-wobble",
      "note": "THE TEST: a press on a dot that only wobbled two points is not a pull, so a plain press does not flatten the four different corners"
    },
    {
      "do": "expect",
      "field": "Corner Radius",
      "reads": "Mixed"
    },
    {
      "do": "action",
      "action": "undo"
    },
    {
      "do": "wait",
      "seconds": 0.8
    },
    {
      "do": "describe",
      "stage": "4-undone",
      "note": "THE TEST: ONE undo takes back the whole Option pull and no more, so all four are the 50 the first pull made, and the wobble left no step of its own. Undo is driven straight on the editor rather than with command Z: the probe is never the frontmost app, so a synthesized chord never reaches its Edit menu"
    },
    {
      "do": "expect",
      "field": "Corner Radius",
      "reads": "50"
    },
    {
      "do": "press",
      "control": "Twist",
      "in": "Corner Radius"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "expect",
      "field": "Top Left",
      "reads": "50"
    },
    {
      "do": "expect",
      "field": "Top Right",
      "reads": "50"
    },
    {
      "do": "expect",
      "field": "Bottom Right",
      "reads": "50"
    },
    {
      "do": "expect",
      "field": "Bottom Left",
      "reads": "50"
    },
    {
      "do": "snapshot",
      "name": "4-undone"
    },
    {
      "do": "key",
      "key": "escape"
    },
    {
      "do": "wait",
      "seconds": 0.4
    },
    {
      "do": "drag",
      "from": [
        370,
        310
      ],
      "to": [
        300,
        240
      ],
      "steps": 14
    },
    {
      "do": "wait",
      "seconds": 0.8
    },
    {
      "do": "describe",
      "stage": "5-squared-again",
      "note": "pulling the same dot back out past the corner squares every corner off rather than going negative"
    },
    {
      "do": "press",
      "control": "Twist",
      "in": "Corner Radius"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "expect",
      "field": "Top Left",
      "reads": "0"
    },
    {
      "do": "expect",
      "field": "Top Right",
      "reads": "0"
    },
    {
      "do": "expect",
      "field": "Bottom Right",
      "reads": "0"
    },
    {
      "do": "expect",
      "field": "Bottom Left",
      "reads": "0"
    },
    {
      "do": "snapshot",
      "name": "5-squared-again"
    },
    {
      "do": "render",
      "name": "5-canvas-squared-again"
    },
    {
      "do": "key",
      "key": "escape"
    },
    {
      "do": "wait",
      "seconds": 0.4
    },
    {
      "do": "key",
      "key": "r"
    },
    {
      "do": "drag",
      "from": [
        700,
        470
      ],
      "to": [
        730,
        500
      ]
    },
    {
      "do": "key",
      "key": "v"
    },
    {
      "do": "wait",
      "seconds": 0.8
    },
    {
      "do": "describe",
      "stage": "6-too-small",
      "note": "THE TEST: a 30 by 30 shape is too cramped to keep its edge handles, so it wears no corner dots either. Its four corner squares have stepped OUTSIDE the outline and the whole inside of it belongs to picking it up"
    },
    {
      "do": "snapshot",
      "name": "6-too-small"
    },
    {
      "do": "click",
      "at": [
        460,
        360
      ]
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "drag",
      "from": [
        460,
        242
      ],
      "to": [
        540,
        300
      ]
    },
    {
      "do": "wait",
      "seconds": 0.8
    },
    {
      "do": "describe",
      "stage": "7-rotated",
      "note": "THE TEST: the big shape turned by its knob. The four dots turn with it and stay inside the corners they belong to, because they are placed through the same transform the eight frame handles are"
    },
    {
      "do": "snapshot",
      "name": "7-rotated"
    }
  ]
}
