{
  "out": "/tmp/photonz-playtest/icon-width-row-reads-true",
  "seed": "On a 24 pixel icon frame a line nobody has given a weight is drawn thin, at 2, so it survives the icon. The Width row on the tool bar went on saying 4, so the number you read was not the number you got, which is the one thing a box you can type into must not do. And typing that same 4 could not get you a 4, because asking for it looked exactly like never having asked. This walk reads the row on an icon frame, draws and claims the line, then types a weight and claims it again.",
  "setup": {
    "forget": ["shapes", "frames", "tools", "color"]
  },
  "steps": [
    { "do": "blank", "canvasWidth": 1600, "canvasHeight": 1100, "width": 1280, "height": 900 },
    { "do": "wait", "seconds": 1 },

    { "do": "action", "action": "newFrameDialog" },
    { "do": "wait", "seconds": 0.9 },
    { "do": "press", "control": "24", "in": "Icons" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "press", "control": "Add Frame" },
    { "do": "wait", "seconds": 1.2 },
    { "do": "describe", "stage": "1-frame", "note": "a 24 by 24 icon frame, in the middle of the view" },

    { "do": "key", "key": "p" },
    { "do": "waitFor", "condition": "tool", "value": "pen" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "press", "control": "Color", "in": "Toolbar" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expect", "field": "Width", "reads": "2" },
    { "do": "describe", "stage": "2-row-reads-two", "note": "THE TEST: the Pen's Width row opens on 2, which is what a line drawn on this icon frame really comes out at. It used to say 4 and hand you a 2." },
    { "do": "snapshot", "name": "2-row-reads-two" },

    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "click", "at": [792, 544] },
    { "do": "wait", "seconds": 0.25 },
    { "do": "click", "at": [806, 544] },
    { "do": "wait", "seconds": 0.25 },
    { "do": "click", "at": [799, 556] },
    { "do": "wait", "seconds": 0.25 },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expectPath", "anchors": 3, "closed": false, "width": 2 },
    { "do": "describe", "stage": "3-lands-at-two", "note": "the line landed at the 2 the row was showing, so the two agree" },
    { "do": "snapshot", "name": "3-lands-at-two" },

    { "do": "key", "key": "p" },
    { "do": "waitFor", "condition": "tool", "value": "pen" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "press", "control": "Color", "in": "Toolbar" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expect", "field": "Width", "reads": "2" },
    { "do": "focus", "field": "Width" },
    { "do": "type", "text": "4" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expect", "field": "Width", "reads": "4" },
    { "do": "describe", "stage": "4-typed-four", "note": "four, typed on an icon frame, and the row keeps it. This was the impossible one: asking for the weight the app ships with looked exactly like never having asked, so the row snapped back to 2." },
    { "do": "snapshot", "name": "4-typed-four" },

    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "click", "at": [792, 570] },
    { "do": "wait", "seconds": 0.25 },
    { "do": "click", "at": [806, 570] },
    { "do": "wait", "seconds": 0.25 },
    { "do": "click", "at": [799, 582] },
    { "do": "wait", "seconds": 0.25 },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expectPath", "anchors": 3, "closed": false, "width": 4 },
    { "do": "expectLayers", "count": 4 },
    { "do": "describe", "stage": "5-lands-at-four", "note": "and the line comes out at the 4 that was asked for, on the same icon frame" },
    { "do": "snapshot", "name": "5-lands-at-four" },

    { "do": "tool", "tool": "line" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "move", "at": [799, 550] },
    { "do": "wait", "seconds": 0.4 },
    { "do": "press", "control": "Color", "in": "Toolbar" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expect", "field": "Width", "reads": "2" },
    { "do": "describe", "stage": "6-every-tool", "note": "the gap was never the Pen's alone: a line's own Width row reads the icon's 2 the same way. Picking a tool lets go of the selection, so the only thing left saying which icon this is, is the pointer resting in it." },
    { "do": "snapshot", "name": "6-every-tool" },
    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.5 },

    { "do": "action", "action": "newFrameDialog" },
    { "do": "wait", "seconds": 0.9 },
    { "do": "press", "control": "Desktop" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "press", "control": "Add Frame" },
    { "do": "wait", "seconds": 1.4 },
    { "do": "tool", "tool": "line" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "move", "at": [300, 300] },
    { "do": "wait", "seconds": 0.4 },
    { "do": "press", "control": "Color", "in": "Toolbar" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expect", "field": "Width", "reads": "4" },
    { "do": "describe", "stage": "7-screen-unchanged", "note": "off an icon frame nothing is decided for you: the row reads the four every line in the app has always started at" },
    { "do": "snapshot", "name": "7-screen-unchanged" },
    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "render", "name": "8-final-render" }
  ]
}
