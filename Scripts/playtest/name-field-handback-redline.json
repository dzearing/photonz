{
  "out": "/tmp/photonz-playtest/name-field-handback-redline",
  "steps": [
    { "do": "open", "file": "../../Tests/PhotonzRenderTests/Fixtures/settings-pane-2x.png", "width": 1280, "height": 840 },
    { "do": "wait", "seconds": 1 },
    { "do": "tool", "tool": "measure" },
    { "do": "waitFor", "condition": "edgeMap", "timeout": 20 },
    { "do": "measureMode", "mode": "distance" },
    { "do": "click", "at": [236, 696] },
    { "do": "move", "at": [476, 696] },
    { "do": "click", "at": [476, 696] },
    { "do": "move", "at": [476, 656] },
    { "do": "click", "at": [476, 656] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "1-measured", "note": "one measurement on the picture, selected, so its Properties show a Name field" },

    { "do": "focus", "field": "Measurement name" },
    { "do": "type", "text": "Row gap" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "2-measurement-named", "note": "the measurement is called Row gap and the keyboard is back on the picture" },
    { "do": "key", "key": "a" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "describe", "stage": "3-tool-key-after-measurement-name", "note": "A picks the arrow tool" },
    { "do": "tool", "tool": "select" },

    { "do": "click", "at": [476, 676] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "focus", "field": "Measurement name" },
    { "do": "type", "text": "Not this" },
    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "4-measurement-name-escaped", "note": "it is still called Row gap and the keyboard is back on the picture" },
    { "do": "key", "key": "r" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "describe", "stage": "5-tool-key-after-measurement-escape", "note": "R picks the rectangle tool" },

    { "do": "tool", "tool": "arrow" },
    { "do": "drag", "from": [700, 300], "to": [860, 420] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "tool", "tool": "select" },
    { "do": "click", "at": [780, 360] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "6-arrow-picked", "note": "an uncaptioned arrow is selected, so its Properties show a Caption field" },
    { "do": "focus", "field": "Add a caption" },
    { "do": "type", "text": "Too tight" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.7 },
    { "do": "describe", "stage": "7-caption-typed", "note": "the arrow says Too tight and the keyboard is back on the picture" },
    { "do": "key", "key": "r" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "describe", "stage": "8-tool-key-after-caption", "note": "R picks the rectangle tool" },
    { "do": "tool", "tool": "select" },

    { "do": "click", "at": [780, 360] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "focus", "field": "Add a caption" },
    { "do": "type", "text": "Nope" },
    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.7 },
    { "do": "describe", "stage": "9-caption-escaped", "note": "the arrow still says Too tight and the keyboard is back on the picture" },
    { "do": "key", "key": "a" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "describe", "stage": "10-tool-key-after-caption-escape", "note": "A picks the arrow tool" }
  ]
}
