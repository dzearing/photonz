{
  "out": "/tmp/photonz-playtest/nudge-stays-sharp",
  "setup": { "forget": ["all"] },
  "steps": [
    { "do": "blank", "canvasWidth": 1600, "canvasHeight": 1100, "width": 1240, "height": 900 },
    { "do": "action", "action": "newFrameDialog" },
    { "do": "wait", "seconds": 0.9 },
    { "do": "press", "control": "24", "in": "Icons" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "press", "control": "Add Frame" },
    { "do": "wait", "seconds": 1.2 },
    { "do": "tool", "tool": "ellipse" },
    { "do": "drag", "from": [795, 545], "to": [805, 555] },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expectSharp" },
    { "do": "snapshot", "name": "1-just-drawn" },
    { "do": "drag", "from": [800, 550], "to": [801, 551] },
    { "do": "wait", "seconds": 1.0 },
    { "do": "expectSharp" },
    { "do": "snapshot", "name": "2-after-a-nudge" },
    { "do": "click", "at": [600, 300] },
    { "do": "wait", "seconds": 1.0 },
    { "do": "expectSharp" },
    { "do": "snapshot", "name": "3-nothing-picked" },
    { "do": "click", "at": [800, 550] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "key", "key": "right" },
    { "do": "key", "key": "right" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expectSharp" },
    { "do": "snapshot", "name": "4-after-arrow-keys" },
    { "do": "describe", "stage": "nudge", "note": "the circle is as smooth after the nudge as before it, with no zoom change to repair it, whether it was moved with the pointer or with the arrow keys" }
  ]
}
