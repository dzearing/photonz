{
  "out": "/tmp/photonz-playtest/several-clips-show-where-each-lands-walk",
  "seed": "Several clips carried together show where each one lands, and Option copies of several change track too (task several-clips-carried-together-show-where-each-o). At Next defaults with no flag changed: a recording trimmed to six seconds on V1, a second clip after it on V1, and an empty V2 added from the Add Track menu. Both picked and carried up one track with Option held: V2 lights, and on letting go copies of both sit on V2 half a second later while both originals stay on V1, with no extra track made. With the recording on V1 and the second clip on V2 and an empty V3 over them, carrying the recording up one lights BOTH V2 and V3, one lane for each clip. Carrying the second clip down one is refused because the recording would land on the sound track: only the Audio lane lights, in red, not V1 under the hand, and both only slide in time. Option copies carried down the same way are refused the same way and land at home.",
  "setup": {
    "timelineOpen": true,
    "forget": ["all"],
    "scratch": ["sample:recording as b-roll.mp4"]
  },
  "steps": [
    { "do": "action", "action": "openSampleRecording" },
    { "do": "wait", "seconds": 2.0 },
    { "do": "action", "action": "videoPause" },
    { "do": "tool", "tool": "select" },

    { "do": "action", "action": "videoSeekStart" },
    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "key", "key": "w" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectClip", "clip": "Tutorial Sample", "track": "V1", "startsAt": 0.0, "endsAt": 6.0, "count": 1 },

    { "do": "dropOnTimeline", "file": "scratch/b-roll.mp4", "track": "V1", "seconds": 5.96 },
    { "do": "wait", "seconds": 1.0 },
    { "do": "expectClip", "clip": "b-roll", "track": "V1", "startsAt": 6.0, "endsAt": 14.0, "count": 1 },

    { "do": "panelMenu", "menu": "Add Track", "choose": "Video Track" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectTracks", "tracks": ["V2", "V1", "Audio"] },

    { "do": "dragClip", "clip": "Tutorial Sample" },
    { "do": "dragClip", "clip": "b-roll", "modifiers": ["command"] },
    { "do": "expectTimelinePick", "clips": ["Tutorial Sample", "b-roll"] },
    { "do": "dragClip", "clip": "b-roll", "modifiers": ["option"], "byMS": 500, "tracksUp": 1, "hold": "1-copies-carried-up", "reads": "to V2", "lights": ["V2"] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectClip", "clip": "Tutorial Sample", "count": 2 },
    { "do": "expectClip", "clip": "b-roll", "count": 2 },
    { "do": "expectClip", "clip": "Tutorial Sample", "track": "V1", "startsAt": 0.0, "endsAt": 6.0 },
    { "do": "expectClip", "clip": "b-roll", "track": "V1", "startsAt": 6.0, "endsAt": 14.0 },
    { "do": "expectClip", "clip": "Tutorial Sample", "track": "V2", "startsAt": 0.5, "endsAt": 6.5 },
    { "do": "expectClip", "clip": "b-roll", "track": "V2", "startsAt": 6.5, "endsAt": 14.5 },
    { "comment": "The copies' own sound needs a sound track of its own, under the originals' sound.", "do": "expectTracks", "tracks": ["V2", "V1", "Audio", "Audio 2"] },
    { "do": "describe", "stage": "2-copies-on-v2", "note": "THE FIRST TEST: both picked and carried up one track with Option held lit V2, and on letting go copies of both sit on V2 half a second later while the originals stay on V1, and no picture track was made" },
    { "do": "snapshot", "name": "2-copies-on-v2" },

    { "do": "shortcut", "key": "z", "modifiers": ["command"], "menuItem": "Undo" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectClip", "clip": "Tutorial Sample", "count": 1 },
    { "do": "expectClip", "clip": "b-roll", "count": 1 },
    { "do": "expectTracks", "tracks": ["V2", "V1", "Audio"] },

    { "comment": "b-roll alone up onto V2, and an empty V3 over it, so two clips on two tracks have two lanes to go to.", "do": "dragClip", "clip": "b-roll" },
    { "do": "dragClip", "clip": "b-roll", "byMS": 500, "tracksUp": 1, "reads": "to V2", "lights": ["V2"] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectClip", "clip": "b-roll", "track": "V2", "startsAt": 6.5, "count": 1 },
    { "do": "panelMenu", "menu": "Add Track", "choose": "Video Track" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectTracks", "tracks": ["V3", "V2", "V1", "Audio"] },

    { "do": "dragClip", "clip": "Tutorial Sample" },
    { "do": "dragClip", "clip": "b-roll", "modifiers": ["command"] },
    { "do": "dragClip", "clip": "Tutorial Sample", "byMS": 250, "tracksUp": 1, "hold": "3-two-lanes-lit", "reads": "to V2", "lights": ["V2", "V3"] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectClip", "clip": "Tutorial Sample", "track": "V2", "startsAt": 0.25, "count": 1 },
    { "do": "expectClip", "clip": "b-roll", "track": "V3", "startsAt": 6.75, "count": 1 },
    { "do": "describe", "stage": "3-two-lanes", "note": "THE SECOND TEST: the recording on V1 and b-roll on V2 both picked, the recording carried up one: V2 AND V3 lit while it was in the hand, one lane for each, and they landed there" },

    { "do": "shortcut", "key": "z", "modifiers": ["command"], "menuItem": "Undo" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectClip", "clip": "Tutorial Sample", "track": "V1", "startsAt": 0.0, "count": 1 },
    { "do": "expectClip", "clip": "b-roll", "track": "V2", "startsAt": 6.5, "count": 1 },

    { "do": "dragClip", "clip": "Tutorial Sample" },
    { "do": "dragClip", "clip": "b-roll", "modifiers": ["command"] },
    { "do": "dragClip", "clip": "b-roll", "byMS": 250, "tracksUp": -1, "hold": "4-refused-on-its-own-lane", "reads": "Audio takes sound only", "lights": ["Audio red"] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectClip", "clip": "Tutorial Sample", "track": "V1", "startsAt": 0.25, "count": 1 },
    { "do": "expectClip", "clip": "b-roll", "track": "V2", "startsAt": 6.75, "count": 1 },
    { "do": "describe", "stage": "4-refused", "note": "THE THIRD TEST: b-roll in the hand carried down onto V1, which is clear, but the recording would go down onto Audio: only the Audio lane lit, in red, V1 under the hand did not, and on letting go both only slid in time" },

    { "do": "dragClip", "clip": "Tutorial Sample" },
    { "do": "dragClip", "clip": "b-roll", "modifiers": ["command"] },
    { "do": "dragClip", "clip": "b-roll", "modifiers": ["option"], "byMS": 500, "tracksUp": -1, "hold": "5-copies-refused", "reads": "Audio takes sound only", "lights": ["Audio red"] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectClip", "clip": "Tutorial Sample", "count": 2 },
    { "do": "expectClip", "clip": "b-roll", "count": 2 },
    { "do": "expectClip", "clip": "Tutorial Sample", "track": "V1", "startsAt": 0.25 },
    { "do": "expectClip", "clip": "b-roll", "track": "V2", "startsAt": 6.75 },
    { "do": "describe", "stage": "5-copies-refused", "note": "THE FOURTH TEST: Option copies carried down the same way are refused the same way, Audio lit red, and land at home as Option copies always have" },
    { "do": "snapshot", "name": "5-after" }
  ]
}
