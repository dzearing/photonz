    { "do": "action", "action": "frameSelection" },
    { "do": "wait", "seconds": 0.9 },
    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "move", "at": [40, 40] },
    { "do": "wait", "seconds": 0.8 },

    { "do": "action", "action": "zoomToFit" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "describe", "stage": "six-screens",
      "note": "six screens on one canvas: what the plates look like in numbers, rather than one at a time" },
    { "do": "snapshot", "name": "screen-name-3-six-screens" },

    { "do": "appearance", "value": "light" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "describe", "stage": "light-mode",
      "note": "the same names with the app in light mode: the plate is the same grey either way, so a name does not change with the theme any more than the picture under it does" },
    { "do": "snapshot", "name": "screen-name-4-light" },
    { "do": "appearance", "value": "dark" },
    { "do": "wait", "seconds": 0.8 }
