{
  "out": "/tmp/photonz-playtest/screen-name-reads-anywhere",
  "seed": "The name above a screen was grey letters painted straight onto the picture, so it went missing on anything mid-toned: 1.9:1 over a crimson shape, against 4.8:1 on plain white, which is why nobody noticed. The component name next door was put on a plate on 2026-09-15 and reads at 9.9:1 on everything. This walk puts four screens on four different things - the plain light canvas, a saturated shape, a deep crimson shape, and a real screenshot - photographs all four names at once, hovers one so the live plate is photographed too, and then puts six screens on one canvas to show what a canvas full of plates actually looks like.",
  "setup": { "forget": ["panel", "shapes", "color", "groups", "frames"] },
  "steps": [
    { "do": "blank", "canvasWidth": 1900, "canvasHeight": 1200, "width": 1400, "height": 940 },
    { "do": "wait", "seconds": 0.8 },

    { "do": "dropImage", "file": "fixtures/Hero banner.png", "at": [1350, 800] },
    { "do": "wait", "seconds": 1.2 },

    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [100, 620], "to": [600, 950] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.5 },

    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [1000, 150], "to": [1500, 480] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "action", "action": "paintSelectionColor" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.4 },

    { "do": "describe", "stage": "backgrounds",
      "note": "four things for a name to sit on: plain light canvas top left, a saturated shape bottom left, a deep crimson shape top right, and a real screenshot bottom right" },
    { "do": "snapshot", "name": "screen-name-0-backgrounds" },

    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [220, 220], "to": [520, 400] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "tool", "tool": "select" },
    { "do": "action", "action": "frameSelection" },
    { "do": "wait", "seconds": 0.9 },
    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.4 },

    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [180, 740], "to": [470, 900] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "tool", "tool": "select" },
    { "do": "action", "action": "frameSelection" },
    { "do": "wait", "seconds": 0.9 },
    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.4 },

    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [1080, 260], "to": [1400, 440] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "tool", "tool": "select" },
    { "do": "action", "action": "frameSelection" },
    { "do": "wait", "seconds": 0.9 },
    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.4 },

    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [1150, 900], "to": [1480, 1080] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "tool", "tool": "select" },
    { "do": "action", "action": "frameSelection" },
    { "do": "wait", "seconds": 0.9 },
    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "move", "at": [40, 40] },
    { "do": "wait", "seconds": 0.8 },

    { "do": "action", "action": "zoomToFit" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "describe", "stage": "four-backgrounds",
      "note": "four screens, each wearing its name above its top left corner, one on each background: plain canvas, a saturated shape, a crimson shape, and a screenshot" },
    { "do": "expectLayers", "count": 12 },
    { "do": "snapshot", "name": "screen-name-1-four-backgrounds" },

    { "do": "move", "at": [661, 280], "space": "window" },
    { "do": "wait", "seconds": 0.9 },
    { "do": "describe", "stage": "live-name",
      "note": "the pointer resting on the name of the screen inside the crimson shape: it moves onto the accent plate, which is the only hint anywhere that a name answers a click" },
    { "do": "snapshot", "name": "screen-name-2-live" },
    { "do": "move", "at": [40, 40] },
    { "do": "wait", "seconds": 0.6 },

    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [640, 120], "to": [900, 300] },
    { "do": "wait", "seconds": 0.5 },
