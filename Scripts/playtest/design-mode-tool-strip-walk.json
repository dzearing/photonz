{
  "out": "/tmp/photonz-playtest/design-mode-tool-strip-walk",
  "setup": { "forget": ["all"] },
  "seed": "The Design mode puts the UI entry mock's tools in front of the tool bar (ui-entry-wt.html step 4, UX-PATTERNS D4 UI design): Select | Frame, Component insert, Shapes, Pen, Text | Measure | Hand, every other tool under More with its key. Starts from the front door's Design UI tile at Next defaults with no switch changed, reads the strip, rests the pointer on each of its tools to read its tip, picks up Frame and Crop by their keys (Crop is under More, so More lights and the pill says where it lives), then zooms in, picks the Hand with a pointer click and drags the canvas from on top of the Login screen: the view moves 200 by 100 points, the screen's own position does not change, nothing is picked, and Select clicks then find the screen where it now is. Then it leaves Design with Show Everything and reads the bar the window had before. The Shape slot starts on the Rectangle in Design (the mock's square, Shape (R)), remembers an Ellipse picked there, and the picture bar outside Design keeps its Line.",
  "steps": [
    { "do": "startFromFrontDoor", "tile": "Design UI", "press": "New UI canvas",
      "width": 1280, "height": 900, "card": "1-design-ui-picked" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "expectWindows", "titled": "untitled-ui", "count": 1 },
    { "do": "expect", "control": "Mode", "reads": "Design" },
    { "do": "toolBar", "stage": "1-design", "zoom": false, "onlyTools": true,
      "slots": ["Select", "Frame", "Component insert", "Shapes", "Pen", "Text", "Measure", "Hand"],
      "more": ["Selection", "Crop", "Arrow", "Highlight", "Lens", "Fill"],
      "lit": "Select" },
    { "do": "describe", "stage": "1-design", "note": "A new UI design from the front door is in the Design mode: the tool bar holds Select, then Frame, Component insert, Shapes, Pen and Text, then Measure, the mock's UI tools in the mock's order, and More holds the picture tools" },
    { "do": "snapshot", "name": "1-design-tool-strip" },

    { "do": "hover", "label": "Frame" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "snapshot", "name": "2-frame-tip" },
    { "do": "hover", "label": "Component insert" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "snapshot", "name": "2-component-tip" },
    { "do": "hover", "label": "Pen" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "hover", "label": "Text" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "hover", "label": "Measure" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "hover", "label": "Rectangle" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "describe", "stage": "2-shape-tip", "note": "on a fresh machine the Shape slot wears the Rectangle, as the mock draws it, and its tip reads Rectangle (R)" },
    { "do": "snapshot", "name": "2-shape-tip" },
    { "do": "hover", "at": [640, 400], "space": "view" },
    { "do": "wait", "seconds": 0.4 },

    { "do": "key", "key": "f" },
    { "do": "waitFor", "condition": "tool", "value": "frame", "timeout": 2 },
    { "do": "toolBar", "stage": "3-f-picks-frame", "lit": "Frame" },
    { "do": "key", "key": "c" },
    { "do": "waitFor", "condition": "tool", "value": "crop", "timeout": 2 },
    { "do": "wait", "seconds": 0.4 },
    { "do": "toolBar", "stage": "3-c-picks-crop", "lit": "More",
      "slots": ["Select", "Frame", "Component insert", "Shapes", "Pen", "Text", "Measure", "Hand"] },
    { "do": "describe", "stage": "3-c-picks-crop", "note": "C still crops in Design: Crop is under More, so More lights rather than a picture tool pushing into the strip" },
    { "do": "snapshot", "name": "3-crop-under-more" },
    { "do": "key", "key": "escape" },
    { "do": "key", "key": "v" },
    { "do": "waitFor", "condition": "tool", "value": "select", "timeout": 2 },

    { "do": "windowClick", "at": [439, 865] },
    { "do": "waitFor", "condition": "tool", "value": "component", "timeout": 2 },
    { "do": "toolBar", "stage": "4-component-in-hand", "lit": "Component insert" },
    { "do": "describe", "stage": "4-component-in-hand", "note": "A click on the Component insert button picks it up: it lights, and the capsule over the bar names the component a click places" },
    { "do": "snapshot", "name": "4-component-in-hand" },
    { "do": "click", "at": [640, 420], "space": "view" },
    { "do": "waitFor", "condition": "tool", "value": "select", "timeout": 2 },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "4-component-placed", "note": "A click on the canvas puts a copy of that component centred on the click, picked, with Select back in hand" },
    { "do": "snapshot", "name": "4-component-placed" },
    { "do": "key", "key": "n" },
    { "do": "waitFor", "condition": "tool", "value": "component", "timeout": 2 },
    { "do": "panelMenu", "menu": "Tool Component", "choose": "Card" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "snapshot", "name": "4-card-in-the-capsule" },
    { "do": "click", "at": [300, 650], "space": "view" },
    { "do": "waitFor", "condition": "tool", "value": "select", "timeout": 2 },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "4-card-placed", "note": "N picks the tool back up, the capsule's menu swaps it to Card, and the next click places a Card" },
    { "do": "snapshot", "name": "4-card-placed" },

    { "do": "pinch", "to": 3 },
    { "do": "wait", "seconds": 0.6 },
    { "do": "key", "key": "escape" },
    { "do": "expectPicked", "layers": [] },
    { "do": "expectBox", "layer": "Login", "at": [480, 302] },
    { "do": "describe", "stage": "7-zoomed", "note": "zoomed in to 300% so the picture is bigger than the window and has somewhere to go" },
    { "do": "windowClick", "at": [616, 865] },
    { "do": "waitFor", "condition": "tool", "value": "hand", "timeout": 2 },
    { "do": "toolBar", "stage": "7-hand-in-hand", "lit": "Hand" },
    { "do": "snapshot", "name": "7-hand-in-hand" },
    { "do": "describe", "stage": "7-hand-in-hand", "note": "a pointer click on the Hand at the end of the bar, after Measure, picks it up: it lights, no capsule rises because it has nothing to set, and the canvas wears an open hand" },
    { "do": "drag", "from": [500, 450], "to": [700, 550], "space": "view" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "expectPicked", "layers": [] },
    { "do": "expectBox", "layer": "Login", "at": [480, 302] },
    { "do": "describe", "stage": "7-panned", "note": "the drag started on the Login screen and the view followed the pointer 200 by 100 points: the screen slid with it on screen, its own position did not change, and nothing was picked" },
    { "do": "snapshot", "name": "7-panned" },
    { "do": "key", "key": "v" },
    { "do": "waitFor", "condition": "tool", "value": "select", "timeout": 2 },
    { "do": "click", "at": [40, 140], "space": "view" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "expectPicked", "layers": [] },
    { "do": "click", "at": [241, 240], "space": "view" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "expectPicked", "layers": ["Login"] },
    { "do": "describe", "stage": "7-screen-where-it-moved", "note": "with Select, a click where the screen's name was before the pan finds bare canvas, and a click where it is now picks the screen: the picture really moved under the pointer" },
    { "do": "key", "key": "escape" },
    { "do": "action", "action": "zoomToFit" },
    { "do": "wait", "seconds": 0.6 },

    { "do": "action", "action": "modeShowEverything" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expect", "control": "Mode", "reads": "Everything" },
    { "do": "toolBar", "stage": "5-everything", "zoom": false, "onlyTools": true, "more": [],
      "slots": ["Select", "Selection", "Crop", "Measure", "Arrow", "Shapes", "Highlight", "Text", "Lens", "Frame", "Pen", "Component insert", "Fill", "Hand"] },
    { "do": "describe", "stage": "5-everything", "note": "Show Everything gives the window its own bar back, every tool in its usual place" },
    { "do": "snapshot", "name": "5-everything" },

    { "do": "action", "action": "modeDesign" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "toolBar", "stage": "6-design-again",
      "slots": ["Select", "Frame", "Component insert", "Shapes", "Pen", "Text", "Measure", "Hand"] },

    { "do": "key", "key": "o" },
    { "do": "waitFor", "condition": "tool", "value": "ellipse", "timeout": 2 },
    { "do": "key", "key": "v" },
    { "do": "waitFor", "condition": "tool", "value": "select", "timeout": 2 },
    { "do": "hover", "label": "Ellipse" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "describe", "stage": "8-design-remembers", "note": "O picks the Ellipse up, and with Select back in hand the Shape slot keeps wearing the Ellipse: the slot remembers the last shape picked" },
    { "do": "snapshot", "name": "8-design-remembers-ellipse" },
    { "do": "hover", "at": [640, 400], "space": "view" },
    { "do": "action", "action": "modeShowEverything" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "hover", "label": "Line" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "describe", "stage": "8-picture-bar-default", "note": "outside Design the picture bar keeps its own face for the shapes: the Line, its default, untouched by what was picked in Design" },
    { "do": "snapshot", "name": "8-picture-bar-line" },
    { "do": "hover", "at": [640, 400], "space": "view" },
    { "do": "action", "action": "modeDesign" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "hover", "label": "Ellipse" },
    { "do": "wait", "seconds": 0.6 }
  ]
}
