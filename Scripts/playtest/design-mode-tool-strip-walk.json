{
  "out": "/tmp/photonz-playtest/design-mode-tool-strip-walk",
  "setup": { "forget": ["all"] },
  "seed": "The Design mode puts the UI entry mock's tools in front of the tool bar (ui-entry-wt.html step 4, UX-PATTERNS D4 UI design): Select | Frame, Shapes, Pen, Text | Measure, every other tool under More with its key. Starts from the front door's Design UI tile at Next defaults with no switch changed, reads the strip, rests the pointer on each of its tools to read its tip, picks up Frame and Crop by their keys (Crop is under More, so More lights and the pill says where it lives), then leaves Design with Show Everything and reads the bar the window had before.",
  "steps": [
    { "do": "startFromFrontDoor", "tile": "Design UI", "press": "New UI canvas",
      "width": 1280, "height": 900, "card": "1-design-ui-picked" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "expectWindows", "titled": "untitled-ui", "count": 1 },
    { "do": "expect", "control": "Mode", "reads": "Design" },
    { "do": "toolBar", "stage": "1-design", "zoom": false, "onlyTools": true,
      "slots": ["Select", "Frame", "Shapes", "Pen", "Text", "Measure"],
      "more": ["Selection", "Crop", "Arrow", "Highlight", "Lens", "Fill"],
      "lit": "Select" },
    { "do": "describe", "stage": "1-design", "note": "A new UI design from the front door is in the Design mode: the tool bar holds Select, then Frame, Shapes, Pen and Text, then Measure, the mock's UI tools in the mock's order, and More holds the picture tools" },
    { "do": "snapshot", "name": "1-design-tool-strip" },

    { "do": "hover", "label": "Frame" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "snapshot", "name": "2-frame-tip" },
    { "do": "hover", "label": "Pen" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "hover", "label": "Text" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "hover", "label": "Measure" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "hover", "at": [640, 400], "space": "view" },
    { "do": "wait", "seconds": 0.4 },

    { "do": "key", "key": "f" },
    { "do": "waitFor", "condition": "tool", "value": "frame", "timeout": 2 },
    { "do": "toolBar", "stage": "3-f-picks-frame", "lit": "Frame" },
    { "do": "key", "key": "c" },
    { "do": "waitFor", "condition": "tool", "value": "crop", "timeout": 2 },
    { "do": "wait", "seconds": 0.4 },
    { "do": "toolBar", "stage": "3-c-picks-crop", "lit": "More",
      "slots": ["Select", "Frame", "Shapes", "Pen", "Text", "Measure"] },
    { "do": "describe", "stage": "3-c-picks-crop", "note": "C still crops in Design: Crop is under More, so More lights rather than a picture tool pushing into the strip" },
    { "do": "snapshot", "name": "3-crop-under-more" },
    { "do": "key", "key": "escape" },
    { "do": "key", "key": "v" },
    { "do": "waitFor", "condition": "tool", "value": "select", "timeout": 2 },

    { "do": "action", "action": "modeShowEverything" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expect", "control": "Mode", "reads": "Everything" },
    { "do": "toolBar", "stage": "4-everything", "zoom": false, "onlyTools": true, "more": [],
      "slots": ["Select", "Selection", "Crop", "Measure", "Arrow", "Shapes", "Highlight", "Text", "Lens", "Frame", "Pen", "Fill"] },
    { "do": "describe", "stage": "4-everything", "note": "Show Everything gives the window its own bar back, every tool in its usual place" },
    { "do": "snapshot", "name": "4-everything" },

    { "do": "action", "action": "modeDesign" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "toolBar", "stage": "5-design-again",
      "slots": ["Select", "Frame", "Shapes", "Pen", "Text", "Measure"] }
  ]
}
