{
  "out": "/tmp/photonz-playtest/playback-speed-walk",
  "seed": "The transport's speed menu at Next defaults, no flag touched: it sits beside play reading 1x, a click on its face opens the seven speeds, a pick plays at that speed, the sound keeps its pitch at half and one and a half speed (a 440 Hz test tone, listened to at the engine's output), goes quiet above double speed, Shift-period and Shift-comma step it, and L L L shows 4x in the same control.",
  "setup": {
    "forget": ["all"]
  },
  "steps": [
    { "do": "action", "action": "openSampleRecording" },
    { "do": "wait", "seconds": 2.0 },
    { "do": "action", "action": "videoPause" },
    { "do": "key", "key": "home" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "dropImage", "file": "fixtures/A 440 Hz tone 12s.m4a", "at": [640, 400] },
    { "do": "wait", "seconds": 1.5 },
    { "do": "key", "key": "home" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "expectTimeline", "speed": "1x", "rate": 0 },
    { "do": "describe", "stage": "1-opened", "note": "an eight second recording with a 440 Hz test tone dropped onto its timeline, at Next defaults: the speed control beside play reads 1x" },
    { "do": "snapshot", "name": "1-speed-control-at-1x" },

    { "do": "key", "key": "space" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectTimeline", "rate": 1, "speed": "1x", "sound": true },
    { "do": "expectSoundPitch", "hz": 440 },
    { "do": "key", "key": "space" },
    { "do": "key", "key": "home" },
    { "do": "wait", "seconds": 0.3 },

    { "do": "panelMenu", "menu": "Playback Speed", "at": ["centre"], "choose": "0.5x" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "expectTimeline", "speed": "0.5x", "rate": 0 },
    { "do": "key", "key": "space" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "2-half-speed", "note": "a click on the speed control's face and 0.5x picked; Space plays at half speed and the tone is still 440 Hz: slower, not lower" },
    { "do": "expectTimeline", "rate": 0.5, "speed": "0.5x", "sound": true },
    { "do": "expectSoundPitch", "hz": 440 },
    { "do": "snapshot", "name": "2-playing-at-half-speed" },

    { "do": "panelMenu", "menu": "Playback Speed", "at": ["centre"], "choose": "1.5x" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "3-one-and-a-half", "note": "picked 1.5x while it plays: it changes speed where it is, and the tone still reads 440 Hz" },
    { "do": "expectTimeline", "rate": 1.5, "speed": "1.5x", "sound": true },
    { "do": "expectSoundPitch", "hz": 440 },

    { "do": "panelMenu", "menu": "Playback Speed", "at": ["centre"], "choose": "4x" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "describe", "stage": "4-four-times", "note": "4x sits under Without Sound in the menu: it plays four times as fast and the sound goes quiet; Space stops it, and the control still reads 4x with a struck-through speaker, the speed Space plays at next" },
    { "do": "expectTimeline", "rate": 4, "speed": "4x", "sound": false },
    { "do": "key", "key": "space" },
    { "do": "wait", "seconds": 0.2 },
    { "do": "expectTimeline", "rate": 0, "speed": "4x" },
    { "do": "snapshot", "name": "3-four-times-no-sound" },

    { "do": "key", "key": ",", "modifiers": ["shift"] },
    { "do": "wait", "seconds": 0.2 },
    { "do": "expectTimeline", "rate": 0, "speed": "2x" },
    { "do": "key", "key": ",", "modifiers": ["shift"] },
    { "do": "key", "key": ",", "modifiers": ["shift"] },
    { "do": "wait", "seconds": 0.2 },
    { "do": "expectTimeline", "rate": 0, "speed": "1x" },
    { "do": "key", "key": ".", "modifiers": ["shift"] },
    { "do": "wait", "seconds": 0.2 },
    { "do": "describe", "stage": "5-shift-keys", "note": "Shift-comma stepped it down from 4x to 2x, 1.5x and 1x, and Shift-period back up to 1.5x, all while stopped" },
    { "do": "expectTimeline", "rate": 0, "speed": "1.5x" },

    { "do": "press", "control": "Timeline Select" },
    { "do": "key", "key": "home" },
    { "do": "key", "key": "l" },
    { "do": "key", "key": "l" },
    { "do": "key", "key": "l" },
    { "do": "wait", "seconds": 0.2 },
    { "do": "describe", "stage": "6-shuttle", "note": "L L L, Premiere's shuttle, still climbs its own ladder of 1, 2 and 4 times, and the speed control shows 4x while it runs" },
    { "do": "expectTimeline", "rate": 4, "speed": "4x", "sound": false },
    { "do": "snapshot", "name": "4-shuttle-shows-4x" },
    { "do": "key", "key": "k" },
    { "do": "wait", "seconds": 0.2 },
    { "do": "expectTimeline", "rate": 0, "speed": "1.5x" }
  ]
}
