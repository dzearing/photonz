{
  "out": "/tmp/photonz-playtest/drag-readout",
  "setup": { "forget": ["grid", "tools", "shapes", "panel"] },
  "steps": [
    { "do": "blank", "canvasWidth": 900, "canvasHeight": 700, "width": 1280, "height": 900 },
    { "do": "wait", "seconds": 1 },

    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [120, 100], "to": [280, 160], "steps": 8 },
    { "do": "wait", "seconds": 0.4 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expectReadout", "absent": true },
    { "do": "describe", "stage": "0-nothing-in-hand", "note": "a rectangle picked and nothing being dragged: the canvas carries no reading at all" },

    { "do": "drag", "from": [200, 130], "to": [423, 317], "steps": 12, "readout": "343, 287", "hold": "1-mid-move" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectReadout", "absent": true },
    { "do": "action", "action": "positionAndSize" },
    { "do": "expect", "field": "X", "reads": "343" },
    { "do": "expect", "field": "Y", "reads": "287" },
    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "describe", "stage": "1-moved", "note": "a move says WHERE: the pill read 343, 287 with the button still down, and the panel reads the same two numbers after the release, so nothing jumped" },
    { "do": "snapshot", "name": "2-after-move" },

    { "do": "drag", "from": [503, 347], "to": [611, 429], "steps": 12, "readout": "268 × 142", "hold": "3-mid-resize" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectReadout", "absent": true },
    { "do": "action", "action": "positionAndSize" },
    { "do": "expect", "field": "W", "reads": "268" },
    { "do": "expect", "field": "H", "reads": "142" },
    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "describe", "stage": "2-resized", "note": "a resize says HOW BIG: the pill read 268 x 142 mid-drag and the panel reads the same size after the release" },
    { "do": "snapshot", "name": "4-after-resize" },

    { "do": "tool", "tool": "rectSelect" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "drag", "from": [180, 470], "to": [383, 601], "steps": 12, "readout": "203 × 131", "hold": "5-mid-sweep" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectReadout", "absent": true },
    { "do": "expectRegion", "reads": "180,470 203x131" },
    { "do": "describe", "stage": "3-swept", "note": "a selection box says how big it is the whole time it is being swept: 203 x 131 with the button down, and that is exactly the region that landed" },
    { "do": "snapshot", "name": "6-after-sweep" },

    { "do": "key", "key": "escape" },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.4 },

    { "do": "key", "key": "p" },
    { "do": "waitFor", "condition": "tool", "value": "pen" },
    { "do": "click", "at": [200, 200] },
    { "do": "wait", "seconds": 0.2 },
    { "do": "click", "at": [500, 200] },
    { "do": "wait", "seconds": 0.2 },
    { "do": "click", "at": [500, 400] },
    { "do": "wait", "seconds": 0.2 },
    { "do": "click", "at": [203, 203] },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expectPath", "anchors": 3, "closed": true },
    { "do": "waitFor", "condition": "tool", "value": "select", "timeout": 2 },
    { "do": "wait", "seconds": 0.5 },

    { "do": "drag", "from": [500, 400], "to": [620, 520], "steps": 14, "readout": "420 × 320", "hold": "7-mid-reshape" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectReadout", "absent": true },
    { "do": "action", "action": "positionAndSize" },
    { "do": "expect", "field": "W", "reads": "420" },
    { "do": "expect", "field": "H", "reads": "320" },
    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "describe", "stage": "4-reshaped", "note": "a point pulled out past the old edge: the pill read 420 x 320 under the pointer, which is the shape as it IS rather than as it was before the press, and the panel reads the same after the release" },
    { "do": "snapshot", "name": "8-after-reshape" },

    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [100, 560], "to": [200, 620], "steps": 8 },
    { "do": "wait", "seconds": 0.3 },
    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [300, 560], "to": [400, 620], "steps": 8 },
    { "do": "wait", "seconds": 0.3 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "drag", "from": [80, 540], "to": [420, 645], "steps": 10 },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expectPicked", "layers": ["Rectangle 2", "Rectangle 3"] },

    { "do": "drag", "from": [150, 590], "to": [190, 614], "steps": 12, "readout": "140, 584", "hold": "10-mid-multi-move" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectReadout", "absent": true },
    { "do": "describe", "stage": "5-multi-moved", "note": "two rectangles picked and dragged together: the pill describes the BOX the pair makes, 140, 584, because a whole selection has no one layer to speak for" },
    { "do": "snapshot", "name": "11-after-multi-move" },

    { "do": "render", "name": "9-final-render" }
  ]
}
