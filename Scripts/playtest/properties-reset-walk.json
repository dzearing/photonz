{
  "out": "/tmp/photonz-playtest/properties-reset-walk",
  "seed": "Reset to defaults on the Properties menu, at Next defaults with no flag changed. A title is typed on a recording, its scale is keyed from 100 to 160 and its opacity keyed down to 40, then the three dots on the Properties heading are opened and Reset to Defaults is chosen, as video.html #propMenu draws it under the copy row. Nothing is left animating, the title stands where it was typed at its own size, square and fully opaque, and one undo brings both animations back.",
  "setup": {
    "front": true,
    "forget": ["all"]
  },
  "steps": [
    { "do": "action", "action": "openSampleRecording" },
    { "do": "wait", "seconds": 2.0 },
    { "do": "action", "action": "videoPause" },
    { "do": "tool", "tool": "select" },
    { "do": "action", "action": "videoSeekMiddle" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "tool", "tool": "text" },
    { "do": "click", "at": [620, 330] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "type", "text": "Launch day" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "key", "key": "return", "modifiers": ["command"] },
    { "do": "wait", "seconds": 1.0 },
    { "do": "reveal", "control": "Properties section" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expect", "field": "Properties Kind", "reads": "Title" },
    { "do": "expect", "field": "Animating Count", "reads": "nothing yet" },
    { "do": "panelMenu", "menu": "Properties Menu" },
    { "do": "describe", "stage": "1-nothing-to-reset", "note": "THE FIRST TEST: a title nobody has animated. The Properties menu lists Copy Look, Paste Look and Reset to Defaults, and Reset to Defaults is dimmed because there is nothing to put back" },

    { "do": "press", "control": "Animate a property" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "press", "control": "Scale", "in": "Animate a property" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "press", "control": "Animate a property" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "press", "control": "Opacity", "in": "Animate a property" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "action", "action": "videoSeekThreeQuarters" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "press", "control": "Scale Value" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "key", "key": "a", "modifiers": ["command"] },
    { "do": "type", "text": "160" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "press", "control": "Opacity Value" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "key", "key": "a", "modifiers": ["command"] },
    { "do": "type", "text": "40" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "2-keyed", "note": "THE SECOND TEST: the title grows from 100 to 160 and fades to 40 between two moments. Both rows are in Animating with a key on the playhead" },
    { "do": "expect", "field": "Animating Count", "reads": "2 of 12 properties" },
    { "do": "expect", "control": "Key", "in": "Scale", "reads": "on a key" },
    { "do": "expect", "control": "Key", "in": "Opacity", "reads": "on a key" },
    { "do": "panel", "stage": "2-keyed" },
    { "do": "snapshot", "name": "1-a-keyed-title" },

    { "do": "panelMenu", "menu": "Properties Menu", "shot": "1b-the-properties-menu" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "panelMenu", "menu": "Properties Menu", "choose": "Reset to Defaults" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "3-reset", "note": "THE THIRD TEST: Reset to Defaults from the three dots. Nothing is animating any more, both rows have left the list, and the title is back where it was typed at its own size, square and fully opaque" },
    { "do": "expect", "field": "Animating Count", "reads": "nothing yet" },
    { "do": "expect", "control": "Key", "in": "Scale", "present": false },
    { "do": "expect", "control": "Key", "in": "Opacity", "present": false },
    { "do": "expect", "field": "Properties Kind", "reads": "Title" },
    { "do": "panel", "stage": "3-reset" },
    { "do": "snapshot", "name": "2-reset-to-defaults" },

    { "do": "action", "action": "undo" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "4-undone", "note": "THE FOURTH TEST: one undo brings both animations back at once" },
    { "do": "expect", "field": "Animating Count", "reads": "2 of 12 properties" },
    { "do": "expect", "control": "Key", "in": "Scale", "reads": "on a key" },
    { "do": "expect", "control": "Key", "in": "Opacity", "reads": "on a key" },
    { "do": "action", "action": "redo" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expect", "field": "Animating Count", "reads": "nothing yet" },
    { "do": "snapshot", "name": "3-redone" }
  ]
}
