{
  "out": "/tmp/photonz-playtest/label-grows",
  "steps": [
    { "do": "blank", "canvasWidth": 1440, "canvasHeight": 1024, "width": 1240, "height": 900 },
    { "do": "wait", "seconds": 1 },
    { "do": "action", "action": "hideLibrary" },
    { "do": "action", "action": "showInspector" },
    { "do": "wait", "seconds": 0.4 },

    { "do": "tool", "tool": "text" },
    { "do": "click", "at": [200, 200] },
    { "do": "type", "text": "Photonz measures what it says" },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "focus", "field": "W" },
    { "do": "type", "text": "620" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "1-typed",
      "note": "one line of text in a box pinned at (200, 200) and 620 wide, so the right middle handle is at about (820, 216)" },
    { "do": "snapshot", "name": "label-1-typed" },
    { "do": "render", "name": "label-1-typed-doc" },

    { "do": "drag", "from": [820, 216], "to": [380, 216], "steps": 12 },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "2-dragged",
      "note": "dragging the right edge in to 180 wide: the words should have re-wrapped onto several lines and the box grown DOWN to hold them, with nothing cut off at the bottom. The top edge should not have moved." },
    { "do": "snapshot", "name": "label-2-dragged" },
    { "do": "render", "name": "label-2-dragged-doc" },

    { "do": "action", "action": "undo" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "3-undone",
      "note": "one undo puts the whole thing back: 620 wide and one line tall again" },
    { "do": "render", "name": "label-3-undone-doc" },

    { "do": "focus", "field": "W" },
    { "do": "type", "text": "180" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "4-typed-width",
      "note": "the same thing by typing 180 into W: it re-wraps and grows, and H follows rather than taking a number of its own" },
    { "do": "snapshot", "name": "label-4-typed-width" },
    { "do": "render", "name": "label-4-typed-width-doc" },

    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [200, 460], "to": [380, 510], "steps": 8 },
    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [200, 540], "to": [380, 590], "steps": 8 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "drag", "from": [150, 150], "to": [700, 650], "steps": 10 },
    { "do": "wait", "seconds": 0.4 },
    { "do": "action", "action": "stackSelection" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "5-stacked",
      "note": "the label and two boxes are one stack now" },
    { "do": "snapshot", "name": "label-5-stacked" },
    { "do": "render", "name": "label-5-stacked-doc" },

    { "do": "focus", "field": "Gap" },
    { "do": "type", "text": "12" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "focus", "field": "W" },
    { "do": "type", "text": "150" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "action", "action": "stretchContentsAcross" },
    { "do": "wait", "seconds": 0.9 },
    { "do": "describe", "stage": "6-stretched",
      "note": "the stack is 150 wide and its rows fill it. The label re-wraps to 150, gains a line, and the two boxes under it move DOWN by exactly what it gained, in the same step." },
    { "do": "snapshot", "name": "label-6-stretched" },
    { "do": "render", "name": "label-6-stretched-doc" },

    { "do": "action", "action": "makeComponent" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "type", "text": "Note" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "action", "action": "exposeWording" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "action", "action": "pickFirstComponent" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "dropComponent", "at": [900, 300] },
    { "do": "wait", "seconds": 0.9 },
    { "do": "describe", "stage": "7-copy",
      "note": "a copy of the stack, following its original" },
    { "do": "snapshot", "name": "label-7-copy" },

    { "do": "focus", "field": "Wording" },
    { "do": "type", "text": "This copy says a great deal more than the original ever did" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 1 },
    { "do": "describe", "stage": "8-longer-wording",
      "note": "the copy alone says the longer thing, ALL of it: its label kept the 150 wrap width it had, gained lines, and the two boxes under it moved down. The original is untouched." },
    { "do": "snapshot", "name": "label-8-longer-wording" },
    { "do": "render", "name": "label-8-longer-wording-doc" }
  ]
}
