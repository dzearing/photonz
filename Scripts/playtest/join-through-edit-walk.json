{
  "out": "/tmp/photonz-playtest/join-through-edit-walk",
  "seed": "A cut made with Split at Playhead (or the Blade) and nothing else is a through edit, and its right-click joins it back into one piece the way Premiere's Join Through Edit does, without Undo throwing away what came after. A cut with frames taken out offers the row dimmed. At Next defaults, no flag set.",
  "setup": {
    "timelineOpen": true,
    "forget": ["all"]
  },
  "steps": [
    { "do": "action", "action": "openSampleRecording" },
    { "do": "wait", "seconds": 2.0 },
    { "do": "action", "action": "videoPause" },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.5 },

    { "do": "action", "action": "videoSeekStart" },
    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "expectTimeline", "playheadMS": 4000 },
    { "do": "action", "action": "clipSplit" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectClip", "clip": "Tutorial Sample", "pieces": 2 },
    { "do": "describe", "stage": "1-cut-at-4s", "note": "Playhead at four seconds, Split at Playhead: the recording is in two pieces that read straight on across the cut" },
    { "do": "snapshot", "name": "1-cut-at-4s" },

    { "do": "rightClick", "on": "Tutorial Sample join 1", "shot": "2-cut-menu", "choose": "Join Through Edit" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectClip", "clip": "Tutorial Sample", "pieces": 1 },
    { "do": "expect", "control": "Tutorial Sample join 1", "present": false },
    { "do": "describe", "stage": "2-joined", "note": "Right-click the cut, Join Through Edit: one piece again, as if it had never been cut" },
    { "do": "snapshot", "name": "3-joined" },

    { "do": "action", "action": "undo" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectClip", "clip": "Tutorial Sample", "pieces": 2 },
    { "do": "describe", "stage": "3-undone", "note": "One Command Z puts the cut back: the join was one step" },

    { "do": "rightClick", "on": "Tutorial Sample join 1", "choose": "Add Transition > Dip to black" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "rightClick", "on": "Tutorial Sample transition at join 1", "choose": "Join Through Edit" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "expectNotice", "says": "Dip to black taken off" },
    { "do": "expectClip", "clip": "Tutorial Sample", "pieces": 1 },
    { "do": "describe", "stage": "4-joined-with-a-dip", "note": "A dip to black on the cut, then Join Through Edit: one piece, and the canvas says the dip went with the cut" },
    { "do": "snapshot", "name": "4-joined-with-a-dip" },

    { "do": "action", "action": "videoSeekStart" },
    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "action", "action": "clipSplit" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "action", "action": "clipSplit" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "action", "action": "clipDeletePiece" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectClip", "clip": "Tutorial Sample", "pieces": 2 },
    { "do": "rightClick", "on": "Tutorial Sample join 1", "shot": "5-jump-cut-menu", "dimmed": ["Join Through Edit"] },
    { "do": "describe", "stage": "5-jump-cut", "note": "Cut at four and six seconds and the two seconds between thrown away: the cut left behind jumps, so its right-click offers Join Through Edit dimmed" }
  ]
}
