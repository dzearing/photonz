{
  "out": "/tmp/photonz-playtest/tutorial-export-a-recording-walk",
  "setup": { "flags": { "next-a-recording-is-a-document": false }, "forget": ["tutorials"] },
  "steps": [
    { "do": "startGuide", "guide": "export-a-recording" },
    { "do": "waitFor", "condition": "tutorialStep", "value": "three-ways-out", "timeout": 25 },
    { "do": "wait", "seconds": 1 },
    { "do": "describe", "stage": "1-three-ways-out", "note": "the export button ringed, with what is inside it said on the card: the rows live in a menu, which is its own window and cannot be ringed" },
    { "do": "snapshot", "name": "1-three-ways-out" },

    { "do": "action", "action": "tutorialNext" },
    { "do": "waitFor", "condition": "tutorialStep", "value": "how-good", "timeout": 6 },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "2-how-good", "note": "the three quality levels, in the app's own words for them" },
    { "do": "snapshot", "name": "2-how-good" },

    { "do": "action", "action": "tutorialNext" },
    { "do": "waitFor", "condition": "tutorialStep", "value": "copy-it-instead", "timeout": 6 },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "3-copy-it-instead", "note": "the one thing the guide asks anybody to do, and the one with no dialog in it" },
    { "do": "snapshot", "name": "3-copy-it-instead" },

    { "do": "action", "action": "videoCopyGIF" },
    { "do": "waitFor", "condition": "tutorialStep", "value": "what-comes-out", "timeout": 10 },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "4-what-comes-out", "note": "the copy moved it on straight away rather than waiting for the encoder; the closing card is inside the picture" },
    { "do": "snapshot", "name": "4-what-comes-out" },

    { "do": "action", "action": "tutorialNext" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "5-finished", "note": "Done closed the guide" }
  ]
}
