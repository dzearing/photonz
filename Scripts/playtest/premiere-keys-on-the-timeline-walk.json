{
  "out": "/tmp/photonz-playtest/premiere-keys-on-the-timeline-walk",
  "setup": { "forget": ["all"] },
  "steps": [
    { "do": "action", "action": "openSampleRecording" },
    { "do": "wait", "seconds": 2.0 },
    { "do": "action", "action": "videoPause" },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "action", "action": "videoSeekQuarter" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "describe", "stage": "0-opened", "note": "an eight second recording opened in Next with nothing changed from its defaults: one clip, picked, the playhead two seconds in, and the timeline holding the keyboard from the moment it opened, so a ring round the timeline" },
    { "do": "expectTimeline", "keyboard": "timeline", "playheadMS": 2000, "withinMS": 40 },
    { "do": "expectBox", "layer": "Tutorial Sample", "at": [0, 0], "within": 0.5 },
    { "do": "click", "at": [640, 300] },
    { "do": "wait", "seconds": 0.3 },
    { "do": "expectTimeline", "keyboard": "canvas", "playheadMS": 2000, "withinMS": 40 },
    { "do": "snapshot", "name": "0-canvas-has-the-keyboard" },

    { "do": "key", "key": "right" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "describe", "stage": "1-canvas-arrow", "note": "a click on the picture gave the canvas the keyboard, the clip is still picked, so the right arrow is Photoshop's nudge: the picture moved one point right and the playhead did not move" },
    { "do": "expectBox", "layer": "Tutorial Sample", "at": [1, 0], "within": 0.5 },
    { "do": "expectTimeline", "playheadMS": 2000, "withinMS": 40 },
    { "do": "key", "key": "z", "modifiers": ["command"] },
    { "do": "wait", "seconds": 0.3 },
    { "do": "expectBox", "layer": "Tutorial Sample", "at": [0, 0], "within": 0.5 },

    { "do": "press", "control": "Timeline Select" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "expectTimeline", "keyboard": "timeline" },
    { "do": "key", "key": "right" },
    { "do": "key", "key": "right" },
    { "do": "key", "key": "right" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "describe", "stage": "2-timeline-arrows", "note": "a press on the timeline's own Select tool hands the timeline the keyboard, and a thin blue ring goes round the dock to say so. With the SAME clip still picked, three presses of the right arrow stepped the playhead three frames and left the picture where it was" },
    { "do": "expectTimeline", "keyboard": "timeline", "playheadMS": 2099, "withinMS": 34 },
    { "do": "expectBox", "layer": "Tutorial Sample", "at": [0, 0], "within": 0.5 },
    { "do": "snapshot", "name": "2-timeline-has-the-keyboard" },

    { "do": "key", "key": "right", "modifiers": ["shift"] },
    { "do": "wait", "seconds": 0.2 },
    { "do": "expectTimeline", "playheadMS": 2264, "withinMS": 34 },
    { "do": "key", "key": "left" },
    { "do": "wait", "seconds": 0.2 },
    { "do": "expectTimeline", "playheadMS": 2231, "withinMS": 34 },

    { "do": "key", "key": "k", "modifiers": ["command"] },
    { "do": "wait", "seconds": 0.4 },
    { "do": "describe", "stage": "3-command-k", "note": "Command K is Premiere's Add Edit: the clip is cut at the playhead" },
    { "do": "snapshot", "name": "3-command-k-cut" },
    { "do": "key", "key": "home" },
    { "do": "wait", "seconds": 0.2 },
    { "do": "expectTimeline", "playheadMS": 0 },
    { "do": "key", "key": "down" },
    { "do": "wait", "seconds": 0.2 },
    { "do": "describe", "stage": "4-down-to-the-cut", "note": "Home took the playhead to the start and the down arrow to the next edit point, which is the cut Command K just made" },
    { "do": "expectTimeline", "playheadMS": 2231, "withinMS": 34 },
    { "do": "key", "key": "up" },
    { "do": "wait", "seconds": 0.2 },
    { "do": "expectTimeline", "playheadMS": 0 },
    { "do": "key", "key": "end" },
    { "do": "wait", "seconds": 0.2 },
    { "do": "expectTimeline", "playheadMS": 7999, "withinMS": 40 },
    { "do": "key", "key": "up" },
    { "do": "wait", "seconds": 0.2 },
    { "do": "expectTimeline", "playheadMS": 2231, "withinMS": 34 },

    { "do": "key", "key": "i" },
    { "do": "key", "key": "end" },
    { "do": "key", "key": "left", "modifiers": ["shift"] },
    { "do": "key", "key": "o" },
    { "do": "key", "key": "m" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "describe", "stage": "5-in-out-marker", "note": "I set the In at the cut, End and Shift-left went five frames back from the end, O set the Out there and M dropped a marker at the same moment: the green stretch on the ruler and the scrub bar is what the marks enclose" },
    { "do": "expectTimeline", "markInMS": 2231, "hasOut": true, "markers": 1 },
    { "do": "snapshot", "name": "5-in-out-and-a-marker" },
    { "do": "key", "key": "i", "modifiers": ["option"] },
    { "do": "wait", "seconds": 0.2 },
    { "do": "expectTimeline", "hasIn": false, "hasOut": true },
    { "do": "key", "key": "o", "modifiers": ["option"] },
    { "do": "wait", "seconds": 0.2 },
    { "do": "expectTimeline", "hasIn": false, "hasOut": false },

    { "do": "key", "key": "home" },
    { "do": "key", "key": "l" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "expectTimeline", "rate": 1 },
    { "do": "key", "key": "l" },
    { "do": "wait", "seconds": 0.2 },
    { "do": "describe", "stage": "6-double-speed", "note": "L plays, and a second L doubles it: the transport's time carries 2x beside it while it runs" },
    { "do": "expectTimeline", "rate": 2 },
    { "do": "snapshot", "name": "6-l-twice-is-double-speed" },
    { "do": "key", "key": "k" },
    { "do": "wait", "seconds": 0.2 },
    { "do": "expectTimeline", "rate": 0 },
    { "do": "key", "key": "j" },
    { "do": "wait", "seconds": 0.2 },
    { "do": "expectTimeline", "rate": -1 },
    { "do": "key", "key": "k" },
    { "do": "wait", "seconds": 0.2 },
    { "do": "expectTimeline", "rate": 0 },

    { "do": "key", "key": "b" },
    { "do": "wait", "seconds": 0.2 },
    { "do": "expectTimeline", "blade": true },
    { "do": "describe", "stage": "7-blade", "note": "B picked up the timeline's Blade, the mock's B" },
    { "do": "snapshot", "name": "7-b-is-the-blade" },
    { "do": "key", "key": "v" },
    { "do": "wait", "seconds": 0.2 },
    { "do": "expectTimeline", "blade": false },

    { "do": "click", "at": [640, 600] },
    { "do": "wait", "seconds": 0.3 },
    { "do": "expectTimeline", "keyboard": "canvas" },
    { "do": "key", "key": "l" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "describe", "stage": "8-back-on-the-canvas", "note": "a click on the picture gave the canvas the keyboard back, the ring went, and L is the Line tool again instead of Play" },
    { "do": "expectTimeline", "keyboard": "canvas", "rate": 0 },
    { "do": "snapshot", "name": "8-l-is-the-line-tool-again" }
  ]
}
