{
  "out": "/tmp/photonz-playtest/shift-command-j-closes-a-path",
  "seed": "Somebody drawing an icon with the Pen finishes an outline with Return, looks at it, and wants it shut. Shift Command J is Photoshop's New Layer via Cut, which does nothing without a marquee, so with one open outline picked and no marquee up the same key closes the outline instead. This walk draws two sides of a triangle, checks the menu bar prints Shift Command J against Close Path and against nothing else, presses the key, answers the question, and checks the outline closed on its own two ends in one undo step. Then it drops a picture, puts a marquee on it, and checks the key has gone back to New Layer via Cut and still lifts the piece onto its own layer.",
  "setup": { "forget": ["shapes", "color", "panel", "tools"], "front": true },
  "steps": [
    { "do": "blank", "canvasWidth": 1200, "canvasHeight": 800, "width": 1280, "height": 900 },
    { "do": "wait", "seconds": 1 },

    { "do": "key", "key": "p" },
    { "do": "waitFor", "condition": "tool", "value": "pen" },
    { "do": "click", "at": [300, 160] },
    { "do": "wait", "seconds": 0.3 },
    { "do": "click", "at": [480, 460] },
    { "do": "wait", "seconds": 0.3 },
    { "do": "click", "at": [120, 460] },
    { "do": "wait", "seconds": 0.3 },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "key", "key": "escape" },
    { "do": "waitFor", "condition": "tool", "value": "select" },
    { "do": "selectRow", "row": "Path" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectPicked", "layers": ["Path"] },
    { "do": "expectPath", "anchors": 3, "closed": false },
    { "do": "expectLayers", "count": 2 },
    { "do": "describe", "stage": "1-an-open-outline-picked", "note": "two sides of a triangle drawn with the Pen and finished with Return, picked, no marquee anywhere" },
    { "do": "snapshot", "name": "1-open-outline-picked" },

    { "do": "menus", "stage": "2-the-key-is-on-close-path", "menu": "Layer", "oneKeyEach": true },
    { "do": "shortcut", "key": "j", "modifiers": ["command", "shift"], "menuItem": "Close Path…" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "snapshot", "name": "3-question" },
    { "do": "describe", "stage": "3-it-asks-first", "note": "the key ran Close Path, which asks the same question the menu row asks: the gap in points, and a Close Path button" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 1.2 },

    { "do": "expectLayers", "count": 2 },
    { "do": "expectPath", "anchors": 3, "closed": true },
    { "do": "expectPath", "anchors": 3, "anchor": 0, "near": [300, 160], "within": 8 },
    { "do": "expectPath", "anchors": 3, "anchor": 2, "near": [120, 460], "within": 8 },
    { "do": "expectNotice", "says": "Closed" },
    { "do": "describe", "stage": "4-closed-by-key", "note": "THE POINT: Shift Command J shut the outline on its own two ends, with nothing else moved, and the notice says Closed" },
    { "do": "snapshot", "name": "4-closed-by-key" },
    { "do": "render", "name": "doc-4-closed" },

    { "do": "action", "action": "undo" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "expectPath", "anchors": 3, "closed": false },
    { "do": "expectLayers", "count": 2 },
    { "do": "describe", "stage": "5-one-undo-opens-it", "note": "closing by key is one step: a single undo takes the run away" },
    { "do": "action", "action": "redo" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expectPath", "anchors": 3, "closed": true },

    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "dropImage", "file": "fixtures/Photonz drop probe.png", "at": [880, 500] },
    { "do": "wait", "seconds": 1.0 },
    { "do": "tool", "tool": "select" },
    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "click", "at": [880, 500] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expectLayers", "count": 3 },
    { "do": "tool", "tool": "rectSelect" },
    { "do": "drag", "from": [731, 411], "to": [772, 424] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "6-a-marquee-on-a-picture", "note": "a picture picked with a marquee round its General heading" },
    { "do": "snapshot", "name": "6-marquee-on-a-picture" },

    { "do": "menus", "stage": "7-the-key-is-back-on-the-cut", "menu": "Layer", "oneKeyEach": true },
    { "do": "shortcut", "key": "j", "modifiers": ["command", "shift"], "menuItem": "New Layer via Cut" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expectLayers", "count": 4 },
    { "do": "describe", "stage": "8-cut-onto-its-own-layer", "note": "THE OTHER HALF: with a marquee up the key is Photoshop's New Layer via Cut, exactly as before, and the heading is on a layer of its own" },
    { "do": "snapshot", "name": "8-cut-by-key" }
  ]
}
