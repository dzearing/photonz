{
  "out": "/tmp/photonz-playtest/effects-open-into-view",
  "setup": {
    "forget": [
      "shapes",
      "color",
      "panel"
    ]
  },
  "steps": [
    {
      "do": "blank",
      "canvasWidth": 900,
      "canvasHeight": 600,
      "width": 1280,
      "height": 600
    },
    {
      "do": "wait",
      "seconds": 1
    },
    {
      "do": "key",
      "key": "r"
    },
    {
      "do": "drag",
      "from": [
        340,
        240
      ],
      "to": [
        560,
        400
      ]
    },
    {
      "do": "wait",
      "seconds": 0.8
    },
    {
      "do": "panelMenu",
      "menu": "Add Effect",
      "choose": "Shadow"
    },
    {
      "do": "wait",
      "seconds": 0.8
    },
    {
      "do": "describe",
      "stage": "1-border-and-shadow",
      "note": "a box with a Border and a Shadow in a window too short to hold both open: the Effects list scrolls inside itself"
    },
    {
      "do": "press",
      "control": "Twist",
      "in": "Border"
    },
    {
      "do": "wait",
      "seconds": 0.8
    },
    {
      "do": "describe",
      "stage": "2-border-folded",
      "note": "the Border folded away. Folding is not a thing to go and look at, so nothing scrolls: effectReveal still reads none yet"
    },
    {
      "do": "expect",
      "control": "Twist",
      "in": "Border",
      "reads": "Border, shut"
    },
    {
      "do": "snapshot",
      "name": "2-border-folded"
    },
    {
      "do": "press",
      "control": "Twist",
      "in": "Border"
    },
    {
      "do": "wait",
      "seconds": 0.8
    },
    {
      "do": "describe",
      "stage": "3-border-open",
      "note": "the Border opened at the top of the list, where it was already all on screen: effectReveal says nothing moved"
    },
    {
      "do": "expect",
      "control": "Twist",
      "in": "Border",
      "reads": "Border, open"
    },
    {
      "do": "expectInView",
      "field": "Border"
    },
    {
      "do": "snapshot",
      "name": "3-border-open"
    },
    {
      "do": "press",
      "control": "Twist",
      "in": "Shadow"
    },
    {
      "do": "wait",
      "seconds": 0.8
    },
    {
      "do": "describe",
      "stage": "4-shadow-folded",
      "note": "the Shadow folded, so the list is two headings and the Border's settings"
    },
    {
      "do": "expect",
      "control": "Twist",
      "in": "Shadow",
      "reads": "Shadow, shut"
    },
    {
      "do": "press",
      "control": "Twist",
      "in": "Shadow"
    },
    {
      "do": "wait",
      "seconds": 1
    },
    {
      "do": "describe",
      "stage": "5-shadow-open",
      "note": "the Shadow opened at the foot of the list. Its settings used to land below the bottom of the panel with nothing scrolling to them, and then in the top half of a list keeping room for the Border above it; now the panel keeps the room for the Shadow and brings all of it on screen"
    },
    {
      "do": "expect",
      "control": "Twist",
      "in": "Shadow",
      "reads": "Shadow, open"
    },
    {
      "do": "expectInView",
      "field": "Shadow",
      "whole": true
    },
    {
      "do": "expectSectionFits",
      "section": "Effects"
    },
    {
      "do": "panel",
      "stage": "5-shadow-open"
    },
    {
      "do": "snapshot",
      "name": "5-shadow-open"
    },
    {
      "comment": "Back up the list to reach the Border, which the reveal has just carried off the top of it.",
      "do": "scrollPanel",
      "row": "Shadow",
      "by": 120
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "press",
      "control": "Twist",
      "in": "Border"
    },
    {
      "do": "wait",
      "seconds": 0.8
    },
    {
      "do": "press",
      "control": "Twist",
      "in": "Shadow"
    },
    {
      "do": "wait",
      "seconds": 0.6
    },
    {
      "do": "press",
      "control": "Twist",
      "in": "Shadow"
    },
    {
      "do": "wait",
      "seconds": 1
    },
    {
      "do": "describe",
      "stage": "6-dock-scrolled",
      "note": "the Shadow opened with the Border folded away. The Effects list now wants more than the panel is tall, so BOTH move: the dock scrolls up to the end of the list, and the list scrolls on to the Shadow, which is nearly all there"
    },
    {
      "do": "expect",
      "control": "Twist",
      "in": "Shadow",
      "reads": "Shadow, open"
    },
    {
      "do": "expectInView",
      "field": "Shadow",
      "whole": true
    },
    {
      "do": "snapshot",
      "name": "6-dock-scrolled"
    }
  ]
}
