{
  "out": "/tmp/photonz-playtest/trim-save-send-walk",
  "setup": { "forget": ["all"] },
  "steps": [
    { "do": "action", "action": "openSampleRecording" },
    { "do": "action", "action": "videoPause" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expectRecording", "pieces": 1, "seconds": 8 },

    { "do": "action", "action": "videoBeginTrim" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "action", "action": "videoTrimStart" },
    { "do": "action", "action": "videoTrimEnd" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "action", "action": "videoTrimDone" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "expectRecording", "seconds": 4 },
    { "do": "describe", "stage": "1-trimmed", "note": "an eight second recording trimmed to the middle four, with Trim and Return, on the clip's bar in the timeline" },
    { "do": "snapshot", "name": "1-trimmed" },

    { "do": "action", "action": "save" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expectEdited", "edited": false },
    { "do": "describe", "stage": "2-saved", "note": "Command S wrote a project holding the trim; the recording on disk is untouched, which the save step checks byte for byte" },

    { "do": "action", "action": "exportVideoAsTheSheetDoes" },
    { "do": "describe", "stage": "3-sent", "note": "and out it goes: Export writes a video of what plays, the four seconds between the handles" },

    { "do": "action", "action": "videoRevertToOriginal" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expectRecording", "pieces": 1, "seconds": 8 },
    { "do": "expectEdited", "edited": true },
    { "do": "describe", "stage": "4-back-to-the-whole-clip", "note": "THE TEST: Video, Revert to Original throws every edit away and puts the whole eight seconds back, as it opened" },
    { "do": "snapshot", "name": "4-whole-clip-back" },

    { "do": "action", "action": "undo" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expectRecording", "seconds": 4 },
    { "do": "describe", "stage": "5-revert-is-one-undo", "note": "and one Command Z brings the trim back, because a revert is an ordinary step in the history" },
    { "do": "snapshot", "name": "5-revert-undone" }
  ]
}
