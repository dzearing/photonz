{
  "out": "/tmp/photonz-playtest/style-on-a-copy",
  "seed": "A text style carried over the words of a COPY of a component. The words are plainly text, and a copy is now allowed to wear a type of its own for them, so the drop lands on THAT copy and nothing else: the copy beside it and the original do not move. This walk reads back the sentence over a copy's label, lets the style go, checks the other copy stayed put, and then finds the row on the copy's panel that says its type is its own and puts it back.",
  "setup": {
    "forget": ["text", "panel", "shapes", "color", "tools"]
  },
  "steps": [
    { "do": "blank", "canvasWidth": 900, "canvasHeight": 600, "width": 1320, "height": 1000 },
    { "do": "wait", "seconds": 1 },

    { "do": "action", "action": "showComponentShelf" },
    { "do": "wait", "seconds": 1.2 },
    { "do": "action", "action": "pickFirstComponent" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "action", "action": "insertPickedComponent" },
    { "do": "wait", "seconds": 1 },
    { "do": "describe", "stage": "1-original", "note": "the starter Button, as the ORIGINAL, in the middle of the canvas" },

    { "do": "action", "action": "pickFirstComponent" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "dropComponent", "at": [650, 470] },
    { "do": "wait", "seconds": 0.8 },
    { "do": "action", "action": "pickFirstComponent" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "dropComponent", "at": [250, 470] },
    { "do": "wait", "seconds": 1 },
    { "do": "describe", "stage": "2-two-copies", "note": "two copies of the Button, at (650, 470) and (250, 470), both following the original. The first one's words are what this walk aims at; the second one is the control." },
    { "do": "render", "name": "2-two-copies" },

    { "do": "tool", "tool": "text" },
    { "do": "click", "at": [140, 130] },
    { "do": "type", "text": "Sign in" },
    { "do": "key", "key": "return", "modifiers": ["command"] },
    { "do": "wait", "seconds": 0.6 },

    { "do": "tool", "tool": "select" },
    { "do": "click", "at": [180, 145] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "panelMenu", "menu": "Font", "choose": "Georgia" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "panelMenu", "menu": "Size", "choose": "32 px" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "panelMenu", "menu": "Weight", "choose": "Bold" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "panelMenu", "menu": "Style", "choose": "Save as Style" },
    { "do": "wait", "seconds": 0.9 },
    { "do": "type", "text": "Heading" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 1 },
    { "do": "describe", "stage": "3-saved", "note": "Heading saved off the one heading, and saving put the Library on its Styles shelf, where the Ag tile is the handle everything below pulls on." },

    { "do": "click", "at": [840, 90] },
    { "do": "wait", "seconds": 0.6 },

    {
      "do": "dragTile", "tile": "Heading", "to": [650, 470],
      "expect": "takes", "says": "on this copy only",
      "hold": "4-over-a-copys-words"
    },
    { "do": "wait", "seconds": 1.2 },
    { "do": "describe", "stage": "4-landed", "note": "THE TEST: the pointer was on words anybody can read, the sentence said it would set them on this copy only, and it did. The copy at (250, 470) and the original at (450, 300) should both be untouched." },
    { "do": "snapshot", "name": "4-one-copy-in-heading" },
    { "do": "render", "name": "4-one-copy-in-heading" },

    { "do": "click", "at": [650, 470] },
    { "do": "wait", "seconds": 0.8 },
    { "do": "panel", "stage": "5-its-own-type" },
    { "do": "describe", "stage": "5-its-own-type", "note": "the copy picked: the Component section should carry an \"Its own type\" row reading \"Label in Heading\", with the way back beside it." },
    { "do": "snapshot", "name": "5-its-own-type" },

    { "do": "press", "control": "Revert Type" },
    { "do": "wait", "seconds": 1 },
    { "do": "describe", "stage": "6-back", "note": "one press and the words follow the original again, so a copy that has drifted is both visible and reversible." },
    { "do": "render", "name": "6-back-to-the-original" },

    {
      "do": "dragTile", "tile": "Heading", "to": [450, 300],
      "expect": "takes", "says": "Sets this text in Heading",
      "hold": "7-over-the-originals-words"
    },
    { "do": "wait", "seconds": 1.2 },
    { "do": "describe", "stage": "7-on-the-original", "note": "the other move, still there: the same style let go on the ORIGINAL's words lands, and every copy follows it." },
    { "do": "snapshot", "name": "7-every-copy-follows" },
    { "do": "render", "name": "7-every-copy-follows" }
  ]
}
