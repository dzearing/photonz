    },
    {
      "do": "wait",
      "seconds": 0.6
    },
    {
      "do": "expect",
      "control": "Agent Stop",
      "present": false
    },
    {
      "do": "expect",
      "control": "Agent Change 1",
      "present": false
    },
    {
      "do": "expectLayers",
      "count": 1
    },
    {
      "do": "describe",
      "stage": "2-stopped",
