    },
    {
      "do": "snapshot",
      "name": "1-live"
    },
    {
      "do": "press",
      "control": "Agent Stop"
    },
    {
      "do": "wait",
      "seconds": 0.6
    },
    {
      "do": "expect",
      "control": "Agent Stop",
      "present": false
    },
    {
      "do": "expect",
      "control": "Agent Working",
      "present": false
    },
    {
      "do": "expect",
      "field": "Agent State",
      "present": false
    },
    {
      "do": "waitFor",
