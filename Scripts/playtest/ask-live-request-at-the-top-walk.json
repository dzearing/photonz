      "height": 840
    },
    {
      "do": "wait",
      "seconds": 1
    },
    {
      "do": "press",
      "control": "Ask"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "type",
      "text": "add a blue rectangle"
    },
    {
      "do": "wait",
      "seconds": 0.3
    },
    {
      "do": "press",
      "control": "Ask Send"
    },
    {
      "do": "waitFor",
      "condition": "askPhase",
      "value": "planning",
      "timeout": 30
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "expect",
      "control": "Ask Dock",
      "present": false
    },
    {
      "do": "expect",
      "control": "Agent Working",
      "reads": "add a blue rectangle"
    },
    {
      "do": "expect",
      "control": "Agent Stage",
      "present": true
    },
    {
      "do": "expect",
      "control": "Agent Stop",
      "present": true
    },
    {
      "do": "expect",
      "control": "Agent Request",
      "present": true
    },
    {
      "do": "describe",
