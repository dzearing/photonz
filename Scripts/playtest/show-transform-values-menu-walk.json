    { "do": "wait", "seconds": 2.0 },
    { "do": "action", "action": "videoPause" },
    { "do": "action", "action": "videoSeekStart" },
    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "tool", "tool": "text" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "click", "at": [520, 300] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "type", "text": "Ship it faster." },
    { "do": "key", "key": "return", "modifiers": ["command"] },
    { "do": "wait", "seconds": 1.0 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectTransformBar", "present": false },
    { "do": "menus", "stage": "1-layer-menu", "menu": "Layer", "choose": "Layer > Show Transform Values" },
