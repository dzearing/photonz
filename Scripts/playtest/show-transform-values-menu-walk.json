{
  "out": "/tmp/photonz-playtest/show-transform-values-menu-walk",
  "seed": "Layer, Show Transform Values opens the transform values popover over the tool bar, and F8 opens and closes it, at Next defaults with no flag changed. A title is typed over a recording and picked: nothing open. The Layer menu's row opens it with X, Y, W, H and Rotation, nothing outlined; Escape closes it; F8 opens it again, as Photoshop's F8 opens its Info panel. The menu bar is only live with the app in front, so this walk takes the front.",
  "setup": {
    "forget": [
      "all"
    ],
    "timelineOpen": true,
    "front": true
  },
  "steps": [
