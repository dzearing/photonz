{
  "out": "/tmp/photonz-playtest/drag-path-points-on-the-grid-walk",
  "setup": {
    "forget": ["grid", "tools", "panel"]
  },
  "steps": [
    { "do": "appearance", "value": "light" },
    { "do": "blank", "canvasWidth": 900, "canvasHeight": 700, "width": 1240, "height": 900 },
    { "do": "wait", "seconds": 0.6 },

    { "do": "action", "action": "selectCanvas" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "press", "control": "Show grid" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "describe", "stage": "grid-on-default", "note": "default grid at 100%: the canvas draws 32s, and Snap to grid is on by default" },

    { "do": "key", "key": "p" },
    { "do": "waitFor", "condition": "tool", "value": "pen" },
    { "do": "click", "at": [131, 67] },
    { "do": "wait", "seconds": 0.2 },
    { "do": "click", "at": [355, 71] },
    { "do": "wait", "seconds": 0.2 },
    { "do": "click", "at": [358, 290] },
    { "do": "wait", "seconds": 0.2 },
    { "do": "click", "at": [129, 293] },
    { "do": "wait", "seconds": 0.2 },
    { "do": "click", "at": [139, 74] },
    { "do": "wait", "seconds": 0.8 },
    { "do": "waitFor", "condition": "tool", "value": "select", "timeout": 2 },
    { "do": "expectPath", "anchors": 4, "closed": true, "curves": 0 },
    { "do": "expectPath", "anchor": 2, "near": [352, 288], "within": 0.5 },
    { "do": "describe", "stage": "square-on-the-grid", "note": "a Pen square whose four corners landed on whole 32 steps, picked, with its points showing" },
    { "do": "snapshot", "name": "drag-grid-1-square" },

    { "do": "drag", "from": [352, 288], "to": [397, 341], "steps": 12, "hold": "drag-grid-2-held" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectPath", "anchors": 4, "closed": true, "anchor": 2, "near": [384, 352], "within": 0.5 },
    { "do": "describe", "stage": "first-drag-on-the-grid", "note": "the corner dragged from 352,288 to a rough 397,341 landed on the crossing at 384,352: whole 32 steps" },

    { "do": "drag", "from": [128, 64], "to": [101, 40], "steps": 12 },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectPath", "anchors": 4, "closed": true, "anchor": 0, "near": [96, 32], "within": 0.5 },
    { "do": "describe", "stage": "second-drag-on-the-grid", "note": "a second corner dragged from 128,64 to a rough 101,40 landed on 96,32" },
    { "do": "snapshot", "name": "drag-grid-3-two-corners" },

    { "do": "click", "at": [128, 288] },
    { "do": "wait", "seconds": 0.3 },
    { "do": "click", "at": [384, 352], "modifiers": ["shift"] },
    { "do": "wait", "seconds": 0.3 },
    { "do": "drag", "from": [384, 352], "to": [421, 309], "steps": 12 },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectPath", "anchors": 4, "closed": true, "anchor": 2, "near": [416, 320], "within": 0.5 },
    { "do": "expectPath", "anchor": 3, "near": [160, 256], "within": 0.5 },
    { "do": "describe", "stage": "two-picked-points-together", "note": "two points picked and the lower right one dragged to a rough 421,309: it landed on 416,320 and the other moved the same 32 right and 32 up, to 160,256" },

    { "do": "click", "at": [352, 64] },
    { "do": "wait", "seconds": 0.3 },
    { "do": "drag", "from": [352, 64], "to": [371, 85], "steps": 12, "modifiers": ["command"] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectPath", "anchors": 4, "closed": true, "anchor": 1, "near": [371, 85], "within": 0.5 },
    { "do": "describe", "stage": "command-drags-freely", "note": "Command held through the drag: the corner went exactly under the pointer, off every line" },
    { "do": "action", "action": "undo" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expectPath", "anchors": 4, "anchor": 1, "near": [352, 64], "within": 0.5 },

    { "do": "drag", "from": [352, 64], "to": [347, 62], "steps": 6 },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expectPath", "anchors": 4, "anchor": 1, "near": [352, 64], "within": 0.5 },
    { "do": "action", "action": "undo" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expectPath", "anchors": 4, "anchor": 1, "near": [352, 64], "within": 0.5 },
    { "do": "expectPath", "anchor": 2, "near": [384, 352], "within": 0.5 },
    { "do": "expectPath", "anchor": 3, "near": [128, 288], "within": 0.5 },
    { "do": "describe", "stage": "a-drag-that-snaps-home-is-no-step", "note": "a short drag the grid pulls straight back home changes nothing, so it leaves no undo step: the undo after it took back the two-point move instead" },

    { "do": "action", "action": "selectCanvas" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "press", "control": "Snap to grid" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "click", "at": [250, 200] },
    { "do": "wait", "seconds": 0.4 },
    { "do": "expectPicked", "layers": ["Path"] },
    { "do": "drag", "from": [96, 32], "to": [117, 51], "steps": 12 },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectPath", "anchors": 4, "anchor": 0, "near": [117, 51], "within": 0.5 },
    { "do": "describe", "stage": "snap-off-drags-freely", "note": "Snap to grid off with the lines still drawn: the corner went exactly where the pointer took it" },
    { "do": "snapshot", "name": "drag-grid-4-snap-off" }
  ]
}
