{
  "out": "/tmp/photonz-playtest/screen-columns-walk",
  "setup": {
    "forget": ["grid", "shapes", "tools", "panel"]
  },
  "steps": [
    { "do": "appearance", "value": "light" },
    { "do": "blank", "canvasWidth": 1600, "canvasHeight": 1100, "width": 1240, "height": 900 },
    { "do": "wait", "seconds": 0.6 },

    { "do": "tool", "tool": "frame" },
    { "do": "drag", "from": [200, 180], "to": [1000, 780] },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "1-screen-drawn", "note": "a screen drawn and selected; the panel should now carry a Columns section under Frame, and columns should still be OFF" },
    { "do": "panel", "stage": "columns-section-present" },
    { "do": "snapshot", "name": "columns-1-screen" },

    { "do": "menus", "stage": "layer-menu", "menu": "Layer" },
    { "do": "describe", "stage": "2-menu-row", "note": "the Layer menu should carry Show Columns, unticked, right under Frame Selection" },

    { "do": "press", "control": "Show columns" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "3-columns-on", "note": "a wide screen, so expect twelve columns with a 24 gutter and a 32 margin, drawn, pulling to twelve columns" },
    { "do": "panel", "stage": "columns-numbers" },
    { "do": "snapshot", "name": "columns-2-on" },
    { "do": "render", "name": "columns-2-on-render" },

    { "do": "menus", "stage": "layer-menu-ticked", "menu": "Layer" },
    { "do": "describe", "stage": "4-menu-ticked", "note": "the same row should now be ticked; the name must not have flipped to Hide Columns" },

    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [300, 300], "to": [500, 400] },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "5-box-drawn", "note": "a box drawn on the screen, over the columns; the bands should still read through it" },
    { "do": "snapshot", "name": "columns-3-box" },

    { "do": "click", "at": [400, 350] },
    { "do": "wait", "seconds": 0.4 },
    { "do": "drag", "from": [400, 350], "to": [447, 396], "steps": 16, "wobble": 3, "hold": "columns-4-caught" },
    { "do": "describe", "stage": "6-drag-catches-a-column", "note": "dragged with a shaking hand across the screen: expect the box's left edge on a column edge, and a short yellow line down the screen saying which one" },
    { "do": "snapshot", "name": "columns-5-after-drag" },
    { "do": "render", "name": "columns-5-after-drag-render" },

    { "do": "drag", "from": [447, 396], "to": [458, 403], "steps": 8, "modifiers": ["command"] },
    { "do": "describe", "stage": "7-command-drags-free", "note": "Command held: expect the box moved by exactly 11 and 7, off every column edge, and no line at all" },
    { "do": "snapshot", "name": "columns-6-command-free" },

    { "do": "click", "at": [700, 700] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "8-screen-picked-again", "note": "clicking the empty room in the screen picks the screen, so its Columns section is back" },
    { "do": "focus", "field": "Columns" },
    { "do": "type", "text": "6" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "9-six-columns", "note": "six typed: expect six wider bands, and the footnote to say what one column comes out as" },
    { "do": "panel", "stage": "columns-six" },
    { "do": "snapshot", "name": "columns-7-six" },

    { "do": "focus", "field": "Margin" },
    { "do": "type", "text": "80" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "10-fat-margin", "note": "an 80 margin: the bands should pull in from both edges by the same amount" },
    { "do": "snapshot", "name": "columns-8-margin" },

    { "do": "action", "action": "zoomIn" },
    { "do": "action", "action": "zoomIn" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "11-zoomed-in", "note": "the bands should still be exactly on the columns, wider on screen" },
    { "do": "snapshot", "name": "columns-9-zoomed-in" },
    { "do": "action", "action": "zoomToFit" },
    { "do": "action", "action": "zoomOut" },
    { "do": "action", "action": "zoomOut" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "12-zoomed-out", "note": "and still there small" },
    { "do": "snapshot", "name": "columns-10-zoomed-out" },
    { "do": "action", "action": "zoomToFit" },
    { "do": "wait", "seconds": 0.5 },

    { "do": "appearance", "value": "dark" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "13-dark", "note": "the bands have to read on a dark surround too" },
    { "do": "snapshot", "name": "columns-11-dark" },
    { "do": "appearance", "value": "light" },
    { "do": "wait", "seconds": 0.6 },

    { "do": "action", "action": "selectCanvas" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "press", "control": "Show grid" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "14-both-at-once", "note": "the canvas grid AND the screen's columns on together: they must read as two different things, fine cool lines against soft warm bands" },
    { "do": "snapshot", "name": "columns-12-both" },
    { "do": "press", "control": "Show grid" },
    { "do": "wait", "seconds": 0.5 },

    { "do": "click", "at": [700, 700] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "press", "control": "Show columns" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "15-columns-off", "note": "switched off: expect nothing drawn and nothing to pull to, with the six and the 80 still remembered" },
    { "do": "snapshot", "name": "columns-13-off" },
    { "do": "render", "name": "columns-13-off-render" },

    { "do": "click", "at": [400, 400] },
    { "do": "wait", "seconds": 0.4 },
    { "do": "drag", "from": [400, 400], "to": [437, 411], "steps": 8 },
    { "do": "describe", "stage": "16-nothing-pulls-when-off", "note": "with the columns off, expect the box moved by exactly 37 and 11, and no line" },

    { "do": "click", "at": [700, 700] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "press", "control": "Show columns" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "17-back-on-with-its-numbers", "note": "switched back on: expect six columns and an 80 margin again, not twelve and 32" },
    { "do": "panel", "stage": "columns-remembered" },
    { "do": "snapshot", "name": "columns-14-remembered" }
  ]
}
