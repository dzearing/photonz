{
  "out": "/tmp/photonz-playtest/turn-into-a-path",
  "seed": "A rectangle is a fixed thing: you can resize it but you cannot move one corner. This walk rounds a box, turns it into a path from its own row menu, checks the picture did not move, then pulls one of the points the rounding made and puts it all back with two undos. It ends on an ellipse, because a circle turning into a lumpy approximation is the other way this can go wrong.",
  "setup": { "forget": ["shapes", "color", "panel", "tools"] },
  "steps": [
    { "do": "blank", "canvasWidth": 900, "canvasHeight": 600, "width": 1280, "height": 900 },
    { "do": "wait", "seconds": 1 },

    { "do": "key", "key": "r" },
    { "do": "drag", "from": [300, 200], "to": [620, 420] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "press", "control": "Twist", "in": "Corner Radius" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "focus", "field": "Top Left" },
    { "do": "type", "text": "50" },
    { "do": "key", "key": "return" },
    { "do": "focus", "field": "Top Right" },
    { "do": "type", "text": "50" },
    { "do": "key", "key": "return" },
    { "do": "focus", "field": "Bottom Right" },
    { "do": "type", "text": "50" },
    { "do": "key", "key": "return" },
    { "do": "focus", "field": "Bottom Left" },
    { "do": "type", "text": "50" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "key", "key": "escape" },
    { "do": "waitFor", "condition": "tool", "value": "select" },
    { "do": "click", "at": [460, 310] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expectPicked", "layers": ["Rectangle"] },
    { "do": "describe", "stage": "1-a-rounded-rectangle", "note": "a rectangle with its corners rounded. It is still a rectangle: the panel has a Corner Radius row and the canvas has eight square resize handles, no points" },
    { "do": "panel", "stage": "1-a-rounded-rectangle" },
    { "do": "render", "name": "doc-1-rounded-rectangle" },
    { "do": "snapshot", "name": "1-rounded-rectangle" },

    { "do": "menus", "stage": "2-the-layer-menu-offers-it", "menu": "Layer" },
    { "do": "rightClick", "on": "Rectangle", "shot": "2-row-menu" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "describe", "stage": "2-the-row-menu-offers-it", "note": "the layer row menu carries a row called 'Turn Into Path…', above 'Turn Into Picture…'" },

    { "do": "rightClick", "on": "Rectangle", "choose": "Turn Into Path…" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "snapshot", "name": "3-question" },
    { "do": "describe", "stage": "3-it-asks-first", "note": "the sheet asks 'Turn “Rectangle” into a path?' and says the Corner Radius control goes. Nothing has changed yet" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 1.0 },

    { "do": "expectPath", "anchors": 8, "closed": true, "curves": 4 },
    { "do": "describe", "stage": "4-turned", "note": "THE POINT: the picture is the same rounded box it was, and the layer is now a path of eight points, four runs of it curved. Compare doc-1-rounded-rectangle with doc-4-turned. The panel has lost its Corner Radius row, because a path has points rather than corners, and the canvas shows those points instead of resize squares" },
    { "do": "panel", "stage": "4-turned" },
    { "do": "render", "name": "doc-4-turned" },
    { "do": "snapshot", "name": "4-turned" },

    { "do": "expectPath", "anchors": 8, "closed": true, "anchor": 7, "near": [300, 250], "within": 2 },
    { "do": "drag", "from": [300, 250], "to": [180, 250], "steps": 12 },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expectPath", "anchors": 8, "closed": true, "anchor": 7, "near": [180, 250], "within": 8 },
    { "do": "describe", "stage": "5-a-point-pulled", "note": "THE OTHER POINT: the point where the left edge meets the top left curve was picked up and pulled out, and the curve came with it. A rectangle could never have done this. Position and Size must show the box grown to the left, not the whole shape slid" },
    { "do": "render", "name": "doc-5-point-pulled" },
    { "do": "snapshot", "name": "5-point-pulled" },

    { "do": "action", "action": "undo" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectPath", "anchors": 8, "closed": true },
    { "do": "action", "action": "undo" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "6-two-undos-put-the-rectangle-back", "note": "one undo puts the point back, a second takes the path back to being a real rectangle with its Corner Radius row: turning is ONE step, not eight" },
    { "do": "panel", "stage": "6-rectangle-back" },
    { "do": "render", "name": "doc-6-rectangle-back" },

    { "do": "key", "key": "escape" },
    { "do": "key", "key": "o" },
    { "do": "drag", "from": [660, 220], "to": [840, 400] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "key", "key": "escape" },
    { "do": "waitFor", "condition": "tool", "value": "select" },
    { "do": "click", "at": [750, 310] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "render", "name": "doc-7-circle-before" },
    { "do": "rightClick", "on": "Ellipse", "choose": "Turn Into Path…" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "expectPath", "anchors": 4, "closed": true, "curves": 4, "smooth": 4 },
    { "do": "describe", "stage": "7-a-circle-stays-a-circle", "note": "the circle became four smooth points and is still a circle, not a lumpy approximation. Compare doc-7-circle-before with doc-7-circle-after" },
    { "do": "render", "name": "doc-7-circle-after" },
    { "do": "snapshot", "name": "7-circle-after" },

    { "do": "rightClick", "on": "Ellipse", "shot": "8-already-a-path" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "describe", "stage": "8-it-is-not-offered-twice", "note": "the same row menu on the layer that is already a path: 'Turn Into Path…' is gone, because there is nothing left to turn" }
  ]
}
