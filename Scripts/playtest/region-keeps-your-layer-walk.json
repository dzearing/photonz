{
  "out": "/tmp/photonz-playtest/region-keeps-your-layer",
  "seed": "Picking a layer and then drawing a box round part of it used to deselect it the moment the button went down, so the obvious next keystroke, delete to clear those pixels, had no layer to act on. A band that catches nothing now says WHERE and not WHAT: the pick survives, the band becomes a pixel region on it, and delete, the bucket and copy all act on that one layer. A band that DOES catch layers still picks them up, which is the other half of the walk.",
  "setup": { "forget": ["shapes", "color", "tools"] },
  "steps": [
    { "do": "blank", "canvasWidth": 1200, "canvasHeight": 800, "width": 1280, "height": 900 },
    { "do": "wait", "seconds": 1.0 },
    { "do": "dropImage", "file": "fixtures/Photonz drop probe.png", "at": [300, 250] },
    { "do": "wait", "seconds": 1.0 },
    { "do": "dropImage", "file": "fixtures/Photonz drop probe.png", "at": [900, 250] },
    { "do": "wait", "seconds": 1.0 },
    { "do": "action", "action": "showInspector" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "panel", "stage": "0-two-pictures" },
    { "do": "render", "name": "region-0-start" },

    { "do": "tool", "tool": "select" },
    { "do": "click", "at": [300, 250] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "1-picked-left", "note": "the left picture is picked, pointer in hand" },

    { "do": "drag", "from": [600, 500], "to": [200, 250] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "2-band-caught-nothing", "note": "THE TEST: a band started on bare canvas and drawn back across the left picture's corner. It encloses neither picture, so the left picture must still be picked and the band must be a pixel region" },
    { "do": "snapshot", "name": "region-2-band" },

    { "do": "clearClipboard" },
    { "do": "action", "action": "copy" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "action", "action": "pasteLayer" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "describe", "stage": "2b-copy-follows-the-pick", "note": "THE TEST: copy over the band hands back the PICKED picture's pixels inside it, 260x100, not the 400x250 of everything flattened together" },
    { "do": "action", "action": "undo" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "click", "at": [300, 250] },
    { "do": "wait", "seconds": 0.4 },
    { "do": "drag", "from": [600, 500], "to": [200, 250] },
    { "do": "wait", "seconds": 0.6 },

    { "do": "key", "key": "delete" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "describe", "stage": "3-deleted", "note": "THE TEST: delete cleared the band's pixels out of the left picture and left the right picture alone" },
    { "do": "render", "name": "region-3-deleted" },
    { "do": "snapshot", "name": "region-3-deleted-window" },

    { "do": "action", "action": "undo" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "4-undone", "note": "THE TEST: one undo puts the pixels back" },
    { "do": "render", "name": "region-4-undone" },

    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "click", "at": [300, 250] },
    { "do": "wait", "seconds": 0.4 },
    { "do": "drag", "from": [80, 80], "to": [1150, 500] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "5-band-caught-both", "note": "THE CONTROL: a band round BOTH pictures still picks them both up, which is what the pointer's band is for" },
    { "do": "key", "key": "delete" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "5b-sweep-then-delete", "note": "THE CONTROL: delete after a band that CAUGHT layers still removes them, which is the sweep-a-mess-and-clear-it gesture" },
    { "do": "action", "action": "undo" },
    { "do": "wait", "seconds": 0.8 },

    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "click", "at": [300, 250] },
    { "do": "wait", "seconds": 0.4 },
    { "do": "drag", "from": [600, 500], "to": [200, 250] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "tool", "tool": "fill" },
    { "do": "click", "at": [520, 420] },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "6-bucket-follows-the-pick", "note": "THE TEST: the bucket clicked inside the band but over bare canvas paints the band on the PICKED picture, not the layer under the pointer" },
    { "do": "render", "name": "region-6-bucket" },

    { "do": "action", "action": "undo" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "tool", "tool": "select" },
    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "click", "at": [600, 700] },
    { "do": "wait", "seconds": 0.4 },
    { "do": "tool", "tool": "rectSelect" },
    { "do": "drag", "from": [780, 200], "to": [1000, 320] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "7-nothing-picked", "note": "a marquee with nothing picked: delete has only the locked Background to clear to the background colour" },
    { "do": "key", "key": "delete" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "8-delete-with-no-pick", "note": "THE TEST: with nothing picked, delete leaves every picture alone" },
    { "do": "render", "name": "region-8-no-pick" },

    { "do": "selectRow", "row": "Photonz drop probe 2" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "9-marquee-tool", "note": "THE TEST: the marquee tool's own region, with a layer picked out of the list" },
    { "do": "key", "key": "delete" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "10-marquee-tool-delete", "note": "THE TEST: the M tool's marquee clears the picked picture and nothing else" },
    { "do": "render", "name": "region-10-marquee-delete" }
  ]
}
