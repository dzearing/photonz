{
  "out": "/tmp/photonz-playtest/stretched-words",
  "steps": [
    { "do": "blank", "canvasWidth": 1440, "canvasHeight": 1024, "width": 1240, "height": 900 },
    { "do": "wait", "seconds": 1 },

    { "do": "tool", "tool": "frame" },
    { "do": "drag", "from": [200, 180], "to": [820, 520] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "action", "action": "paintScreenSurface" },
    { "do": "wait", "seconds": 0.5 },

    { "do": "tool", "tool": "text" },
    { "do": "click", "at": [230, 220] },
    { "do": "type", "text": "Settings" },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "click", "at": [260, 232] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "1-typed",
      "note": "a word typed near the left of a screen, picked: the Text section now carries an Align row, reading Left across and Top down, and the word's box hugs the word" },
    { "do": "snapshot", "name": "words-1-typed" },
    { "do": "render", "name": "words-1-typed-doc" },

    { "do": "action", "action": "stretchSelectionAcross" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "2-stretched",
      "note": "the word told to stretch across the screen: Layout reads Stretch, its caption says what that means for words, and Align has flipped to Center. Like every other Layout rule, nothing on the canvas moves until the screen is next resized" },
    { "do": "snapshot", "name": "words-2-stretched" },
    { "do": "render", "name": "words-2-stretched-doc" },

    { "do": "click", "at": [600, 450] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "drag", "from": [820, 520], "to": [1080, 680], "steps": 12 },
    { "do": "wait", "seconds": 0.9 },
    { "do": "describe", "stage": "3-wider",
      "note": "the screen dragged wider: the word's box stretched with it, keeping the gap it had on each side, and the word rides the middle of that box instead of staying pinned to its left edge. THIS is what stretching a label does that it did not do before" },
    { "do": "snapshot", "name": "words-3-wider" },
    { "do": "render", "name": "words-3-wider-doc" },

    { "do": "action", "action": "stepIntoSelection" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "action", "action": "alignWordsLeft" },
    { "do": "wait", "seconds": 0.7 },
    { "do": "describe", "stage": "4-back-to-left",
      "note": "Align set back to Left by hand: the box keeps its full width and the word returns to the left edge, so what stretching did to the words is a starting point, not a rule" },
    { "do": "snapshot", "name": "words-4-back-to-left" },
    { "do": "render", "name": "words-4-back-to-left-doc" },

    { "do": "action", "action": "showComponentShelf" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "action", "action": "pickFirstComponent" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "action", "action": "insertPickedComponent" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "action", "action": "hideLibrary" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "action", "action": "stepIntoSelection" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "action", "action": "pickNextSibling" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "5-label",
      "note": "the word inside a Library button, picked: Align reads Left, because a label centred by the button's own rule has never needed a place of its own" },
    { "do": "snapshot", "name": "words-5-label" },
    { "do": "render", "name": "words-5-label-doc" },

    { "do": "action", "action": "stretchSelectionAcross" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "6-label-stretched",
      "note": "that label told to stretch: Align flips to Center, so the next time the button is dragged wider the word rides the middle of a box that fills it" },
    { "do": "snapshot", "name": "words-6-label-stretched" },
    { "do": "render", "name": "words-6-label-stretched-doc" }
  ]
}
