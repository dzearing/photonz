{
  "out": "/tmp/photonz-playtest/redline-walk",
  "steps": [
    { "do": "open", "file": "../../Tests/PhotonzRenderTests/Fixtures/settings-pane-2x.png", "width": 1280, "height": 840 },
    { "do": "wait", "seconds": 1 },
    { "do": "describe", "stage": "1-open", "note": "editor open, nothing touched yet" },
    { "do": "snapshot", "name": "1-open" },

    { "do": "key", "key": "i" },
    { "do": "waitFor", "condition": "tool", "value": "measure" },
    { "do": "waitFor", "condition": "edgeMap", "timeout": 15 },
    { "do": "describe", "stage": "2-measure", "note": "I picked up Measure in whichever mode the probe remembered; the hint pill should be showing" },
    { "do": "snapshot", "name": "2-measure-hint" },
    { "do": "measureMode", "mode": "distance" },

    { "do": "click", "at": [236, 696] },
    { "do": "move", "at": [476, 696] },
    { "do": "click", "at": [476, 696] },
    { "do": "describe", "stage": "3-distance", "note": "two clicks placed the feet; the line should follow the pointer" },
    { "do": "snapshot", "name": "3-distance-two-clicks" },
    { "do": "move", "at": [476, 656] },
    { "do": "click", "at": [476, 656] },
    { "do": "describe", "stage": "3-distance", "note": "third click placed the number" },
    { "do": "snapshot", "name": "3-distance-placed" },

    { "do": "measureMode", "mode": "size" },
    { "do": "move", "at": [356, 786] },
    { "do": "wait", "seconds": 0.4 },
    { "do": "snapshot", "name": "4-size-hover" },
    { "do": "click", "at": [356, 786] },
    { "do": "wait", "seconds": 0.4 },
    { "do": "describe", "stage": "4-size", "note": "Save Changes measured" },
    { "do": "snapshot", "name": "4-size-landed" },

    { "do": "measureMode", "mode": "gap" },
    { "do": "move", "at": [720, 432] },
    { "do": "wait", "seconds": 0.4 },
    { "do": "snapshot", "name": "5-gap-hover" },
    { "do": "click", "at": [720, 432] },
    { "do": "wait", "seconds": 0.4 },
    { "do": "describe", "stage": "5-gap", "note": "gap between the two cards" },
    { "do": "snapshot", "name": "5-gap-landed" },

    { "do": "measureMode", "mode": "alignment" },
    { "do": "move", "at": [96, 150] },
    { "do": "drag", "from": [96, 150], "to": [96, 700] },
    { "do": "wait", "seconds": 0.4 },
    { "do": "describe", "stage": "6-align", "note": "a guide down the left text edge" },
    { "do": "snapshot", "name": "6-align-landed" },

    { "do": "key", "key": "a" },
    { "do": "waitFor", "condition": "tool", "value": "arrow" },
    { "do": "drag", "from": [640, 880], "to": [420, 810] },
    { "do": "waitFor", "condition": "captionField", "timeout": 3 },
    { "do": "snapshot", "name": "7-arrow-field" },
    { "do": "type", "text": "Primary action" },
    { "do": "snapshot", "name": "7-arrow-typing" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "describe", "stage": "7-arrow", "note": "captioned arrow" },
    { "do": "snapshot", "name": "7-arrow-captioned" },

    { "do": "clearClipboard" },
    { "do": "key", "key": "c", "modifiers": ["command", "control"] },
    { "do": "wait", "seconds": 0.4 },
    { "do": "readClipboard", "stage": "8-spec-by-shortcut" },
    { "do": "action", "action": "copySpecList" },
    { "do": "readClipboard", "stage": "8-spec" },
    { "do": "snapshot", "name": "8-spec-copied" },

    { "do": "wait", "seconds": 2 },
    { "do": "clearClipboard" },
    { "do": "key", "key": "c", "modifiers": ["command", "shift"] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "readClipboard", "stage": "9-image-by-shortcut" },
    { "do": "action", "action": "copyImage" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "readClipboard", "stage": "9-image" },
    { "do": "snapshot", "name": "9-image-copied" },
    { "do": "render", "name": "9-final-render" }
  ]
}
