{
  "out": "/tmp/photonz-playtest/a-saved-stroke-tile-counts-its-lines",
  "seed": "The saved stroke's tile on the Library's Styles shelf counts the lines wearing it the moment each one takes it, with no other click to make the shelf redraw. On a File, New, Image, Icon picture at Next defaults, no flag set: a Pen line saved as a style reads 1 use; a second Pen line, which starts in that style, makes it 2 uses; a Line tool line given it from its Style row makes 3; an oval given a Border and then the stroke from its Border's Stroke row makes 4. The tile is read and photographed at each step. The tile used to say 1 use with three lines wearing it, because a shelf entry with new words compared equal to its old self and SwiftUI kept the old tile (2026-11-12).",
  "setup": {
    "forget": ["all"]
  },
  "steps": [
    {"do": "startFromEmpty", "row": "New image", "answer": ["Icon", "Create"], "width": 1280, "height": 900},
    {"do": "wait", "seconds": 1.2},
    {"do": "tool", "tool": "pen"},
    {"do": "wait", "seconds": 0.4},
    {"do": "click", "at": [200, 120]},
    {"do": "wait", "seconds": 0.3},
    {"do": "click", "at": [400, 120]},
    {"do": "wait", "seconds": 0.3},
    {"do": "click", "at": [400, 240]},
    {"do": "wait", "seconds": 0.3},
    {"do": "key", "key": "return"},
    {"do": "wait", "seconds": 0.5},
    {"do": "tool", "tool": "select"},
    {"do": "wait", "seconds": 0.8},
    {"do": "focus", "field": "Width"},
    {"do": "type", "text": "1.75"},
    {"do": "key", "key": "return"},
    {"do": "wait", "seconds": 0.6},
    {"do": "press", "control": "Round", "in": "Corners"},
    {"do": "wait", "seconds": 0.6},
    {"do": "press", "control": "Save as Style"},
    {"do": "wait", "seconds": 0.9},
    {"do": "key", "key": "return"},
    {"do": "wait", "seconds": 1},
    {"do": "expect", "control": "Style", "reads": "Line Style, Glyph / stroke 1.75"},
    {"do": "expect", "tile": "Glyph / stroke 1.75", "reads": "Styles, 1 use"},
    {"do": "snapshot", "name": "1-one-use"},

    {"do": "tool", "tool": "pen"},
    {"do": "wait", "seconds": 0.5},
    {"do": "click", "at": [120, 300]},
    {"do": "wait", "seconds": 0.3},
    {"do": "click", "at": [300, 300]},
    {"do": "wait", "seconds": 0.3},
    {"do": "click", "at": [300, 420]},
    {"do": "wait", "seconds": 0.3},
    {"do": "key", "key": "return"},
    {"do": "wait", "seconds": 0.5},
    {"do": "tool", "tool": "select"},
    {"do": "wait", "seconds": 0.8},
    {"do": "expect", "control": "Style", "reads": "Line Style, Glyph / stroke 1.75"},
    {"do": "expect", "tile": "Glyph / stroke 1.75", "reads": "Styles, 2 uses"},
    {"do": "snapshot", "name": "2-two-uses"},

    {"do": "tool", "tool": "line"},
    {"do": "wait", "seconds": 0.4},
    {"do": "drag", "from": [120, 470], "to": [300, 470], "steps": 8},
    {"do": "wait", "seconds": 0.6},
    {"do": "tool", "tool": "select"},
    {"do": "wait", "seconds": 0.8},
    {"do": "expect", "tile": "Glyph / stroke 1.75", "reads": "Styles, 2 uses"},
    {"do": "press", "control": "Glyph / stroke 1.75", "in": "Line Style"},
    {"do": "wait", "seconds": 0.8},
    {"do": "expect", "control": "Style", "reads": "Line Style, Glyph / stroke 1.75"},
    {"do": "expect", "tile": "Glyph / stroke 1.75", "reads": "Styles, 3 uses"},
    {"do": "snapshot", "name": "3-three-uses"},

    {"do": "tool", "tool": "ellipse"},
    {"do": "wait", "seconds": 0.4},
    {"do": "drag", "from": [380, 300], "to": [500, 420], "steps": 8},
    {"do": "wait", "seconds": 0.6},
    {"do": "tool", "tool": "select"},
    {"do": "wait", "seconds": 0.8},
    {"do": "panelMenu", "menu": "Add Effect", "choose": "Border"},
    {"do": "wait", "seconds": 0.8},
    {"do": "press", "control": "Glyph / stroke 1.75", "in": "Border Stroke"},
    {"do": "wait", "seconds": 0.8},
    {"do": "expect", "control": "Stroke", "reads": "Border, Border Stroke, Glyph / stroke 1.75"},
    {"do": "expect", "tile": "Glyph / stroke 1.75", "reads": "Styles, 4 uses"},
    {"do": "panel", "stage": "4-four-uses"},
    {"do": "snapshot", "name": "4-four-uses"}
  ]
}
