{
  "out": "/tmp/photonz-playtest/ask-draws-a-dog-walk",
  "seed": "ask-draws-a-dog-you-can-tell-is-a-dog: the user's own two requests on a blank picture at Next defaults, no flag touched",
  "clock": 420,
  "setup": { "forget": ["all"] },
  "steps": [
    { "do": "blank", "canvasWidth": 1440, "canvasHeight": 1024, "width": 1280, "height": 840 },
    { "do": "wait", "seconds": 1 },
    { "do": "expectLayers", "count": 1 },
    { "do": "press", "control": "Ask" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "type", "text": "draw a picture of a dog." },
    { "do": "wait", "seconds": 0.3 },
    { "do": "press", "control": "Ask Send" },
    { "do": "waitFor", "condition": "askPhase", "value": "ran|stopped", "timeout": 300 },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "1-dog", "note": "the dog Ask drew: one group named Dog of editable parts, over the blank picture's background" },
    { "do": "expectLayers", "count": 14, "comment": "the background, the Dog group and its 12 parts" },
    { "do": "snapshot", "name": "1-dog" },
    { "do": "shortcut", "key": "z", "modifiers": ["command"], "menuItem": "Undo" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "2-undone", "note": "one Command Z took the whole drawing back" },
    { "do": "expectLayers", "count": 1 },
    { "do": "press", "control": "Ask" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "type", "text": "create a smiley face icon" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "press", "control": "Ask Send" },
    { "do": "waitFor", "condition": "askPhase", "value": "ran|stopped", "timeout": 300 },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "3-smiley-icon", "note": "the smiley icon: the blank picture became a 512 point icon frame, the face on its keylines, eyes and smile inside it" },
    { "do": "snapshot", "name": "3-smiley-icon" }
  ]
}
