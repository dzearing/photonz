{
  "out": "/tmp/photonz-playtest/spinner-turns-about-the-artboard",
  "seed": "A spinner is an arc on a 24 unit icon, and an arc's own middle is not the middle of its circle: turned about its own box it orbits the icon instead of spinning (icon-loop-wt.html, step 3). This walk draws a shape off the middle of an icon frame, adds Rotation, and picks Artboard from the Around row (step 4): the pivot jumps to 12, 12, the middle of the icon, and the copied SVG turns about the same point. Then it drags the crosshair off and back, checking it pulls onto the icon's middle and onto the shape's own. Next defaults, no switch changed.",
  "setup": { "forget": ["all"] },
  "steps": [
    { "do": "blank", "canvasWidth": 1600, "canvasHeight": 1100, "width": 1240, "height": 900 },
    { "do": "action", "action": "newFrameDialog" },
    { "do": "wait", "seconds": 0.9 },
    { "do": "press", "control": "24", "in": "Icons" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "press", "control": "Add Frame" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "pinch", "to": 8 },
    { "do": "wait", "seconds": 0.8 },
    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [802, 541], "to": [808, 547], "steps": 8 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "click", "at": [805, 544] },
    { "do": "wait", "seconds": 0.8 },
    { "do": "panelMenu", "menu": "Add Motion", "choose": "Rotation" },
    { "do": "wait", "seconds": 1 },
    { "do": "describe", "stage": "1-orbits", "note": "a Rotation on a shape drawn in the top right of a 24 unit icon. Around reads Its centre, so it turns about its own middle and swings round the icon rather than spinning in place." },
    { "do": "expect", "control": "Around", "in": "Rotation", "reads": "Its centre" },
    { "do": "expect", "field": "Around X", "reads": "17" },
    { "do": "expect", "field": "Around Y", "reads": "6" },
    { "do": "panel", "stage": "1-orbits" },
    { "do": "snapshot", "name": "1-turns-about-its-own-middle" },
    { "do": "panelMenu", "menu": "Around", "in": "Rotation", "choose": "Artboard" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "2-artboard", "note": "THE PICTURE TO LOOK AT. Around reads Artboard and the crosshair sits on the middle of the icon, 12, 12: the shape now spins about the icon's middle instead of orbiting it." },
    { "do": "expect", "control": "Around", "in": "Rotation", "reads": "Artboard" },
    { "do": "expect", "field": "Around X", "reads": "12" },
    { "do": "expect", "field": "Around Y", "reads": "12" },
    { "do": "panel", "stage": "2-artboard" },
    { "do": "snapshot", "name": "2-turns-about-the-artboard" },
    { "do": "writeSVG", "name": "spinner-artboard" },
    { "do": "expectSVG", "contains": "type=\"rotate\"" },
    { "do": "expectSVG", "contains": " 12 12;" },
    { "do": "drag", "from": [800, 550], "to": [804.8, 544.2], "steps": 12 },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "3-back-to-its-own", "note": "the crosshair dragged from the icon's middle to a little off the shape's own middle: it pulls onto it and Around reads Its centre." },
    { "do": "expect", "control": "Around", "in": "Rotation", "reads": "Its centre" },
    { "do": "drag", "from": [805, 544], "to": [800.4, 549.7], "steps": 12 },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "4-dragged-onto-the-middle", "note": "and dragged back to a little off the icon's middle: it pulls onto it, Around reads Artboard and At reads 12, 12." },
    { "do": "expect", "control": "Around", "in": "Rotation", "reads": "Artboard" },
    { "do": "expect", "field": "Around X", "reads": "12" },
    { "do": "expect", "field": "Around Y", "reads": "12" },
    { "do": "snapshot", "name": "3-dragged-onto-the-middle" },
    { "do": "drag", "from": [800, 550], "to": [797, 553], "steps": 12 },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expect", "control": "Around", "in": "Rotation", "reads": "Custom" },
    { "do": "expect", "field": "Around X", "reads": "9" },
    { "do": "expect", "field": "Around Y", "reads": "15" }
  ]
}
