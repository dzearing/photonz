      "count": 2
    },
    {
      "do": "wait",
      "seconds": 0.9
    },
    {
      "do": "snapshot",
      "name": "text-5a-editor"
    },
    {
      "do": "type",
      "text": "Appearance"
    },
    {
      "do": "key",
      "key": "return",
      "modifiers": [
        "command"
      ]
    },
    {
      "do": "wait",
      "seconds": 1
    },
    {
      "do": "describe",
      "stage": "5-retyped",
      "note": "THE FOURTH TEST, and the whole point of the feature: the heading has been RETYPED. It reads Appearance in the same bold face, the same size and the same colour the screenshot's own heading was in, sitting exactly where that heading sat. That is changing a label rather than covering it up. Its ROW followed the words: it said General a moment ago and says Appearance now, without anyone renaming anything."
    },
    {
      "do": "expect",
      "row": "Appearance",
      "present": true
    },
    {
      "do": "expect",
      "row": "General",
      "present": false
    },
    {
      "do": "snapshot",
      "name": "text-5-retyped"
    },
    {
      "do": "render",
      "name": "text-5-retyped-doc"
    },
    {
      "do": "action",
      "action": "undo"
    },
    {
      "do": "wait",
      "seconds": 1
    },
    {
      "do": "action",
      "action": "undo"
    },
    {
      "do": "wait",
      "seconds": 1.2
    },
    {
      "do": "describe",
