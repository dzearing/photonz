    },
    {
      "do": "expect",
      "row": "General",
      "present": true
    },
    {
      "do": "selectRow",
      "row": "General"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "expect",
      "control": "Text section",
      "present": false
    },
    {
      "do": "snapshot",
      "name": "text-6-undone"
    },
    {
      "do": "action",
      "action": "redo"
    },
    {
      "do": "wait",
      "seconds": 1
    },
    {
      "do": "action",
      "action": "redo"
    },
    {
      "do": "wait",
      "seconds": 1.2
    },
    {
      "do": "expect",
      "row": "Appearance",
      "present": true
    },
    {
      "do": "selectRow",
      "row": "Appearance"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "action",
      "action": "renameSelectedLayer"
    },
    {
      "do": "wait",
      "seconds": 0.8
    },
    {
      "do": "expect",
      "row": "Renamed Layer",
      "present": true
    },
    {
      "do": "click",
      "at": [
        146,
        85
      ],
      "count": 2
    },
    {
      "do": "wait",
      "seconds": 0.9
    },
    {
      "do": "type",
      "text": "Sign in"
    },
    {
      "do": "key",
      "key": "return",
      "modifiers": [
        "command"
      ]
    },
    {
      "do": "wait",
      "seconds": 1.2
    },
    {
      "do": "describe",
      "stage": "7-a-name-somebody-typed-stays",
      "note": "THE SIXTH TEST: the heading was renamed by hand, then retyped again. The canvas says Sign in and the ROW still says the name that was typed for it. A name a person gave a layer is theirs, and the words have no say from then on."
