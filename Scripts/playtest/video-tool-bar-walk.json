{
  "out": "/tmp/photonz-playtest/video-tool-bar-walk",
  "setup": { "front": true, "forget": ["all"] },
  "steps": [
    { "do": "action", "action": "openSampleRecording" },
    { "do": "wait", "seconds": 2.0 },
    { "do": "action", "action": "videoPause" },
    { "do": "key", "key": "2", "modifiers": ["command"] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "1-opened", "note": "a recording opened at Next defaults, no flag touched, and switched to Edit (Cmd-2): the video's own tools lead the bar, Select, Blade, Title / Text, Shape and Measure, and the window has room for every other tool after them, so there is no More" },
    { "do": "toolBar", "stage": "1-opened",
      "slots": ["Select", "Blade", "Text", "Shapes", "Measure", "Selection", "Crop", "Arrow", "Highlight", "Lens", "Frame", "Pen", "Fill"],
      "more": [], "zoom": false,
      "lit": "Select", "capsules": 1 },
    { "do": "snapshot", "name": "1-the-video-tool-bar" },

    { "do": "key", "key": "g" },
    { "do": "waitFor", "condition": "tool", "value": "fill", "timeout": 2 },
    { "do": "expectNotice", "absent": true },
    { "do": "toolBar", "stage": "2-g-picks-fill", "lit": "Fill" },
    { "do": "describe", "stage": "2-g-picks-fill", "note": "G, a letter the timeline has no use for, picked up Fill, which is on the bar: it lit, and no pill says it is under More" },
    { "do": "snapshot", "name": "2-fill-by-its-key" },

    { "do": "press", "control": "Blade" },
    { "do": "wait", "seconds": 1.2 },
    { "do": "expectTimeline", "blade": true, "tool": "select", "open": true },
    { "do": "toolBar", "stage": "3-blade", "lit": "Blade" },
    { "do": "press", "control": "Blade Tutorial Sample" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectClip", "clip": "Tutorial Sample", "pieces": 2 },
    { "do": "expectTimeline", "playheadMS": 4000, "withinMS": 600, "blade": true },
    { "do": "press", "control": "Blade Tutorial Sample sound", "across": 0.25 },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectClip", "clip": "Tutorial Sample", "pieces": 3 },
    { "do": "toolBar", "stage": "3-blade", "lit": "Blade" },
    { "do": "describe", "stage": "3-blade", "note": "the tool bar's Blade is the timeline's Blade: it lit both and brought the tucked timeline up to cut on. One click in the middle of the recording cut it there and put the playhead at the click; a click a quarter of the way along its sound cut it again, picture and sound together" },
    { "do": "snapshot", "name": "3-the-blade-cuts" },

    { "do": "press", "control": "Timeline Select" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "toolBar", "stage": "4-timeline-select", "lit": "Select" },
    { "do": "key", "key": "b" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "expectTimeline", "blade": true },
    { "do": "toolBar", "stage": "4-b-from-the-timeline", "lit": "Blade" },
    { "do": "key", "key": "t" },
    { "do": "waitFor", "condition": "tool", "value": "text", "timeout": 2 },
    { "do": "expectTimeline", "blade": false },
    { "do": "toolBar", "stage": "4-t-puts-the-blade-down", "lit": "Text" },

    { "do": "tool", "tool": "arrow" },
    { "do": "waitFor", "condition": "tool", "value": "arrow", "timeout": 2 },
    { "do": "toolBar", "stage": "5-arrow", "lit": "Arrow" },
    { "do": "describe", "stage": "5-arrow", "note": "Arrow in hand: its own slot on the bar lights, not More, and the Blade is down" },
    { "do": "snapshot", "name": "5-arrow" },

    { "do": "tool", "tool": "select" },
    { "do": "click", "at": [720, 300] },
    { "do": "wait", "seconds": 0.3 },
    { "do": "expectTimeline", "keyboard": "canvas" },
    { "do": "key", "key": "k" },
    { "do": "waitFor", "condition": "tool", "value": "lens", "timeout": 2 },
    { "do": "toolBar", "stage": "6-k-on-the-canvas", "lit": "Lens" },
    { "do": "key", "key": "b" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "expectTimeline", "blade": true, "keyboard": "canvas" },
    { "do": "toolBar", "stage": "6-b-from-the-canvas", "lit": "Blade" },
    { "do": "describe", "stage": "6-canvas-keys", "note": "after a click on the picture K, which the timeline uses, reached the Lens; B from the canvas armed the Blade" },
    { "do": "snapshot", "name": "6-keys-from-the-canvas" }
  ]
}
