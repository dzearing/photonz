{
  "out": "/tmp/photonz-playtest/video-tool-bar-walk",
  "setup": { "forget": ["all"] },
  "steps": [
    { "do": "action", "action": "openSampleRecording" },
    { "do": "wait", "seconds": 2.0 },
    { "do": "action", "action": "videoPause" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "describe", "stage": "1-opened", "note": "a recording opened at Next defaults, no flag touched: the tool bar is the video's own, Select, Blade, Title / Text, Shape and Measure, and More holds every other tool" },
    { "do": "toolBar", "stage": "1-opened",
      "slots": ["Select", "Blade", "Text", "Shapes", "Measure"],
      "more": ["Selection", "Crop", "Arrow", "Highlight", "Lens", "Frame", "Pen", "Fill"],
      "lit": "Select" },
    { "do": "snapshot", "name": "1-the-video-tool-bar" },

    { "do": "key", "key": "g" },
    { "do": "waitFor", "condition": "tool", "value": "fill", "timeout": 2 },
    { "do": "expectNotice", "says": "Under More" },
    { "do": "toolBar", "stage": "2-g-picks-fill", "lit": "More" },
    { "do": "describe", "stage": "2-g-picks-fill", "note": "G, a letter the timeline has no use for, picked up Fill though it is folded: the More button lit and the pill under the picture says Fill is under More" },
    { "do": "snapshot", "name": "2-a-folded-tool-by-its-key" },

    { "do": "press", "control": "Blade" },
    { "do": "wait", "seconds": 1.2 },
    { "do": "expectTimeline", "blade": true, "tool": "select", "open": true },
    { "do": "toolBar", "stage": "3-blade", "lit": "Blade" },
    { "do": "describe", "stage": "3-blade", "note": "the tool bar's Blade is the timeline's Blade: it lit both and brought the tucked timeline up to cut on. The click on a clip that should cut is a-click-on-a-clip-with-the-blade-cuts-it-there, which adds that check back here" },
    { "do": "snapshot", "name": "3-the-blade-cuts" },

    { "do": "press", "control": "Timeline Select" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "toolBar", "stage": "4-timeline-select", "lit": "Select" },
    { "do": "key", "key": "b" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "expectTimeline", "blade": true },
    { "do": "toolBar", "stage": "4-b-from-the-timeline", "lit": "Blade" },
    { "do": "key", "key": "t" },
    { "do": "waitFor", "condition": "tool", "value": "text", "timeout": 2 },
    { "do": "expectTimeline", "blade": false },
    { "do": "toolBar", "stage": "4-t-puts-the-blade-down", "lit": "Text" },

    { "do": "toolBar", "stage": "5-arrow-from-more", "choose": "Arrow", "lit": "More" },
    { "do": "waitFor", "condition": "tool", "value": "arrow", "timeout": 2 },
    { "do": "describe", "stage": "5-arrow-from-more", "note": "Arrow picked from the More menu: it is in hand and More is lit; the five slots in front did not move" },
    { "do": "snapshot", "name": "5-arrow-from-more" },

    { "do": "tool", "tool": "select" },
    { "do": "click", "at": [720, 300] },
    { "do": "wait", "seconds": 0.3 },
    { "do": "expectTimeline", "keyboard": "canvas" },
    { "do": "key", "key": "k" },
    { "do": "waitFor", "condition": "tool", "value": "lens", "timeout": 2 },
    { "do": "expectNotice", "says": "Under More" },
    { "do": "toolBar", "stage": "6-k-on-the-canvas", "lit": "More" },
    { "do": "key", "key": "b" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "expectTimeline", "blade": true, "keyboard": "canvas" },
    { "do": "toolBar", "stage": "6-b-from-the-canvas", "lit": "Blade" },
    { "do": "describe", "stage": "6-canvas-keys", "note": "after a click on the picture K, which the timeline uses, reached the folded Lens and said so; B from the canvas armed the Blade" },
    { "do": "snapshot", "name": "6-keys-from-the-canvas" }
  ]
}
