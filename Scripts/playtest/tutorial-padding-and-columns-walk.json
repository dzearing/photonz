{
  "out": "/tmp/photonz-playtest/tutorial-padding-and-columns-walk",
  "seed": "The third guide of the Building UI track, and the one that exists because these two were a real source of confusion: a screen has ONE inset from its edge, and the columns are drawn inside it. It opens a screen whose cards run right out to both sides, has you type 24 into Padding and watch them come in, then turns the columns on and shows them starting at the padding rather than at the screen's edge.",
  "setup": { "forget": ["tutorials", "panel", "frames", "groups", "tools", "grid"] },
  "steps": [
    { "do": "appearance", "value": "light" },
    { "do": "open", "file": "../../Tests/PhotonzRenderTests/Fixtures/settings-pane-2x.png", "width": 1280, "height": 900 },
    { "do": "wait", "seconds": 1 },

    { "do": "startGuide", "guide": "padding-and-columns" },
    { "do": "waitFor", "condition": "tutorialStep", "value": "flush-to-the-edges", "timeout": 10 },
    { "do": "wait", "seconds": 0.9 },
    { "do": "describe", "stage": "1-flush", "note": "the cards touch both sides of the screen, which is the state the guide is about" },
    { "do": "snapshot", "name": "1-flush" },

    { "do": "action", "action": "tutorialNext" },
    { "do": "waitFor", "condition": "tutorialStep", "value": "pick-the-screen", "timeout": 5 },
    { "do": "wait", "seconds": 0.5 },
    { "do": "click", "at": [360, 430] },
    { "do": "waitFor", "condition": "tutorialStep", "value": "give-it-room", "timeout": 6 },
    { "do": "wait", "seconds": 0.8 },
    { "do": "panel", "stage": "2-screen-picked" },
    { "do": "snapshot", "name": "2-screen-picked" },

    { "do": "focus", "field": "Padding" },
    { "do": "type", "text": "24" },
    { "do": "key", "key": "return" },
    { "do": "waitFor", "condition": "tutorialStep", "value": "show-the-columns", "timeout": 6 },
    { "do": "wait", "seconds": 0.9 },
    { "do": "describe", "stage": "3-padded", "note": "THE TEST: the cards came IN on both sides rather than sliding right and being cut off at the far edge" },
    { "do": "snapshot", "name": "3-padded" },

    { "do": "reveal", "control": "Show columns" },
    { "do": "press", "control": "Show columns" },
    { "do": "waitFor", "condition": "tutorialStep", "value": "columns-start-at-the-padding", "timeout": 6 },
    { "do": "wait", "seconds": 0.9 },
    { "do": "describe", "stage": "4-columns-on", "note": "THE OTHER TEST: the columns start at the padding, and the Columns section says so where the Margin row used to be" },
    { "do": "panel", "stage": "4-columns-on" },
    { "do": "snapshot", "name": "4-columns-on" },

    { "do": "action", "action": "tutorialNext" },
    { "do": "waitFor", "condition": "tutorialStep", "value": "set-the-count", "timeout": 6 },
    { "do": "wait", "seconds": 0.5 },
    { "do": "focus", "field": "Gutter" },
    { "do": "type", "text": "24" },
    { "do": "key", "key": "return" },
    { "do": "waitFor", "condition": "tutorialStep", "value": "drag-pulls-to-them", "timeout": 6 },
    { "do": "wait", "seconds": 0.9 },
    { "do": "describe", "stage": "5-gutter-typed", "note": "the four columns the app picked for a narrow screen, now 24 apart, and the line under the numbers works out what each one comes to" },
    { "do": "panel", "stage": "5-gutter-typed" },
    { "do": "snapshot", "name": "5-gutter-typed" },

    { "do": "action", "action": "tutorialNext" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "6-finished", "note": "Done closed the guide" }
  ]
}
