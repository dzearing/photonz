{
  "out": "/tmp/photonz-playtest/ask-queues-a-request-walk",
  "seed": "a-request-typed-while-ask-is-working-waits-its-t: a second request sent while Ask plans the first waits as a row, then runs on what the first left; at Next defaults, no flag touched",
  "clock": 720,
  "setup": { "forget": ["all"] },
  "steps": [
    { "do": "blank", "canvasWidth": 1440, "canvasHeight": 1024, "width": 1280, "height": 840 },
    { "do": "wait", "seconds": 1 },
    { "do": "press", "control": "Ask" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "type", "text": "add a blue rectangle" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "press", "control": "Ask Send" },
    { "do": "waitFor", "condition": "askPhase", "value": "planning", "timeout": 30 },
    { "do": "press", "control": "Ask" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "type", "text": "make the rectangle red" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "press", "control": "Ask Send" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expect", "control": "Agent Working", "reads": "add a blue rectangle" },
    { "do": "expect", "control": "Agent Waiting 1 Words", "reads": "make the rectangle red" },
    { "do": "expect", "control": "Agent Waiting 1 Cancel", "present": true },
    { "do": "describe", "stage": "1-waiting", "note": "the second request is a waiting row above the working one, with a cancel" },
    { "do": "snapshot", "name": "1-waiting" },
    { "do": "waitFor", "condition": "askSettled", "timeout": 400 },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expect", "control": "Agent Waiting 1", "present": false },
    { "do": "expect", "control": "Agent Change 1 Switch", "reads": "on" },
    { "do": "expect", "control": "Agent Change 2 Switch", "reads": "on" },
    { "do": "expect", "control": "Agent Change 3", "present": false },
    { "do": "describe", "stage": "2-both-ran", "note": "both requests ran in the order sent, each its own row; the second worked on the first one's rectangle" },
    { "do": "snapshot", "name": "2-both-ran" },
    { "do": "shortcut", "key": "z", "modifiers": ["command"] },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expect", "control": "Agent Change 1 Switch", "reads": "off" },
    { "do": "expect", "control": "Agent Change 2 Switch", "reads": "on" },
    { "do": "describe", "stage": "3-undo", "note": "one Command Z takes back the latest request whole; the first one stays" },
    { "do": "snapshot", "name": "3-undo" }
  ]
}
