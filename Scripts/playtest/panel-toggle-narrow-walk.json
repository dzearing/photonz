{
  "out": "/tmp/photonz-playtest/panel-toggle-narrow",
  "setup": { "forget": ["panel"] },
  "steps": [
    { "do": "open", "file": "../../Tests/PhotonzRenderTests/Fixtures/settings-pane-2x.png", "width": 620, "height": 700 },
    { "do": "wait", "seconds": 1.2 },
    { "do": "describe", "stage": "1-narrow-auto-collapsed", "note": "620pt window, under the 680pt threshold: the panel collapses itself and the title bar still carries the way back, clear of the traffic lights" },
    { "do": "snapshot", "name": "1-narrow-auto-collapsed" },
    { "do": "press", "control": "Panel" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "describe", "stage": "2-narrow-reopened", "note": "pressing it forces the panel back open even under the threshold" },
    { "do": "snapshot", "name": "2-narrow-reopened" },
    { "do": "press", "control": "Panel" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "describe", "stage": "3-narrow-closed-again", "note": "and the same button sends it away again" },
    { "do": "snapshot", "name": "3-narrow-closed-again" }
  ]
}
