{
  "out": "/tmp/photonz-playtest/unique-layer-names",
  "steps": [
    { "do": "blank", "canvasWidth": 1100, "canvasHeight": 700, "width": 1400, "height": 1080 },
    { "do": "wait", "seconds": 1 },
    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [140, 140], "to": [420, 320], "steps": 8 },
    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [480, 140], "to": [760, 320], "steps": 8 },
    { "do": "tool", "tool": "ellipse" },
    { "do": "drag", "from": [140, 380], "to": [420, 560], "steps": 8 },
    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [480, 380], "to": [760, 560], "steps": 8 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "1-four-shapes",
      "note": "the tree should read Rectangle, Rectangle 2, Ellipse, Rectangle 3: no two rows share a name" },
    { "do": "snapshot", "name": "names-1-four-shapes" },
    { "do": "click", "at": [280, 230] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "action", "action": "renameSelectedLayer" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [820, 140], "to": [1040, 320], "steps": 8 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "2-after-a-rename",
      "note": "the hand-named row still reads Renamed Layer, and the new box takes Rectangle 4 without disturbing it" },
    { "do": "snapshot", "name": "names-2-after-rename" },
    { "do": "action", "action": "copyLayer" },
    { "do": "action", "action": "pasteLayer" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "3-after-a-paste",
      "note": "a pasted box arrives under a free number rather than repeating the name it was copied from" },
    { "do": "snapshot", "name": "names-3-after-paste" }
  ]
}
