{
  "out": "/tmp/photonz-playtest/component-whole-path",
  "seed": "The whole component path in one sitting, played as somebody who has never seen the app. Draw a button by hand, make it a component, hand it three knobs, give it a second look called Disabled, place three copies, change one of them, put that change back, place a copy that arrives already Disabled, then edit the original once and carry that edit to every version. Every turn claims what the panel is showing, so the walk fails when the app answers differently rather than when a step falls over.",
  "setup": { "forget": ["shapes", "text", "panel", "groups", "tools"] },
  "steps": [
    { "do": "blank", "canvasWidth": 1440, "canvasHeight": 1024, "width": 1360, "height": 1080 },
    { "do": "wait", "seconds": 0.6 },

    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [240, 180], "to": [600, 300], "steps": 8 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "action", "action": "dragShapeCorners" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "tool", "tool": "text" },
    { "do": "click", "at": [300, 220] },
    { "do": "type", "text": "Save" },
    { "do": "key", "key": "return", "modifiers": ["command"] },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "drag", "from": [190, 140], "to": [660, 360], "steps": 8 },
    { "do": "wait", "seconds": 0.5 },
    { "do": "action", "action": "group" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "focus", "field": "Padding" },
    { "do": "type", "text": "16" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "action", "action": "beginRenameSelectedLayer" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "type", "text": "Save button" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expect", "field": "W", "reads": "392" },
    { "do": "expect", "control": "Add Version", "present": false },
    { "do": "describe", "stage": "1-drawn", "note": "a rounded box with the word Save on it, grouped, named, and keeping 16 of room: 360 wide plus 16 either side is the 392 the panel reads. Nothing here knows anything about components yet" },
    { "do": "snapshot", "name": "path-1-drawn" },
    { "do": "render", "name": "path-1-drawn-doc" },

    { "do": "action", "action": "makeComponent" },
    { "do": "wait", "seconds": 1.5 },
    { "do": "expect", "field": "Component name", "reads": "Save button" },
    { "do": "expect", "control": "Add Version", "present": true },
    { "do": "expect", "tile": "Save button", "present": true },
    { "do": "describe", "stage": "2-component", "note": "one press turned the group into a component: the Library opened on its own with a Save button tile on the shelf, and the panel says this drawing is the original" },
    { "do": "snapshot", "name": "path-2-component" },

    { "do": "action", "action": "undo" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expect", "control": "Add Version", "present": false },
    { "do": "expect", "tile": "Save button", "present": false },
    { "do": "describe", "stage": "2b-undone", "note": "one undo takes the component back off: the tile leaves the shelf and the group is a plain group again" },
    { "do": "action", "action": "redo" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "expect", "control": "Add Version", "present": true },
    { "do": "expect", "tile": "Save button", "present": true },

    { "do": "panelMenu", "menu": "Add", "shot": "path-3-add-menu", "choose": "Text “Save”" },
    { "do": "wait", "seconds": 0.9 },
    { "do": "snapshot", "name": "path-3-knob-arrives" },
    { "do": "describe", "stage": "3-first-knob", "note": "the Add menu offered every part of the drawing that could be adjustable. Picking the words made the first knob, and it landed with its name selected, so the name it came with is on screen here" },
    { "do": "type", "text": "Label" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.8 },

    { "do": "panelMenu", "menu": "Add", "choose": "Rectangle · Corner radius" },
    { "do": "wait", "seconds": 0.9 },
    { "do": "type", "text": "Corner radius" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.8 },

    { "do": "panelMenu", "menu": "Add", "choose": "Save button · Padding" },
    { "do": "wait", "seconds": 0.9 },
    { "do": "type", "text": "Room" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.9 },
    { "do": "describe", "stage": "4-knobs", "note": "three knobs on the original: the words, the rounding of the box, and the room the button keeps inside its own edges" },
    { "do": "snapshot", "name": "path-4-knobs" },
    { "do": "panel", "stage": "4-knobs" },

    { "do": "action", "action": "addComponentVersion" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "type", "text": "Disabled" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.9 },
    { "do": "action", "action": "fadeLayer" },
    { "do": "wait", "seconds": 0.9 },
    { "do": "describe", "stage": "5-second-version", "note": "a second drawing under the same name, called Disabled and faded so the two genuinely differ. It arrives on the canvas beside the original" },
    { "do": "snapshot", "name": "path-5-second-version" },
    { "do": "render", "name": "path-5-second-version-doc" },
    { "do": "panel", "stage": "5-second-version" },

    { "do": "action", "action": "pickFirstComponent" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expect", "menu": "Place", "reads": "Default" },
    { "do": "dropComponent", "at": [300, 480] },
    { "do": "wait", "seconds": 1.0 },
    { "do": "action", "action": "pickFirstComponent" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "dropComponent", "at": [300, 660] },
    { "do": "wait", "seconds": 1.0 },
    { "do": "action", "action": "pickFirstComponent" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "dropComponent", "at": [300, 840] },
    { "do": "wait", "seconds": 1.0 },
    { "do": "expect", "menu": "Version", "reads": "Default" },
    { "do": "expect", "field": "Label", "reads": "Save" },
    { "do": "expect", "field": "Corner radius", "reads": "18" },
    { "do": "expect", "field": "Room", "reads": "16" },
    { "do": "expect", "control": "Revert Label", "present": false },
    { "do": "describe", "stage": "6-three-copies", "note": "three copies off the shelf, all following the original. The last one is picked, and its knobs read the original's own numbers rather than sitting empty" },
    { "do": "snapshot", "name": "path-6-three-copies" },
    { "do": "render", "name": "path-6-three-copies-doc" },

    { "do": "click", "at": [300, 660] },
    { "do": "wait", "seconds": 0.7 },
    { "do": "focus", "field": "Label" },
    { "do": "type", "text": "Cancel" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "expect", "field": "Label", "reads": "Cancel" },
    { "do": "expect", "control": "Revert Label", "present": true },
    { "do": "describe", "stage": "7-one-copy-changed", "note": "THE POINT of a knob: the middle copy alone says Cancel, and the way back appeared beside the row it changed. The other two and the original still say Save" },
    { "do": "snapshot", "name": "path-7-one-copy-changed" },
    { "do": "render", "name": "path-7-one-copy-changed-doc" },

    { "do": "action", "action": "undo" },
    { "do": "wait", "seconds": 0.9 },
    { "do": "expect", "field": "Label", "reads": "Save" },
    { "do": "expect", "control": "Revert Label", "present": false },
    { "do": "describe", "stage": "7b-undone", "note": "one undo takes the change off, way back and all" },
    { "do": "action", "action": "redo" },
    { "do": "wait", "seconds": 0.9 },
    { "do": "expect", "field": "Label", "reads": "Cancel" },

    { "do": "focus", "field": "Room" },
    { "do": "type", "text": "48" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "expect", "field": "Room", "reads": "48" },
    { "do": "expect", "control": "Revert Room", "present": true },
    { "do": "describe", "stage": "7c-more-room", "note": "the second knob on the same copy: three times the room inside its own edges, while the other two copies keep the original's 16" },
    { "do": "snapshot", "name": "path-7c-more-room" },
    { "do": "render", "name": "path-7c-more-room-doc" },

    { "do": "press", "control": "Revert Room" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "expect", "field": "Room", "reads": "16" },
    { "do": "expect", "control": "Revert Room", "present": false },

    { "do": "press", "control": "Revert Label" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "expect", "field": "Label", "reads": "Save" },
    { "do": "expect", "control": "Revert Label", "present": false },
    { "do": "describe", "stage": "8-put-back", "note": "the way back pressed: this copy follows the original again, without hunting back through undo" },
    { "do": "snapshot", "name": "path-8-put-back" },
    { "do": "render", "name": "path-8-put-back-doc" },

    { "do": "action", "action": "pickFirstComponent" },
    { "do": "wait", "seconds": 0.7 },
    { "do": "action", "action": "chooseNextShelfComponentVersion" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "expect", "menu": "Place", "reads": "Disabled" },
    { "do": "describe", "stage": "9-shelf-set", "note": "the shelf is set to hand over the Disabled drawing, and the tile draws it" },
    { "do": "snapshot", "name": "path-9-shelf-set" },
    { "do": "dropComponent", "at": [900, 840] },
    { "do": "wait", "seconds": 1.0 },
    { "do": "expect", "menu": "Version", "reads": "Disabled" },
    { "do": "describe", "stage": "10-placed-disabled", "note": "the copy arrived already faded, in one step rather than dropping one and switching it" },
    { "do": "snapshot", "name": "path-10-placed-disabled" },
    { "do": "render", "name": "path-10-placed-disabled-doc" },

    { "do": "click", "at": [300, 660] },
    { "do": "wait", "seconds": 0.7 },
    { "do": "expect", "menu": "Version", "reads": "Default" },
    { "do": "press", "control": "Edit Original" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "expect", "field": "Component name", "reads": "Save button" },
    { "do": "expect", "control": "Add Version", "present": true },
    { "do": "describe", "stage": "10b-edit-original", "note": "Edit Original pressed on a copy showing Default: it lands on the Default drawing, the one that copy shows, with the Versions list saying which is showing" },
    { "do": "snapshot", "name": "path-10b-edit-original" },
    { "do": "panel", "stage": "10b-edit-original" },

    { "do": "click", "at": [400, 240] },
    { "do": "wait", "seconds": 0.7 },
    { "do": "action", "action": "stepIntoSelection" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expect", "control": "Apply to Other Versions", "present": true },
    { "do": "expect", "control": "Apply to Other Versions", "reads": "every version already matches" },
    { "do": "describe", "stage": "11-inside-original", "note": "double clicking the original drawing goes inside it and picks the box, and the panel says which drawing this piece belongs to" },
    { "do": "snapshot", "name": "path-11-inside-original" },
    { "do": "action", "action": "addShadow" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "expect", "control": "Apply to Other Versions", "reads": "there is something to carry" },
    { "do": "describe", "stage": "12-original-edited", "note": "a shadow on the original's box reaches every copy following it, in the one edit" },
    { "do": "snapshot", "name": "path-12-original-edited" },
    { "do": "render", "name": "path-12-original-edited-doc" },

    { "do": "press", "control": "Apply to Other Versions" },
    { "do": "wait", "seconds": 1.2 },
    { "do": "expect", "control": "Apply to Other Versions", "reads": "every version already matches" },
    { "do": "describe", "stage": "13-every-version", "note": "THE LAST POINT: one press carried that shadow to the Disabled drawing too, so the copy placed as Disabled has it as well, and the button now says the versions match" },
    { "do": "snapshot", "name": "path-13-every-version" },
    { "do": "render", "name": "path-13-every-version-doc" },

    { "do": "action", "action": "undo" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "expect", "control": "Apply to Other Versions", "reads": "there is something to carry" },
    { "do": "describe", "stage": "14-undone", "note": "one undo takes it back off every version at once, because carrying it was one step" },
    { "do": "render", "name": "path-14-undone-doc" }
  ]
}
