{
  "out": "/tmp/photonz-playtest/ask-annotates-a-screenshot-walk",
  "clock": 420,
  "setup": {
    "forget": [
      "all"
    ]
  },
  "steps": [
    {
      "do": "open",
      "file": "../../Tests/PhotonzRenderTests/Fixtures/settings-pane-2x.png",
      "width": 1280,
      "height": 840
    },
    {
      "do": "wait",
      "seconds": 1
    },
    {
      "do": "expectLayers",
      "count": 1
    },
    {
      "do": "press",
      "control": "Ask"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "describe",
      "stage": "1-composer",
      "note": "the Ask button opened the composer over the canvas"
    },
    {
      "do": "snapshot",
      "name": "1-composer"
    },
    {
      "do": "type",
      "text": "annotate the ux with measurements around the major ui elements"
    },
    {
      "do": "snapshot",
      "name": "2-typed"
    },
    {
      "do": "press",
      "control": "Ask Send"
    },
    {
      "do": "waitFor",
      "condition": "askPhase",
      "value": "planning",
      "timeout": 5
    },
    {
      "do": "wait",
      "seconds": 0.6
    },
    {
      "do": "snapshot",
      "name": "3-planning"
    },
    {
      "do": "waitFor",
      "condition": "askPhase",
      "value": "ran|stopped",
      "timeout": 300
    },
    {
      "do": "describe",
      "stage": "run-ended",
      "note": "where the request ended: it runs as soon as the model is done, with no Run Plan"
    },
    {
      "do": "waitFor",
      "condition": "askPhase",
      "value": "ran",
      "timeout": 1
    },
    {
      "do": "wait",
      "seconds": 0.8
    },
    {
      "do": "describe",
      "stage": "1-ran",
      "note": "measurements on the screenshot, and one row in the Agent group saying what changed"
    },
    {
      "do": "expect",
      "control": "Agent Change 1",
      "present": true
    },
    {
      "do": "expect",
      "control": "Ask Step 1",
      "present": false
    },
    {
      "do": "expect",
      "control": "Run Plan",
      "present": false
    },
    {
      "do": "expectLayers",
      "atLeast": 4
    },
    {
      "do": "snapshot",
      "name": "1-ran"
    },
    {
      "do": "action",
      "action": "undo"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "describe",
      "stage": "2-undone",
      "note": "one Command Z took the whole request back, and its row reads off"
    },
    {
      "do": "expectLayers",
      "count": 1
    },
    {
      "do": "expect",
      "control": "Agent Change 1 Switch",
      "reads": "off"
    },
    {
      "do": "action",
      "action": "redo"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "expect",
      "control": "Agent Change 1 Switch",
      "reads": "on"
    },
    {
      "do": "expectLayers",
      "atLeast": 4
    },
    {
      "do": "press",
      "control": "Agent Change 1 Switch"
    },
    {
      "do": "wait",
      "seconds": 0.6
    },
    {
      "do": "describe",
      "stage": "3-off",
      "note": "the row's switch turned the change off: the document reads as before the request"
    },
    {
      "do": "expect",
      "control": "Agent Change 1 Switch",
      "reads": "off"
    },
    {
      "do": "expectLayers",
      "count": 1
    },
    {
      "do": "snapshot",
      "name": "3-off"
    },
    {
      "do": "press",
      "control": "Agent Change 1 Switch"
    },
    {
      "do": "wait",
      "seconds": 0.6
    },
    {
      "do": "describe",
      "stage": "4-on",
      "note": "the switch put the change back"
    },
    {
      "do": "expect",
      "control": "Agent Change 1 Switch",
      "reads": "on"
    },
    {
      "do": "expectLayers",
      "atLeast": 4
    },
    {
      "do": "snapshot",
      "name": "4-on"
    },
    {
      "do": "press",
      "control": "Agent Change 1 Delete"
    },
    {
      "do": "wait",
      "seconds": 0.6
    },
    {
      "do": "describe",
      "stage": "5-deleted",
      "note": "delete took the change out and the row went"
    },
    {
      "do": "expect",
      "control": "Agent Change 1",
      "present": false
    },
    {
      "do": "expectLayers",
      "count": 1
    },
    {
      "do": "snapshot",
      "name": "5-deleted"
    },
    {
      "do": "action",
      "action": "undo"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "describe",
      "stage": "6-delete-undone",
      "note": "undoing the delete brought the change and its row back"
    },
    {
      "do": "expect",
      "control": "Agent Change 1",
      "present": true
    },
    {
      "do": "expectLayers",
      "atLeast": 4
    }
  ]
}
