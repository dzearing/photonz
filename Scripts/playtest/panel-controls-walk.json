{
  "out": "/tmp/photonz-playtest/panel-controls",
  "seed": "Every control the right hand panel names for itself is pressed by the words on it. The walk starts from the shape and colour settings a fresh machine would have, because the look a shape is drawn in is remembered and decides which rows the panel shows.",
  "setup": {
    "forget": ["shapes", "color"]
  },
  "steps": [
    { "do": "blank", "canvasWidth": 900, "canvasHeight": 600, "width": 1280, "height": 900 },
    { "do": "wait", "seconds": 1 },

    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [100, 60], "to": [300, 160], "steps": 8 },
    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [100, 220], "to": [300, 320], "steps": 8 },
    { "do": "tool", "tool": "select" },
    { "do": "click", "at": [200, 110] },
    { "do": "wait", "seconds": 0.5 },

    { "do": "panel", "stage": "1-named" },
    { "do": "describe", "stage": "1-named",
      "note": "every layer row now carries a Visibility and a Lock, and the Color section a Color and a Switch, each saying which row it sits on" },
    { "do": "snapshot", "name": "panel-controls-1-named" },

    { "do": "press", "control": "Visibility", "in": "Rectangle" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "2-hidden",
      "note": "the eye on the row called Rectangle, pressed: that layer is hidden and Rectangle 2 is untouched, which is what \"in\" bought" },
    { "do": "snapshot", "name": "panel-controls-2-hidden" },

    { "do": "press", "control": "Visibility", "in": "Rectangle" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "describe", "stage": "3-shown-again",
      "note": "the same words press it back: the name holds still and the detail is what changed" },

    { "do": "press", "control": "Lock", "in": "Rectangle 2" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "panel", "stage": "4-locked" },
    { "do": "describe", "stage": "4-locked",
      "note": "Rectangle 2 is locked and its row's Lock now reads locked in the listing" },
    { "do": "snapshot", "name": "panel-controls-3-locked" },

    { "do": "press", "control": "Color", "in": "Fill" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "5-picker",
      "note": "pressing the Fill row's well opens the color picker on the selected rectangle" },
    { "do": "snapshot", "name": "panel-controls-4-picker" },
    { "do": "action", "action": "closeColorPicker" },
    { "do": "wait", "seconds": 0.4 },

    { "do": "press", "control": "Lock", "in": "Rectangle 2" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "click", "at": [200, 110] },
    { "do": "click", "at": [200, 270], "modifiers": ["shift"] },
    { "do": "wait", "seconds": 0.4 },
    { "do": "action", "action": "group" },
    { "do": "wait", "seconds": 0.6 },

    { "do": "press", "control": "Twist", "in": "Group" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "panel", "stage": "6-opened" },
    { "do": "describe", "stage": "6-opened",
      "note": "a new group starts shut; the twist opened it, and the two rows inside are in the list and pressable with it" },
    { "do": "snapshot", "name": "panel-controls-5-opened" },
    { "do": "press", "control": "Twist", "in": "Group" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "panel", "stage": "7-shut" },
    { "do": "describe", "stage": "7-shut",
      "note": "and shut it again: the rows inside are gone from the inventory, which is why the twist is the only way in to a group" },

    { "do": "selectRow", "row": "Group" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "action", "action": "makeComponent" },
    { "do": "wait", "seconds": 0.9 },
    { "do": "type", "text": "Card" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.9 },
    { "do": "action", "action": "pickFirstComponent" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "action", "action": "insertPickedComponent" },
    { "do": "wait", "seconds": 0.9 },
    { "do": "action", "action": "fadeLayer" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "panel", "stage": "8-own-opacity" },
    { "do": "describe", "stage": "8-own-opacity",
      "note": "this copy of Card has been faded, so the Effects section's Opacity row grew the arrow that puts it back, called Revert Opacity" },
    { "do": "snapshot", "name": "panel-controls-6-own-opacity" },
    { "do": "press", "control": "Revert Opacity" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "panel", "stage": "9-following-again" },
    { "do": "describe", "stage": "9-following-again",
      "note": "pressed: the copy follows the original's opacity again and the arrow is gone with the override" },
    { "do": "snapshot", "name": "panel-controls-7-following-again" },

    { "do": "action", "action": "frameSelection" },
    { "do": "wait", "seconds": 0.9 },
    { "do": "panel", "stage": "10-frame" },
    { "do": "press", "control": "Clip contents" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "panel", "stage": "11-unclipped" },
    { "do": "describe", "stage": "11-unclipped",
      "note": "the Frame section's checkbox, pressed by the words on it: the frame no longer clips what hangs off its edge" },
    { "do": "snapshot", "name": "panel-controls-8-frame" }
  ]
}
