{
  "out": "/tmp/photonz-playtest/canvas-grid-walk",
  "setup": {
    "forget": ["grid", "shapes", "tools", "panel"]
  },
  "steps": [
    { "do": "appearance", "value": "light" },
    { "do": "blank", "canvasWidth": 1440, "canvasHeight": 1024, "width": 1240, "height": 900 },
    { "do": "wait", "seconds": 0.6 },

    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [240, 220], "to": [560, 380] },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.4 },

    { "do": "action", "action": "selectCanvas" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "panel", "stage": "canvas-section" },
    { "do": "menus", "stage": "view-menu", "menu": "View" },
    { "do": "snapshot", "name": "grid-off-before" },

    { "do": "describe", "stage": "the-view-menu-row", "note": "View shows Show Grid on Command apostrophe. Pressing the chord here proves nothing: with no window focused the probe's whole View menu is dimmed, so the menu bar refuses every window scoped chord, Zoom In included. The switch below is the same call the menu row makes." },

    { "do": "press", "control": "Grid" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "panel", "stage": "grid-on" },
    { "do": "snapshot", "name": "grid-on-fit" },
    { "do": "render", "name": "grid-on-render" },

    { "do": "press", "control": "Columns", "in": "Lines" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "snapshot", "name": "grid-columns-only" },
    { "do": "press", "control": "Columns and rows", "in": "Lines" },
    { "do": "wait", "seconds": 0.4 },

    { "do": "press", "control": "Grid" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "snapshot", "name": "grid-off-after" },

    { "do": "press", "control": "Grid" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "action", "action": "zoomIn" },
    { "do": "action", "action": "zoomIn" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "snapshot", "name": "grid-on-near" },
    { "do": "action", "action": "zoomIn" },
    { "do": "action", "action": "zoomIn" },
    { "do": "action", "action": "zoomIn" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "snapshot", "name": "grid-on-close" },
    { "do": "action", "action": "zoomToFit" },
    { "do": "action", "action": "zoomOut" },
    { "do": "action", "action": "zoomOut" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "snapshot", "name": "grid-on-far" },

    { "do": "appearance", "value": "dark" },
    { "do": "action", "action": "zoomToFit" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "snapshot", "name": "grid-on-dark-fit" },
    { "do": "action", "action": "zoomIn" },
    { "do": "action", "action": "zoomIn" },
    { "do": "action", "action": "zoomIn" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "snapshot", "name": "grid-on-dark-near" },
    { "do": "action", "action": "zoomOut" },
    { "do": "action", "action": "zoomOut" },
    { "do": "action", "action": "zoomOut" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "snapshot", "name": "grid-on-dark-far" },
    { "do": "appearance", "value": "light" },
    { "do": "action", "action": "zoomToFit" },
    { "do": "wait", "seconds": 0.5 },

    { "do": "describe", "stage": "cost-with-the-grid-on", "note": "the run of zooms and the sweep below are measured from the click that resets the meter" },
    { "do": "click", "at": [700, 700] },
    { "do": "action", "action": "zoomIn" },
    { "do": "action", "action": "zoomIn" },
    { "do": "action", "action": "zoomIn" },
    { "do": "action", "action": "zoomOut" },
    { "do": "action", "action": "zoomOut" },
    { "do": "action", "action": "zoomOut" },
    { "do": "drag", "from": [200, 620], "to": [1000, 820], "steps": 24 },
    { "do": "wait", "seconds": 0.3 },

    { "do": "action", "action": "selectCanvas" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "press", "control": "Grid" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "describe", "stage": "cost-with-the-grid-off", "note": "the same run of zooms and the same sweep, for the number to be compared against" },
    { "do": "click", "at": [700, 700] },
    { "do": "action", "action": "zoomIn" },
    { "do": "action", "action": "zoomIn" },
    { "do": "action", "action": "zoomIn" },
    { "do": "action", "action": "zoomOut" },
    { "do": "action", "action": "zoomOut" },
    { "do": "action", "action": "zoomOut" },
    { "do": "drag", "from": [200, 620], "to": [1000, 820], "steps": 24 },
    { "do": "wait", "seconds": 0.3 }
  ]
}
