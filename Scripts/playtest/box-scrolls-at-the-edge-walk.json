{
  "out": "/tmp/photonz-playtest/box-scrolls-at-the-edge-walk",
  "seed": "At Next defaults, a box drawn on a timeline opened out so most of it is off screen scrolls the timeline when held at an edge, and keeps reaching to the hand: from the recording on screen to a title twelve seconds in, off to the right; back from the song to the recording, off to the left; down past more tracks than fit; and a five second run at the edge for frame timing.",
  "setup": {
    "timelineOpen": true,
    "forget": [
      "all"
    ]
  },
  "steps": [
    { "do": "action", "action": "openSampleRecording" },
    { "do": "wait", "seconds": 2.0 },
    { "do": "action", "action": "videoPause" },
    { "do": "tool", "tool": "select" },
    { "do": "action", "action": "soundAddSample" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "clickRuler", "seconds": 12.0 },
    { "do": "tool", "tool": "text" },
    { "do": "click", "at": [620, 330] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "type", "text": "Later" },
    { "do": "key", "key": "return", "modifiers": ["command"] },
    { "do": "wait", "seconds": 0.8 },
    { "do": "tool", "tool": "select" },
    { "do": "clickRuler", "seconds": 0.0 },
    { "do": "expectClip", "clip": "Text", "startsAt": 12.0, "within": 0.1 },
    { "do": "action", "action": "timelineZoomIn" },
    { "do": "action", "action": "timelineZoomIn" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "0-opened-out", "note": "the timeline opened out to the first few seconds: the recording on screen, the title at 0:12 well off to the right" },
    { "do": "snapshot", "name": "0-opened-out" },
    { "do": "boxToEdge", "fromTrack": "V1", "from": 1.0, "toTrack": "Title", "edge": "right", "holdSeconds": 3.0, "hold": "1-held-at-the-right-edge" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "expectTimelinePick", "clips": ["Tutorial Sample", "Text"] },
    { "do": "describe", "stage": "1-picked-off-screen", "note": "held at the right edge the timeline scrolled on to the end, and letting go picked the recording the box started on and the title that scrolled into view" },
    { "do": "snapshot", "name": "1-picked-off-screen" },
    { "do": "boxToEdge", "fromTrack": "Audio 2", "from": 13.0, "toTrack": "V1", "edge": "left", "holdSeconds": 3.0, "hold": "2-held-at-the-left-edge" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "expectTimelinePick", "clips": ["Tutorial Sample", "Sample Music"] },
    { "do": "snapshot", "name": "2-picked-back-to-the-start" },
    { "do": "panelMenu", "menu": "Add Track", "choose": "Video Track" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "panelMenu", "menu": "Add Track", "choose": "Video Track" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "panelMenu", "menu": "Add Track", "choose": "Video Track" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "boxToEdge", "fromTrack": "V2", "from": 0.5, "edge": "bottom", "holdSeconds": 2.0, "hold": "3-held-at-the-bottom" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "expectTimelinePick", "clips": ["Tutorial Sample", "Sample Music"] },
    { "do": "snapshot", "name": "3-picked-down-the-tracks" },
    { "do": "clickRuler", "seconds": 0.0 },
    { "do": "action", "action": "timelineZoomIn" },
    { "do": "action", "action": "timelineZoomIn" },
    { "do": "action", "action": "timelineZoomIn" },
    { "do": "action", "action": "timelineZoomIn" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "boxToEdge", "fromTrack": "V1", "from": 0.1, "edge": "right", "inset": 8, "holdSeconds": 5.0 },
    { "do": "describe", "stage": "4-five-seconds-at-the-edge", "note": "five seconds held eight points inside the right edge, opened right in: the log line carries the frame timing" }
  ]
}
