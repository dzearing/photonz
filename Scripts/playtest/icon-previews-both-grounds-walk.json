{
  "out": "/tmp/photonz-playtest/icon-previews-both-grounds-walk",
  "seed": "Every size in the icon previews card is drawn on a Light and a Dark ground, so a glyph is checked on both and no size is singled out. This walk makes a 24 point icon frame at Next defaults, draws in it and reads the card, then a 16 point frame, which shows at 16, 24 and 32.",
  "setup": { "forget": ["shapes", "frames", "tools", "color"] },
  "steps": [
    { "do": "blank", "canvasWidth": 1600, "canvasHeight": 1100, "width": 1700, "height": 1000 },
    { "do": "wait", "seconds": 1 },
    { "do": "action", "action": "newFrameDialog" },
    { "do": "wait", "seconds": 0.9 },
    { "do": "press", "control": "24", "in": "Icons" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "press", "control": "Add Frame" },
    { "do": "wait", "seconds": 1.4 },
    { "do": "expectIconPreviews", "sides": [16, 24, 32, 48], "bothGrounds": true },
    { "do": "describe", "stage": "1-empty", "note": "a fresh 24 point icon frame: the card shows it at 16, 24, 32 and 48, each on Light and on Dark" },
    { "do": "snapshot", "name": "1-empty" },
    { "do": "tool", "tool": "rectangle" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "drag", "from": [791, 542], "to": [809, 556] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "tool", "tool": "ellipse" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "drag", "from": [796, 537], "to": [804, 545] },
    { "do": "wait", "seconds": 0.9 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "expectIconPreviews", "sides": [16, 24, 32, 48], "bothGrounds": true },
    { "do": "expect", "control": "Icon preview 32", "present": true },
    { "do": "expect", "control": "Icon preview 48", "present": true },
    { "do": "describe", "stage": "2-drawn", "note": "two shapes drawn in it: every picture redraws, the 32 and 48 drawn at those sizes from the shapes rather than blown up, and the Dark ground shows the drawing without the frame's white artboard behind it" },
    { "do": "snapshot", "name": "2-drawn" },
    { "do": "render", "name": "2-drawn-doc" },
    { "do": "action", "action": "newFrameDialog" },
    { "do": "wait", "seconds": 0.9 },
    { "do": "press", "control": "16", "in": "Icons" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "press", "control": "Add Frame" },
    { "do": "wait", "seconds": 1.4 },
    { "do": "expectIconPreviews", "sides": [16, 24, 32], "bothGrounds": true },
    { "do": "describe", "stage": "3-sixteen", "note": "a 16 point frame is shown at 16, 24 and 32, up to twice its own size, each on both grounds" },
    { "do": "snapshot", "name": "3-sixteen" }
  ]
}
