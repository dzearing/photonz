{
  "out": "/tmp/photonz-playtest/panel-grip",
  "setup": {
    "forget": ["panel", "groups", "tools", "measure"]
  },
  "steps": [
    { "do": "open", "file": "../../Tests/PhotonzRenderTests/Fixtures/settings-pane-2x.png", "width": 1280, "height": 900 },
    { "do": "action", "action": "showInspector" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "panel", "stage": "short-list" },
    { "do": "snapshot", "name": "1-short-list" },
    { "do": "dragHandle", "area": "Layers", "expect": "absent" },

    { "do": "selectRow", "row": "Background" },
    { "do": "action", "action": "duplicateLayer" },
    { "do": "action", "action": "duplicateLayer" },
    { "do": "action", "action": "duplicateLayer" },
    { "do": "action", "action": "duplicateLayer" },
    { "do": "action", "action": "duplicateLayer" },
    { "do": "action", "action": "duplicateLayer" },
    { "do": "action", "action": "duplicateLayer" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "panel", "stage": "long-list" },
    { "do": "snapshot", "name": "2-long-list" },

    { "comment": "In the pane of lists the Layers list has no grab bar of its own: it fills the room the pane holds, and the pane's grip sets that room.", "do": "dragHandle", "area": "Layers", "expect": "absent" },
    { "do": "dragHandle", "area": "Lists", "by": 90, "hold": "3-grip-held" },
    { "do": "snapshot", "name": "4-taller" },
    { "do": "dragHandle", "area": "Lists", "by": -140 },
    { "do": "snapshot", "name": "5-shorter" },
    { "do": "dragHandle", "area": "Lists", "by": 400 },
    { "do": "snapshot", "name": "6-all-the-way-open" },

    { "comment": "The Library holds this document's own pictures (since 2026-09-23), not the capture folder, so four are dropped in to give it more than one row.", "do": "dropImage", "file": "fixtures/photonz-grip-tile-1.png", "at": [200, 200] },
    { "do": "dropImage", "file": "fixtures/photonz-grip-tile-2.png", "at": [300, 200] },
    { "do": "dropImage", "file": "fixtures/photonz-grip-tile-3.png", "at": [400, 200] },
    { "do": "dropImage", "file": "fixtures/photonz-grip-tile-4.png", "at": [500, 200] },
    { "do": "wait", "seconds": 0.8 },
    { "do": "action", "action": "showLibrary" },
    { "do": "wait", "seconds": 1.2 },
    { "do": "panel", "stage": "library" },
    { "do": "dragHandle", "area": "Library", "by": -40 },
    { "do": "snapshot", "name": "7-library-shorter" },
    { "do": "dragHandle", "area": "Library", "by": 400 },
    { "do": "snapshot", "name": "8-library-open" },

    { "do": "describe", "stage": "end", "note": "the Layers list has no grab bar of its own in the pane and fills whatever room the pane grip gives it" }
  ]
}
