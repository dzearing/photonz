{
  "out": "/tmp/photonz-playtest/stack-from-a-band",
  "steps": [
    { "do": "blank", "canvasWidth": 900, "canvasHeight": 700, "width": 1280, "height": 900 },
    { "do": "wait", "seconds": 1 },

    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [140, 90], "to": [340, 150], "steps": 8 },
    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [140, 220], "to": [300, 280], "steps": 8 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.5 },

    { "do": "drag", "from": [80, 50], "to": [520, 380], "steps": 10 },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "1-band-caught-both", "note": "a rubber band drawn round both boxes: both picked, the band still on screen" },
    { "do": "snapshot", "name": "stack-band-1-picked" },

    { "do": "action", "action": "stackSelection" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "2-stacked", "note": "one press: the two boxes are now one stack, and the band that caught them has come down because it no longer describes anything" },
    { "do": "snapshot", "name": "stack-band-2-stacked" },

    { "do": "action", "action": "undo" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "3-one-undo", "note": "THE TEST: ONE undo takes the stack apart and leaves the two boxes where they were, with the band back. The band coming down rides with the stack, so it must not cost a press of its own (2026-09-08)" },
    { "do": "snapshot", "name": "stack-band-3-undone" },

    { "do": "action", "action": "redo", "note": "and forward again in one press" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "4-redone", "note": "one redo puts the stack back and takes the band down again, the same one step in reverse" },
    { "do": "snapshot", "name": "stack-band-4-redone" }
  ]
}
