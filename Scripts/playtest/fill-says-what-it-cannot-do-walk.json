{
  "out": "/tmp/photonz-playtest/fill-says-what-it-cannot-do",
  "seed": "Option Backspace fills the piece of a picture a marquee is over. Drawn over half a rectangle or a piece of text it used to do nothing at all and say nothing, so the person is left holding a marquee over a result they did not get. Now it refuses out loud, in the same words and on the same pill as Command X and Backspace already do. Filling a piece of a real picture is untouched, and so is filling with no marquee up.",
  "setup": { "forget": ["shapes", "color", "tools"] },
  "steps": [
    { "do": "blank", "canvasWidth": 1200, "canvasHeight": 800, "width": 1280, "height": 900 },
    { "do": "wait", "seconds": 1.0 },

    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [200, 160], "to": [560, 380] },
    { "do": "wait", "seconds": 0.8 },
    { "do": "tool", "tool": "select" },
    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "click", "at": [380, 270] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "1-rectangle-picked", "note": "a rectangle drawn and picked; layers should be 2 (Background + Rectangle)" },
    { "do": "render", "name": "fill-1-rectangle" },

    { "do": "tool", "tool": "rectSelect" },
    { "do": "drag", "from": [200, 160], "to": [380, 380] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "2-marquee-over-half", "note": "a marquee over the LEFT HALF of the rectangle, rectangle still picked" },
    { "do": "snapshot", "name": "fill-2-marquee" },

    { "do": "clearClipboard" },
    { "do": "key", "key": "delete", "modifiers": ["option"] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "3-fill-refused", "note": "THE TEST: Option Backspace must say 'Cannot fill a piece' instead of doing nothing at all. layers stays 2, canUndo stays false" },
    { "do": "snapshot", "name": "fill-3-refused" },
    { "do": "render", "name": "fill-3-refused-doc" },

    { "do": "tool", "tool": "fill" },
    { "do": "click", "at": [300, 270] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "3a-bucket-refused", "note": "THE TEST: the paint bucket clicked INSIDE the same marquee says the same line rather than going quiet where the key explains itself" },
    { "do": "snapshot", "name": "fill-3a-bucket-refused" },

    { "do": "tool", "tool": "rectSelect" },
    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "4-marquee-cleared", "note": "escape takes the ants down and leaves the rectangle picked" },
    { "do": "key", "key": "delete", "modifiers": ["option"] },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "5-no-marquee-fills-the-lot", "note": "THE CONTROL: with no marquee, Option Backspace recolors the whole rectangle as it always did. canUndo true, copied must NOT be a refusal" },
    { "do": "render", "name": "fill-5-whole-shape-filled" },
    { "do": "action", "action": "undo" },
    { "do": "wait", "seconds": 0.8 },

    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "dropImage", "file": "fixtures/Photonz drop probe.png", "at": [880, 500] },
    { "do": "wait", "seconds": 1.0 },
    { "do": "tool", "tool": "select" },
    { "do": "click", "at": [880, 500] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "tool", "tool": "rectSelect" },
    { "do": "drag", "from": [760, 420], "to": [900, 560] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "6-picture-picked", "note": "a real picture picked with a marquee over its corner" },
    { "do": "key", "key": "delete", "modifiers": ["option"] },
    { "do": "wait", "seconds": 1.0 },
    { "do": "describe", "stage": "7-picture-filled", "note": "THE CONTROL: a piece of a real picture really does get filled. copied must NOT be a refusal, canUndo true" },
    { "do": "render", "name": "fill-7-piece-of-picture-filled" }
  ]
}
