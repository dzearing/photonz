{
  "out": "/tmp/photonz-playtest/line-thickness-typed-walk",
  "seed": "The user drew a line, raised Thickness in Appearance and the line on the canvas stayed as thin as it was drawn (2026-10-19): the number changed, the line was still drawn inside the box it came out in. outline-width-walk pulls the slider; this walk TYPES the number, draws the next line to see it start at the width just chosen, and does the same on a video. Every claim is read off the rendered picture, not the panel. At Next defaults, no flag set.",
  "setup": { "forget": ["all"] },
  "steps": [
    { "do": "blank", "canvasWidth": 1100, "canvasHeight": 700, "width": 1400, "height": 1000 },
    { "do": "wait", "seconds": 1 },
    { "do": "tool", "tool": "line" },
    { "do": "drag", "from": [200, 250], "to": [700, 250], "steps": 8 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectInk", "at": [450, 250], "thickness": 4 },
    { "do": "focus", "field": "Thickness" },
    { "do": "type", "text": "12" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expect", "field": "Thickness", "reads": "12" },
    { "do": "describe", "stage": "1-typed", "note": "THE TEST: typing 12 into Thickness draws the line 12 pixels thick on the canvas, the same as pulling the slider" },
    { "do": "expectInk", "at": [450, 250], "thickness": 12 },
    { "do": "snapshot", "name": "1-typed-twelve" },
    { "do": "action", "action": "undo" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expectInk", "at": [450, 250], "thickness": 4 },
    { "do": "action", "action": "redo" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expectInk", "at": [450, 250], "thickness": 12 },

    { "do": "key", "key": "escape" },
    { "do": "tool", "tool": "line" },
    { "do": "drag", "from": [200, 450], "to": [700, 450], "steps": 8 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expect", "field": "Thickness", "reads": "12" },
    { "do": "describe", "stage": "2-next-line", "note": "the next line out of the Line tool starts at the 12 just chosen" },
    { "do": "expectInk", "at": [450, 450], "thickness": 12 },
    { "do": "snapshot", "name": "2-next-line" },

    { "do": "blankVideo", "width": 1400, "height": 900 },
    { "do": "wait", "seconds": 1.0 },
    { "do": "tool", "tool": "line" },
    { "do": "drag", "from": [400, 500], "to": [1400, 500], "steps": 8 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "focus", "field": "Thickness" },
    { "do": "type", "text": "30" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expect", "field": "Thickness", "reads": "30" },
    { "do": "describe", "stage": "3-video", "note": "on a video the same line takes the same number, and the picture is 30 pixels thick" },
    { "do": "expectInk", "at": [900, 500], "thickness": 30 },
    { "do": "snapshot", "name": "3-video-line" },
    { "do": "render", "name": "3-video-render" }
  ]
}
