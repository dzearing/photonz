{
  "out": "/tmp/photonz-playtest/a-sound-s-trim-grip-trims-from-its-middle-walk",
  "seed": "The talking sample at Next defaults, nothing switched. Its sound under V1 is picked and the white trim grip at its start is pressed in its MIDDLE, where the level line runs across it at the ordinary level, and pulled right: the clip is trimmed and the level is left alone. Then the level is turned down and up by dragging the line away from the grips, and each time the grip pressed in its middle still trims rather than moving the level.",
  "setup": { "timelineOpen": true, "forget": ["all"] },
  "steps": [
    { "do": "action", "action": "openSampleTalk" },
    { "do": "wait", "seconds": 2.0 },
    { "do": "action", "action": "videoPause" },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "windowClick", "at": [600, 945] },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expect", "field": "Gain in dB", "reads": "0.0" },
    { "do": "describe", "stage": "1-picked", "note": "The talking sample's sound picked: a white trim grip at each end of its segment, the level line running across both at the ordinary level" },
    { "do": "snapshot", "name": "1-picked" },

    { "do": "dragGrip", "control": "Sample Talk sound clip start", "by": 45, "steps": 8, "hold": "2-trimming-held" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expectClip", "clip": "Sample Talk", "track": "V1", "startsAt": 0, "endsAt": 16.75 },
    { "do": "expect", "field": "Gain in dB", "reads": "0.0" },
    { "do": "describe", "stage": "2-trimmed", "note": "The start grip pressed in its middle, across the level line, and pulled right trims the clip; the level is where it was" },
    { "do": "snapshot", "name": "2-trimmed" },
    { "do": "shortcut", "key": "z", "modifiers": ["command"], "menuItem": "Undo" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expectClip", "clip": "Sample Talk", "track": "V1", "startsAt": 0, "endsAt": 17.25 },

    { "do": "windowDrag", "from": [700, 926], "to": [700, 936], "steps": 8 },
    { "do": "wait", "seconds": 0.8 },
    { "do": "panel", "stage": "3-turned-down" },
    { "do": "describe", "stage": "3-turned-down", "note": "The level line grabbed in the middle of the segment, well away from either grip, moves the level down" },
    { "do": "snapshot", "name": "3-turned-down" },
    { "do": "dragGrip", "control": "Sample Talk sound clip start", "by": 45, "steps": 8, "hold": "4-trimming-turned-down-held" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expectClip", "clip": "Sample Talk", "track": "V1", "startsAt": 0, "endsAt": 16.75 },
    { "do": "panel", "stage": "4-trimmed-turned-down" },
    { "do": "describe", "stage": "4-trimmed-turned-down", "note": "With the level turned down the start grip pressed in its middle still trims" },
    { "do": "snapshot", "name": "4-trimmed-turned-down" },
    { "do": "shortcut", "key": "z", "modifiers": ["command"], "menuItem": "Undo" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expectClip", "clip": "Sample Talk", "track": "V1", "startsAt": 0, "endsAt": 17.25 },

    { "do": "windowDrag", "from": [700, 936], "to": [700, 918], "steps": 8 },
    { "do": "wait", "seconds": 0.8 },
    { "do": "panel", "stage": "5-turned-up" },
    { "do": "describe", "stage": "5-turned-up", "note": "The level line dragged up past the ordinary level, again in the middle of the segment" },
    { "do": "snapshot", "name": "5-turned-up" },
    { "do": "dragGrip", "control": "Sample Talk sound clip end", "by": -45, "steps": 8, "hold": "6-trimming-end-turned-up-held" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expectClip", "clip": "Sample Talk", "track": "V1", "startsAt": 0, "endsAt": 16.75 },
    { "do": "panel", "stage": "6-trimmed-end-turned-up" },
    { "do": "describe", "stage": "6-trimmed-end-turned-up", "note": "With the level turned up the end grip pressed in its middle trims the clip from its end" },
    { "do": "snapshot", "name": "6-trimmed-end-turned-up" }
  ]
}
