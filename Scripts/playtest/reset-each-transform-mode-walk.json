{
  "out": "/tmp/photonz-playtest/reset-each-transform-mode-walk",
  "seed": "Reset each transform mode on its own at Next defaults with no flag changed (the user's approved prototype selection-transform.html, approved 2026-11-01). A busy screenshot is dropped on a blank picture and picked: no chip button wears a dot and a right click on the chip by the pointer offers Reset Size, Reset Skew & Distort, Reset 3D and Reset All, all greyed. Stretched and turned, Size gets a dot; skewed, Skew & distort gets one (white, on the picked button); tipped in 3D, 3D gets one. Reset Size from the chip's right click puts the picture back at its own 800 by 500, upright, about the same middle, keeps the skew and the tip, says Reset Size on the tag and takes only the Size dot; one undo puts it back. Reset Skew & Distort and Reset 3D each take only their own; Reset All takes the rest.",
  "setup": { "forget": ["all"] },
  "steps": [
    { "do": "blank", "canvasWidth": 1200, "canvasHeight": 860, "width": 1400, "height": 1000 },
    { "do": "dropImage", "file": "fixtures/Busy screenshot 800x500.png", "at": [600, 430] },
    { "do": "wait", "seconds": 1.0 },
    { "do": "tool", "tool": "select" },
    { "do": "click", "at": [600, 430] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expectGrips", "mode": "size", "tag": "800 × 500", "dots": [] },
    { "do": "rightClick", "on": "grip:chip-size",
      "rows": ["Reset Size", "Reset Skew & Distort", "Reset 3D", "—", "Reset All"],
      "dimmed": ["Reset Size", "Reset Skew & Distort", "Reset 3D", "Reset All"] },
    { "do": "describe", "stage": "1-fresh", "note": "a picture fresh at its own size: no dot on the chip, and every reset row on the chip's right click is greyed" },

    { "do": "grip", "grip": "right", "by": [45.3, 0] },
    { "do": "grip", "grip": "knob", "by": [90, 60] },
    { "do": "expectGrips", "mode": "size", "dots": ["size"] },
    { "do": "snapshot", "name": "1-size-dot" },
    { "do": "grip", "grip": "chip-reshape" },
    { "do": "grip", "grip": "top", "by": [90.6, 0] },
    { "do": "expectGrips", "mode": "reshape", "dots": ["size", "reshape"] },
    { "do": "grip", "grip": "chip-space" },
    { "do": "grip", "grip": "right", "by": [67, -25] },
    { "do": "expectTilt", "atLeast": 1.02 },
    { "do": "expectGrips", "mode": "space", "dots": ["size", "reshape", "space"] },
    { "do": "snapshot", "name": "2-three-dots" },
    { "do": "describe", "stage": "2-changed", "note": "stretched and turned, then skewed, then tipped: each mode's chip button wears a dot, white on the picked 3D button" },

    { "do": "rightClick", "on": "grip:chip-size", "dimmed": [], "choose": "Reset Size" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "expectGrips", "mode": "space", "tag": "Reset Size", "dots": ["reshape", "space"] },
    { "do": "expectReshape", "corners": [[311, 180], [1111, 180], [1025, 680], [225, 680]], "within": 3 },
    { "do": "expectTilt", "atLeast": 1.02 },
    { "do": "snapshot", "name": "3-size-reset" },
    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "wait", "seconds": 1.4, "onTheClock": true },
    { "do": "expectGrips", "mode": "size", "tag": "800 × 500", "dots": ["reshape", "space"] },
    { "do": "describe", "stage": "3-size-reset", "note": "Reset Size from the chip's right click: the picture is its own 800 by 500 again, upright, about the same middle; the skew and the tip stayed; the tag said Reset Size and only the Size dot went" },
    { "do": "action", "action": "undo" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "expectGrips", "dots": ["size", "reshape", "space"] },

    { "do": "rightClick", "on": "grip:chip-reshape", "choose": "Reset Skew & Distort" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "expectReshape", "none": true },
    { "do": "expectGrips", "dots": ["size", "space"] },
    { "do": "rightClick", "on": "grip:chip-space", "choose": "Reset 3D" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "expectGrips", "dots": ["size"] },
    { "do": "snapshot", "name": "4-shape-and-3d-reset" },
    { "do": "action", "action": "undo" },
    { "do": "action", "action": "undo" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "expectGrips", "dots": ["size", "reshape", "space"] },
    { "do": "rightClick", "on": "grip:chip-size", "choose": "Reset All" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "expectGrips", "dots": [] },
    { "do": "expectReshape", "none": true },
    { "do": "rightClick", "on": "grip:chip-size",
      "dimmed": ["Reset Size", "Reset Skew & Distort", "Reset 3D", "Reset All"] },
    { "do": "snapshot", "name": "5-all-reset" },
    { "do": "describe", "stage": "5-all-reset", "note": "Reset Skew & Distort and Reset 3D each took only their own dot, one undo step each; Reset All took every mode back and greyed every row" }
  ]
}
