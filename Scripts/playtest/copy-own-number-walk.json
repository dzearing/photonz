{
  "out": "/tmp/photonz-playtest/copy-own-number-walk",
  "seed": "A number as a knob. A card original rounds its box and spaces its labels; the author exposes the rounding, drops two copies, and squares one of them off. The other keeps following, so an edit to the original still reaches it. Then both copies are picked at once, so the field has to say Mixed and still take a number typed over it.",
  "steps": [
    { "do": "blank", "canvasWidth": 1440, "canvasHeight": 1024, "width": 1360, "height": 1080 },

    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [200, 180], "to": [520, 320], "steps": 8 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "action", "action": "dragShapeCorners" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "0-rounded",
      "note": "one rounded box, drawn the ordinary way" },

    { "do": "tool", "tool": "text" },
    { "do": "click", "at": [240, 220] },
    { "do": "type", "text": "Card" },
    { "do": "key", "key": "return", "modifiers": ["command"] },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "drag", "from": [150, 130], "to": [600, 400], "steps": 8 },
    { "do": "wait", "seconds": 0.5 },

    { "do": "action", "action": "group" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "action", "action": "makeComponent" },
    { "do": "wait", "seconds": 1.5 },
    { "do": "action", "action": "beginRenameSelectedLayer" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "type", "text": "Card" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.8 },

    { "do": "action", "action": "exposeNumber" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "1-exposed",
      "note": "the original's Adjustable list grew a number knob, named Corner radius for the number it turns rather than for the box it sits on, with a number chip beside it" },
    { "do": "snapshot", "name": "copy-own-number-1-exposed" },

    { "do": "action", "action": "pickFirstComponent" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "action", "action": "insertPickedComponent" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "2-copy",
      "note": "a copy is placed and selected; its section shows a Corner radius row holding the original's number, with no revert arrow because it has answered nothing" },
    { "do": "snapshot", "name": "copy-own-number-2-copy" },

    { "do": "focus", "field": "Corner radius" },
    { "do": "type", "text": "0" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "3-squared",
      "note": "this copy alone is square; the revert arrow appeared on the row, and the keyboard went back to the picture" },
    { "do": "snapshot", "name": "copy-own-number-3-squared" },
    { "do": "render", "name": "copy-own-number-3-squared-doc" },

    { "do": "action", "action": "pickFirstComponent" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "dropComponent", "at": [1000, 700] },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "4-second-copy",
      "note": "a second copy arrives following the original, so it is still round" },
    { "do": "snapshot", "name": "copy-own-number-4-second-copy" },

    { "do": "focus", "field": "Corner radius" },
    { "do": "key", "key": "up" },
    { "do": "key", "key": "up" },
    { "do": "key", "key": "up" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "5-arrow-keys",
      "note": "the arrow keys step this knob the way they step every other number field in the dock" },
    { "do": "snapshot", "name": "copy-own-number-5-arrow-keys" },
    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.5 },

    { "do": "click", "at": [720, 512] },
    { "do": "wait", "seconds": 0.4 },
    { "do": "click", "at": [1000, 700], "modifiers": ["shift"] },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "6-mixed",
      "note": "both copies picked at once and they disagree, so the field says Mixed in the number's own place rather than printing one copy's number as if it were everybody's" },
    { "do": "snapshot", "name": "copy-own-number-6-mixed" },

    { "do": "focus", "field": "Corner radius" },
    { "do": "type", "text": "24" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "7-typed-over-mixed",
      "note": "a number typed straight over the word Mixed replaces it and reaches every picked copy in one step" },
    { "do": "snapshot", "name": "copy-own-number-7-typed-over-mixed" },
    { "do": "render", "name": "copy-own-number-7-typed-over-mixed-doc" },

    { "do": "action", "action": "undo" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "render", "name": "copy-own-number-8-undone-doc" }
  ]
}
