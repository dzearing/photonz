{
  "out": "/tmp/photonz-playtest/size-measures-a-drawn-shape",
  "seed": "Size mode reads the box under the pointer off the picture, which means it could only ever measure pixels somebody else made. Point it at a rectangle you drew a moment ago on a blank canvas and nothing lit up. The app knows exactly where that box is, so it should be the easiest thing in the document to measure, not the only impossible one. Stage one draws a 260 x 180 rectangle on a blank canvas and measures it. Stage two measures a button in a screenshot, to show that reading the picture is untouched.",
  "setup": { "forget": ["shapes", "measure", "panel"] },
  "steps": [
    { "do": "blank", "canvasWidth": 900, "canvasHeight": 600, "width": 1400, "height": 1000 },
    { "do": "wait", "seconds": 0.6 },

    { "do": "key", "key": "r" },
    { "do": "waitFor", "condition": "tool", "value": "rectangle" },
    { "do": "drag", "from": [300, 240], "to": [560, 420] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "describe", "stage": "1-drawn", "note": "THE SETUP: a rectangle at (300, 240), 260 x 180, on a blank canvas with no picture anywhere in the document" },

    { "do": "key", "key": "i" },
    { "do": "waitFor", "condition": "tool", "value": "measure" },
    { "do": "measureMode", "mode": "size" },
    { "do": "move", "at": [430, 330] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "2-hover-drawn", "note": "THE FIRST CLAIM: the pointer is dead centre in the drawn rectangle and it is lit up, with its width and height offered" },
    { "do": "snapshot", "name": "size-over-a-drawn-shape" },
    { "do": "click", "at": [430, 330] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "3-measured-drawn", "note": "THE SECOND CLAIM: the click left two measurements, Width = 260 px and Height = 180 px, on the picture and in the list" },
    { "do": "panel", "stage": "drawn-measured" },
    { "do": "expect", "row": "Width", "present": true },
    { "do": "expect", "row": "Height", "present": true },
    { "do": "snapshot", "name": "size-measured-a-drawn-shape" },

    { "do": "action", "action": "closeDocument" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "open", "file": "../../Tests/PhotonzRenderTests/Fixtures/settings-pane-2x.png", "width": 1400, "height": 1000 },
    { "do": "wait", "seconds": 1 },
    { "do": "key", "key": "i" },
    { "do": "waitFor", "condition": "tool", "value": "measure" },
    { "do": "waitFor", "condition": "edgeMap", "timeout": 30 },
    { "do": "measureMode", "mode": "size" },
    { "do": "move", "at": [438, 786] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "click", "at": [438, 786] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "4-measured-picture", "note": "THE THIRD CLAIM: nothing about reading a screenshot changed, so the Save Changes button in the picture still measures its width and height" },
    { "do": "snapshot", "name": "size-still-measures-the-picture" },
    { "do": "action", "action": "undo" },
    { "do": "wait", "seconds": 0.6 },

    { "do": "key", "key": "r" },
    { "do": "waitFor", "condition": "tool", "value": "rectangle" },
    { "do": "drag", "from": [213, 736], "to": [501, 836], "modifiers": ["command"] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "key", "key": "i" },
    { "do": "waitFor", "condition": "tool", "value": "measure" },
    { "do": "measureMode", "mode": "size" },
    { "do": "move", "at": [357, 786] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "click", "at": [357, 786] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "5-box-does-not-hide-the-button", "note": "THE FOURTH CLAIM: a highlight box drawn around the Save Changes button does not take the button away. The pointer is inside the drawn box and the first pick is still the button, Width = 124 px and Height = 30 px" },
    { "do": "snapshot", "name": "size-inside-a-highlight-box" },
    { "do": "action", "action": "undo" },
    { "do": "wait", "seconds": 0.6 },

    { "do": "key", "key": "i" },
    { "do": "waitFor", "condition": "tool", "value": "measure" },
    { "do": "measureMode", "mode": "size" },
    { "do": "move", "at": [357, 786] },
    { "do": "key", "key": "]" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "click", "at": [357, 786] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "6-climbs-to-the-drawn-box", "note": "THE FIFTH CLAIM: one press of ] climbs out of the button and onto the box that was drawn around it, Width = 144 px and Height = 50 px" },
    { "do": "snapshot", "name": "size-climbs-to-the-drawn-box" }
  ]
}
