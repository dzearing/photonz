{
  "out": "/tmp/photonz-playtest/every-section-header-opens-walk",
  "seed": "Every section in the right hand panel opens and closes when you click its header, at Next defaults with nothing switched by hand. The user found sections in a recording that would not open (2026-10-02): with nothing picked the click was saved and the header stayed shut, because the rows were never drawn again. Each header here is CLICKED, a real press on its face with the app in front, never pressed by name, and each claim is a control inside the section's body that is there while it is open and gone while it is shut. Nothing picked, a clip, a title and a shape in a recording, the recording in View, and a plain picture.",
  "setup": {
    "front": true,
    "timelineOpen": true,
    "forget": ["all"]
  },
  "steps": [
    { "do": "action", "action": "openSampleRecording" },
    { "do": "wait", "seconds": 2.0 },
    { "do": "action", "action": "videoPause" },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.6 },

    { "do": "describe", "stage": "1-nothing-picked", "note": "THE USER'S CASE: a recording in Edit with nothing picked. Time, Captions and Transitions, all open" },
    { "do": "expect", "control": "Add Captions", "present": true },
    { "do": "expect", "control": "Search transitions", "present": true },
    { "do": "expectInView", "field": "Speed" },
    { "do": "press", "control": "Time section" },
    { "do": "press", "control": "Captions section" },
    { "do": "press", "control": "Transitions section" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "2-nothing-picked-shut", "note": "each header clicked once: all three shut, the headers stacked" },
    { "do": "expect", "control": "Add Captions", "present": false },
    { "do": "expect", "control": "Search transitions", "present": false },
    { "do": "expect", "field": "Speed", "present": false },
    { "do": "snapshot", "name": "2-nothing-picked-shut" },
    { "do": "press", "control": "Time section" },
    { "do": "press", "control": "Captions section" },
    { "do": "press", "control": "Transitions section" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "3-nothing-picked-open", "note": "THE FIX: clicked again, all three open. Before the fix this click was saved and the header stayed shut. The click never took the keyboard: firstResponder is still the canvas, so Space plays" },
    { "do": "key", "key": "space" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expectTimeline", "rate": 1 },
    { "do": "key", "key": "space" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "expectTimeline", "rate": 0 },
    { "do": "expectInView", "field": "Speed" },
    { "do": "expect", "control": "Add Captions", "present": true },
    { "do": "expect", "control": "Search transitions", "present": true },
    { "do": "expectInView", "field": "Speed" },
    { "do": "snapshot", "name": "3-nothing-picked-open" },
    { "do": "press", "control": "Captions section" },
    { "do": "press", "control": "Transitions section" },
    { "do": "wait", "seconds": 0.6 },

    { "do": "selectRow", "row": "Tutorial Sample" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "4-clip", "note": "the clip picked: Captions and Transitions remember they were shut, the rest open" },
    { "do": "expect", "control": "Add Captions", "present": false },
    { "do": "expect", "control": "Search transitions", "present": false },
    { "do": "press", "control": "Properties section" },
    { "do": "press", "control": "Time section" },
    { "do": "expect", "control": "Mute", "present": true },
    { "do": "press", "control": "Audio section" },
    { "do": "press", "control": "Audio Fades section" },
    { "do": "press", "control": "Audio Gain section" },
    { "do": "press", "control": "Audio Effects section" },
    { "do": "press", "control": "Appearance section" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "5-clip-shut", "note": "every header the clip brings clicked shut" },
    { "do": "expect", "control": "Animate a property", "present": false },
    { "do": "expect", "field": "Speed", "present": false },
    { "do": "expect", "control": "Mute", "present": false },
    { "do": "expect", "control": "Normalize", "present": false },
    { "do": "expect", "field": "Blending", "present": false },
    { "do": "snapshot", "name": "5-clip-shut" },
    { "do": "press", "control": "Properties section" },
    { "do": "press", "control": "Time section" },
    { "do": "press", "control": "Audio section" },
    { "do": "press", "control": "Audio Fades section" },
    { "do": "press", "control": "Audio Gain section" },
    { "do": "press", "control": "Audio Effects section" },
    { "do": "press", "control": "Appearance section" },
    { "do": "press", "control": "Captions section" },
    { "do": "press", "control": "Transitions section" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "6-clip-open", "note": "and open again" },
    { "do": "expect", "control": "Animate a property", "present": true },
    { "do": "expect", "control": "Mute", "present": true },
    { "do": "reveal", "control": "Audio Gain section" },
    { "do": "expect", "control": "Normalize", "present": true },
    { "do": "reveal", "control": "Appearance section" },
    { "do": "expect", "field": "Blending", "present": true },
    { "do": "reveal", "control": "Captions section" },
    { "do": "expect", "control": "Add Captions", "present": true },
    { "do": "reveal", "control": "Transitions section" },
    { "do": "expect", "control": "Search transitions", "present": true },

    { "do": "tool", "tool": "text" },
    { "do": "click", "at": [620, 330] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "type", "text": "Shipping today" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "key", "key": "return", "modifiers": ["command"] },
    { "do": "wait", "seconds": 1.0 },
    { "do": "tool", "tool": "select" },
    { "do": "describe", "stage": "7-title", "note": "a title picked" },
    { "do": "panel", "stage": "7-title" },
    { "do": "snapshot", "name": "7-title" },
    { "do": "press", "control": "Text section" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "8-title-text-shut", "note": "the title's Text section clicked shut" },
    { "do": "snapshot", "name": "8-title-text-shut" },
    { "do": "press", "control": "Text section" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "9-title-text-open", "note": "and open again" },

    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [500, 450], "to": [700, 560], "steps": 10 },
    { "do": "wait", "seconds": 1.0 },
    { "do": "tool", "tool": "select" },
    { "do": "describe", "stage": "10-shape", "note": "a rectangle picked" },
    { "do": "panel", "stage": "10-shape" },
    { "do": "snapshot", "name": "10-shape" },

    { "do": "key", "key": "1", "modifiers": ["command"] },
    { "do": "wait", "seconds": 1.0 },
    { "do": "describe", "stage": "11-view", "note": "View: the player, no panel, so no section to open or shut" },
    { "do": "expect", "control": "Time section", "present": false },
    { "do": "key", "key": "2", "modifiers": ["command"] },
    { "do": "wait", "seconds": 1.2 },

    { "do": "blank", "canvasWidth": 1200, "canvasHeight": 800, "width": 1440, "height": 900 },
    { "do": "wait", "seconds": 1.0 },
    { "do": "describe", "stage": "12-picture", "note": "a plain picture, nothing picked: Layers" },
    { "do": "expect", "control": "Visibility", "present": true },
    { "do": "press", "control": "Layers section" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expect", "control": "Visibility", "present": false },
    { "do": "press", "control": "Layers section" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expect", "control": "Visibility", "present": true },
    { "do": "describe", "stage": "13-picture-open", "note": "Layers shut and open again in a picture" },
    { "do": "snapshot", "name": "13-picture-open" }
  ]
}
