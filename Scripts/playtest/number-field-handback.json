      "note": "the very next key picks a tool: I must make measure the tool in hand"
    },
    {
      "do": "snapshot",
      "name": "handback-3-tool-key-lands"
    },
    {
      "do": "tool",
      "tool": "select"
    },
    {
      "do": "click",
      "at": [
        200,
        170
      ]
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
