    {
      "do": "focus",
      "field": "X"
    },
    {
      "do": "type",
      "text": "60"
    },
    {
      "do": "key",
      "key": "tab"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "describe",
      "stage": "5-tab-still-walks",
      "note": "Tab still lands the number and walks to the next field: X is 60 and a field editor still holds the keyboard"
    },
    {
      "do": "focus",
      "field": "H"
    },
    {
      "do": "key",
      "key": "up"
    },
    {
      "do": "wait",
      "seconds": 0.4
    },
    {
      "do": "describe",
      "stage": "6-arrow-steps",
      "note": "up steps the height from 100 to 101 and the field keeps the keyboard"
    },
    {
      "do": "key",
      "key": "up",
      "modifiers": [
        "shift"
      ]
    },
    {
      "do": "wait",
      "seconds": 0.4
    },
    {
      "do": "describe",
      "stage": "7-shift-arrow-steps",
      "note": "shift and up steps by 10 more, to 111, still in the field"
    },
    {
      "do": "focus",
      "field": "H"
    },
    {
      "do": "type",
      "text": "77"
    },
    {
      "do": "key",
      "key": "escape"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "describe",
      "stage": "8-escape-puts-it-back",
      "note": "Escape abandons the 77: the height is still 111, and the keyboard is back on the canvas"
    },
    {
      "do": "snapshot",
      "name": "handback-8-after-escape"
    },
    {
      "do": "key",
      "key": "a"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "describe",
      "stage": "9-tool-key-after-escape",
      "note": "A picks the arrow tool, so Escape hands the keyboard back as completely as Return does"
    },
    {
      "do": "action",
      "action": "undo"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
