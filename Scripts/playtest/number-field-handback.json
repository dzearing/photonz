{
  "out": "/tmp/photonz-playtest/number-field-handback",
  "steps": [
    {
      "do": "blank",
      "canvasWidth": 900,
      "canvasHeight": 600,
      "width": 1280,
      "height": 840
    },
    {
      "do": "wait",
      "seconds": 1
    },
    {
      "do": "tool",
      "tool": "rectangle"
    },
    {
      "do": "drag",
      "from": [
        120,
        120
      ],
      "to": [
        320,
        220
      ],
      "steps": 8
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "tool",
      "tool": "select"
    },
    {
      "do": "describe",
      "stage": "1-drawn",
      "note": "a rectangle 200 by 100, selected, and the canvas holds the keyboard"
    },
    {
      "do": "focus",
      "field": "W"
    },
    {
      "do": "type",
      "text": "440"
    },
    {
      "do": "key",
      "key": "return"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "describe",
      "stage": "2-return-hands-back",
      "note": "Return landed the width at 440 AND handed the keyboard back: firstResponder must read CanvasNSView, not a field editor"
    },
    {
      "do": "snapshot",
      "name": "handback-2-after-return"
    },
    {
      "do": "key",
      "key": "i"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "describe",
