    },
    {
      "do": "drag",
      "from": [
        300,
        300
      ],
      "to": [
        560,
        460
      ],
      "steps": 10
    },
    {
      "do": "wait",
      "seconds": 0.8
    },
    {
      "do": "describe",
      "stage": "8-canvas-wins",
      "note": "drawing a rectangle selects it on the canvas, and the tile lets go: one thing selected at a time"
    },
    {
      "do": "snapshot",
      "name": "8-canvas-wins"
    }
  ]
}