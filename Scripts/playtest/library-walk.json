{
  "out": "/tmp/photonz-playtest/library-walk",
  "setup": { "forget": ["all"] },
  "steps": [
    {
      "do": "open",
      "file": "../../Tests/PhotonzRenderTests/Fixtures/settings-pane-2x.png",
      "width": 1280,
      "height": 840
    },
    {
      "do": "wait",
      "seconds": 1
    },
    {
      "do": "describe",
      "stage": "1-dock-today",
      "note": "the right dock with the Library switched off: this is the dock someone who only redlines has today"
    },
    {
      "do": "snapshot",
      "name": "1-dock-today"
    },
    {
      "do": "action",
      "action": "showMediaShelf"
    },
    {
      "do": "wait",
      "seconds": 0.8
    },
    {
      "do": "describe",
      "stage": "2-library-open",
      "note": "View > Show Library, on the Media shelf: it joins the dock under the property sections. Nothing has been put into this document yet, so the shelf is empty and says what will fill it and where every capture lives instead"
    },
    {
      "do": "panel",
      "stage": "2-library-open"
    },
    {
      "do": "snapshot",
      "name": "2-library-open"
    },
    {
      "do": "dropImage",
      "file": "fixtures/Hero banner.png",
      "at": [420, 320]
    },
    {
      "do": "wait",
      "seconds": 1.0
    },
    {
      "do": "describe",
      "stage": "3-a-picture-in-it",
      "note": "a picture dropped into the document is on its shelf: one tile, named after the layer that placed it"
    },
    {
      "do": "panel",
      "stage": "3-a-picture-in-it"
    },
    {
      "do": "expect",
      "tile": "Hero banner",
      "present": true
    },
    {
      "do": "snapshot",
      "name": "3-a-picture-in-it"
    },
    {
      "do": "focus",
      "field": "Search media"
    },
    {
      "do": "type",
      "text": "hero"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "describe",
      "stage": "4-search",
      "note": "typing narrows the shelf the same way it always did, over this document's pictures"
    },
    {
      "do": "snapshot",
      "name": "4-search"
    },
    {
      "do": "key",
      "key": "return"
    },
    {
      "do": "wait",
      "seconds": 0.6
    },
    {
      "do": "describe",
      "stage": "5-picked",
      "note": "Return takes the top hit: the tile is outlined and a Media section opens in the dock, the way picking a layer opens its sections"
    },
    {
      "do": "snapshot",
      "name": "5-picked"
    },
    {
      "do": "action",
      "action": "placeLibraryPick"
    },
    {
      "do": "wait",
      "seconds": 1.0
    },
    {
      "do": "describe",
      "stage": "6-placed",
      "note": "Place in Picture (the same thing a double click on the tile does): the picture lands as a second layer, and the shelf still shows one tile because it is one picture"
    },
    {
      "do": "panel",
      "stage": "6-placed"
    },
    {
      "do": "expect",
      "tile": "Hero banner 2",
      "present": false
    },
    {
      "do": "snapshot",
      "name": "6-placed"
    },
    {
      "do": "action",
      "action": "undo"
    },
    {
      "do": "wait",
      "seconds": 0.6
    },
    {
      "do": "focus",
      "field": "Search media"
    },
    {
      "do": "type",
      "text": "zzz"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "describe",
      "stage": "7-no-match",
      "note": "a search that finds nothing says so, instead of the scope's own empty line"
    },
    {
      "do": "snapshot",
      "name": "7-no-match"
    },
    {
      "do": "click",
      "at": [
        400,
        400
      ]
    },
    {
      "do": "wait",
      "seconds": 0.6
    },
    {
      "do": "describe",
      "stage": "8-clicked-away",
      "note": "a click on the picture that lands on nothing lets the tile go: the Media section closes"
    },
    {
      "do": "snapshot",
      "name": "8-clicked-away"
    },
    {
      "do": "action",
      "action": "pickFirstMedia"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "describe",
      "stage": "9-picked-again",
      "note": "pick a tile again, so the next step has something to take the selection away from it"
    },
    {
      "do": "snapshot",
      "name": "9-picked-again"
    },
    {
      "do": "tool",
      "tool": "rectangle"
    },
    {
      "do": "drag",
      "from": [
        300,
        300
      ],
      "to": [
        560,
        460
      ],
      "steps": 10
    },
    {
      "do": "wait",
      "seconds": 0.8
    },
    {
      "do": "describe",
      "stage": "10-canvas-wins",
      "note": "drawing a rectangle selects it on the canvas, and the tile lets go: one thing selected at a time"
    },
    {
      "do": "snapshot",
      "name": "10-canvas-wins"
    }
  ]
}
