{
  "out": "/tmp/photonz-playtest/component-choice-one-step-walk",
  "steps": [
    { "do": "blank", "canvasWidth": 1440, "canvasHeight": 1024, "width": 1240, "height": 900 },

    { "do": "tool", "tool": "text" },
    { "do": "click", "at": [300, 250] },
    { "do": "type", "text": "Quality" },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.4 },

    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [300, 300], "to": [460, 350] },
    { "do": "wait", "seconds": 0.3 },
    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [300, 380], "to": [460, 430] },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.4 },

    { "do": "drag", "from": [250, 200], "to": [540, 480] },
    { "do": "wait", "seconds": 0.3 },
    { "do": "action", "action": "group" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "action", "action": "makeComponent" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "type", "text": "Row" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "0-component",
      "note": "a component called Row holding a label and two buttons nobody has grouped. canMakeChoice is false: the whole component is picked, not two shapes inside it" },
    { "do": "snapshot", "name": "component-choice-one-step-0-component" },

    { "do": "click", "at": [380, 325], "count": 2 },
    { "do": "wait", "seconds": 0.5 },
    { "do": "click", "at": [380, 405], "modifiers": ["shift"] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "1-two-shapes-picked",
      "note": "both buttons picked, inside the original. canMakeChoice turns true here, which is the whole of whether the Layer menu carries the row" },

    { "do": "action", "action": "makeChoice" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "2-choice-made",
      "note": "one act: the two buttons are now alternatives in a group called Choice, one shows, and the pill says where the other went" },
    { "do": "snapshot", "name": "component-choice-one-step-2-made" },

    { "do": "action", "action": "undo" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "3-undone",
      "note": "one undo takes the whole thing back: no Choice group, both buttons drawn again, and the original exposes nothing" },
    { "do": "action", "action": "redo" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "4-redone", "note": "and one redo puts it back" },

    { "do": "key", "key": "escape" },
    { "do": "click", "at": [900, 700] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "5-nothing-picked",
      "note": "with nothing picked canMakeChoice is false again, so the row is gone rather than sitting there dead" },

    { "do": "action", "action": "pickFirstComponent" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "action", "action": "insertPickedComponent" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "6-copy",
      "note": "a copy of Row, with the choice knob on its own section" },
    { "do": "snapshot", "name": "component-choice-one-step-4-copy" },

    { "do": "action", "action": "cycleChoice" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "7-swapped",
      "note": "the copy draws the other button; the original still draws the first" },
    { "do": "snapshot", "name": "component-choice-one-step-5-swapped" },
    { "do": "render", "name": "component-choice-one-step-5-swapped-doc" }
  ]
}
