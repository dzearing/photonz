{
  "out": "/tmp/photonz-playtest/view-mode-and-edit-mode-walk",
  "seed": "A recording opened the way the Finder opens one, at Next defaults with no flag set and nothing remembered, opens in View mode: a player, the picture fitted to the whole window over a slim transport, no tool bar, no tracks, no panel, nothing picked. Cmd-2 brings the editor (tool bar, tracks, panel), Cmd-1 and E go back, an edit key (I) or a tool (T) switches to Edit by itself, and the title bar's View | Edit switch does the same. Nothing is remembered: go to Edit, close, and the recording opens in View again. The user asked for it on 2026-09-28: 'when I open a video, again, I don't want to see the full edit experience by default.'",
  "setup": {
    "forget": ["all"]
  },
  "steps": [
    { "do": "open", "file": "fixtures/Full screen Retina recording 3456x2234.mp4", "width": 1440, "height": 900 },
    { "do": "wait", "seconds": 1.0 },
    { "do": "expectTimeline", "mode": "view", "open": false, "tool": "select", "keyboard": "timeline", "playheadMS": 0 },
    { "do": "expectPicked", "layers": [] },
    { "do": "describe", "stage": "1-view", "note": "THE TEST: just opened, nothing pressed. The picture fitted to the whole window over the transport; no tool bar, no tracks, no panel; View | Edit at the right of the title bar with View on" },
    { "do": "snapshot", "name": "1-view" },

    { "do": "key", "key": "space" },
    { "do": "wait", "seconds": 1.2 },
    { "do": "expectTimeline", "rate": 1, "mode": "view" },
    { "do": "key", "key": "space" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "expectTimeline", "rate": 0, "mode": "view" },
    { "do": "click", "at": [1728, 1000] },
    { "do": "wait", "seconds": 0.3 },
    { "do": "expectPicked", "layers": [] },
    { "do": "key", "key": "l" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectTimeline", "mode": "view", "keyboard": "timeline" },
    { "do": "key", "key": "k" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "expectTimeline", "rate": 0, "mode": "view", "tool": "select" },

    { "do": "key", "key": "2", "modifiers": ["command"] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectTimeline", "mode": "edit", "open": true, "tool": "select" },
    { "do": "describe", "stage": "2-edit", "note": "Cmd-2: the tool bar, the timeline with its tracks and the panel came back; Edit is on in the title bar" },
    { "do": "snapshot", "name": "2-edit" },

    { "do": "key", "key": "1", "modifiers": ["command"] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectTimeline", "mode": "view", "open": false },
    { "do": "key", "key": "e" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectTimeline", "mode": "edit" },
    { "do": "key", "key": "e" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectTimeline", "mode": "view" },

    { "do": "key", "key": "i" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectTimeline", "mode": "edit", "hasIn": true },
    { "do": "describe", "stage": "3-an-edit-brings-the-editor", "note": "in View, I marked an In, and the editor came up by itself to show it" },
    { "do": "snapshot", "name": "3-an-edit-brings-the-editor" },
    { "do": "key", "key": "i", "modifiers": ["option"] },
    { "do": "wait", "seconds": 0.3 },

    { "do": "key", "key": "1", "modifiers": ["command"] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "key", "key": "t" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectTimeline", "mode": "edit", "tool": "text" },
    { "do": "key", "key": "v" },
    { "do": "wait", "seconds": 0.3 },

    { "do": "press", "control": "View Mode" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectTimeline", "mode": "view" },
    { "do": "press", "control": "Edit Mode" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectTimeline", "mode": "edit", "open": true },

    { "do": "action", "action": "reopenSampleRecording" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "expectTimeline", "mode": "view", "open": false, "tool": "select" },
    { "do": "expectPicked", "layers": [] },
    { "do": "describe", "stage": "4-reopened-in-view", "note": "left in Edit, closed and opened again: it comes up in View, because every recording opens to watch" },
    { "do": "snapshot", "name": "4-reopened-in-view" },

    { "do": "open", "file": "fixtures/Quiet system audio recording 1280x800.mp4", "width": 1280, "height": 860 },
    { "do": "wait", "seconds": 1.0 },
    { "do": "expectTimeline", "mode": "view", "open": false },
    { "do": "describe", "stage": "5-another-recording", "note": "another recording opens in View too" },
    { "do": "snapshot", "name": "5-another-recording" },

    { "do": "rightClick", "at": [640, 400], "choose": "Freeze Frame > Freeze for 2s" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expectTimeline", "mode": "edit", "open": true },
    { "do": "shortcut", "key": "z", "modifiers": ["command"], "menuItem": "Undo" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "key", "key": "1", "modifiers": ["command"] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectTimeline", "mode": "view" },
    { "do": "dropImage", "file": "fixtures/Photonz drop probe.png", "at": [640, 400] },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expectTimeline", "mode": "edit", "open": true },
    { "do": "describe", "stage": "6-a-drop-brings-the-editor", "note": "a right click's Freeze Frame, then (after undo and Cmd-1) a picture dropped on the player: each switched to Edit by itself" }
  ]
}
