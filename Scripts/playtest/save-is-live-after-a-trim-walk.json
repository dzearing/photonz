{
  "out": "/tmp/photonz-playtest/save-is-live-after-a-trim-walk",
  "setup": { "forget": ["all"] },
  "steps": [
    { "do": "action", "action": "openSampleRecording" },
    { "do": "action", "action": "videoPause" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expectEdited", "edited": false },
    { "do": "action", "action": "videoBeginTrim" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "action", "action": "videoTrimStart" },
    { "do": "action", "action": "videoTrimEnd" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "action", "action": "videoTrimDone" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "expectRecording", "seconds": 4 },
    { "do": "expectEdited", "edited": true },
    { "do": "action", "action": "videoSeekMiddle" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "expectRecording", "playhead": 2.0 },
    { "do": "describe", "stage": "1-trimmed", "note": "trimmed to the middle four seconds and not saved: the window wears the edited dot, and Save is live rather than dimmed" },
    { "do": "snapshot", "name": "1-trimmed" },

    { "do": "action", "action": "save" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expectEdited", "edited": false },
    { "do": "expectRecording", "seconds": 4, "playhead": 2.0 },
    { "do": "describe", "stage": "2-command-s-saved-it", "note": "THE TEST: Command S saved the trim as a project and left the recording on disk byte for byte as it was, so the window is exactly where it was: four seconds long, the playhead still two seconds in" },
    { "do": "snapshot", "name": "2-command-s-saved-it" }
  ]
}
