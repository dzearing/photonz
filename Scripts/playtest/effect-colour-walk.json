{
  "out": "/tmp/photonz-playtest/effect-colour",
  "setup": { "forget": ["shapes", "color", "panel"] },
  "steps": [
    { "do": "blank", "canvasWidth": 900, "canvasHeight": 600, "width": 1280, "height": 900 },
    { "do": "wait", "seconds": 1 },
    { "do": "key", "key": "r" },
    { "do": "drag", "from": [340, 300], "to": [560, 460] },
    { "do": "wait", "seconds": 0.8 },
    { "do": "press", "control": "Slider", "in": "Border", "across": 0.3 },
    { "do": "wait", "seconds": 0.5 },
    { "do": "press", "control": "Color", "in": "Border" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "press", "control": "Shades 2" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "1-border", "note": "one border, its colour picked in the Color row under the effect" },
    { "do": "panel", "stage": "1-border" },
    { "do": "snapshot", "name": "1-border-colour-in-settings" },
    { "do": "panelMenu", "menu": "Color", "shot": "2-saved-colours-menu", "in": "Border" },
    { "do": "panelMenu", "menu": "Color", "choose": "Save as Style", "in": "Border" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "type", "text": "Edge" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "3-named", "note": "the border's colour now wears the name Edge" },
    { "do": "panel", "stage": "3-named" },
    { "do": "snapshot", "name": "3-border-wears-a-name" },
    { "do": "panelMenu", "menu": "Add Effect", "choose": "Shadow" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "panelMenu", "menu": "Color", "shot": "4-shadow-colour-menu", "in": "Shadow" },
    { "do": "panelMenu", "menu": "Color", "choose": "Edge", "in": "Shadow" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "5-shadow-named", "note": "the shadow's colour takes the same saved name, from the same menu" },
    { "do": "panel", "stage": "5-shadow-named" },
    { "do": "snapshot", "name": "5-shadow-wears-the-same-name" },
    { "do": "render", "name": "5-canvas" }
  ]
}
