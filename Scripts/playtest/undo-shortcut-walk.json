{
  "out": "/tmp/photonz-playtest/undo-shortcut",
  "steps": [
    { "do": "blank", "canvasWidth": 800, "canvasHeight": 600, "width": 1100, "height": 800 },
    { "do": "wait", "seconds": 1 },
    { "do": "describe", "stage": "1-blank", "note": "an empty canvas: one layer, nothing to undo yet, and appActive false, which is the fact everything below turns on" },

    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [120, 100], "to": [280, 160], "steps": 8 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "2-drew", "note": "a rectangle drawn: two layers, and canUndo is now true, so Undo has something to do" },
    { "do": "render", "name": "undo-2-drew" },

    { "do": "shortcut", "key": "n", "modifiers": ["command", "shift"], "menuItem": "New Window" },
    { "do": "wait", "seconds": 1 },
    { "do": "menus", "stage": "3-after-new-window", "menu": "Edit" },

    { "do": "key", "key": "z", "modifiers": ["command"] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "4-after-cmd-z", "note": "command Z went to Edit > Undo and nothing happened: still two layers. The key line says why" },
    { "do": "snapshot", "name": "undo-4-after-cmd-z" },

    { "do": "action", "action": "undo" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "5-undone", "note": "the action step undoes it for real: back to one layer, and canRedo is now true" },
    { "do": "render", "name": "undo-5-undone" },
    { "do": "snapshot", "name": "undo-5-undone" }
  ]
}
