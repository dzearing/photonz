{
  "out": "/tmp/photonz-playtest/dots-on-an-icon-s-crossings-walk",
  "seed": "New Frame, 24, View, Show Grid at Next defaults: a dot on every crossing of the live area, the targets the Pen and the shapes land on. Snap in Icons Grid off takes the dots away and leaves the lines.",
  "setup": {
    "forget": [
      "all"
    ]
  },
  "steps": [
    { "do": "blank", "canvasWidth": 1600, "canvasHeight": 1100, "width": 1240, "height": 900 },
    { "do": "action", "action": "newFrameDialog" },
    { "do": "wait", "seconds": 0.9 },
    { "do": "press", "control": "24", "in": "Icons" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "press", "control": "Add Frame" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "pinch", "to": 16 },
    { "do": "wait", "seconds": 0.8 },
    { "do": "tool", "tool": "select" },
    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "snapshot", "name": "dots-0-grid-off" },
    { "do": "action", "action": "showGrid" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "1-dots", "note": "the Grid on: units ruled, and a dot on all 441 crossings of the live area" },
    { "do": "snapshot", "name": "dots-1-on" },
    { "do": "action", "action": "snapToGridOff" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "snapshot", "name": "dots-1-same-window-snap-off" },
    { "do": "action", "action": "snapToGridOn" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "tool", "tool": "rectangle" },
    { "do": "move", "at": [797.3, 548.4] },
    { "do": "wait", "seconds": 0.3 },
    { "do": "snapshot", "name": "dots-2-aim" },
    { "do": "drag", "from": [797.3, 548.4], "to": [803.2, 551.1], "steps": 10 },
    { "do": "wait", "seconds": 0.4 },
    { "do": "tool", "tool": "select" },
    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "snapshot", "name": "dots-3-drawn" },
    { "do": "action", "action": "snapToGridOff" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "2-off", "note": "Snap in Icons Grid off: no dots, the lines stay" },
    { "do": "snapshot", "name": "dots-4-snap-off" },
    { "do": "action", "action": "snapToGridOn" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "appearance", "value": "dark" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "snapshot", "name": "dots-5-dark" },
    { "do": "appearance", "value": "light" },
    { "do": "wait", "seconds": 0.4 }
  ]
}
