{
  "out": "/tmp/photonz-playtest/icon-width-row-with-nothing-picked",
  "seed": "The Width row was taught to read the weight a line will really land at, and it learns which icon it is speaking for from whatever is picked inside it. So with NOTHING picked and the pointer sitting in a 24 pixel icon frame, the row went back to saying 4 while the line still landed at 2. This walk deselects everything, rests the pointer in the frame, and reads the row.",
  "setup": {
    "forget": ["shapes", "frames", "tools", "color"]
  },
  "steps": [
    { "do": "blank", "canvasWidth": 1600, "canvasHeight": 1100, "width": 1280, "height": 900 },
    { "do": "wait", "seconds": 1 },

    { "do": "action", "action": "newFrameDialog" },
    { "do": "wait", "seconds": 0.9 },
    { "do": "press", "control": "24", "in": "Icons" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "press", "control": "Add Frame" },
    { "do": "wait", "seconds": 1.2 },

    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "click", "at": [300, 300] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectPicked", "layers": [] },
    { "do": "describe", "stage": "1-nothing-picked", "note": "a 24 by 24 icon frame is on the canvas and nothing at all is picked" },

    { "do": "key", "key": "p" },
    { "do": "waitFor", "condition": "tool", "value": "pen" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "move", "at": [799, 550] },
    { "do": "wait", "seconds": 0.4 },
    { "do": "press", "control": "Color", "in": "Toolbar" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expect", "field": "Width", "reads": "2" },
    { "do": "describe", "stage": "2-row-reads-two", "note": "THE TEST: with nothing picked and the pointer in the icon frame, the Pen's Width row reads the 2 a line there really comes out at. It used to say 4." },
    { "do": "snapshot", "name": "2-row-reads-two" },
    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.5 },

    { "do": "click", "at": [792, 544] },
    { "do": "wait", "seconds": 0.25 },
    { "do": "click", "at": [806, 544] },
    { "do": "wait", "seconds": 0.25 },
    { "do": "click", "at": [799, 556] },
    { "do": "wait", "seconds": 0.25 },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expectPath", "anchors": 3, "closed": false, "width": 2 },
    { "do": "describe", "stage": "3-lands-at-two", "note": "and the line lands at the 2 the row had been showing, so the number read and the number drawn are one" },
    { "do": "snapshot", "name": "3-lands-at-two" },

    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "click", "at": [300, 300] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expectPicked", "layers": [] },
    { "do": "tool", "tool": "line" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "move", "at": [799, 550] },
    { "do": "wait", "seconds": 0.4 },
    { "do": "press", "control": "Color", "in": "Toolbar" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expect", "field": "Width", "reads": "2" },
    { "do": "describe", "stage": "4-every-tool", "note": "a line's own Width row reads the icon's 2 the same way, with nothing picked" },
    { "do": "snapshot", "name": "4-every-tool" },
    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.5 },

    { "do": "tool", "tool": "rectangle" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "move", "at": [799, 550] },
    { "do": "wait", "seconds": 0.4 },
    { "do": "press", "control": "Color", "in": "Toolbar border" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expect", "field": "Width", "reads": "0" },
    { "do": "describe", "stage": "5-a-box-has-no-edge-to-thin", "note": "a box's Width row runs through the same rule and reads 0, because a box arrives with no edge at all. Switch one on and you have CHOSEN its weight, and a chosen weight is never thinned. So there is no number here for the icon to disagree with." },
    { "do": "snapshot", "name": "5-a-box-has-no-edge-to-thin" },
    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.5 },

    { "do": "tool", "tool": "line" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "move", "at": [300, 300] },
    { "do": "wait", "seconds": 0.4 },
    { "do": "press", "control": "Color", "in": "Toolbar" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expect", "field": "Width", "reads": "4" },
    { "do": "describe", "stage": "6-bare-canvas-unchanged", "note": "out on bare canvas there is no icon to fit, so the row reads the four every line in this app has always started at" },
    { "do": "snapshot", "name": "6-bare-canvas-unchanged" },
    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "render", "name": "7-final-render" }
  ]
}
