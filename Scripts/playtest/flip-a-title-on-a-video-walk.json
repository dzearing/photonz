{
  "out": "/tmp/photonz-playtest/flip-a-title-on-a-video-walk",
  "seed": "Flip on a video, at Next defaults with no flag changed. A title is typed over the sample recording at one second and picked. Its right-click menu flips it left to right, Edit > Transform flips it top to bottom, and one undo takes back only the second. A second later in the recording the title still reads mirrored. The menu bar is only live with the app in front, so this walk takes the front.",
  "setup": { "forget": ["all"], "timelineOpen": true, "front": true },
  "steps": [
    { "do": "action", "action": "openSampleRecording" },
    { "do": "wait", "seconds": 2.0 },
    { "do": "action", "action": "videoPause" },
    { "do": "action", "action": "videoSeekStart" },
    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "tool", "tool": "text" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "click", "at": [520, 300] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "type", "text": "Ship it faster." },
    { "do": "key", "key": "return", "modifiers": ["command"] },
    { "do": "wait", "seconds": 1.0 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectFlip" },
    { "do": "snapshot", "name": "1-title" },
    { "do": "rightClick", "at": [560, 312], "shot": "2-right-click-menu", "choose": "Flip Horizontal" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectFlip", "horizontal": true },
    { "do": "menus", "stage": "3-edit-transform", "menu": "Edit", "choose": "Edit > Transform > Flip Vertical" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectFlip", "horizontal": true, "vertical": true },
    { "do": "snapshot", "name": "3-flipped-both-ways" },
    { "do": "shortcut", "key": "z", "modifiers": ["command"], "menuItem": "Undo" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectFlip", "horizontal": true },
    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "4-a-second-later", "note": "a second further into the recording the title still reads mirrored left to right" },
    { "do": "snapshot", "name": "4-a-second-later" }
  ]
}
