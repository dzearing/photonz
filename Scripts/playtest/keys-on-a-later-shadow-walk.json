{
  "out": "/tmp/photonz-playtest/keys-on-a-later-shadow-walk",
  "seed": "Keys on a layer with several shadows move the shadow you picked: at Next defaults with no flag changed, a title typed on a recording at 0:01 (it wears two shadows) is given a third from Add Effect. Animate a property names every shadow's values (Shadow 3 distance and the rest), picking Shadow 3 distance keys that shadow at 2, and dragging Shadow 3's Distance slider in the Effects list at 0:03 is a second key on the same row, while Shadow 1 and Shadow 2 stay as they were.",
  "setup": { "forget": ["all"] },
  "steps": [
    { "do": "action", "action": "openSampleRecording" },
    { "do": "wait", "seconds": 2.0 },
    { "do": "action", "action": "videoPause" },
    { "do": "tool", "tool": "select" },
    { "do": "action", "action": "videoSeekStart" },
    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "key", "key": "t" },
    { "do": "click", "at": [620, 330] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "type", "text": "Lift off" },
    { "do": "key", "key": "return", "modifiers": ["command"] },
    { "do": "wait", "seconds": 1.0 },
    { "do": "panelMenu", "menu": "Add Effect", "choose": "Shadow" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "reveal", "control": "Properties section" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "press", "control": "Animate a property" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "1-the-picker", "note": "THE FIRST TEST: with three shadows on the title, Animate a property says which shadow each value belongs to, the way the Effects list numbers them" },
    { "do": "expect", "control": "Shadow 1 distance", "in": "Animate a property", "present": true },
    { "do": "expect", "control": "Shadow 2 distance", "in": "Animate a property", "present": true },
    { "do": "expect", "control": "Shadow 3 distance", "in": "Animate a property", "present": true },
    { "do": "expect", "control": "Shadow 3 size", "in": "Animate a property", "present": true },
    { "do": "expect", "control": "Shadow distance", "in": "Animate a property", "present": false },
    { "do": "snapshot", "name": "1-the-picker" },
    { "do": "press", "control": "Shadow 3 distance", "in": "Animate a property" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expect", "control": "Key", "in": "Shadow 3 distance", "reads": "on a key" },
    { "do": "press", "control": "Shadow 3 distance Value" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "key", "key": "a", "modifiers": ["command"] },
    { "do": "type", "text": "2" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "2-first-key", "note": "THE SECOND TEST: at 0:01 Shadow 3 is keyed at 2, and only its row is animating" },
    { "do": "expect", "field": "Shadow 3 distance", "reads": "2" },
    { "do": "expect", "control": "Key", "in": "Shadow 3 distance", "reads": "on a key" },
    { "do": "panel", "stage": "2-first-key" },
    { "do": "snapshot", "name": "2-first-key" },
    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expect", "control": "Key", "in": "Shadow 3 distance", "reads": "between keys" },
    { "do": "reveal", "control": "Slider", "in": "@shadow.3, Distance" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "press", "control": "Slider", "in": "@shadow.3, Distance", "across": 0.8 },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "3-the-list-keys-it", "note": "THE THIRD TEST: at 0:03, Shadow 3's Distance slider in the Effects list is dragged out, and that is a second key on Shadow 3 distance: its diamond is filled here, and no other shadow's row has started animating" },
    { "do": "reveal", "control": "Properties section" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "expect", "control": "Key", "in": "Shadow 3 distance", "reads": "on a key" },
    { "do": "expect", "field": "Shadow 1 distance", "present": false },
    { "do": "expect", "field": "Shadow 2 distance", "present": false },
    { "do": "expect", "field": "Key lane Lift off Shadow 3 distance", "present": true },
    { "do": "panel", "stage": "3-the-list-keys-it" },
    { "do": "snapshot", "name": "3-the-list-keys-it" },
    { "do": "render", "name": "3-canvas" },
    { "do": "action", "action": "videoStepBackOneSecond" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "4-between", "note": "THE FOURTH TEST: at 0:02, between the keys, Shadow 3's distance reads part way, and the picture agrees" },
    { "do": "expect", "control": "Key", "in": "Shadow 3 distance", "reads": "between keys" },
    { "do": "panel", "stage": "4-between" },
    { "do": "snapshot", "name": "4-between-the-keys" }
  ]
}
