{
  "out": "/tmp/photonz-playtest/arrow-caption-anchor",
  "steps": [
    { "do": "open", "file": "../../Tests/PhotonzRenderTests/Fixtures/settings-pane-2x.png", "width": 1280, "height": 840 },
    { "do": "wait", "seconds": 1 },
    { "do": "action", "action": "zoomToFit" },
    { "do": "wait", "seconds": 0.5 },

    { "do": "key", "key": "a" },
    { "do": "waitFor", "condition": "tool", "value": "arrow" },
    { "do": "drag", "from": [560, 700], "to": [860, 500], "steps": 12 },
    { "do": "waitFor", "condition": "captionField", "timeout": 3 },
    { "do": "type", "text": "Save" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "snapshot", "name": "1-up-right-short" },
    { "do": "type", "text": " and close the window" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "snapshot", "name": "2-up-right-long" },
    { "do": "key", "key": "return", "modifiers": ["command"] },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "up-right", "note": "committed long caption on an up-right arrow" },
    { "do": "snapshot", "name": "3-up-right-committed" },

    { "do": "key", "key": "a" },
    { "do": "waitFor", "condition": "tool", "value": "arrow" },
    { "do": "drag", "from": [1120, 300], "to": [820, 240], "steps": 12 },
    { "do": "waitFor", "condition": "captionField", "timeout": 3 },
    { "do": "type", "text": "Back" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "snapshot", "name": "4-left-short" },
    { "do": "type", "text": " to the previous pane" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "snapshot", "name": "5-left-long" },
    { "do": "key", "key": "return", "modifiers": ["command"] },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "left", "note": "committed long caption on a leftward arrow" },

    { "do": "key", "key": "a" },
    { "do": "waitFor", "condition": "tool", "value": "arrow" },
    { "do": "drag", "from": [600, 800], "to": [600, 620], "steps": 12 },
    { "do": "waitFor", "condition": "captionField", "timeout": 3 },
    { "do": "type", "text": "Up" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "snapshot", "name": "6-up-short" },
    { "do": "type", "text": " here is the toggle row" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "snapshot", "name": "7-up-long" },
    { "do": "key", "key": "return", "modifiers": ["command"] },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "up", "note": "committed long caption on an upward arrow" },

    { "do": "key", "key": "a" },
    { "do": "waitFor", "condition": "tool", "value": "arrow" },
    { "do": "drag", "from": [340, 200], "to": [340, 420], "steps": 12 },
    { "do": "waitFor", "condition": "captionField", "timeout": 3 },
    { "do": "type", "text": "Down" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "snapshot", "name": "8-down-short" },
    { "do": "type", "text": " at the search field" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "snapshot", "name": "9-down-long" },
    { "do": "key", "key": "return", "modifiers": ["command"] },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "down", "note": "committed long caption on a downward arrow" },

    { "do": "key", "key": "a" },
    { "do": "waitFor", "condition": "tool", "value": "arrow" },
    { "do": "drag", "from": [120, 640], "to": [420, 600], "steps": 12 },
    { "do": "waitFor", "condition": "captionField", "timeout": 3 },
    { "do": "type", "text": "Edge" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "snapshot", "name": "10-edge-short" },
    { "do": "type", "text": " arrow with no room behind it" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "snapshot", "name": "11-edge-long" },
    { "do": "key", "key": "return", "modifiers": ["command"] },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "edge", "note": "tail at the left margin: the caption grows into the room" },
    { "do": "snapshot", "name": "12-all-committed" },
    { "do": "render", "name": "12-all-committed" }
  ]
}
