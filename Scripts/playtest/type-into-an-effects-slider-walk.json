{
  "out": "/tmp/photonz-playtest/type-into-an-effects-slider",
  "seed": "Every setting in the Effects list was a slider you drag, and nothing else: a border width of exactly 12 was a matter of nudging the knob until the readout agreed. The number beside each slider is now the app's one number box. This walk types into a border's Width and Offset, refuses a word, holds a number past the end of the range back to the end, checks that one typed number is one undo step, turns a shadow past the end of its dial, and types into an arrow's Thickness and Head Size in Appearance.",
  "setup": { "forget": ["shapes", "color", "panel"] },
  "steps": [
    { "do": "blank", "canvasWidth": 900, "canvasHeight": 600, "width": 1280, "height": 980 },
    { "do": "wait", "seconds": 1 },
    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [340, 300], "to": [560, 460] },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.8 },

    { "do": "panelMenu", "menu": "Add Effect", "choose": "Border" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "1-border-added", "note": "a border on the box: its Width is a box you can type in, not only a knob to nudge" },
    { "do": "focus", "field": "Width" },
    { "do": "type", "text": "12" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expect", "field": "Width", "reads": "12" },
    { "do": "panel", "stage": "1-typed-width" },
    { "do": "snapshot", "name": "1-typed-width" },
    { "do": "render", "name": "1-canvas-typed-width" },

    { "do": "focus", "field": "Offset" },
    { "do": "type", "text": "7" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expect", "field": "Offset", "reads": "7" },
    { "do": "describe", "stage": "2-typed-offset", "note": "the ring stands exactly 7 off the edge, asked for rather than hunted for" },
    { "do": "snapshot", "name": "2-typed-offset" },

    { "do": "focus", "field": "Offset" },
    { "do": "type", "text": "wide" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "3-nonsense", "note": "a word is not a number, so the old one stays: the row is unchanged rather than emptied or zeroed" },
    { "do": "expect", "field": "Offset", "reads": "7" },

    { "do": "focus", "field": "Offset" },
    { "do": "type", "text": "99" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "4-held-to-the-end", "note": "the ends of the slider are the ends of the box: 99 on a row that stops at 40 shows 40, rather than a number over a knob sitting at the top" },
    { "do": "expect", "field": "Offset", "reads": "40" },
    { "do": "snapshot", "name": "4-held-to-the-end" },

    { "do": "action", "action": "undo" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "5-one-undo", "note": "ONE undo step for one typed number, the same as one pull on the knob: the offset is back at the 7 before it, and the 12 width is untouched" },
    { "do": "expect", "field": "Offset", "reads": "7" },
    { "do": "expect", "field": "Width", "reads": "12" },

    { "do": "panelMenu", "menu": "Add Effect", "choose": "Glow" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "focus", "field": "Softness" },
    { "do": "type", "text": "30" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expect", "field": "Softness", "reads": "30" },
    { "do": "describe", "stage": "6-glow", "note": "a glow's Softness typed straight in" },
    { "do": "snapshot", "name": "6-glow" },

    { "do": "panelMenu", "menu": "Add Effect", "choose": "Blur" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "focus", "field": "Amount" },
    { "do": "type", "text": "18" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expect", "field": "Amount", "reads": "18" },

    { "do": "panelMenu", "menu": "Add Effect", "choose": "Shadow" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "focus", "field": "Distance" },
    { "do": "type", "text": "20" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expect", "field": "Distance", "reads": "20" },
    { "do": "focus", "field": "Direction" },
    { "do": "type", "text": "135" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expect", "field": "Direction", "reads": "135" },
    { "do": "focus", "field": "Direction" },
    { "do": "type", "text": "370" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "7-turned", "note": "a turn asked for past the end of the dial is held at the end, exactly as the rotation field in Position and Size holds one" },
    { "do": "expect", "field": "Direction", "reads": "360" },
    { "do": "panel", "stage": "7-turned" },
    { "do": "snapshot", "name": "7-turned" },
    { "do": "render", "name": "7-canvas-turned" },

    { "do": "key", "key": "a" },
    { "do": "waitFor", "condition": "tool", "value": "arrow" },
    { "do": "drag", "from": [200, 150], "to": [420, 240], "steps": 8 },
    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "focus", "field": "Thickness" },
    { "do": "type", "text": "9" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "8-appearance", "note": "Appearance takes a typed number too. On a 24 pixel icon the useful weights are the first two points of a slider that runs to 40, which is what made typing worth having here" },
    { "do": "expect", "field": "Thickness", "reads": "9" },
    { "do": "focus", "field": "Head Size" },
    { "do": "type", "text": "2.5" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "9-head-size", "note": "a multiple rather than a measurement: it keeps its decimal place and wears its sign in front" },
    { "do": "expect", "field": "Head Size", "reads": "2.5" },
    { "do": "panel", "stage": "9-head-size" },
    { "do": "snapshot", "name": "9-head-size" }
  ]
}
