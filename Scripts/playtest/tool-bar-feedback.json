{
  "out": "/tmp/photonz-playtest/tool-bar-feedback",
  "steps": [
    { "do": "open", "file": "../../Tests/PhotonzRenderTests/Fixtures/settings-pane-2x.png", "width": 1280, "height": 840 },
    { "do": "wait", "seconds": 1 },
    { "do": "describe", "stage": "1-select", "note": "Select in hand: the accent circle sits under the first tool, drawn by the shared style" },
    { "do": "snapshot", "name": "1-select" },

    { "do": "key", "key": "i" },
    { "do": "waitFor", "condition": "tool", "value": "measure" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "2-measure", "note": "Measure is a menu-backed button; the circle must have slid to it" },
    { "do": "snapshot", "name": "2-measure" },

    { "do": "key", "key": "c" },
    { "do": "waitFor", "condition": "tool", "value": "crop" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "3-crop", "note": "Crop is the other menu-backed button" },
    { "do": "snapshot", "name": "3-crop" },

    { "do": "key", "key": "m" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "4-marquee", "note": "the selection family button" },
    { "do": "snapshot", "name": "4-marquee" },

    { "do": "key", "key": "r" },
    { "do": "waitFor", "condition": "tool", "value": "rectangle" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "5-shapes", "note": "the shapes family button" },
    { "do": "snapshot", "name": "5-shapes" }
  ]
}
