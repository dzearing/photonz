{
  "out": "/tmp/photonz-playtest/appearance-effects",
  "steps": [
    { "do": "blank", "canvasWidth": 900, "canvasHeight": 600, "width": 1280, "height": 900 },
    { "do": "wait", "seconds": 1 },
    { "do": "key", "key": "r" },
    { "do": "drag", "from": [320, 260], "to": [620, 460] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "1-box",
      "note": "one rectangle drawn and picked; Appearance holds Opacity, Fill, Outline and Corner Radius, and Effects is empty" },
    { "do": "panel", "stage": "1-box" },
    { "do": "snapshot", "name": "1-split" },
    { "do": "panelMenu", "menu": "Add Effect", "shot": "2-add-menu" },
    { "do": "panelMenu", "menu": "Add Effect", "choose": "Shadow" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "panel", "stage": "2-one-shadow" },
    { "do": "snapshot", "name": "2-one-shadow" },
    { "do": "panelMenu", "menu": "Add Effect", "choose": "Shadow" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "panelMenu", "menu": "Add Effect", "choose": "Blur" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "panel", "stage": "3-two-shadows-and-a-blur" },
    { "do": "snapshot", "name": "3-two-shadows-and-a-blur" },
    { "do": "render", "name": "3-canvas" },
    { "do": "press", "control": "Switch", "in": "Blur" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "panel", "stage": "4-blur-off" },
    { "do": "snapshot", "name": "4-blur-off" },
    { "do": "press", "control": "Remove", "in": "Blur" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "panel", "stage": "5-blur-gone" },
    { "do": "snapshot", "name": "5-blur-gone" },
    { "do": "describe", "stage": "5-blur-gone",
      "note": "the tick keeps the effect and stops it drawing; the cross takes it out of the list" }
  ]
}
