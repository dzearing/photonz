{
  "out": "/tmp/photonz-playtest/shift-m-jumps-between-markers-walk",
  "setup": { "forget": ["all"] },
  "steps": [
    { "do": "action", "action": "openSampleRecording" },
    { "do": "wait", "seconds": 2.0 },
    { "do": "action", "action": "videoPause" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectTimeline", "keyboard": "timeline" },

    { "do": "key", "key": "home" },
    { "do": "key", "key": "right", "modifiers": ["shift"] },
    { "do": "key", "key": "m" },
    { "do": "action", "action": "videoSeekQuarter" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "key", "key": "m" },
    { "do": "key", "key": "end" },
    { "do": "key", "key": "left", "modifiers": ["shift"] },
    { "do": "key", "key": "m" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "describe", "stage": "1-three-markers", "note": "an eight second recording at Next defaults, three markers dropped with M: five frames in, two seconds in, and five frames from the end" },
    { "do": "expectTimeline", "markers": 3, "markerAtMS": 2000, "withinMS": 40 },
    { "do": "snapshot", "name": "1-three-markers" },

    { "do": "key", "key": "home" },
    { "do": "wait", "seconds": 0.2 },
    { "do": "expectTimeline", "playheadMS": 0 },
    { "do": "key", "key": "m", "modifiers": ["shift"] },
    { "do": "wait", "seconds": 0.3 },
    { "do": "describe", "stage": "2-shift-m-first", "note": "Shift M from the start put the playhead on the first marker, five frames in" },
    { "do": "expectTimeline", "playheadMS": 167, "withinMS": 34, "keyboard": "timeline", "rate": 0 },
    { "do": "expectTimeline", "tool": "select" },
    { "do": "key", "key": "m", "modifiers": ["shift"] },
    { "do": "wait", "seconds": 0.3 },
    { "do": "expectTimeline", "playheadMS": 2000, "withinMS": 40 },
    { "do": "snapshot", "name": "2-shift-m-on-the-second-marker" },
    { "do": "key", "key": "m", "modifiers": ["shift"] },
    { "do": "wait", "seconds": 0.3 },
    { "do": "expectTimeline", "playheadMS": 7832, "withinMS": 40 },
    { "do": "key", "key": "m", "modifiers": ["shift"] },
    { "do": "wait", "seconds": 0.3 },
    { "do": "describe", "stage": "3-last-marker-stays", "note": "at the last marker Shift M had nowhere to go: the playhead stayed, and the press did not cycle the canvas's selection tools either" },
    { "do": "expectTimeline", "playheadMS": 7832, "withinMS": 40, "tool": "select" },
    { "do": "snapshot", "name": "3-shift-m-on-the-last-marker" },

    { "do": "key", "key": "m", "modifiers": ["command", "shift"] },
    { "do": "wait", "seconds": 0.3 },
    { "do": "describe", "stage": "4-command-shift-m-back", "note": "Command Shift M went back to the marker before, two seconds in" },
    { "do": "expectTimeline", "playheadMS": 2000, "withinMS": 40 },
    { "do": "key", "key": "m", "modifiers": ["command", "shift"] },
    { "do": "wait", "seconds": 0.3 },
    { "do": "expectTimeline", "playheadMS": 167, "withinMS": 34 },
    { "do": "key", "key": "m", "modifiers": ["command", "shift"] },
    { "do": "wait", "seconds": 0.3 },
    { "do": "describe", "stage": "5-first-marker-stays", "note": "at the first marker Command Shift M had nowhere to go, so the playhead stayed" },
    { "do": "expectTimeline", "playheadMS": 167, "withinMS": 34 },
    { "do": "snapshot", "name": "5-command-shift-m-on-the-first-marker" }
  ]
}
