{
  "out": "/tmp/photonz-playtest/band-inside-a-screen",
  "steps": [
    { "do": "blank", "canvasWidth": 900, "canvasHeight": 620, "width": 1240, "height": 900 },
    { "do": "wait", "seconds": 1 },

    { "do": "tool", "tool": "frame" },
    { "do": "drag", "from": [440, 100], "to": [840, 460], "steps": 10 },
    { "do": "wait", "seconds": 0.6 },
    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [480, 150], "to": [640, 210], "steps": 8 },
    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [480, 270], "to": [760, 340], "steps": 8 },
    { "do": "tool", "tool": "select" },
    { "do": "click", "at": [150, 560] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "1-made",
      "note": "a screen at 440,100 400x360 with two rectangles on it, nothing picked. Zoom is 1, so the screen's name sits between y 82 and y 96" },

    { "do": "drag", "from": [455, 115], "to": [790, 400], "steps": 12, "hold": "band-inside-screen" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "2-swept",
      "note": "the band swept across the screen's empty surface: the screen must still be at 440,100 and the selection must be the two rectangles, never the screen and never the canvas beside it" },
    { "do": "snapshot", "name": "band-after-sweep" },

    { "do": "click", "at": [150, 560] },
    { "do": "wait", "seconds": 0.4 },
    { "do": "click", "at": [800, 430] },
    { "do": "wait", "seconds": 0.4 },
    { "do": "describe", "stage": "3-click-picks-the-screen",
      "note": "a CLICK on the same empty surface still picks the screen, exactly as it always did: only the drag changed meaning" },

    { "do": "click", "at": [150, 560] },
    { "do": "click", "at": [520, 180] },
    { "do": "click", "at": [800, 430], "modifiers": ["shift"] },
    { "do": "wait", "seconds": 0.4 },
    { "do": "describe", "stage": "3b-shift-click-adds-the-screen",
      "note": "a shift click on the surface still ADDS the screen to what is picked, so a rectangle and its screen can be picked together" },

    { "do": "click", "at": [150, 560] },
    { "do": "click", "at": [800, 430] },
    { "do": "wait", "seconds": 0.4 },
    { "do": "drag", "from": [800, 430], "to": [850, 480], "steps": 10 },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "4-picked-screen-moves",
      "note": "a screen that is already picked moves from its middle, so a selected screen never feels stuck: the screen should have travelled down and right" },
    { "do": "action", "action": "undo" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "5-undone", "note": "the screen is back at 440,100" },

    { "do": "key", "key": "escape" },
    { "do": "click", "at": [150, 560] },
    { "do": "wait", "seconds": 0.4 },
    { "do": "move", "at": [446, 89] },
    { "do": "wait", "seconds": 0.4 },
    { "do": "describe", "stage": "6-hover-name", "note": "the pointer resting on the screen's name: it tints, which is the whole invitation" },
    { "do": "snapshot", "name": "band-name-handle" },
    { "do": "drag", "from": [446, 89], "to": [496, 139], "steps": 10, "hold": "name-drag" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "7-name-moves-the-screen",
      "note": "dragging the name moves the screen without picking it first, which is the one grab that is always there" },
    { "do": "action", "action": "undo" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "8-back", "note": "the screen is back at 440,100 and the walk leaves nothing behind" }
  ]
}
