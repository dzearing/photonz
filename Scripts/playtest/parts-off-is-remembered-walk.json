{
  "out": "/tmp/photonz-playtest/parts-off-is-remembered",
  "seed": "Switching a part off is remembered for the next shape you draw. Reported by the user on 2026-09-06: take a box's outline off, draw another box, and the outline is back. This walk switches each part in turn and draws a fresh shape after every press, so the box that comes out has to match the box the switch was pressed on. It ends on a shadow, which is an effect rather than a part since 2026-09-07 and so is added from the plus rather than switched on. It also draws an ellipse in the middle, which must be untouched by anything done to a rectangle.",
  "setup": { "forget": ["panel", "shapes", "tools"] },
  "steps": [
    { "do": "blank", "canvasWidth": 900, "canvasHeight": 620, "width": 1400, "height": 950 },
    { "do": "wait", "seconds": 1.2 },
    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [120, 120], "to": [300, 240], "steps": 10 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "1-box-as-drawn",
      "note": "a box as it comes out of the tool: fill on, outline on, no shadow." },
    { "do": "panel", "stage": "1-box-as-drawn" },

    { "do": "press", "control": "Switch", "in": "Outline" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "panel", "stage": "2-outline-off" },

    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [340, 120], "to": [520, 240], "steps": 10 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "3-second-box",
      "note": "the next box, drawn after the outline was switched off. Its Outline switch has to read off: this is the bug the user reported." },
    { "do": "panel", "stage": "3-second-box" },
    { "do": "snapshot", "name": "parts-off-3-second-box" },

    { "do": "tool", "tool": "ellipse" },
    { "do": "drag", "from": [560, 120], "to": [740, 240], "steps": 10 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "4-ellipse-unchanged",
      "note": "an ellipse, untouched by anything done to a rectangle: its Outline switch reads on." },
    { "do": "panel", "stage": "4-ellipse-unchanged" },

    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [120, 300], "to": [300, 420], "steps": 10 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "press", "control": "Switch", "in": "Outline" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "panel", "stage": "5-outline-back-on" },

    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [340, 300], "to": [520, 420], "steps": 10 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "6-outline-restored",
      "note": "the outline was put back on the last box, so this one has one too." },
    { "do": "panel", "stage": "6-outline-restored" },

    { "do": "press", "control": "Switch", "in": "Fill" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [560, 300], "to": [740, 420], "steps": 10 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "panel", "stage": "7-fill-off-inherited" },

    { "do": "panelMenu", "menu": "Add Effect", "choose": "Shadow" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [120, 470], "to": [300, 580], "steps": 10 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "8-shadow-on-inherited",
      "note": "every part now stands where the switches left it: no fill, an outline, and a shadow. A shadow is an effect rather than a part since 2026-09-07, so it is added from the plus on the Effects header, and it is remembered the same way." },
    { "do": "expect", "control": "Switch", "in": "Shadow", "reads": "Shadow, on" },
    { "do": "panel", "stage": "8-shadow-on-inherited" },
    { "do": "snapshot", "name": "parts-off-is-remembered" }
  ]
}
