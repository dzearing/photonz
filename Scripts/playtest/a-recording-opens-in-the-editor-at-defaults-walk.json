{
  "out": "/tmp/photonz-playtest/a-recording-opens-in-the-editor-at-defaults-walk",
  "setup": { "forget": ["all"] },
  "steps": [
    { "do": "action", "action": "openSampleRecording" },
    { "do": "wait", "seconds": 2.0 },
    { "do": "describe", "stage": "1-opened", "note": "THE TEST, with no flag set: a recording opened at Next defaults lands in the ordinary editor, with the clip in the layers list, the timeline across the bottom and the transport under the picture. Not the small play-and-shorten window" },
    { "do": "snapshot", "name": "1-a-recording-at-next-defaults" },

    { "do": "action", "action": "videoSeekMiddle" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "action", "action": "clipSplit" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "2-cut", "note": "a cut at the playhead: the recording has been edited, and nothing can save it in place yet" },
    { "do": "snapshot", "name": "2-cut-in-two" },

    { "do": "action", "action": "askToClose" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "3-closing-asks", "note": "THE OTHER TEST: closing an edited recording stops and asks whether to keep the changes, offering Save As (a project that points at the recording) beside Export, instead of dropping the cut without a word" },
    { "do": "snapshot", "name": "3-closing-asks" },

    { "do": "action", "action": "answerCloseExport" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "describe", "stage": "4-export-offered", "note": "Export in that question keeps the window open and puts the Export sheet on it, so the edit can leave as a video" },
    { "do": "snapshot", "name": "4-export-sheet" },
    { "do": "action", "action": "closeSheets" },
    { "do": "wait", "seconds": 0.5 },

    { "do": "expectEdited", "edited": true },
    { "do": "action", "action": "exportVideoAsTheSheetDoes" },
    { "do": "expectEdited", "edited": false },
    { "do": "describe", "stage": "5-kept-by-export", "note": "once the edit has gone out as a video it is kept, so closing no longer has anything to warn about" },

    { "do": "action", "action": "videoSeekQuarter" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "action", "action": "clipSplit" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expectEdited", "edited": true },
    { "do": "action", "action": "askToClose" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "action", "action": "answerCloseFirst" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "describe", "stage": "6-saved-and-closed", "note": "a second cut, then Save As from the same question: the edit is saved as a project where the save box pointed and the window closes with nothing more to ask" },
    { "do": "open", "file": "/tmp/photonz-playtest/a-recording-opens-in-the-editor-at-defaults-walk/project.photonz" },
    { "do": "wait", "seconds": 1.2 },
    { "do": "action", "action": "expectReopenedAsSaved" },
    { "do": "expectEdited", "edited": false },
    { "do": "snapshot", "name": "6-the-project-reopened" }
  ]
}
