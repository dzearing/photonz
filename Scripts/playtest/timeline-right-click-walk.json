{
  "out": "/tmp/photonz-playtest/timeline-right-click-walk",
  "setup": {
    "timelineOpen": true,
    "forget": [
      "all"
    ]
  },
  "steps": [
    {
      "do": "action",
      "action": "openSampleRecording"
    },
    {
      "do": "wait",
      "seconds": 2.0
    },
    {
      "do": "action",
      "action": "videoPause"
    },
    {
      "do": "wait",
      "seconds": 1.0
    },
    {
      "do": "tool",
      "tool": "select"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "windowDrag",
      "from": [
        485.2,
        833
      ],
      "to": [
        485.9,
        833
      ],
      "steps": 3
    },
    {
      "do": "expectTimeline",
      "playheadMS": 2000,
      "withinMS": 100
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "describe",
      "stage": "1-playhead-at-2s",
      "note": "At defaults, a fresh recording, a click on the ruler at two seconds puts the playhead there (a drag there would draw a range)"
    },
    {
      "do": "snapshot",
      "name": "1-playhead-at-2s"
    },
    {
      "do": "rightClick",
      "at": [
        800,
        400
      ],
      "space": "window",
      "shot": "1b-canvas-menu"
    },
    {
      "do": "rightClick",
      "at": [
        485.2,
        866
      ],
      "space": "window",
      "shot": "2-clip-menu",
      "choose": "Split at 0:02.02",
      "comment": "A right click on the tracks puts the playhead where it lands before the menu opens. So it is made at two seconds, where the ruler put the playhead."
    },
    {
      "do": "wait",
      "seconds": 0.6
    },
    {
      "do": "describe",
      "stage": "3-split",
      "note": "Right-click the clip, Split at 0:02.02: two pieces meeting at two seconds"
    },
    {
      "do": "snapshot",
      "name": "3-split"
    },
    {
      "do": "rightClick",
      "at": [
        486.7,
        866
      ],
      "space": "window",
      "shot": "4-cut-menu",
      "choose": "Transition…"
    },
    {
      "do": "wait",
      "seconds": 0.8
    },
    {
      "comment": "The tiles opened at the cut. A walk cannot press inside them on this Mac yet (walks-that-fail-in-the-full-sweep-26), so the kind goes on through the default key and the panel's Type.",
      "do": "key",
      "key": "escape"
    },
    {
      "do": "wait",
      "seconds": 0.4
    },
    {
      "do": "key",
      "key": "t",
      "modifiers": [
        "command"
      ]
    },
    {
      "do": "wait",
      "seconds": 0.6
    },
    {
      "do": "panelMenu",
      "menu": "Type",
      "choose": "Dip to black"
    },
    {
      "do": "wait",
      "seconds": 0.6
    },
    {
      "do": "describe",
      "stage": "5-transition",
      "note": "Right-click the join, Transition…, Dip to black from the tiles: a band over the cut"
    },
    {
      "do": "snapshot",
      "name": "5-transition"
    },
    {
      "do": "windowDrag",
      "from": [
        645.3,
        833
      ],
      "to": [
        646.1,
        833
      ],
      "steps": 3
    },
    {
      "do": "expectTimeline",
      "playheadMS": 3000,
      "withinMS": 100
    },
    {
      "do": "wait",
      "seconds": 0.4
    },
    {
      "do": "rightClick",
      "at": [
        490.0,
        866
      ],
      "space": "window",
      "choose": "Roll Edit to 0:03.01"
    },
    {
      "do": "wait",
      "seconds": 0.6
    },
    {
      "do": "describe",
      "stage": "6-rolled",
      "note": "Playhead to three seconds, right-click the band, Roll Edit to Playhead: the join and its band are at three seconds, the clip is still eight long"
    },
    {
      "do": "snapshot",
      "name": "6-rolled"
    },
    {
      "do": "windowDrag",
      "from": [
        324.9,
        833
      ],
      "to": [
        325.8,
        833
      ],
      "steps": 3
    },
    {
      "do": "expectTimeline",
      "playheadMS": 1000,
      "withinMS": 100
    },
    {
      "do": "rightClick",
      "at": [
        329.0,
        833
      ],
      "space": "window",
      "shot": "7-ruler-menu",
      "choose": "Set In"
    },
    {
      "do": "windowDrag",
      "from": [
        967.2,
        833
      ],
      "to": [
        968.0,
        833
      ],
      "steps": 3
    },
    {
      "do": "expectTimeline",
      "playheadMS": 5000,
      "withinMS": 100
    },
    {
      "do": "rightClick",
      "at": [
        972.8,
        833
      ],
      "space": "window",
      "choose": "Set Out"
    },
    {
      "do": "windowDrag",
      "from": [
        807.1,
        833
      ],
      "to": [
        807.8,
        833
      ],
      "steps": 3
    },
    {
      "do": "expectTimeline",
      "playheadMS": 4000,
      "withinMS": 100
    },
    {
      "do": "rightClick",
      "at": [
        811.9,
        833
      ],
      "space": "window",
      "choose": "Add Marker"
    },
    {
      "do": "wait",
      "seconds": 0.6
    },
    {
      "do": "expectTimeline",
      "hasIn": true,
      "hasOut": true,
      "markers": 1
    },
    {
      "do": "describe",
      "stage": "8-marks",
      "note": "In at one second, Out at five, a marker at four: a green wash on the ruler between them, green marks on the scrub bar, an amber tab at four"
    },
    {
      "do": "snapshot",
      "name": "8-marks"
    },
    {
      "do": "rightClick",
      "at": [
        1020.9,
        758
      ],
      "space": "window",
      "shot": "9-scrub-menu"
    },
    {
      "do": "rightClick",
      "at": [
        35,
        866
      ],
      "space": "window",
      "shot": "10-track-menu"
    },
    {
      "do": "rightClick",
      "at": [
        317.0,
        866
      ],
      "space": "window",
      "shot": "11-first-piece-menu",
      "choose": "Speed > 2x"
    },
    {
      "do": "wait",
      "seconds": 0.6
    },
    {
      "do": "describe",
      "stage": "12-first-piece-faster",
      "note": "Right-click the FIRST piece, Speed, 2x: only that piece is faster, the clip is shorter"
    },
    {
      "do": "snapshot",
      "name": "12-first-piece-faster"
    },
    {
      "do": "rightClick",
      "at": [
        1117.7,
        866
      ],
      "space": "window",
      "choose": "Ripple Delete"
    },
    {
      "do": "wait",
      "seconds": 0.6
    },
    {
      "do": "describe",
      "stage": "13-ripple-deleted",
      "note": "Right-click the second piece, Ripple Delete: only the sped-up first piece is left"
    },
    {
      "do": "snapshot",
      "name": "13-ripple-deleted"
    },
    {
      "do": "key",
      "key": "x",
      "modifiers": [
        "option"
      ]
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "describe",
      "stage": "14-marks-cleared",
      "note": "Option X, Clear In and Out: the green wash and the scrub bar's marks are gone, the marker stays"
    },
    {
      "do": "snapshot",
      "name": "14-marks-cleared"
    },
    {
      "do": "rightClick",
      "at": [
        317.0,
        866
      ],
      "space": "window",
      "choose": "Rename…"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "type",
      "text": "Intro"
    },
    {
      "do": "key",
      "key": "return"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "describe",
      "stage": "15-renamed",
      "note": "Right-click, Rename, type Intro, Return: the clip and its layer row say Intro"
    },
    {
      "do": "snapshot",
      "name": "15-renamed"
    }
  ]
}
