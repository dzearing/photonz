{
  "out": "/tmp/photonz-playtest/a-silenced-question-comes-back",
  "seed": "Turn Into Picture asks before it acts, and its question carries a Don't ask again box. Tick it and the question was gone for good: nowhere in the app brought it back. This walk ticks the box, watches the command go quiet, opens the new Settings window, turns the question back on, and proves the very next use of the command asks again.",
  "setup": {
    "forget": ["all"]
  },
  "steps": [
    { "do": "blank", "canvasWidth": 1200, "canvasHeight": 800, "width": 1280, "height": 900 },
    { "do": "wait", "seconds": 1.0 },

    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [200, 160], "to": [500, 340] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "tool", "tool": "select" },
    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "click", "at": [350, 250] },
    { "do": "wait", "seconds": 0.5 },

    { "do": "action", "action": "turnIntoPicture" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "describe", "stage": "1-it-asks", "note": "the sheet asks before turning the rectangle into pixels, and carries the silence box" },
    { "do": "expect", "control": "Don't ask again", "in": "Sheet", "present": true },
    { "do": "snapshot", "name": "question-1-it-asks" },

    { "do": "press", "control": "Don't ask again", "in": "Sheet" },
    { "do": "press", "control": "Turn Into Picture", "in": "Sheet" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "describe", "stage": "2-silenced", "note": "answered yes with the box ticked: the rectangle is a picture and the question is now silent" },

    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [600, 160], "to": [900, 340] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "tool", "tool": "select" },
    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "click", "at": [750, 250] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "action", "action": "turnIntoPicture" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "describe", "stage": "3-no-question", "note": "THE DOOR: the second shape turns with no question at all, which is what the box was for" },
    { "do": "expect", "control": "Turn Into Picture", "in": "Sheet", "present": false },
    { "do": "snapshot", "name": "question-2-went-quiet" },

    { "do": "shortcut", "key": ",", "modifiers": ["command"], "menuItem": "Settings\u2026" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "describe", "stage": "4-settings-lists-it", "note": "THE WAY BACK: the Settings window lists the silenced question by the name of the command that asks it" },
    { "do": "expect", "control": "Ask Me Again", "in": "Turn Into Picture", "present": true },
    { "do": "snapshot", "name": "question-3-settings-lists-it", "window": "Settings" },

    { "do": "press", "control": "Ask Me Again", "in": "Turn Into Picture" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "5-turned-back-on", "note": "the row is gone and the page says the normal state in one sentence, rather than leaving a row of switches behind" },
    { "do": "expect", "control": "Ask Me Again", "present": false },
    { "do": "expect", "row": "Photonz is asking you every question it knows how to ask.", "present": true },
    { "do": "snapshot", "name": "question-4-nothing-silenced", "window": "Settings" },
    { "do": "action", "action": "closeSettings" },
    { "do": "wait", "seconds": 0.6 },

    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [200, 430], "to": [500, 610] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "tool", "tool": "select" },
    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "click", "at": [350, 520] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "action", "action": "turnIntoPicture" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "describe", "stage": "6-asks-again", "note": "THE POINT: the very next use of the command asks again, word for word as it did the first time" },
    { "do": "expect", "control": "Turn Into Picture", "in": "Sheet", "present": true },
    { "do": "expect", "control": "Don't ask again", "in": "Sheet", "present": true },
    { "do": "snapshot", "name": "question-5-asks-again" },
    { "do": "press", "control": "Cancel", "in": "Sheet" },
    { "do": "wait", "seconds": 0.6 }
  ]
}
