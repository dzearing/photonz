{
  "out": "/tmp/photonz-playtest/bucket-fills-the-enclosed-area",
  "seed": "The user drew four lines that crossed at the corners, merged them into the Background and clicked inside with the paint bucket: the whole picture turned the fill colour and the lines were gone. The bucket now floods the area round the click and stops at the lines, the way Photoshop's does. At Next defaults: Tolerance 32, Anti-alias on, Contiguous on.",
  "setup": {"forget": ["shapes", "panel", "tools", "color"]},
  "steps": [
    {"do": "blank", "canvasWidth": 1200, "canvasHeight": 800, "width": 1400, "height": 1000},
    {"do": "wait", "seconds": 1},
    {"do": "expectLayers", "count": 1},

    {"do": "tool", "tool": "line"},
    {"do": "drag", "from": [200, 150], "to": [900, 170], "steps": 8},
    {"do": "wait", "seconds": 0.4},
    {"do": "shortcut", "key": "e", "modifiers": ["command"], "menuItem": "Merge Down"},
    {"do": "wait", "seconds": 0.4},
    {"do": "tool", "tool": "line"},
    {"do": "drag", "from": [230, 120], "to": [210, 600], "steps": 8},
    {"do": "wait", "seconds": 0.4},
    {"do": "shortcut", "key": "e", "modifiers": ["command"], "menuItem": "Merge Down"},
    {"do": "wait", "seconds": 0.4},
    {"do": "tool", "tool": "line"},
    {"do": "drag", "from": [180, 570], "to": [900, 700], "steps": 8},
    {"do": "wait", "seconds": 0.4},
    {"do": "shortcut", "key": "e", "modifiers": ["command"], "menuItem": "Merge Down"},
    {"do": "wait", "seconds": 0.4},
    {"do": "tool", "tool": "line"},
    {"do": "drag", "from": [870, 140], "to": [880, 730], "steps": 8},
    {"do": "wait", "seconds": 0.4},
    {"do": "shortcut", "key": "e", "modifiers": ["command"], "menuItem": "Merge Down"},
    {"do": "wait", "seconds": 0.4},
    {"do": "expectLayers", "count": 1},
    {"do": "describe", "stage": "1-four-lines-in-the-background", "note": "four red lines crossing at the corners, all merged into the Background"},
    {"do": "render", "name": "1-merged"},

    {"do": "tool", "tool": "fill"},
    {"do": "wait", "seconds": 0.4},
    {"do": "snapshot", "name": "2-bucket-in-hand-window"},
    {"do": "click", "at": [500, 400]},
    {"do": "wait", "seconds": 1.5},
    {"do": "expectLayers", "count": 1},
    {"do": "describe", "stage": "3-filled-inside", "note": "THE TEST: only the box inside the lines took the fill; the lines and the white outside them are untouched, and the Background did not move"},
    {"do": "render", "name": "3-filled"},
    {"do": "snapshot", "name": "3-filled-window"},

    {"do": "shortcut", "key": "z", "modifiers": ["command"], "menuItem": "Undo"},
    {"do": "wait", "seconds": 0.6},
    {"do": "describe", "stage": "4-one-undo", "note": "one Undo takes the whole fill back"},
    {"do": "render", "name": "4-undone"},

    {"do": "click", "at": [1050, 400]},
    {"do": "wait", "seconds": 1.5},
    {"do": "describe", "stage": "5-filled-outside", "note": "a click outside the box fills the outside and leaves the inside white"},
    {"do": "render", "name": "5-outside"},
    {"do": "shortcut", "key": "z", "modifiers": ["command"], "menuItem": "Undo"},
    {"do": "wait", "seconds": 0.6},

    {"do": "tool", "tool": "line"},
    {"do": "drag", "from": [960, 80], "to": [1150, 80], "steps": 6},
    {"do": "wait", "seconds": 0.4},
    {"do": "shortcut", "key": "e", "modifiers": ["command"], "menuItem": "Merge Down"},
    {"do": "wait", "seconds": 0.4},
    {"do": "tool", "tool": "line"},
    {"do": "drag", "from": [970, 70], "to": [970, 260], "steps": 6},
    {"do": "wait", "seconds": 0.4},
    {"do": "shortcut", "key": "e", "modifiers": ["command"], "menuItem": "Merge Down"},
    {"do": "wait", "seconds": 0.4},
    {"do": "tool", "tool": "line"},
    {"do": "drag", "from": [1140, 70], "to": [1140, 260], "steps": 6},
    {"do": "wait", "seconds": 0.4},
    {"do": "shortcut", "key": "e", "modifiers": ["command"], "menuItem": "Merge Down"},
    {"do": "wait", "seconds": 0.4},
    {"do": "tool", "tool": "line"},
    {"do": "drag", "from": [960, 250], "to": [1040, 250], "steps": 6},
    {"do": "wait", "seconds": 0.4},
    {"do": "shortcut", "key": "e", "modifiers": ["command"], "menuItem": "Merge Down"},
    {"do": "wait", "seconds": 0.4},
    {"do": "tool", "tool": "fill"},
    {"do": "click", "at": [1050, 160]},
    {"do": "wait", "seconds": 1.5},
    {"do": "describe", "stage": "6-gap-leaks", "note": "a small box whose bottom line stops short: the fill leaks out through the gap into the white around it, as Photoshop's would, but never into the closed box"},
    {"do": "render", "name": "6-gap-leaks"},
    {"do": "snapshot", "name": "6-gap-leaks-window"},
    {"do": "shortcut", "key": "z", "modifiers": ["command"], "menuItem": "Undo"},
    {"do": "wait", "seconds": 0.6},
    {"do": "describe", "stage": "7-gap-undone", "note": "the leaked fill is one undo step too"},
    {"do": "render", "name": "7-gap-undone"},

    {"do": "windowClick", "at": [689, 919]},
    {"do": "wait", "seconds": 0.4},
    {"do": "snapshot", "name": "8-contiguous-off-window"},
    {"do": "click", "at": [500, 400]},
    {"do": "wait", "seconds": 1.5},
    {"do": "describe", "stage": "8-contiguous-off", "note": "Contiguous unticked with a pointer click on the checkbox in the bar above the tools, then a click inside the box: every white pixel on the Background takes the fill, inside and out, and the lines stay red"},
    {"do": "render", "name": "8-contiguous-off"},
    {"do": "shortcut", "key": "z", "modifiers": ["command"], "menuItem": "Undo"},
    {"do": "wait", "seconds": 0.6},
    {"do": "windowClick", "at": [689, 919]},
    {"do": "wait", "seconds": 0.4},

    {"do": "tool", "tool": "rectangle"},
    {"do": "drag", "from": [400, 300], "to": [600, 450]},
    {"do": "wait", "seconds": 0.6},
    {"do": "expectLayers", "count": 2},
    {"do": "tool", "tool": "fill"},
    {"do": "click", "at": [500, 375]},
    {"do": "wait", "seconds": 1.0},
    {"do": "describe", "stage": "9-shape-whole", "note": "a rectangle still takes the colour whole, as it did before: the flood is for pictures"},
    {"do": "render", "name": "9-shape-whole"}
  ]
}
