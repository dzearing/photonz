{
  "out": "/tmp/photonz-playtest/stack-and-grid",
  "steps": [
    { "do": "blank", "canvasWidth": 900, "canvasHeight": 700, "width": 1280, "height": 900 },
    { "do": "wait", "seconds": 1 },

    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [140, 90], "to": [340, 150], "steps": 8 },
    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [140, 190], "to": [300, 250], "steps": 8 },
    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [140, 320], "to": [360, 380], "steps": 8 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "1-rough", "note": "three rows drawn by hand, unevenly spaced: 40 between the first two, 70 between the next" },
    { "do": "snapshot", "name": "stack-1-rough" },
    { "do": "render", "name": "stack-1-rough-doc" },

    { "do": "drag", "from": [80, 50], "to": [520, 440], "steps": 10 },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "2-picked", "note": "all three picked with a rubber band" },

    { "do": "action", "action": "stackSelection" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "3-stacked", "note": "one press: they are one group that stacks itself. The Layout section should read Arrangement Stack, Direction Column, and a Gap read off what was already there (55, the average of 40 and 70). Vertical should say the stack owns it, and the top row should not have moved." },
    { "do": "snapshot", "name": "stack-2-stacked" },
    { "do": "render", "name": "stack-2-stacked-doc" },

    { "do": "focus", "field": "Gap" },
    { "do": "type", "text": "8" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "4-gap", "note": "typed 8: every gap should now be exactly 8, top row unmoved" },
    { "do": "snapshot", "name": "stack-3-gap-8" },
    { "do": "render", "name": "stack-3-gap-8-doc" },

    { "do": "action", "action": "gridSelection" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "5-grid", "note": "the same group as a grid: three cells across one row, and Columns, Column gap and Row gap as typed numbers" },
    { "do": "snapshot", "name": "stack-4-grid" },
    { "do": "render", "name": "stack-4-grid-doc" },

    { "do": "focus", "field": "Columns" },
    { "do": "type", "text": "2" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "6-two-columns", "note": "typed 2 columns: two across, then the third wrapping onto a second row" },
    { "do": "snapshot", "name": "stack-5-two-columns" },
    { "do": "render", "name": "stack-5-two-columns-doc" },

    { "do": "action", "action": "stackSelection" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "7-back-to-stack", "note": "back to a stack, which should still remember the gap of 8 that was typed" },
    { "do": "render", "name": "stack-6-back-doc" },

    { "do": "action", "action": "makeComponent" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "action", "action": "showComponentShelf" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "action", "action": "pickFirstComponent" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "action", "action": "insertPickedComponent" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "describe", "stage": "8-copy", "note": "the stack is now a component and a copy of it has been dropped: the copy should be stacked exactly like the original" },
    { "do": "snapshot", "name": "stack-7-copy" },
    { "do": "render", "name": "stack-7-copy-doc" },

    { "do": "action", "action": "selectComponentOriginal" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "action", "action": "stepIntoSelection" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "action", "action": "duplicateLayer" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "9-added", "note": "a fourth row added inside the original with no dragging: it should have taken its place in the column, 8 below its neighbour, and the COPY should have grown a fourth row in the same place" },
    { "do": "snapshot", "name": "stack-8-added" },
    { "do": "render", "name": "stack-8-added-doc" },

    { "do": "action", "action": "deleteLayer" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "10-removed", "note": "deleted again: the hole it left should have closed on its own" },
    { "do": "render", "name": "stack-9-removed-doc" },

    { "do": "action", "action": "undo" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "11-undone", "note": "one undo brings the row back AND re-opens its place, in one step" },
    { "do": "render", "name": "stack-10-undone-doc" },

    { "do": "drag", "from": [240, 188], "to": [240, 96], "steps": 12, "hold": "stack-11-dragging" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "12-reordered", "note": "the second row dragged up past the first: it should have TAKEN first place rather than snapping back where it was" },
    { "do": "snapshot", "name": "stack-11-reordered" },
    { "do": "render", "name": "stack-11-reordered-doc" },
    { "do": "menus", "stage": "layer-menu", "menu": "Layer" }
  ]
}
