{
  "out": "/tmp/photonz-playtest/track-column-resizes-walk",
  "seed": "The column of track names on the left of the timeline, at Next defaults with no flag set. A title over the recording, its track renamed V10, grouped with V1 so it is indented, and keyed so its header has the arrow: with the pointer on it the header carries everything a header can (arrow, name, hide, solo, lock, key diamond) and every pair is measured at least 4 points apart, the name V10 whole. Then the edge between the names and the lanes is dragged as far narrower as it goes and as far wider, measured and photographed at both; a double-click on the edge puts the default back; and a width dragged to is still there after the recording is closed and opened again, and is what the next launch would open at.",
  "setup": {
    "timelineOpen": true,
    "forget": ["all"]
  },
  "steps": [
    { "do": "action", "action": "openSampleRecording" },
    { "do": "wait", "seconds": 2.0 },
    { "do": "action", "action": "videoPause" },
    { "do": "action", "action": "videoSeekMiddle" },
    { "do": "tool", "tool": "text" },
    { "do": "click", "at": [620, 330] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "type", "text": "Shipping today" },
    { "do": "key", "key": "return", "modifiers": ["command"] },
    { "do": "wait", "seconds": 0.8 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "expectTimeline", "trackColumn": 140 },

    { "do": "press", "control": "Track Title", "count": 2 },
    { "do": "wait", "seconds": 0.5 },
    { "do": "type", "text": "V10" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "press", "control": "Track V10" },
    { "do": "press", "control": "Track V1", "modifiers": ["shift"] },
    { "do": "action", "action": "tracksGroupPicked" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "click", "at": [620, 330] },
    { "do": "wait", "seconds": 0.4 },
    { "do": "press", "control": "Key V10" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "move", "control": "Track V10" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "describe", "stage": "1-default", "note": "THE FIRST TEST: at the default width the fullest header (in a group, with its arrow, hide, solo, lock and the key diamond) shows V10 whole and nothing touches" },
    { "do": "expectApart", "controls": ["Track V10", "Track V10 Hide", "Track V10 Solo", "Track V10 Lock", "Key V10"], "gap": 4, "whole": ["Track V10"] },
    { "do": "snapshot", "name": "1-default" },

    { "do": "windowDrag", "from": [156, 850], "to": [40, 850], "steps": 10 },
    { "do": "wait", "seconds": 0.4 },
    { "do": "expectTimeline", "trackColumn": 123 },
    { "do": "move", "control": "Track V10" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "describe", "stage": "2-narrowest", "note": "THE SECOND TEST: the edge pulled hard left stops where the fullest header still fits with 4 points between everything and a few letters of the name" },
    { "do": "expectApart", "controls": ["Track V10", "Track V10 Hide", "Track V10 Solo", "Track V10 Lock", "Key V10"], "gap": 4, "whole": ["Track V10"] },
    { "do": "snapshot", "name": "2-narrowest" },

    { "do": "windowDrag", "from": [139, 850], "to": [520, 850], "steps": 12 },
    { "do": "wait", "seconds": 0.4 },
    { "do": "expectTimeline", "trackColumn": 320 },
    { "do": "move", "control": "Track V10" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "describe", "stage": "3-widest", "note": "THE THIRD TEST: the edge pulled hard right stops at its widest; the switches and the key stay on the right edge and the Time, group and Audio rows follow" },
    { "do": "expectApart", "controls": ["Track V10", "Track V10 Hide", "Track V10 Solo", "Track V10 Lock", "Key V10"], "gap": 4, "whole": ["Track V10"] },
    { "do": "snapshot", "name": "3-widest" },

    { "do": "windowClick", "at": [336, 850], "count": 2 },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "4-reset", "note": "THE FOURTH TEST: a double-click on the edge puts the default width back" },
    { "do": "expectTimeline", "trackColumn": 140 },

    { "do": "windowDrag", "from": [156, 850], "to": [216, 850], "steps": 8 },
    { "do": "wait", "seconds": 0.4 },
    { "do": "expectTimeline", "trackColumn": 200 },
    { "do": "action", "action": "closeDocument" },
    { "do": "action", "action": "openSampleRecording" },
    { "do": "wait", "seconds": 2.0 },
    { "do": "action", "action": "videoPause" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "describe", "stage": "5-remembered", "note": "THE FIFTH TEST: closed and opened again, the recording's timeline comes back with the names at the width they were dragged to, and that is the width on file for the next launch" },
    { "do": "expectTimeline", "trackColumn": 200 },
    { "do": "snapshot", "name": "5-remembered" }
  ]
}
