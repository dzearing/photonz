{
  "out": "/tmp/photonz-playtest/variant-follows-and-goes",
  "seed": "Two loose ends of a component asking two questions (Variant and Size), at Next defaults. A Badge gets a Secondary look and a Size question whose new drawing is called Large, so Secondary · Large is drawn and Default · Large is not. A copy set to Default and Large shows the nearest drawing, Secondary · Large. Then Default · Large is drawn on Edit Original and Done is pressed: the copy now shows Default · Large with no click. Then Size is taken away again with the minus on its row, clicked with the pointer: undo puts it back in one step, Done brings the copy back onto Default, and its panel asks Variant alone.",
  "setup": { "forget": ["all"] },
  "steps": [
    { "do": "blank", "canvasWidth": 1440, "canvasHeight": 1024, "width": 1240, "height": 900 },
    { "do": "appearance", "value": "dark" },
    { "do": "action", "action": "showComponentShelf" },
    { "do": "wait", "seconds": 1.2 },
    { "do": "dragTile", "tile": "Badge", "to": [420, 300] },
    { "do": "wait", "seconds": 1.5 },
    { "do": "expectPicked", "layers": ["Badge"] },

    { "do": "action", "action": "selectComponentOriginal" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "action", "action": "addComponentVersion" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "type", "text": "Secondary" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "action", "action": "fadeLayer" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "panelMenu", "menu": "Add Property", "choose": "New Variant Property" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "focus", "field": "Size name" },
    { "do": "key", "key": "a", "modifiers": ["command"] },
    { "do": "type", "text": "Large" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expect", "field": "Size name", "reads": "Large" },
    { "do": "action", "action": "doneEditingOriginal" },
    { "do": "wait", "seconds": 1.2 },

    { "do": "dragTile", "tile": "Badge", "to": [760, 620] },
    { "do": "wait", "seconds": 1.2 },
    { "do": "click", "at": [760, 620] },
    { "do": "wait", "seconds": 0.8 },
    { "do": "press", "control": "Large" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expect", "control": "Default", "in": "Variant", "reads": "Variant, already on Default, tooltip none" },
    { "do": "expect", "control": "Large", "reads": "Size, already on Large, tooltip none" },
    { "do": "expectShows", "drawing": "Secondary · Large" },
    { "do": "describe", "stage": "1-stand-in", "note": "a copy set to Default and Large: nobody drew Default · Large, so it shows the nearest drawing, the faded Secondary · Large" },
    { "do": "snapshot", "name": "1-stand-in-dark" },

    { "do": "action", "action": "selectComponentOriginal" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "press", "control": "Default", "in": "Variant" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "panelMenu", "menu": "Add Property", "choose": "Another Size" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "focus", "field": "Size name" },
    { "do": "key", "key": "a", "modifiers": ["command"] },
    { "do": "type", "text": "Large" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expect", "field": "Size name", "reads": "Large" },
    { "do": "describe", "stage": "2-drawn", "note": "Default · Large drawn on Edit Original: every cell of the grid filled" },
    { "do": "snapshot", "name": "2-drawn-dark" },
    { "do": "action", "action": "doneEditingOriginal" },
    { "do": "wait", "seconds": 1.2 },
    { "do": "click", "at": [760, 620] },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expectShows", "drawing": "Default · Large" },
    { "do": "expect", "control": "Large", "reads": "Size, already on Large, tooltip none" },
    { "do": "describe", "stage": "3-follows", "note": "after Done the copy shows the Default · Large drawing it asked for, with no click" },
    { "do": "snapshot", "name": "3-follows-dark" },

    { "do": "action", "action": "selectComponentOriginal" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "expect", "field": "Property name 2", "reads": "Size" },
    { "do": "panel", "stage": "4-remove-row" },
    { "do": "snapshot", "name": "4-remove-row-dark" },
    { "do": "press", "control": "Remove Size" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "expect", "field": "Property name 2", "present": false },
    { "do": "expect", "control": "Remove Size", "present": false },
    { "do": "expect", "field": "Property name", "present": true },
    { "do": "expect", "field": "Variant name", "reads": "Default" },
    { "do": "describe", "stage": "5-removed", "note": "Size taken away on Edit Original: the Large drawings folded into Default, the component asks Variant alone" },
    { "do": "snapshot", "name": "5-removed-dark" },
    { "do": "shortcut", "key": "z", "modifiers": ["command"], "menuItem": "Undo" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "expect", "field": "Property name 2", "reads": "Size" },
    { "do": "press", "control": "Remove Size" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "expect", "field": "Property name 2", "present": false },
    { "do": "action", "action": "doneEditingOriginal" },
    { "do": "wait", "seconds": 1.2 },
    { "do": "click", "at": [760, 620] },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expectShows", "drawing": "Default" },
    { "do": "expect", "control": "Large", "present": false },
    { "do": "expect", "control": "Secondary", "present": true },
    { "do": "describe", "stage": "6-fell-back", "note": "the copy that showed Default · Large falls back to Default, and its panel asks Variant alone" },
    { "do": "panel", "stage": "6-fell-back" },
    { "do": "snapshot", "name": "6-fell-back-dark" },
    { "do": "appearance", "value": "light" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "snapshot", "name": "7-fell-back-light" }
  ]
}
