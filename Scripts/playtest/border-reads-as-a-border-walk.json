{
  "out": "/tmp/photonz-playtest/border-reads-as-a-border",
  "setup": { "forget": ["shapes", "color", "panel"] },
  "steps": [
    { "do": "blank", "canvasWidth": 900, "canvasHeight": 600, "width": 1280, "height": 900 },
    { "do": "wait", "seconds": 1 },
    { "do": "key", "key": "r" },
    { "do": "drag", "from": [340, 300], "to": [560, 460] },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "1-fresh", "note": "a box just drawn: it is its fill and nothing else, and the Effects list is empty. No Border row saying 4 pt over a picture with no line in it" },
    { "do": "panel", "stage": "1-fresh" },
    { "do": "render", "name": "1-canvas-fresh" },
    { "do": "panelMenu", "menu": "Add Effect", "choose": "Border" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "2-border-added", "note": "one press of the plus and the ring is THERE: a graphite line round the red box, visible without a trip to the colour well" },
    { "do": "panel", "stage": "2-border-added" },
    { "do": "render", "name": "2-canvas-border-added" },
    { "do": "snapshot", "name": "2-border-added" },
    { "do": "press", "control": "Slider", "in": "@border, Width", "across": 0.3 },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "3-thicker", "note": "dragging Width now thickens a line you can already see, which is the whole complaint answered" },
    { "do": "render", "name": "3-canvas-thicker" },
    { "do": "snapshot", "name": "3-thicker" },
    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "key", "key": "r" },
    { "do": "drag", "from": [620, 120], "to": [820, 250] },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "4-next-box", "note": "the NEXT box wears the border you left on the last one, ink and width and all: the memory rule is untouched" },
    { "do": "panel", "stage": "4-next-box" },
    { "do": "render", "name": "4-canvas-next-box" },
    { "do": "snapshot", "name": "4-next-box" }
  ]
}
