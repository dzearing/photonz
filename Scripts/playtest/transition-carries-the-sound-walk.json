    },
    {
      "do": "action",
      "action": "soundExpectCutCarried"
    },
    {
      "do": "describe",
      "stage": "2-dissolve",
      "note": "THE TEST: a cross dissolve picked from the picker at the cut. The talk's sound runs on into its spare and fades out while the b-roll's starts early and fades in, crossing at equal power on the cut, the way the picture blends"
    },
    {
      "do": "snapshot",
      "name": "2-a-dissolve-carries-the-sound"
    },
    {
      "do": "action",
      "action": "soundExportMix"
    },
    {
      "do": "action",
      "action": "clipTransitionDipToBlack"
    },
    {
      "do": "wait",
      "seconds": 0.8
    },
    {
      "do": "action",
      "action": "soundExpectCutCarried"
    },
    {
      "do": "describe",
      "stage": "3-dip",
      "note": "A dip to black takes the sound through silence on the cut along with the picture"
    },
    {
      "do": "snapshot",
      "name": "3-a-dip-dips-the-sound"
    },
    {
      "do": "action",
