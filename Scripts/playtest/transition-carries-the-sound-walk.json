      "file": "scratch/b-roll.mp4",
      "track": "V1",
      "seconds": 6.95
    },
    {
      "do": "wait",
      "seconds": 1.0
    },
    {
      "do": "action",
      "action": "clipDragStartIn"
    },
    {
      "do": "wait",
      "seconds": 0.8
    },
    {
      "do": "expectClip",
      "clip": "b-roll",
      "track": "V1",
      "startsAt": 7.0,
      "count": 1
    },
    {
      "do": "action",
      "action": "clipPickEditPoint"
    },
    {
      "do": "wait",
      "seconds": 0.8
    },
    {
      "do": "action",
      "action": "soundExpectCutCarried"
    },
    {
      "do": "describe",
      "stage": "1-hard-cut",
      "note": "Two clips meet at 0:07 with nothing on the cut: the talk's sound stops on the cut and the b-roll's starts there"
    },
