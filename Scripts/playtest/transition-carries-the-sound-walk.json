    },
    {
      "do": "action",
      "action": "clipDragEndIn"
    },
    {
      "do": "wait",
      "seconds": 0.6
    },
    {
      "do": "expectClip",
      "clip": "Tutorial Sample",
      "track": "V1",
      "startsAt": 0.0,
      "endsAt": 7.0,
      "count": 1
    },
    {
