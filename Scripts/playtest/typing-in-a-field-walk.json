{
  "out": "/tmp/photonz-playtest/typing-in-a-field",
  "steps": [
    { "do": "open", "file": "../../Tests/PhotonzRenderTests/Fixtures/settings-pane-2x.png", "width": 1280, "height": 840 },
    { "do": "wait", "seconds": 1 },
    { "do": "action", "action": "selectCanvas" },
    { "do": "describe", "stage": "1-canvas", "note": "the canvas is picked, so the panel is showing W and H" },

    { "do": "focus", "field": "W" },

    { "do": "key", "key": "t" },
    { "do": "expect", "field": "W", "reads": "t" },
    { "do": "waitFor", "condition": "tool", "value": "select", "timeout": 2 },
    { "do": "describe", "stage": "2-typed-t", "note": "T went into the field and the Text tool was NOT picked up" },

    { "do": "key", "key": "x" },
    { "do": "expect", "field": "W", "reads": "tx" },
    { "do": "waitFor", "condition": "tool", "value": "select", "timeout": 2 },
    { "do": "describe", "stage": "3-typed-x", "note": "X went into the field too, so the fill colours did not swap" },

    { "do": "key", "key": "m", "modifiers": ["shift"] },
    { "do": "expect", "field": "W", "reads": "txM" },
    { "do": "waitFor", "condition": "tool", "value": "select", "timeout": 2 },
    { "do": "describe", "stage": "4-typed-shift-m", "note": "a capital letter types too: shift is how you get one, not a way of asking for the selection cycle" },

    { "do": "snapshot", "name": "typing-in-a-field" },

    { "do": "key", "key": "escape" },
    { "do": "key", "key": "t" },
    { "do": "waitFor", "condition": "tool", "value": "text", "timeout": 3 },
    { "do": "describe", "stage": "5-not-typing", "note": "with the field let go, the same letter picks the Text tool as it always did" },
    { "do": "snapshot", "name": "letter-picks-the-tool" }
  ]
}
