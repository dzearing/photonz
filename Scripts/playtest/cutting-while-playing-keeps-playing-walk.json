{
  "out": "/tmp/photonz-playtest/cutting-while-playing-keeps-playing-walk",
  "seed": "At Next defaults, no switch touched: Split at Playhead (Command B) pressed while a recording plays cuts the clip and play carries on, the way Final Cut's Blade and Premiere's Add Edit do. The sample recording opens, a real click on its clip on V1 picks it, Space plays, and Command B a second in cuts it in two with the playhead still moving. A second Command B further on makes three pieces, still playing. Space stops it, and Command Z twice puts the clip back whole.",
  "setup": {
    "timelineOpen": true,
    "forget": ["all"]
  },
  "steps": [
    { "do": "action", "action": "openSampleRecording" },
    { "do": "wait", "seconds": 2.0 },
    { "do": "action", "action": "videoPause" },
    { "do": "tool", "tool": "select" },
    { "do": "key", "key": "home" },
    { "do": "wait", "seconds": 0.6 },
    { "comment": "A real click on the clip, well inside it, picks it.", "do": "windowClick", "lane": "V1", "seconds": 4 },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectPicked", "layers": ["Tutorial Sample"] },
    { "do": "expectClip", "clip": "Tutorial Sample", "pieces": 1 },
    { "do": "key", "key": "home" },
    { "do": "key", "key": "space" },
    { "do": "wait", "seconds": 1.0, "onTheClock": true },
    { "do": "expectTimeline", "rate": 1.0 },
    { "comment": "Command B while it plays: the clip is cut and play carries on.", "do": "key", "key": "b", "modifiers": ["command"] },
    { "do": "wait", "seconds": 0.5, "onTheClock": true },
    { "do": "expectClip", "clip": "Tutorial Sample", "pieces": 2 },
    { "do": "expectTimeline", "rate": 1.0 },
    { "do": "describe", "stage": "1-cut-while-playing", "note": "Command B a second into play: the clip is in two pieces and the playhead is still moving" },
    { "do": "snapshot", "name": "1-cut-while-playing" },
    { "do": "wait", "seconds": 0.8, "onTheClock": true },
    { "do": "key", "key": "b", "modifiers": ["command"] },
    { "do": "wait", "seconds": 0.5, "onTheClock": true },
    { "do": "expectClip", "clip": "Tutorial Sample", "pieces": 3 },
    { "do": "expectTimeline", "rate": 1.0 },
    { "do": "key", "key": "space" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expectTimeline", "rate": 0 },
    { "do": "snapshot", "name": "2-two-cuts-stopped" },
    { "do": "shortcut", "key": "z", "modifiers": ["command"], "menuItem": "Undo" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "shortcut", "key": "z", "modifiers": ["command"], "menuItem": "Undo" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectClip", "clip": "Tutorial Sample", "pieces": 1 }
  ]
}
