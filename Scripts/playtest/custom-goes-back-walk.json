{
  "out": "/tmp/photonz-playtest/custom-goes-back",
  "seed": "A menu that says Custom lets you pick Custom. A bell whose pivot sits somewhere of its own reads Custom on its Around row; open the menu to see what Top centre looks like, pick it, and until 2026-10-02 there was no way back: Custom was a word the menu printed and would not offer. This walk tries Top centre and picks Custom to get the point back, twice: once for a point that came in with the document, once for a point the crosshair was just dragged to. Then it does the same round trip in New Frame: a size typed by hand, a preset tried over it, and Custom giving the typed size back. The pivot half is lock-safe (its menus are chosen inside the app); the New Frame half finds its two size boxes by name, so on a locked Mac it is refused there.",
  "setup": { "forget": ["all"] },
  "steps": [
    { "do": "open", "file": "fixtures/pivot-of-its-own.photonz", "width": 1320, "height": 900 },
    { "do": "wait", "seconds": 1.2 },
    { "do": "expectLayers", "count": 1 },
    { "do": "click", "at": [380, 280] },
    { "do": "wait", "seconds": 1 },
    { "do": "reveal", "control": "Around", "in": "Rotation" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expect", "control": "Around", "in": "Rotation", "reads": "Custom" },
    { "do": "expect", "field": "Around X", "reads": "380" },
    { "do": "expect", "field": "Around Y", "reads": "140" },

    { "do": "describe", "stage": "1-tried-a-named-spot", "note": "Top centre is picked from Around to see what it looks like. The row names it, and the point of your own is not gone: the menu keeps it." },
    { "do": "panelMenu", "menu": "Around", "choose": "Top centre" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expect", "control": "Around", "in": "Rotation", "reads": "Top centre" },
    { "do": "panel", "stage": "1-tried-a-named-spot" },
    { "do": "snapshot", "name": "1-tried-top-centre" },

    { "do": "describe", "stage": "2-custom-is-a-choice", "note": "THE PICTURE TO LOOK AT. Custom is picked from the same menu and the bell hangs from its own point again: Around reads Custom and At reads 380, 140, exactly where it came in." },
    { "do": "panelMenu", "menu": "Around", "choose": "Custom" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expect", "control": "Around", "in": "Rotation", "reads": "Custom" },
    { "do": "expect", "field": "Around X", "reads": "380" },
    { "do": "expect", "field": "Around Y", "reads": "140" },
    { "do": "panel", "stage": "2-custom-is-a-choice" },
    { "do": "snapshot", "name": "2-custom-gives-it-back" },

    { "do": "describe", "stage": "3-dragged-somewhere-new", "note": "the crosshair is dragged to a new point of its own, then Bottom centre is tried over it" },
    { "do": "drag", "from": [380, 140], "to": [440, 110], "steps": 14 },
    { "do": "wait", "seconds": 1 },
    { "do": "expect", "control": "Around", "in": "Rotation", "reads": "Custom" },
    { "do": "expect", "field": "Around X", "reads": "440" },
    { "do": "expect", "field": "Around Y", "reads": "110" },
    { "do": "panelMenu", "menu": "Around", "choose": "Bottom centre" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expect", "control": "Around", "in": "Rotation", "reads": "Bottom centre" },

    { "do": "describe", "stage": "4-the-dragged-point-comes-back", "note": "Custom gives back the point just dragged to, not the one the document came with: the newest point of your own wins." },
    { "do": "panelMenu", "menu": "Around", "choose": "Custom" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expect", "control": "Around", "in": "Rotation", "reads": "Custom" },
    { "do": "expect", "field": "Around X", "reads": "440" },
    { "do": "expect", "field": "Around Y", "reads": "110" },
    { "do": "panel", "stage": "4-the-dragged-point-comes-back" },
    { "do": "snapshot", "name": "4-dragged-point-back" },

    { "do": "describe", "stage": "5-new-frame", "note": "New Frame: 300 x 200 typed by hand, Desktop tried over it, and Custom giving 300 x 200 back. While Desktop is picked the Custom row shows the size it keeps." },
    { "do": "key", "key": "escape", "comment": "Nothing picked, so the panel has no Border Width for the focus step below to find before the dialog's own Width." },
    { "do": "wait", "seconds": 0.5 },
    { "do": "action", "action": "newFrameDialog" },
    { "do": "wait", "seconds": 0.9 },
    { "do": "press", "control": "Custom" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "focus", "field": "Width" },
    { "do": "type", "text": "300" },
    { "do": "focus", "field": "Height" },
    { "do": "type", "text": "200" },
    { "do": "focus", "field": "Width" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "press", "control": "Desktop" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "snapshot", "name": "5-desktop-tried" },
    { "do": "press", "control": "Custom" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "snapshot", "name": "6-custom-size-back" },
    { "do": "press", "control": "Add Frame" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "expectLayers", "count": 2 },
    { "do": "expectBox", "layer": "Frame", "size": [300, 200], "within": 1 },
    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "7-new-canvas", "note": "New Canvas: 640 x 480 typed by hand, Square tried over it, and Custom puts 640 x 480 back in the two boxes." },
    { "do": "action", "action": "newCanvasDialog" },
    { "do": "wait", "seconds": 0.9 },
    { "do": "press", "control": "Custom" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "focus", "field": "Width" },
    { "do": "type", "text": "640" },
    { "do": "focus", "field": "Height" },
    { "do": "type", "text": "480" },
    { "do": "focus", "field": "Width" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "press", "control": "Square" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "press", "control": "Custom" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "expect", "field": "Width", "reads": "640" },
    { "do": "expect", "field": "Height", "reads": "480" },
    { "do": "snapshot", "name": "7-new-canvas" },
    { "do": "action", "action": "closeSheets" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "8-new-video", "note": "New Video: the same round trip, 640 x 480 typed, 4K tried, Custom gives 640 x 480 back." },
    { "do": "action", "action": "newVideoDialog" },
    { "do": "wait", "seconds": 0.9 },
    { "do": "press", "control": "Custom" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "focus", "field": "Width" },
    { "do": "type", "text": "640" },
    { "do": "focus", "field": "Height" },
    { "do": "type", "text": "480" },
    { "do": "focus", "field": "Width" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "press", "control": "4K" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "press", "control": "Custom" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "expect", "field": "Width", "reads": "640" },
    { "do": "expect", "field": "Height", "reads": "480" },
    { "do": "snapshot", "name": "8-new-video" },
    { "do": "action", "action": "closeSheets" },
    { "do": "wait", "seconds": 0.5 }
  ]
}
