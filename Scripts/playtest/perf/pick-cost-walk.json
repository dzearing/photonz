{
 "out": "/tmp/photonz-playtest/pick-cost-walk",
 "setup": { "forget": ["all"] },
 "steps": [
  {
   "do": "describe",
   "stage": "why",
   "note": "A STOPWATCH, not a test, which is why it sits in perf/ and the sweep never runs it. Every other walk asserts a build COUNT because a time on a busy machine fails a walk that is fine (see expectBuilds); this one is here to be read by hand when somebody is working on what a pick costs the right hand panel. Run it, then read the mainBusy and longest numbers off the wait step after each click. It draws a box and two identical arrows and then picks back and forth, first between the two ARROWS, which show the same sections and the same rows, and then between the box and an arrow, which show the same sections and DIFFERENT rows. The difference between those two phases is what an arriving row costs; the size of either is what a pick costs."
  },
  { "do": "blank", "canvasWidth": 900, "canvasHeight": 700, "width": 1240, "height": 900 },
  { "do": "wait", "seconds": 0.8 },
  { "do": "tool", "tool": "rectangle" },
  { "do": "drag", "from": [140, 90], "to": [340, 150] },
  { "do": "wait", "seconds": 0.4 },
  { "do": "tool", "tool": "arrow" },
  { "do": "drag", "from": [160, 300], "to": [420, 420] },
  { "do": "wait", "seconds": 0.5 },
  { "do": "key", "key": "escape" },
  { "do": "wait", "seconds": 0.3 },
  { "do": "tool", "tool": "arrow" },
  { "do": "drag", "from": [520, 300], "to": [780, 420] },
  { "do": "wait", "seconds": 0.5 },
  { "do": "key", "key": "escape" },
  { "do": "wait", "seconds": 0.3 },
  { "do": "tool", "tool": "select" },
  { "do": "wait", "seconds": 0.8 },

  { "do": "describe", "stage": "phase-same-rows", "note": "one arrow, then the other: the same sections and the same rows" },
  { "do": "click", "at": [290, 360] }, { "do": "wait", "seconds": 0.5 },
  { "do": "click", "at": [650, 360] }, { "do": "wait", "seconds": 0.5 },
  { "do": "click", "at": [290, 360] }, { "do": "wait", "seconds": 0.5 },
  { "do": "click", "at": [650, 360] }, { "do": "wait", "seconds": 0.5 },
  { "do": "click", "at": [290, 360] }, { "do": "wait", "seconds": 0.5 },
  { "do": "click", "at": [650, 360] }, { "do": "wait", "seconds": 0.5 },
  { "do": "click", "at": [290, 360] }, { "do": "wait", "seconds": 0.5 },
  { "do": "click", "at": [650, 360] }, { "do": "wait", "seconds": 0.5 },
  { "do": "click", "at": [290, 360] }, { "do": "wait", "seconds": 0.5 },
  { "do": "click", "at": [650, 360] }, { "do": "wait", "seconds": 0.5 },
  { "do": "click", "at": [290, 360] }, { "do": "wait", "seconds": 0.5 },
  { "do": "click", "at": [650, 360] }, { "do": "wait", "seconds": 0.5 },
  { "do": "expectPicked", "layers": ["Arrow 2"] },

  { "do": "describe", "stage": "phase-different-rows", "note": "the box, then an arrow: the same sections, different rows in Appearance" },
  { "do": "click", "at": [240, 120] }, { "do": "wait", "seconds": 0.5 },
  { "do": "click", "at": [290, 360] }, { "do": "wait", "seconds": 0.5 },
  { "do": "click", "at": [240, 120] }, { "do": "wait", "seconds": 0.5 },
  { "do": "click", "at": [290, 360] }, { "do": "wait", "seconds": 0.5 },
  { "do": "click", "at": [240, 120] }, { "do": "wait", "seconds": 0.5 },
  { "do": "click", "at": [290, 360] }, { "do": "wait", "seconds": 0.5 },
  { "do": "click", "at": [240, 120] }, { "do": "wait", "seconds": 0.5 },
  { "do": "click", "at": [290, 360] }, { "do": "wait", "seconds": 0.5 },
  { "do": "click", "at": [240, 120] }, { "do": "wait", "seconds": 0.5 },
  { "do": "click", "at": [290, 360] }, { "do": "wait", "seconds": 0.5 },
  { "do": "click", "at": [240, 120] }, { "do": "wait", "seconds": 0.5 },
  { "do": "click", "at": [290, 360] }, { "do": "wait", "seconds": 0.5 },
  { "do": "describe", "stage": "done", "note": "twenty four picks, twelve of each kind" }
 ]
}
