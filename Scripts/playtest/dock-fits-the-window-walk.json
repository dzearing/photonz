{
  "out": "/tmp/photonz-playtest/dock-fits-the-window",
  "seed": "The right hand panel has to fit in the window it is given, so that the look controls at the bottom of it are there when you reach for them instead of being somewhere below the fold. The window is opened as tall as this display allows and the panel is then asked for every shape it takes in a day's work: one piece of text picked, two, four at once, an arrow, a zoom callout, and a document with fifteen layers in it. At each of those the walk reads the dock's own section offsets back rather than photographing them, so 'Effects is on screen' is a number and not an opinion, and it waits for the Effects section to be wholly inside the panel before it says so. The last stage is the real test of the rule: fifteen layers must scroll inside the Layers list rather than pushing everything under it off the bottom.",
  "steps": [
    { "do": "blank", "canvasWidth": 900, "canvasHeight": 600, "width": 1360, "height": 1180 },
    { "do": "wait", "seconds": 1 },

    { "do": "tool", "tool": "text" },
    { "do": "click", "at": [140, 130] },
    { "do": "type", "text": "Sign in" },
    { "do": "key", "key": "return", "modifiers": ["command"] },
    { "do": "wait", "seconds": 0.5 },

    { "do": "tool", "tool": "text" },
    { "do": "click", "at": [140, 300] },
    { "do": "type", "text": "Use your account" },
    { "do": "key", "key": "return", "modifiers": ["command"] },
    { "do": "wait", "seconds": 0.5 },

    { "do": "tool", "tool": "select" },
    { "do": "click", "at": [180, 145] },
    { "do": "wait", "seconds": 1.2 },
    { "do": "panel", "stage": "one-text" },
    { "do": "describe", "stage": "1-one-text", "note": "one piece of text picked. Effects is wholly inside the panel, so Corner Radius is there without a scroll." },
    { "do": "snapshot", "name": "1-one-text" },

    { "do": "click", "at": [200, 312], "modifiers": ["shift"] },
    { "do": "wait", "seconds": 1.2 },
    { "do": "panel", "stage": "two-text" },
    { "do": "describe", "stage": "2-two-text", "note": "two pieces of text picked, which also brings an Arrange section in. Effects still whole." },
    { "do": "snapshot", "name": "2-two-text" },

    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [420, 120], "to": [600, 240], "steps": 8 },
    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [420, 300], "to": [600, 420], "steps": 8 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "key", "key": "a", "modifiers": ["command"] },
    { "do": "wait", "seconds": 1.2 },
    { "do": "panel", "stage": "four-picked" },
    { "do": "describe", "stage": "3-four-picked", "note": "four layers picked at once, which is the fullest the dock gets for a mixed selection." },
    { "do": "snapshot", "name": "3-four-picked" },

    { "do": "tool", "tool": "arrow" },
    { "do": "drag", "from": [200, 450], "to": [400, 520], "steps": 8 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "wait", "seconds": 1.2 },
    { "do": "panel", "stage": "arrow" },
    { "do": "describe", "stage": "4-arrow", "note": "an arrow picked, which brings its own Arrow section with a head, a thickness and a caption." },
    { "do": "snapshot", "name": "4-arrow" },

    { "do": "tool", "tool": "zoomCallout" },
    { "do": "drag", "from": [620, 440], "to": [800, 560], "steps": 10 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "wait", "seconds": 1.2 },
    { "do": "panel", "stage": "callout" },
    { "do": "describe", "stage": "5-callout", "note": "a zoom callout picked, which brings a Zoom Callout section on top of everything else." },
    { "do": "snapshot", "name": "5-callout" },

    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [60, 60], "to": [120, 100], "steps": 4 },
    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [60, 120], "to": [120, 160], "steps": 4 },
    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [60, 180], "to": [120, 220], "steps": 4 },
    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [60, 240], "to": [120, 280], "steps": 4 },
    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [60, 300], "to": [120, 340], "steps": 4 },
    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [60, 360], "to": [120, 400], "steps": 4 },
    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [60, 420], "to": [120, 460], "steps": 4 },
    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [60, 480], "to": [120, 520], "steps": 4 },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "click", "at": [90, 500] },
    { "do": "wait", "seconds": 1.2 },
    { "do": "panel", "stage": "many-layers" },
    { "do": "describe", "stage": "6-many-layers", "note": "fifteen layers in the document with one of them picked. The rule this whole change is for: the Layers list scrolls inside itself and Effects stays where it was, instead of the list carrying it off the bottom." },
    { "do": "snapshot", "name": "6-many-layers" }
  ]
}
