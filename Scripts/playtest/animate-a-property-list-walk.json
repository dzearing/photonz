    { "do": "action", "action": "videoSeekStart" },
    { "do": "action", "action": "videoStepOneSecond" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "key", "key": "t" },
    { "do": "click", "at": [620, 330] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "type", "text": "Lift off" },
    { "do": "key", "key": "return", "modifiers": ["command"] },
    { "do": "wait", "seconds": 1.0 },
    { "do": "reveal", "control": "Properties section" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "press", "control": "Animate a property" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "1-title-two-shadows", "note": "THE FIRST PICTURE: a typed title wears two shadows, and Animate a property lists every value it can key, Shadow 1's and Shadow 2's numbered the way the Effects list numbers them" },
    { "do": "expect", "control": "Position", "in": "Animate a property", "present": true },
    { "do": "expect", "control": "Opacity", "in": "Animate a property", "present": true },
    { "do": "expect", "control": "Blur", "in": "Animate a property", "present": true },
    { "do": "expect", "control": "Shadow 2 color", "in": "Animate a property", "present": true },
    { "do": "expect", "control": "Swatch", "in": "Color", "present": true },
    { "do": "expect", "control": "Swatch", "in": "Shadow 2 color", "present": true },
    { "do": "expect", "control": "Swatch", "in": "Opacity", "present": false },
    { "do": "expect", "control": "Text size", "in": "Animate a property", "present": true },
    { "do": "snapshot", "name": "1-title-two-shadows" },
