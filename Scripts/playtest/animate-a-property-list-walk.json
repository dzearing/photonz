    { "do": "expect", "control": "Centre", "in": "Animate a property", "present": true },
    { "do": "expect", "control": "Border width", "in": "Animate a property", "present": true },
    { "do": "expect", "control": "Border color", "in": "Animate a property", "present": true },
    { "do": "expect", "control": "Swatch", "in": "Border color", "present": true },
    { "do": "expect", "control": "Swatch", "in": "Border width", "present": false },
