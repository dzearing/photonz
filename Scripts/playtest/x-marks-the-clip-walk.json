{
  "out": "/tmp/photonz-playtest/x-marks-the-clip-walk",
  "seed": "X marks the clip under the playhead and Shift I and Shift O go to the marks, Premiere's Mark Clip, Go to In and Go to Out. At Next defaults, no flag set. After a click on the picture X is Photoshop's fill swap again.",
  "setup": { "forget": ["all"] },
  "steps": [
    { "do": "action", "action": "openSampleRecording" },
    { "do": "wait", "seconds": 2.0 },
    { "do": "action", "action": "videoPause" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectTimeline", "keyboard": "timeline", "lengthMS": 8000 },

    { "do": "action", "action": "videoSeekQuarter" },
    { "do": "key", "key": "k", "modifiers": ["command"] },
    { "do": "action", "action": "videoSeekMiddle" },
    { "do": "key", "key": "k", "modifiers": ["command"] },
    { "do": "action", "action": "videoSeekQuarter" },
    { "do": "key", "key": "right", "modifiers": ["shift"] },
    { "do": "key", "key": "right", "modifiers": ["shift"] },
    { "do": "key", "key": "right", "modifiers": ["shift"] },
    { "do": "key", "key": "right", "modifiers": ["shift"] },
    { "do": "key", "key": "right", "modifiers": ["shift"] },
    { "do": "key", "key": "right", "modifiers": ["shift"] },
    { "do": "wait", "seconds": 0.3 },
    { "do": "expectTimeline", "playheadMS": 3000, "withinMS": 40, "hasIn": false, "hasOut": false },
    { "do": "describe", "stage": "0-cut-twice", "note": "an eight second recording at Next defaults, cut at two and at four seconds, the playhead parked at three, in the middle piece. Nothing is marked yet" },
    { "do": "snapshot", "name": "0-cut-at-two-and-four" },

    { "do": "key", "key": "x" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expectTimeline", "markInMS": 2000, "markOutMS": 4000, "playheadMS": 3000, "withinMS": 40, "keyboard": "timeline" },
    { "do": "describe", "stage": "1-x-marked-the-piece", "note": "one press of X, Premiere's Mark Clip: the In sits on the cut at two seconds and the Out on the cut at four, so the middle piece is shaded on the ruler. The playhead did not move" },
    { "do": "snapshot", "name": "1-x-marks-two-to-four" },

    { "do": "shortcut", "key": "z", "modifiers": ["command"], "menuItem": "Undo" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expectTimeline", "hasIn": false, "hasOut": false, "lengthMS": 8000 },
    { "do": "describe", "stage": "2-undone", "note": "Command Z took both marks back in one step" },
    { "do": "key", "key": "x" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expectTimeline", "markInMS": 2000, "markOutMS": 4000 },

    { "do": "key", "key": "'" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "expectTimeline", "lengthMS": 6000, "playheadMS": 2000, "withinMS": 40, "hasIn": false, "hasOut": false },
    { "do": "describe", "stage": "3-extracted", "note": "the apostrophe, Premiere's Extract, took the marked piece out and closed the gap: the recording reads six seconds and the playhead sits on the join" },
    { "do": "snapshot", "name": "3-extracted-reads-six-seconds" },

    { "do": "action", "action": "videoSeekMiddle" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "key", "key": "x" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expectTimeline", "markInMS": 2000, "markOutMS": 6000 },
    { "do": "key", "key": "i", "modifiers": ["shift"] },
    { "do": "wait", "seconds": 0.3 },
    { "do": "expectTimeline", "playheadMS": 2000, "withinMS": 40, "keyboard": "timeline", "rate": 0 },
    { "do": "describe", "stage": "4-shift-i", "note": "X marked the last piece, two seconds to the end, and Shift I took the playhead back to its In at two seconds" },
    { "do": "snapshot", "name": "4-shift-i-on-the-in" },
    { "do": "key", "key": "o", "modifiers": ["shift"] },
    { "do": "wait", "seconds": 0.3 },
    { "do": "expectTimeline", "playheadMS": 5967, "withinMS": 40, "keyboard": "timeline" },
    { "do": "describe", "stage": "5-shift-o", "note": "Shift O took the playhead to the Out, the last frame of the recording" },
    { "do": "snapshot", "name": "5-shift-o-on-the-out" },

    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "expectTimeline", "hasIn": false, "hasOut": false },
    { "do": "action", "action": "videoSeekQuarter" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "key", "key": "i", "modifiers": ["shift"] },
    { "do": "key", "key": "o", "modifiers": ["shift"] },
    { "do": "wait", "seconds": 0.3 },
    { "do": "expectTimeline", "playheadMS": 1500, "withinMS": 40, "hasIn": false, "hasOut": false },
    { "do": "describe", "stage": "6-no-marks-nothing-moves", "note": "with the marks cleared, Shift I and Shift O did nothing: the playhead stayed where it was and nothing was said" },

    { "do": "describe", "stage": "7-fills-before", "note": "the fill pair before the picture is clicked" },
    { "do": "click", "at": [640, 300] },
    { "do": "wait", "seconds": 0.3 },
    { "do": "expectTimeline", "keyboard": "canvas" },
    { "do": "key", "key": "x" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expectTimeline", "keyboard": "canvas", "hasIn": false, "hasOut": false },
    { "do": "describe", "stage": "8-x-on-the-canvas", "note": "after a click on the picture X is Photoshop's again: the fill pair swapped and nothing was marked" }
  ]
}
