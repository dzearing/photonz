{
  "out": "/tmp/photonz-playtest/ask-makes-a-pricing-section-walk",
  "seed": "Ask on a blank canvas at Next defaults, the mock's own request (agent-generate-wt.html): 'Make a pricing section on brand'. The plan lands in the Agent group with nothing run, Run Plan builds it from the Library's components and styles where it can, and one undo takes the whole section back. Needs Ollama with a model Ask plans with (docs/design/ask.md).",
  "clock": 420,
  "setup": {
    "forget": [
      "all"
    ]
  },
  "steps": [
    {
      "do": "blank",
      "canvasWidth": 1440,
      "canvasHeight": 900,
      "width": 1280,
      "height": 840
    },
    {
      "do": "wait",
      "seconds": 1
    },
    {
      "do": "press",
      "control": "Ask"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "type",
      "text": "Make a pricing section on brand"
    },
    {
      "do": "wait",
      "seconds": 0.3
    },
    {
      "do": "press",
      "control": "Ask Send"
    },
    {
      "do": "waitFor",
      "condition": "askPhase",
      "value": "ran|stopped",
      "timeout": 300
    },
    {
      "do": "describe",
      "stage": "run-ended",
      "note": "where the request ended: it runs as soon as the model is done, with no Run Plan"
    },
    {
      "do": "waitFor",
      "condition": "askPhase",
      "value": "ran",
      "timeout": 1
    },
    {
      "do": "wait",
      "seconds": 0.8
    },
    {
      "do": "describe",
      "stage": "1-ran",
      "note": "the pricing section on the canvas, and one row in the Agent group saying what changed"
    },
    {
      "do": "expect",
      "control": "Agent Change 1",
      "present": true
    },
    {
      "do": "expect",
      "control": "Ask Step 1",
      "present": false
    },
    {
      "do": "expect",
      "control": "Run Plan",
      "present": false
    },
    {
      "do": "expectLayers",
      "atLeast": 2
    },
    {
      "do": "snapshot",
      "name": "1-ran"
    },
    {
      "do": "action",
      "action": "undo"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "describe",
      "stage": "2-undone",
      "note": "one Command Z took the whole request back, and its row reads off"
    },
    {
      "do": "expectLayers",
      "count": 1
    },
    {
      "do": "expect",
      "control": "Agent Change 1 Switch",
      "reads": "off"
    },
    {
      "do": "action",
      "action": "redo"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "expect",
      "control": "Agent Change 1 Switch",
      "reads": "on"
    },
    {
      "do": "expectLayers",
      "atLeast": 2
    },
    {
      "do": "press",
      "control": "Agent Change 1 Switch"
    },
    {
      "do": "wait",
      "seconds": 0.6
    },
    {
      "do": "describe",
      "stage": "3-off",
      "note": "the row's switch turned the change off: the document reads as before the request"
    },
    {
      "do": "expect",
      "control": "Agent Change 1 Switch",
      "reads": "off"
    },
    {
      "do": "expectLayers",
      "count": 1
    },
    {
      "do": "snapshot",
      "name": "3-off"
    },
    {
      "do": "press",
      "control": "Agent Change 1 Switch"
    },
    {
      "do": "wait",
      "seconds": 0.6
    },
    {
      "do": "describe",
      "stage": "4-on",
      "note": "the switch put the change back"
    },
    {
      "do": "expect",
      "control": "Agent Change 1 Switch",
      "reads": "on"
    },
    {
      "do": "expectLayers",
      "atLeast": 2
    },
    {
      "do": "snapshot",
      "name": "4-on"
    },
    {
      "do": "press",
      "control": "Agent Change 1 Delete"
    },
    {
      "do": "wait",
      "seconds": 0.6
    },
    {
      "do": "describe",
      "stage": "5-deleted",
      "note": "delete took the change out and the row went"
    },
    {
      "do": "expect",
      "control": "Agent Change 1",
      "present": false
    },
    {
      "do": "expectLayers",
      "count": 1
    },
    {
      "do": "snapshot",
      "name": "5-deleted"
    },
    {
      "do": "action",
      "action": "undo"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "describe",
      "stage": "6-delete-undone",
      "note": "undoing the delete brought the change and its row back"
    },
    {
      "do": "expect",
      "control": "Agent Change 1",
      "present": true
    },
    {
      "do": "expectLayers",
      "atLeast": 2
    }
  ]
}
