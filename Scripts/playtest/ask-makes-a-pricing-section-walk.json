{
  "out": "/tmp/photonz-playtest/ask-makes-a-pricing-section-walk",
  "seed": "Ask on a blank canvas at Next defaults, the mock's own request (agent-generate-wt.html): 'Make a pricing section on brand'. The plan lands in the Agent group with nothing run, Run Plan builds it from the Library's components and styles where it can, and one undo takes the whole section back. Needs Ollama with a model Ask plans with (docs/design/ask.md).",
  "clock": 540,
  "setup": {
    "forget": [
      "all"
    ]
  },
  "steps": [
    {
      "do": "blank",
      "canvasWidth": 1440,
      "canvasHeight": 900,
      "width": 1280,
      "height": 840
    },
    {
      "do": "wait",
      "seconds": 1
    },
    {
      "do": "press",
      "control": "Ask"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "type",
      "text": "Make a pricing section on brand"
    },
    {
      "do": "wait",
      "seconds": 0.3
    },
    {
      "do": "press",
      "control": "Ask Send"
    },
    {
      "do": "waitFor",
      "condition": "askPhase",
      "value": "ran|stopped",
      "timeout": 420
    },
    {
      "do": "describe",
      "stage": "run-ended",
      "note": "where the request ended: it runs as soon as the model is done, with no Run Plan"
    },
    {
      "do": "waitFor",
      "condition": "askPhase",
      "value": "ran",
      "timeout": 1
    },
    {
      "do": "wait",
      "seconds": 0.8
    },
    {
      "do": "describe",
      "stage": "1-ran",
      "note": "the pricing section on the canvas, and one row in the Agent group saying what changed"
    },
    {
      "do": "expect",
      "control": "Agent Change 1",
      "present": true
    },
    {
      "do": "expect",
      "control": "Ask Step 1",
      "present": false
    },
    {
      "do": "expect",
      "control": "Run Plan",
      "present": false
    },
    {
      "do": "expectLayers",
      "atLeast": 2
    },
    {
      "do": "snapshot",
      "name": "1-ran"
    },
    {
      "do": "action",
      "action": "undo"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "describe",
      "stage": "2-undone",
      "note": "one Command Z took the whole request back, and its row reads undone"
    },
    {
      "do": "expectLayers",
      "count": 1
    },
    {
      "do": "expect",
      "control": "Agent Change 1 State",
      "reads": "undone"
    },
    {
      "do": "action",
      "action": "redo"
    },
    {
      "do": "wait",
      "seconds": 0.5
    },
    {
      "do": "expect",
      "control": "Agent Change 1 State",
      "reads": "standing"
    },
    {
      "do": "expectLayers",
      "atLeast": 2
    }
  ]
}
