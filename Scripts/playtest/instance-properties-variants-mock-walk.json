{
  "out": "/tmp/photonz-playtest/instance-properties-variants-mock",
  "seed": "The variants mock (ui-variants.html) draws what you see when you pick a component instance: Component with a linked badge, the main as a field with a chevron and Make Unique beside it, the variant as a segmented control under a small caps label, the instance's own knobs under Instance properties, and Reset props. This walk drops a Button at Next defaults and photographs that panel in dark and light, gives the Button two more looks, picks Secondary on an instance with the pointer, undoes it in one step, resets it, and photographs the field turning into a swap menu once a Card is in the document too.",
  "setup": { "forget": ["all"] },
  "steps": [
    { "do": "blank", "canvasWidth": 1440, "canvasHeight": 1024, "width": 1240, "height": 900 },
    { "do": "appearance", "value": "dark" },
    { "do": "action", "action": "showComponentShelf" },
    { "do": "wait", "seconds": 1.2 },
    { "do": "dragTile", "tile": "Button", "to": [420, 300] },
    { "do": "wait", "seconds": 1.5 },
    { "do": "expectPicked", "layers": ["Button"] },
    { "do": "describe", "stage": "1-instance", "note": "the picked Button: Component header says linked, the field reads Button with a chevron, Make Unique beside it, Label under Instance properties, Reset props dimmed" },
    { "do": "expect", "field": "Component header", "reads": "linked" },
    { "do": "expect", "control": "Edit Original", "present": true },
    { "do": "expect", "control": "Make Unique", "present": true },
    { "do": "expect", "control": "Reset Props", "present": true },
    { "do": "panel", "stage": "1-instance" },
    { "do": "snapshot", "name": "1-instance-dark" },
    { "do": "appearance", "value": "light" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "snapshot", "name": "2-instance-light" },
    { "do": "appearance", "value": "dark" },
    { "do": "wait", "seconds": 0.5 },

    { "do": "action", "action": "selectComponentOriginal" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "action", "action": "addComponentVersion" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "type", "text": "Secondary" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "action", "action": "fadeLayer" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "action", "action": "addComponentVersion" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "type", "text": "Ghost" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "action", "action": "doneEditingOriginal" },
    { "do": "wait", "seconds": 1.2 },

    { "do": "dragTile", "tile": "Button", "to": [760, 620] },
    { "do": "wait", "seconds": 1.2 },
    { "do": "click", "at": [760, 620] },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "3-variants", "note": "an instance of a Button with three looks: VARIANT in small capitals over a segmented control reading Default | Secondary | Ghost, Default lit" },
    { "do": "panel", "stage": "3-variants" },
    { "do": "snapshot", "name": "3-variants-dark" },

    { "do": "press", "control": "Secondary" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expect", "control": "Secondary", "reads": "Variant, already on Secondary, tooltip none" },
    { "do": "describe", "stage": "4-secondary", "note": "Secondary picked with the pointer: the chip moved and the instance on the canvas is the faded drawing" },
    { "do": "snapshot", "name": "4-secondary-dark" },
    { "do": "render", "name": "4-secondary-doc" },
    { "do": "appearance", "value": "light" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "snapshot", "name": "5-secondary-light" },
    { "do": "appearance", "value": "dark" },
    { "do": "wait", "seconds": 0.5 },

    { "do": "shortcut", "key": "z", "modifiers": ["command"], "menuItem": "Undo" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expect", "control": "Default", "reads": "Variant, already on Default, tooltip none" },

    { "do": "press", "control": "Ghost" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expect", "control": "Ghost", "reads": "Variant, already on Ghost, tooltip none" },
    { "do": "press", "control": "Reset Props" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expect", "control": "Default", "reads": "Variant, already on Default, tooltip none" },
    { "do": "describe", "stage": "6-reset", "note": "Reset props put the instance back on Default" },
    { "do": "snapshot", "name": "6-reset-dark" },

    { "do": "dragTile", "tile": "Card", "to": [1100, 300] },
    { "do": "wait", "seconds": 1.2 },
    { "do": "click", "at": [760, 620] },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "7-swap", "note": "with a Card in the document too, the Button field is a menu: Edit Original, then Swap To with Button ticked and Card" },
    { "do": "expect", "control": "Component", "present": true },
    { "do": "panelMenu", "menu": "Component", "at": ["centre", "start", "end"], "choose": "Edit Original" },
    { "do": "wait", "seconds": 1.2 },
    { "do": "describe", "stage": "8-original", "note": "Edit Original from the field's menu opened the Button's original on its own" },
    { "do": "snapshot", "name": "8-original" }
  ]
}
