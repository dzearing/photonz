{
  "out": "/tmp/photonz-playtest/pen-on-the-grid-walk",
  "setup": {
    "forget": ["grid", "tools", "panel"]
  },
  "steps": [
    { "do": "appearance", "value": "light" },
    { "do": "blank", "canvasWidth": 900, "canvasHeight": 700, "width": 1240, "height": 900 },
    { "do": "wait", "seconds": 0.6 },

    { "do": "action", "action": "selectCanvas" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "press", "control": "Show grid" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "describe", "stage": "grid-on-default", "note": "default grid at 100%: the canvas draws 32s, so a Pen point should land on a multiple of 32" },

    { "do": "key", "key": "p" },
    { "do": "waitFor", "condition": "tool", "value": "pen" },
    { "do": "click", "at": [131, 67] },
    { "do": "wait", "seconds": 0.2 },
    { "do": "move", "at": [355, 71] },
    { "do": "wait", "seconds": 0.3 },
    { "do": "describe", "stage": "preview-on-the-line", "note": "one point down at a rough 131,67 and the run to the pointer already reaches 352,64: the preview shows where the click will land before it commits" },
    { "do": "snapshot", "name": "pen-grid-1-preview" },

    { "do": "click", "at": [355, 71] },
    { "do": "wait", "seconds": 0.2 },
    { "do": "click", "at": [358, 290] },
    { "do": "wait", "seconds": 0.2 },
    { "do": "click", "at": [129, 293] },
    { "do": "wait", "seconds": 0.2 },
    { "do": "move", "at": [139, 74] },
    { "do": "wait", "seconds": 0.3 },
    { "do": "describe", "stage": "close-offered", "note": "the pointer is 15 points from the first corner, further than the 8 a click gets on its own, but the grid puts it exactly on that corner: the ring says so" },
    { "do": "snapshot", "name": "pen-grid-2-close-offered" },

    { "do": "click", "at": [139, 74] },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expectPath", "anchors": 4, "closed": true, "curves": 0 },
    { "do": "expectPath", "anchor": 0, "near": [128, 64], "within": 0.5 },
    { "do": "expectPath", "anchor": 1, "near": [352, 64], "within": 0.5 },
    { "do": "expectPath", "anchor": 2, "near": [352, 288], "within": 0.5 },
    { "do": "expectPath", "anchor": 3, "near": [128, 288], "within": 0.5 },
    { "do": "describe", "stage": "square-on-whole-steps", "note": "four corners clicked roughly at 131,67 / 355,71 / 358,290 / 129,293 came out at 128,64 / 352,64 / 352,288 / 128,288 — every one a whole 32 step, so the box is 224 by 224 rather than a fraction off on all four sides" },
    { "do": "snapshot", "name": "pen-grid-3-square" },

    { "do": "key", "key": "p" },
    { "do": "waitFor", "condition": "tool", "value": "pen" },
    { "do": "click", "at": [300, 505], "modifiers": ["command"] },
    { "do": "wait", "seconds": 0.2 },
    { "do": "click", "at": [503, 517], "modifiers": ["command"] },
    { "do": "wait", "seconds": 0.2 },
    { "do": "click", "at": [451, 601], "modifiers": ["command"] },
    { "do": "wait", "seconds": 0.2 },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expectPath", "anchors": 3, "closed": false },
    { "do": "expectPath", "anchor": 0, "near": [300, 505], "within": 0.5 },
    { "do": "expectPath", "anchor": 1, "near": [503, 517], "within": 0.5 },
    { "do": "expectPath", "anchor": 2, "near": [451, 601], "within": 0.5 },
    { "do": "describe", "stage": "command-places-it-exactly", "note": "Command held on every click: the three points are exactly where the pointer was, off every line, the same escape a drag has" },

    { "do": "action", "action": "selectCanvas" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "press", "control": "Snap to grid" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "key", "key": "p" },
    { "do": "waitFor", "condition": "tool", "value": "pen" },
    { "do": "click", "at": [201, 611] },
    { "do": "wait", "seconds": 0.2 },
    { "do": "click", "at": [277, 643] },
    { "do": "wait", "seconds": 0.2 },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "expectPath", "anchors": 2, "closed": false },
    { "do": "expectPath", "anchor": 0, "near": [201, 611], "within": 0.5 },
    { "do": "expectPath", "anchor": 1, "near": [277, 643], "within": 0.5 },
    { "do": "describe", "stage": "snapping-off-draws-as-it-always-did", "note": "Snap to grid off with the lines still drawn: the Pen puts both points exactly where the pointer was" },
    { "do": "snapshot", "name": "pen-grid-4-everything" },
    { "do": "render", "name": "pen-grid-5-final-render" }
  ]
}
