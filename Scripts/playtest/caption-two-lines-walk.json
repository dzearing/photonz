{
  "out": "/tmp/photonz-playtest/caption-two-lines",
  "steps": [
    { "do": "open", "file": "../../Tests/PhotonzRenderTests/Fixtures/settings-pane-2x.png", "width": 1280, "height": 840 },
    { "do": "wait", "seconds": 1 },
    { "do": "action", "action": "zoomToFit" },
    { "do": "wait", "seconds": 0.5 },

    { "do": "key", "key": "a" },
    { "do": "waitFor", "condition": "tool", "value": "arrow" },
    { "do": "drag", "from": [700, 300], "to": [980, 300], "steps": 12 },
    { "do": "waitFor", "condition": "captionField", "timeout": 3 },
    { "do": "wait", "seconds": 0.4 },
    { "do": "type", "text": "Focus ring" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "type", "text": "is two pixels off" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "1-typing-two-lines", "note": "Return dropped a line inside the field: the bubble should be two lines tall and still meet the tail" },
    { "do": "snapshot", "name": "1-typing-two-lines" },
    { "do": "key", "key": "return", "modifiers": ["command"] },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "2-committed", "note": "Command Return landed the two line caption; it should read exactly as it did while being typed" },
    { "do": "snapshot", "name": "2-committed" },

    { "do": "focus", "field": "Add a caption" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "snapshot", "name": "2b-inspector-caption", "note": "the panel's Caption field shows both lines" },
    { "do": "key", "key": "return", "modifiers": ["command"] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "2c-inspector-landed", "note": "landing the panel's field again must not lose the second line" },

    { "do": "key", "key": "a" },
    { "do": "waitFor", "condition": "tool", "value": "arrow" },
    { "do": "drag", "from": [560, 760], "to": [800, 600], "steps": 12 },
    { "do": "waitFor", "condition": "captionField", "timeout": 3 },
    { "do": "wait", "seconds": 0.4 },
    { "do": "type", "text": "Row height" },
    { "do": "key", "key": "return" },
    { "do": "type", "text": "is 44" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "key", "key": "return", "modifiers": ["command"] },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "3-diagonal", "note": "a two line caption on a diagonal arrow" },
    { "do": "snapshot", "name": "3-diagonal" },

    { "do": "key", "key": "a" },
    { "do": "waitFor", "condition": "tool", "value": "arrow" },
    { "do": "drag", "from": [400, 500], "to": [260, 420], "steps": 12 },
    { "do": "waitFor", "condition": "captionField", "timeout": 3 },
    { "do": "wait", "seconds": 0.4 },
    { "do": "type", "text": "one" },
    { "do": "key", "key": "return" },
    { "do": "type", "text": "two" },
    { "do": "key", "key": "return" },
    { "do": "type", "text": "three" },
    { "do": "key", "key": "return" },
    { "do": "type", "text": "four" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "snapshot", "name": "4-four-lines-typing" },
    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "5-escaped", "note": "Escape abandoned four typed lines: that arrow should have no caption at all" },
    { "do": "snapshot", "name": "5-escaped" },

    { "do": "key", "key": "a" },
    { "do": "waitFor", "condition": "tool", "value": "arrow" },
    { "do": "drag", "from": [1060, 760], "to": [1180, 660], "steps": 12 },
    { "do": "waitFor", "condition": "captionField", "timeout": 3 },
    { "do": "wait", "seconds": 0.4 },
    { "do": "type", "text": "Padding" },
    { "do": "key", "key": "return" },
    { "do": "type", "text": "16 either side" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "click", "at": [200, 200] },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "6-clicked-away", "note": "clicking away landed the two lines, the same as Command Return does" },
    { "do": "snapshot", "name": "6-clicked-away" },
    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "snapshot", "name": "7-all" },
    { "do": "render", "name": "7-all" }
  ]
}
