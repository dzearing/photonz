{
  "out": "/tmp/photonz-playtest/text-style",
  "seed": "A text treatment saved under a name. Two headings are typed, one is set up by hand in Georgia 32 Bold, and the Style row at the top of the Text section saves that under the name Heading. The second heading takes the same name from the same menu and is re-set to match. Then the style itself is edited from the Library, once, and BOTH headings follow: that is the whole point of the feature, and one undo has to put it back.",
  "setup": {
    "forget": ["text", "panel", "shapes", "color", "tools"]
  },
  "steps": [
    { "do": "blank", "canvasWidth": 900, "canvasHeight": 600, "width": 1320, "height": 1000 },
    { "do": "wait", "seconds": 1 },

    { "do": "tool", "tool": "text" },
    { "do": "click", "at": [140, 130] },
    { "do": "type", "text": "Sign in" },
    { "do": "key", "key": "return", "modifiers": ["command"] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "tool", "tool": "text" },
    { "do": "click", "at": [140, 300] },
    { "do": "type", "text": "Create account" },
    { "do": "key", "key": "return", "modifiers": ["command"] },
    { "do": "wait", "seconds": 0.5 },

    { "do": "tool", "tool": "select" },
    { "do": "click", "at": [180, 145] },
    { "do": "wait", "seconds": 0.6 },
    { "do": "press", "control": "Position & Size section" },
    { "do": "press", "control": "Effects section" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "describe", "stage": "1-typed", "note": "two headings, both in the type a fresh text block starts at. The Text section now carries a Style row above Font, and it says nothing yet because this text is its own." },
    { "do": "panel", "stage": "1-typed" },
    { "do": "snapshot", "name": "1-two-headings" },

    { "do": "panelMenu", "menu": "Font", "choose": "Georgia" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "panelMenu", "menu": "Size", "choose": "32 pt" },
    { "do": "wait", "seconds": 0.6 },
    { "do": "panelMenu", "menu": "Weight", "choose": "Bold" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "2-set-up", "note": "the first heading set up by hand: Georgia, 32 pt, Bold" },
    { "do": "snapshot", "name": "2-set-up-by-hand" },

    { "do": "panelMenu", "menu": "Style", "shot": "3-style-menu" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "panelMenu", "menu": "Style", "choose": "Save as Style" },
    { "do": "wait", "seconds": 0.9 },
    { "do": "type", "text": "Heading" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 1 },
    { "do": "expect", "menu": "Style", "reads": "Heading" },
    { "do": "describe", "stage": "4-saved", "note": "asked for the name once, in the dock. The Style row now says Heading, and the Library has opened on the Styles shelf with the new tile on it." },
    { "do": "panel", "stage": "4-saved" },
    { "do": "snapshot", "name": "4-saved-and-on-the-shelf" },

    { "do": "click", "at": [200, 315] },
    { "do": "wait", "seconds": 0.8 },
    { "do": "panelMenu", "menu": "Style", "shot": "5-style-menu-with-one-saved" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "panelMenu", "menu": "Style", "choose": "Heading" },
    { "do": "wait", "seconds": 0.9 },
    { "do": "describe", "stage": "5-worn", "note": "the second heading takes the same name and is re-set to match it in one step" },
    { "do": "panel", "stage": "5-worn" },
    { "do": "snapshot", "name": "5-worn-by-the-other" },
    { "do": "render", "name": "5-canvas" },

    { "do": "click", "at": [650, 560] },
    { "do": "wait", "seconds": 0.8 },
    { "do": "press", "control": "Heading" },
    { "do": "wait", "seconds": 1 },
    { "do": "describe", "stage": "6-the-style-itself", "note": "the style's own section: its name, its font, size, weight and colour, and how much of the document leans on it" },
    { "do": "panel", "stage": "6-the-style-itself" },
    { "do": "snapshot", "name": "6-the-style-itself" },

    { "do": "panelMenu", "menu": "Size", "choose": "48 pt" },
    { "do": "wait", "seconds": 1 },
    { "do": "describe", "stage": "7-edited-once", "note": "THE TEST: one edit to the style, and both headings are 48 pt, each box re-measured so nothing clips" },
    { "do": "panel", "stage": "7-edited-once" },
    { "do": "snapshot", "name": "7-both-followed" },
    { "do": "render", "name": "7-canvas" },

    { "do": "action", "action": "undo" },
    { "do": "wait", "seconds": 1 },
    { "do": "describe", "stage": "8-undone", "note": "ONE undo takes the whole thing back. Undo is asked for as a menu action rather than as command Z, because a synthesized chord does not reach the Edit menu of an app that is not in front (see undo-shortcut-walk): the style is 32 pt again and so are both headings" },
    { "do": "snapshot", "name": "8-one-undo" },
    { "do": "render", "name": "8-canvas" }
  ]
}
