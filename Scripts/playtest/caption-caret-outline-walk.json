{
  "out": "/tmp/photonz-playtest/caption-caret-outline",
  "steps": [
    { "do": "open", "file": "../../Tests/PhotonzRenderTests/Fixtures/settings-pane-2x.png", "width": 1280, "height": 840 },
    { "do": "wait", "seconds": 1 },
    { "do": "action", "action": "zoomToFit" },
    { "do": "wait", "seconds": 0.5 },

    { "do": "key", "key": "a" },
    { "do": "waitFor", "condition": "tool", "value": "arrow" },
    { "do": "drag", "from": [700, 300], "to": [980, 300], "steps": 12 },
    { "do": "waitFor", "condition": "captionField", "timeout": 3 },
    { "do": "wait", "seconds": 0.4 },
    { "do": "describe", "stage": "1-field-open", "note": "an empty caption field: the outline should already be round the bubble, not round the bare arrow" },
    { "do": "type", "text": "Hello" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "expectCaption", "aligned": "left", "outline": "none" },
    { "do": "describe", "stage": "2-one-line", "note": "one line typed, Arrow still in hand so there is no selection chrome yet" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "expectCaption", "aligned": "centred", "caret": "centred" },
    { "do": "describe", "stage": "3-after-return", "note": "THE CARET BUG: Return must leave the caret centred, where the next letter lands, and must not resize the bubble" },
    { "do": "snapshot", "name": "3-after-return" },
    { "do": "type", "text": "X" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "describe", "stage": "4-typed-x", "note": "the letter lands where the caret was: compare 'caret sits' with the line before" },
    { "do": "type", "text": "Y is a much longer second line" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "describe", "stage": "5-long-second-line", "note": "THE OUTLINE BUG: a second line longer than the first; the outline must follow the bubble" },
    { "do": "snapshot", "name": "5-long-second-line" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "expectCaption", "aligned": "centred", "caret": "centred" },
    { "do": "describe", "stage": "6-third-line", "note": "a third line: caret centred again, bubble unchanged by the bare Return" },
    { "do": "type", "text": "three" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "describe", "stage": "7-third-typed", "note": "the third line's first letter lands where the caret was" },

    { "do": "action", "action": "zoomIn" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "8-zoomed-in", "note": "zoomed in: the outline and the bubble must still agree on their edges" },
    { "do": "snapshot", "name": "8-zoomed-in" },
    { "do": "action", "action": "zoomToFit" },
    { "do": "wait", "seconds": 0.5 },

    { "do": "key", "key": "return", "modifiers": ["command"] },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "9-committed", "note": "committing must not move the outline: the pill lands where the live bubble was" },
    { "do": "snapshot", "name": "9-committed" },

    { "do": "click", "at": [550, 300] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "9b-selected", "note": "the committed arrow picked: the outline is the box the live bubble must match" },
    { "do": "click", "at": [550, 300], "count": 2 },
    { "do": "waitFor", "condition": "captionField", "timeout": 3 },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expectCaption", "outline": "hugs the bubble" },
    { "do": "describe", "stage": "9c-reedit-open", "note": "re-editing the caption: the outline must still be round the bubble" },
    { "do": "type", "text": "Ok" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expectCaption", "aligned": "left", "outline": "hugs the bubble" },
    { "do": "describe", "stage": "9d-reedit-shrunk", "note": "THE OUTLINE BUG: three lines replaced by one word, so the bubble shrank; the outline must have shrunk with it" },
    { "do": "snapshot", "name": "9d-reedit-shrunk" },
    { "do": "type", "text": " and now a great deal longer than it ever was before" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expectCaption", "outline": "hugs the bubble" },
    { "do": "describe", "stage": "9d2-reedit-wider", "note": "...and grown again with it" },
    { "do": "snapshot", "name": "9d2-reedit-wider" },
    { "do": "action", "action": "zoomIn" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "expectCaption", "outline": "hugs the bubble" },
    { "do": "describe", "stage": "9d3-reedit-zoomed", "note": "zoomed in, the outline and the bubble still agree on the bubble's far edge" },
    { "do": "snapshot", "name": "9d3-reedit-zoomed" },
    { "do": "action", "action": "zoomToFit" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "key", "key": "return", "modifiers": ["command"] },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "9e-reedit-committed", "note": "no jump at the moment the field closes: the outline stays where the live one was" },

    { "do": "key", "key": "a" },
    { "do": "waitFor", "condition": "tool", "value": "arrow" },
    { "do": "drag", "from": [560, 700], "to": [820, 700], "steps": 12 },
    { "do": "waitFor", "condition": "captionField", "timeout": 3 },
    { "do": "wait", "seconds": 0.4 },
    { "do": "type", "text": "one" },
    { "do": "key", "key": "return" },
    { "do": "type", "text": "two" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "describe", "stage": "10-two-lines", "note": "two lines, about to be deleted back to one" },
    { "do": "key", "key": "delete" },
    { "do": "key", "key": "delete" },
    { "do": "key", "key": "delete" },
    { "do": "key", "key": "delete" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "expectCaption", "aligned": "left" },
    { "do": "describe", "stage": "11-back-to-one-line", "note": "deleted back through the Return: caret and outline back to the single line behaviour" },
    { "do": "snapshot", "name": "11-back-to-one-line" },
    { "do": "key", "key": "escape" },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "12-abandoned", "note": "Escape left that arrow with no caption at all" }
  ]
}
