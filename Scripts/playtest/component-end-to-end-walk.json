{
  "out": "/tmp/photonz-playtest/component-end-to-end-walk",
  "steps": [
    { "do": "blank", "canvasWidth": 1440, "canvasHeight": 1024, "width": 1240, "height": 900 },
    { "do": "wait", "seconds": 0.6 },

    { "do": "tool", "tool": "rectangle" },
    { "do": "drag", "from": [200, 220], "to": [520, 320] },
    { "do": "tool", "tool": "text" },
    { "do": "click", "at": [250, 250] },
    { "do": "type", "text": "Save" },
    { "do": "tool", "tool": "select" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "describe", "stage": "0-drawn", "note": "a box with a word in it: the control, drawn by hand" },
    { "do": "snapshot", "name": "e2e-0-drawn" },
    { "do": "render", "name": "e2e-0-drawn-doc" },

    { "do": "drag", "from": [150, 170], "to": [640, 400] },
    { "do": "wait", "seconds": 0.3 },
    { "do": "action", "action": "group" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "action", "action": "makeComponent" },
    { "do": "wait", "seconds": 0.9 },
    { "do": "type", "text": "Save button" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.9 },
    { "do": "describe", "stage": "1-component", "note": "grouped and promoted: the shelf opened on its own and handed over the name" },
    { "do": "snapshot", "name": "e2e-1-component" },

    { "do": "action", "action": "exposeWording" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "2-adjustable", "note": "the label is now the one adjustable thing about this component" },
    { "do": "snapshot", "name": "e2e-2-adjustable" },

    { "do": "action", "action": "pickFirstComponent" },
    { "do": "wait", "seconds": 0.4 },
    { "do": "dropComponent", "at": [950, 260] },
    { "do": "wait", "seconds": 0.7 },
    { "do": "action", "action": "pickFirstComponent" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "dropComponent", "at": [950, 520] },
    { "do": "wait", "seconds": 0.7 },
    { "do": "action", "action": "pickFirstComponent" },
    { "do": "wait", "seconds": 0.3 },
    { "do": "dropComponent", "at": [950, 780] },
    { "do": "wait", "seconds": 0.9 },
    { "do": "describe", "stage": "3-three-copies", "note": "three copies dropped from the shelf, all following the original" },
    { "do": "snapshot", "name": "e2e-3-three-copies" },
    { "do": "render", "name": "e2e-3-three-copies-doc" },

    { "do": "click", "at": [950, 520] },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "4-copy-picked", "note": "the middle copy is selected and its panel shows the one knob the original exposed" },
    { "do": "snapshot", "name": "e2e-4-copy-picked" },
    { "do": "focus", "field": "Save" },
    { "do": "type", "text": "Cancel" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 0.9 },
    { "do": "describe", "stage": "5-overridden", "note": "the middle copy alone says Cancel; the original and the other two are untouched" },
    { "do": "snapshot", "name": "e2e-5-overridden" },
    { "do": "render", "name": "e2e-5-overridden-doc" },

    { "do": "click", "at": [360, 280] },
    { "do": "wait", "seconds": 0.4 },
    { "do": "click", "at": [360, 280], "count": 2 },
    { "do": "wait", "seconds": 0.5 },
    { "do": "describe", "stage": "6-inside-original", "note": "double clicking descended into the original and picked the box" },
    { "do": "snapshot", "name": "e2e-6-inside-original" },
    { "do": "focus", "field": "W" },
    { "do": "type", "text": "440" },
    { "do": "key", "key": "return" },
    { "do": "wait", "seconds": 1.0 },
    { "do": "describe", "stage": "7-original-edited", "note": "widening the original's box reached all three copies in one step, including the overridden one" },
    { "do": "snapshot", "name": "e2e-7-original-edited" },
    { "do": "render", "name": "e2e-7-original-edited-doc" },

    { "do": "action", "action": "undo" },
    { "do": "wait", "seconds": 0.8 },
    { "do": "describe", "stage": "8-undone", "note": "one undo takes the width back off the original and all three copies" },
    { "do": "render", "name": "e2e-8-undone-doc" }
  ]
}
